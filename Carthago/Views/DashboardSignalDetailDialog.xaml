<!-- File: Views/DashboardSignalDetailDialog.xaml -->
<Window x:Class="Carthago.Views.DashboardSignalDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Signal detail"
        Width="900"
        Height="680"
        MinWidth="520"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Border Style="{StaticResource DialogSurface}"
            Margin="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Signal Investigation"
                               Style="{StaticResource DashboardSectionTitle}"/>
                    <TextBlock Text="{Binding Title}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding Subtitle}"
                               Foreground="{StaticResource TextSubtleBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right">
                    <TextBlock Text="RISK SCORE"
                               Style="{StaticResource MicroLabel}"
                               HorizontalAlignment="Right"/>
                    <Border Width="94"
                            Height="94"
                            Margin="0,8,0,0"
                            CornerRadius="47"
                            BorderThickness="6"
                            BorderBrush="{Binding RiskBrush}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding RiskText}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding RiskLabel}"
                                       Foreground="{Binding RiskBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="0,18,0,18"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <UniformGrid x:Name="MetadataGrid"
                                 Columns="3"
                                 Margin="0,0,0,12">
                        <Border Style="{StaticResource DetailGridCard}"
                                Margin="0,0,10,8">
                            <StackPanel>
                                <TextBlock Text="Source host"
                                           Style="{StaticResource MicroLabel}"/>
                                <TextBlock Text="{Binding Source}"
                                           Style="{StaticResource MonoValue}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           TextTrimming="None"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DetailGridCard}"
                                Margin="0,0,10,8">
                            <StackPanel>
                                <TextBlock Text="Destination"
                                           Style="{StaticResource MicroLabel}"/>
                                <TextBlock Text="{Binding Destination}"
                                           Style="{StaticResource MonoValue}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           TextTrimming="None"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DetailGridCard}"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Protocol / port"
                                           Style="{StaticResource MicroLabel}"/>
                                <TextBlock Text="{Binding Protocol}"
                                           Style="{StaticResource MonoValue}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           TextTrimming="None"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DetailGridCard}"
                                Margin="0,0,10,8">
                            <StackPanel>
                                <TextBlock Text="Category"
                                           Style="{StaticResource MicroLabel}"/>
                                <TextBlock Text="{Binding Category}"
                                           Style="{StaticResource MonoValue}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           TextTrimming="None"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DetailGridCard}"
                                Margin="0,0,10,8">
                            <StackPanel>
                                <TextBlock Text="Detected"
                                           Style="{StaticResource MicroLabel}"/>
                                <TextBlock Text="{Binding Detected}"
                                           Style="{StaticResource MonoValue}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           TextTrimming="None"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DetailGridCard}"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Related incident"
                                           Style="{StaticResource MicroLabel}"/>
                                <TextBlock Text="{Binding RelatedIncident}"
                                           Style="{StaticResource MonoValue}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           TextTrimming="None"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="0.85*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource DetailGridCard}"
                                Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Reasons"
                                           Style="{StaticResource SocSubHeader}"/>
                                <ItemsControl ItemsSource="{Binding Reasons}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{StaticResource TextSubtleBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,5"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource DetailGridCard}"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Tags"
                                           Style="{StaticResource SocSubHeader}"/>
                                <ItemsControl ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel IsItemsHost="True"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Pill}"
                                                    Margin="0,0,6,6">
                                                <TextBlock Text="{Binding}"
                                                           FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Style="{StaticResource DetailGridCard}"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Related rule IDs"
                                           Style="{StaticResource SocSubHeader}"/>
                                <ItemsControl ItemsSource="{Binding Rules}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel IsItemsHost="True"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Pill}"
                                                    Margin="0,0,6,6">
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource DetailGridCard}">
                            <StackPanel>
                                <TextBlock Text="Recommended actions"
                                           Style="{StaticResource SocSubHeader}"/>
                                <ItemsControl ItemsSource="{Binding RecommendedActions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{StaticResource TextSubtleBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,6"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock
                           Text="Copy Summary writes this local investigation summary to the system clipboard, including host details, risk, reasons and rule IDs. Review before sharing; navigation buttons open existing views only."
                           Style="{StaticResource MicroLabel}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

                <WrapPanel Grid.Row="1"
                           HorizontalAlignment="Right"
                           Margin="0,12,0,0">
                    <Button Content="Copy Summary"
                            ToolTip="Copies the selected local investigation summary to the system clipboard, including source, destination, risk, reasons, tags, related rule IDs and recommended actions. Review before sharing; this is not an evidence-file export or verification."
                            ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                            AutomationProperties.Name="Copy local investigation summary"
                            AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                            Width="118"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}"
                            Click="CopySummary_Click"/>
                    <Button Content="Open Anomalies"
                            ToolTip="Opens the existing Anomalies view when this context has a related anomaly ID. Navigation only; does not start capture or verify the signal."
                            ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                            AutomationProperties.Name="Open related anomaly view"
                            AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                            Width="122"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}"
                            IsEnabled="{Binding CanOpenAnomalies}"
                            Click="OpenAnomalies_Click"/>
                    <Button Content="Open Incident"
                            ToolTip="Opens the existing Incidents workspace and selects the related incident when an incident ID is available. Navigation only; no remediation or evidence validation."
                            ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                            AutomationProperties.Name="Open related incident"
                            AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                            Width="122"
                            Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding CanOpenIncident}"
                            Click="OpenIncident_Click"/>
                    <Button Content="Close"
                            ToolTip="Closes Signal Investigation without requesting navigation."
                            ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                            AutomationProperties.Name="Close signal investigation"
                            AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                            Width="92"
                            Style="{StaticResource SecondaryButton}"
                            Click="Close_Click"/>
                </WrapPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
