<!-- File: Views/AnomaliesPage.xaml -->
<Page x:Class="Carthago.Views.AnomaliesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Carthago.Views"
      Title="Anomalies"
      PreviewKeyDown="Page_PreviewKeyDown">

  <Page.Resources>
    <local:SeverityToBrushConverter x:Key="SeverityBrush"/>
    <Style x:Key="AnomalySectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
      <Setter Property="FontSize" Value="15.5"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="AnomalySectionMeta" TargetType="TextBlock" BasedOn="{StaticResource TinyStatusText}">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="AnomalyFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MicroLabel}">
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="AnomalyFieldValue" TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="AnomalyQueueHeader" TargetType="TextBlock" BasedOn="{StaticResource MicroLabel}">
      <Setter Property="FontSize" Value="11.25"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource AnomalyOpsHeroCard}" Margin="0,0,0,20" Padding="24">
        <!-- GA UI-147: two-zone operational masthead, stacked by the existing responsive controller. -->
        <Grid x:Name="AnomalyHeroGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="AnomalyHeroNarrativeColumn" Width="1.55*"/>
            <ColumnDefinition x:Name="AnomalyHeroSnapshotColumn" Width="0.85*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="AnomalyHeroCompactRow" Height="0"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Text="01 / BEHAVIOR ANALYTICS / LOCAL OBSERVATIONS"
                       Style="{StaticResource AnomalyOpsEyebrow}" TextWrapping="Wrap"/>
            <TextBlock Text="Anomaly Intelligence" FontSize="34" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" Margin="0,9,0,8" TextWrapping="Wrap"/>
            <TextBlock Text="Triage observed signals, compare local baselines and investigate recorded evidence."
                       FontSize="13" Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap"
                       MaxWidth="660" HorizontalAlignment="Left"/>
            <Border Height="3" Width="76" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}"
                    CornerRadius="2" Margin="0,20,0,0"/>
          </StackPanel>
          <Border x:Name="AnomalyHeroSnapshotCard" Grid.Column="1"
                  Background="#103247" BorderBrush="#356A80" BorderThickness="1"
                  CornerRadius="12" Padding="22,20" Margin="18,0,0,0"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="130">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="RECENT LOCAL SNAPSHOT" Style="{StaticResource AnomalyOpsEyebrow}"
                         TextWrapping="Wrap"/>
              <TextBlock Grid.Row="1" Text="{Binding RawSignalCount}" FontSize="42" FontWeight="Bold"
                         Foreground="{StaticResource TextBrush}" Margin="0,8,0,5"
                         VerticalAlignment="Center"/>
              <TextBlock Grid.Row="2" Text="Locally observed signals" FontSize="11.5"
                         Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap"/>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <UniformGrid x:Name="KpiGrid"
                   Grid.Row="1"
                   Columns="5"
                   Margin="0,0,0,20">
        <Border Style="{StaticResource AnomalyOpsKpiCard}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="New Anomalies (15m)" Style="{StaticResource TinyStatusText}"/>
            <TextBlock Text="{Binding NewAnomalies15m}" FontSize="28" FontWeight="Bold" Margin="0,8,0,3"/>
            <TextBlock Text="{Binding NewAnomaliesDeltaText}" Style="{StaticResource TinyStatusText}" Foreground="{StaticResource TextSuccessBrush}"/>
            <Border Height="3" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,11,0,0"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource AnomalyOpsKpiCard}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="High Severity" Style="{StaticResource TinyStatusText}"/>
            <TextBlock Text="{Binding HighSeverityCount}" FontSize="28" FontWeight="Bold" Margin="0,8,0,3"/>
            <TextBlock Text="{Binding HighSeverityDeltaText}" Style="{StaticResource TinyStatusText}" Foreground="{StaticResource SeverityHighBrush}"/>
            <Border Height="3" Background="{StaticResource SeverityHighBrush}" CornerRadius="2" Margin="0,11,0,0"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource AnomalyOpsKpiCard}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="Behavior Drift" Style="{StaticResource TinyStatusText}"/>
            <TextBlock Text="{Binding BehaviorDriftPercent, StringFormat={}{0}%}" FontSize="28" FontWeight="Bold" Margin="0,8,0,3"/>
            <TextBlock Text="{Binding BehaviorDriftDeltaText}" Style="{StaticResource TinyStatusText}" Foreground="#A855F7"/>
            <Border Height="3" Background="#8B5CF6" CornerRadius="2" Margin="0,11,0,0"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource AnomalyOpsKpiCard}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="Linked Incidents" Style="{StaticResource TinyStatusText}"/>
            <TextBlock Text="{Binding LinkedIncidentsCount}" FontSize="28" FontWeight="Bold" Margin="0,8,0,3"/>
            <TextBlock Text="{Binding LinkedIncidentsDeltaText}" Style="{StaticResource TinyStatusText}" Foreground="{StaticResource AccentAltBrush}"/>
            <Border Height="3" Background="{StaticResource AccentAltBrush}" CornerRadius="2" Margin="0,11,0,0"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource AnomalyOpsKpiCard}">
          <StackPanel>
            <TextBlock Text="Baseline Confidence" Style="{StaticResource TinyStatusText}"/>
            <TextBlock Text="{Binding BaselineConfidenceLabel}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,3"/>
            <TextBlock Text="{Binding BaselineHealthText}" Style="{StaticResource TinyStatusText}" Foreground="{StaticResource TextSuccessBrush}" TextWrapping="Wrap"/>
            <Border Height="4" CornerRadius="3" Margin="0,12,0,0"
                    Background="{StaticResource AccentAltBrush}"/>
            <TextBlock Text="Local baseline status · not rule coverage"
                       FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,6,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </UniformGrid>

      <Grid x:Name="PrimaryWorkspaceGrid" Grid.Row="2" Margin="0,0,0,20">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="PrimaryWorkspaceTopRow" Height="Auto"/>
          <RowDefinition x:Name="PrimaryWorkspaceBottomRow" Height="0"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="PrimaryWorkspaceQueueColumn" Width="0.49*"/>
          <ColumnDefinition x:Name="PrimaryWorkspaceDetailColumn" Width="0.51*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="QueuePanel" Grid.Column="0"
                Style="{StaticResource AnomalyOpsPanel}"
                Margin="0,0,18,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,15">
              <TextBlock Text="02 / PRIORITY SIGNALS" Style="{StaticResource AnomalyOpsEyebrow}" Margin="0,0,0,6"/>
              <TextBlock Text="Anomaly Triage Queue" Style="{StaticResource AnomalyOpsPanelTitle}" FontSize="21" FontWeight="Bold"/>
              <TextBlock Text="Select a recorded signal to inspect its baseline, host, rule and model context."
                         Style="{StaticResource AnomalySectionMeta}" Margin="0,6,0,0"/>
              <Border Height="1" Background="{StaticResource SoftDividerBrush}" Margin="0,13,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource AnomalyOpsFilterBand}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="FILTER LOCAL SIGNALS" Style="{StaticResource AnomalyOpsEyebrow}"
                           Margin="0,0,0,9"/>
                <Grid>
                  <TextBox x:Name="SearchBox"
                           Height="38"
                           Style="{StaticResource SearchBox}"
                           TextChanged="SearchBox_TextChanged"
                           AutomationProperties.Name="Search anomaly queue"
                           ToolTip="Search local anomaly titles, addresses, reasons, evidence, incident context and related rule IDs. No external lookup."
                           ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                           AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
                  <TextBlock Text="Search anomalies, hosts, IPs..."
                             Foreground="{StaticResource TextMutedBrush}"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ElementName=SearchBox, Path=Text}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
                <WrapPanel Margin="0,11,0,0">
                  <ComboBox x:Name="CategoryFilter"
                            Width="162" Height="38" Margin="0,0,9,9"
                            ItemsSource="{Binding CategoryOptions}"
                            SelectedItem="{Binding FilterCategory}"
                            AutomationProperties.Name="Anomaly category filter"
                            ToolTip="Filter this local anomaly queue by category. All categories removes the category restriction."
                            ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                            AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
                  <ComboBox x:Name="SeverityFilter"
                            Width="158" Height="38" Margin="0,0,9,9"
                            AutomationProperties.Name="Anomaly severity filter"
                            ToolTip="Filter this local anomaly queue by severity. All severities removes the severity restriction."
                            ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                            AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}">
                    <ComboBoxItem Content="All severities" IsSelected="True"/>
                    <ComboBoxItem Content="Critical"/>
                    <ComboBoxItem Content="High"/>
                    <ComboBoxItem Content="Medium"/>
                    <ComboBoxItem Content="Low"/>
                  </ComboBox>
                  <CheckBox x:Name="OnlyLinkedBox"
                            Content="Linked only" VerticalAlignment="Center"
                            Margin="0,0,13,9"
                            Checked="OnlyLinkedBox_Changed"
                            Unchecked="OnlyLinkedBox_Changed"
                            AutomationProperties.Name="Show only anomalies linked to incidents"
                            ToolTip="Show only anomalies that already have a related incident. This does not create or link incidents."
                            ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                            AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
                  <Button Content="Reset" Width="78" Height="38" Margin="0,0,0,9"
                          Style="{StaticResource SecondaryButton}"
                          Click="ResetFilters_Click"
                          AutomationProperties.Name="Reset anomaly queue filters"
                          ToolTip="Clear category, severity, search and linked-only filters for this anomaly queue. Does not reset application preferences or detection settings."
                          ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                          AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- GA UI-114: severity-first triage cards replace the 900px-wide queue table. -->
            <Grid Grid.Row="2" Grid.RowSpan="2">
              <ListBox x:Name="AnomaliesList"
                       ItemsSource="{Binding Visible}"
                       ItemContainerStyle="{StaticResource AnomalyQueueItemContainerStyle}"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       SelectionMode="Single">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#102233" BorderBrush="#315065"
                            BorderThickness="1" CornerRadius="14" Margin="0,0,0,16" Padding="0" MinHeight="220">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="5"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                CornerRadius="10,0,0,10"/>
                        <StackPanel Grid.Column="1" Margin="21,19,20,20">
                          <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                              <Border Style="{StaticResource SmallPill}" Background="#101F30"
                                      BorderBrush="{Binding Severity, Converter={StaticResource SeverityBrush}}">
                                <TextBlock Text="{Binding SeverityUpper}" FontSize="10" FontWeight="Bold"
                                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                              </Border>
                              <TextBlock Text="{Binding CategoryLabel}" Margin="9,0,0,0"
                                         Style="{StaticResource AnomalyQueueCellSubtleText}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="&#x22EF;" Width="30" Height="28" Padding="0"
                                    Style="{StaticResource SecondaryButton}" Click="QueueRowMenu_Click"
                                    Tag="{Binding}" HorizontalAlignment="Right"/>
                          </Grid>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DisplayTitle}" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                                       ToolTip="{Binding DisplayTitle}" Margin="0,0,10,0"/>
                            <Border Grid.Column="1" Background="#12384A" BorderBrush="#42788B"
                                    BorderThickness="1" CornerRadius="10" Padding="13,9" VerticalAlignment="Top" MinWidth="76">
                              <StackPanel>
                                <TextBlock Text="{Binding ScoreNumber}" FontSize="23" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="RISK" Style="{StaticResource AnomalyOpsEyebrow}" FontSize="9"
                                           HorizontalAlignment="Center"/>
                              </StackPanel>
                            </Border>
                          </Grid>
                          <TextBlock Text="{Binding PrimaryReason}" Margin="0,5,0,10"
                                     Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap"
                                     ToolTip="{Binding PrimaryReason}"/>
                          <Border Background="#0B1B2B" BorderBrush="#28485B" BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                              <TextBlock Text="ENTITY / HOST" Style="{StaticResource AnomalyOpsEyebrow}"/>
                              <TextBlock Text="{Binding SourceLabel}" FontWeight="SemiBold"
                                         Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                              <TextBlock Text="{Binding DestinationLabel}" Style="{StaticResource AnomalyQueueCellSubtleText}"
                                         TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                          </Border>
                          <TextBlock Text="{Binding DeviationSummary}" Foreground="{StaticResource TextSubtleBrush}"
                                     TextWrapping="Wrap" Margin="0,0,0,9"/>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock Text="{Binding OccurrenceLabel}" Style="{StaticResource AnomalyQueueCellSubtleText}"/>
                              <TextBlock Text="{Binding FirstSeenLabel}" Style="{StaticResource AnomalyQueueCellSubtleText}"
                                         Margin="0,3,0,0"/>
                              <TextBlock Text="{Binding LastSeenLabel}" Style="{StaticResource AnomalyQueueCellSubtleText}"
                                         Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource SmallPill}" Background="#10233B"
                                    BorderBrush="#1D4ED8" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                              <TextBlock Text="{Binding QueueStatusLabel}" Foreground="{StaticResource AccentAltBrush}"
                                         FontSize="10.5" FontWeight="SemiBold"/>
                            </Border>
                          </Grid>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Border x:Name="AnomaliesEmptyState" Style="{StaticResource EmptyStateCard}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                  <TextBlock Text="No anomaly signals yet" FontSize="18" FontWeight="SemiBold"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="Start monitoring or run demo mode to populate behavior signals."
                             Margin="0,8,0,0" Foreground="{StaticResource TextSubtleBrush}"
                             TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </Grid>

            <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
              <TextBlock Text="{Binding QueueCountText}"
                         Foreground="{StaticResource TextSubtleBrush}"
                         VerticalAlignment="Center"/>

              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding QueuePageText}"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>

                <Button Content="&lt;"
                        Width="30"
                        Height="28"
                        Style="{StaticResource SecondaryButton}"
                        Click="PreviousPage_Click"
                        IsEnabled="{Binding CanPageBack}"/>

                <ItemsControl ItemsSource="{Binding PageChips}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding Label}"
                              Tag="{Binding PageNumber}"
                              Style="{StaticResource AnomalyPageChipButton}"
                              Click="PageChip_Click"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="&gt;"
                        Width="30"
                        Height="28"
                        Style="{StaticResource SecondaryButton}"
                        Click="NextPage_Click"
                        IsEnabled="{Binding CanPageForward}"
                        Margin="6,0,0,0"/>
              </StackPanel>
            </DockPanel>
          </Grid>
        </Border>

        <Border x:Name="InvestigationPanel" Grid.Column="1"
                Style="{StaticResource AnomalyOpsPanel}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,15">
              <TextBlock Text="EVIDENCE / SELECTED SIGNAL" Style="{StaticResource AnomalyOpsEyebrow}" Margin="0,0,0,6"/>
              <TextBlock Text="Selected Anomaly Investigation" Style="{StaticResource AnomalyOpsPanelTitle}"/>
              <TextBlock Text="{Binding SelectedWindowLabel}" Style="{StaticResource AnomalySectionMeta}" Margin="0,6,0,0"/>
              <Border Height="1" Background="{StaticResource SoftDividerBrush}" Margin="0,13,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
              <StackPanel x:Name="InvestigationBody" Visibility="Collapsed">
                <!-- GA UI-170: selected-signal command hero, responsive evidence and severity hierarchy. -->
                <Grid x:Name="SelectedSignalHero" Margin="0,0,0,20">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="SelectedSignalHeroCompactRow" Height="0"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SelectedSignalNarrativeColumn" Width="1.5*"/>
                    <ColumnDefinition x:Name="SelectedSignalRiskColumn" Width="0.65*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#102233" BorderBrush="#356A80"
                          BorderThickness="1.5" CornerRadius="14"/>
                  <Border x:Name="SelectedSignalNarrativeCard" Grid.Column="0" Margin="0,0,14,0"
                          BorderBrush="{Binding Selected.Severity, Converter={StaticResource SeverityBrush}}"
                          BorderThickness="6,0,0,0" Padding="22,22,16,22">
                    <StackPanel>
                      <TextBlock Text="SELECTED LOCAL SIGNAL / RECORDED EVIDENCE" Style="{StaticResource AnomalyOpsEyebrow}"
                                 Margin="0,0,0,11" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Selected.DisplayTitle}" FontSize="27" FontWeight="Bold"
                                 Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                                 ToolTip="{Binding Selected.DisplayTitle}"/>
                      <TextBlock Text="{Binding Selected.Description}" Foreground="{StaticResource TextSubtleBrush}"
                                 FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap"/>
                      <Border Background="{StaticResource AccentBrush}" Height="3" Width="76"
                              HorizontalAlignment="Left" CornerRadius="2" Margin="0,19,0,0"/>
                    </StackPanel>
                  </Border>
                  <Border x:Name="SelectedSignalRiskCard" Grid.Column="1" Margin="0,14,14,14"
                          Background="#12384A" BorderBrush="#356A80" BorderThickness="1"
                          CornerRadius="12" Padding="15">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="RISK / RECORDED SCORE" Style="{StaticResource MicroLabel}"
                                 TextAlignment="Center" TextWrapping="Wrap"/>
                      <Grid Width="104" Height="104" Margin="0,12,0,9">
                        <Ellipse Style="{StaticResource RiskScoreCircle}"
                                 Stroke="{Binding Selected.Severity, Converter={StaticResource SeverityBrush}}"/>
                        <TextBlock Text="{Binding Selected.ScoreNumber}" FontSize="23" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Grid>
                      <Border Style="{StaticResource SmallPill}" Background="#421D22"
                              BorderBrush="{Binding Selected.Severity, Converter={StaticResource SeverityBrush}}"
                              HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Selected.Severity}"
                                   Foreground="{Binding Selected.Severity, Converter={StaticResource SeverityBrush}}"
                                   FontWeight="Bold"/>
                      </Border>
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid x:Name="SelectedSignalEvidenceGrid" Margin="0,0,0,18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                  <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource AnomalyOpsEvidenceCard}" BorderBrush="#31576B" BorderThickness="1.5" Padding="18,16" Margin="0,0,7,12">
                    <StackPanel>
                      <TextBlock Text="Source host" Style="{StaticResource AnomalyFieldLabel}"/>
                      <TextBlock Text="{Binding Selected.SourceLabel}" Style="{StaticResource AnomalyFieldValue}" ToolTip="{Binding Selected.SourceLabel}"/>
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource AnomalyOpsEvidenceCard}" BorderBrush="#31576B" BorderThickness="1.5" Padding="18,16" Margin="7,0,0,12">
                    <StackPanel>
                      <TextBlock Text="Destination" Style="{StaticResource AnomalyFieldLabel}"/>
                      <TextBlock Text="{Binding Selected.DestinationLabel}" Style="{StaticResource AnomalyFieldValue}" ToolTip="{Binding Selected.DestinationLabel}"/>
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource AnomalyOpsEvidenceCard}" BorderBrush="#31576B" BorderThickness="1.5" Padding="18,16" Margin="0,0,7,12">
                    <StackPanel>
                      <TextBlock Text="Protocol / port" Style="{StaticResource AnomalyFieldLabel}"/>
                      <TextBlock Text="{Binding Selected.ProtocolPortLabel}" Style="{StaticResource AnomalyFieldValue}" ToolTip="{Binding Selected.ProtocolPortLabel}"/>
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AnomalyOpsEvidenceCard}" BorderBrush="#31576B" BorderThickness="1.5" Padding="18,16" Margin="7,0,0,12">
                    <StackPanel>
                      <TextBlock Text="Detected" Style="{StaticResource AnomalyFieldLabel}"/>
                      <TextBlock Text="{Binding Selected.CreatedLabelLong}" Style="{StaticResource AnomalyFieldValue}" ToolTip="{Binding Selected.CreatedLabelLong}"/>
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource AnomalyOpsEvidenceCard}" BorderBrush="#31576B" BorderThickness="1.5" Padding="18,16" Margin="0,0,7,12">
                    <StackPanel>
                      <TextBlock Text="Category" Style="{StaticResource AnomalyFieldLabel}"/>
                      <TextBlock Text="{Binding Selected.CategoryLabel}" Style="{StaticResource AnomalyFieldValue}" ToolTip="{Binding Selected.CategoryLabel}"/>
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource AnomalyOpsEvidenceCard}" BorderBrush="#31576B" BorderThickness="1.5" Padding="18,16" Margin="7,0,0,12">
                    <StackPanel>
                      <TextBlock Text="Linked incident" Style="{StaticResource AnomalyFieldLabel}"/>
                      <TextBlock Text="{Binding Selected.RelatedIncidentTitle}" Style="{StaticResource AnomalyFieldValue}" ToolTip="{Binding Selected.RelatedIncidentTitle}"/>
                      <WrapPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource SmallPill}" Background="#10233B" BorderBrush="#1D4ED8" Margin="0,0,6,0">
                          <TextBlock Text="{Binding Selected.RelatedIncidentStatus}" Foreground="{StaticResource AccentAltBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                        </Border>
                        <Border Style="{StaticResource SmallPill}" Background="#421D22" BorderBrush="{Binding Selected.RelatedIncidentSeverity, Converter={StaticResource SeverityBrush}}">
                          <TextBlock Text="{Binding Selected.RelatedIncidentSeverity}" Foreground="{Binding Selected.RelatedIncidentSeverity, Converter={StaticResource SeverityBrush}}" FontSize="10.5" FontWeight="SemiBold"/>
                        </Border>
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid Margin="0,0,0,14">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <Border Grid.Row="0" Style="{StaticResource BaselineComparisonCard}" Margin="0,0,0,16" Padding="20">
                    <StackPanel>
                      <TextBlock Text="01 / LOCAL BASELINE COMPARISON" Style="{StaticResource AnomalySectionTitle}" FontSize="19" FontWeight="Bold" Margin="0,0,0,8"/>
                      <TextBlock Text="{Binding BaselineStatusText}" Style="{StaticResource AnomalySectionMeta}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                      <Border Height="1" Background="{StaticResource SoftDividerBrush}" Margin="0,0,0,16"/>
                      <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,8,0">
                          <Border Background="#142A3A" BorderBrush="#284252" BorderThickness="1" CornerRadius="9" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                              <TextBlock Text="NORMAL / BASELINE" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                              <TextBlock Text="{Binding BaselineNormalLabel}" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                          </Border>
                          <Border Background="#142A3A" BorderBrush="#284252" BorderThickness="1" CornerRadius="9" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                              <TextBlock Text="DEVIATION" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                              <TextBlock Text="{Binding BaselineDeviationLabel}" Foreground="{StaticResource WarnBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                        <StackPanel Margin="8,0,0,0">
                          <Border Background="#142A3A" BorderBrush="#284252" BorderThickness="1" CornerRadius="9" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                              <TextBlock Text="CURRENT OBSERVATION" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                              <TextBlock Text="{Binding BaselineCurrentLabel}" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                          </Border>
                          <Border Background="#142A3A" BorderBrush="#284252" BorderThickness="1" CornerRadius="9" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                              <TextBlock Text="PEER GROUP POSITION" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                              <TextBlock Text="{Binding PeerGroupLabel}" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </UniformGrid>
                      <TextBlock Text="Comparison reflects available local observations; it is not a network-wide health assessment."
                                 Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="1" Style="{StaticResource AnomalyOpsEvidenceCard}" Margin="0,0,0,16" Padding="20">
                    <StackPanel>
                      <TextBlock Text="02 / EXPLAINABLE MODEL CONTEXT" Style="{StaticResource AnomalySectionTitle}" FontSize="19" FontWeight="Bold" Margin="0,0,0,9"/>
                      <TextBlock Text="{Binding ModelSummary}" Style="{StaticResource AnomalySectionMeta}" TextWrapping="Wrap" Margin="0,0,0,15"/>
                      <Border Height="1" Background="{StaticResource SoftDividerBrush}" Margin="0,0,0,14"/>
                      <ItemsControl x:Name="ExplanationItems" ItemsSource="{Binding ModelExplanationPoints}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="#142A3A" BorderBrush="#284252" BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,0,0,10">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="4"/>
                                  <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource AccentAltBrush}" CornerRadius="2"/>
                                <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{StaticResource TextSubtleBrush}"
                                           Margin="12,0,0,0" TextWrapping="Wrap"/>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="No explainable evidence beyond the base anomaly metadata was recorded for this signal."
                                 Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ElementName=ExplanationItems, Path=HasItems}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="2" Style="{StaticResource AnomalyOpsEvidenceCard}" Margin="0" Padding="20">
                    <StackPanel>
                      <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource AccentBrush}" CornerRadius="3" Margin="0,0,0,0"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                          <TextBlock Text="03 / RECORDED FEATURE SIGNALS" Style="{StaticResource AnomalySectionTitle}" FontSize="19" FontWeight="Bold" Margin="0,0,0,6"/>
                          <TextBlock Text="Relative contributions from recorded model evidence only." Style="{StaticResource AnomalySectionMeta}" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Grid>
                      <ItemsControl x:Name="TopSignalsItems" ItemsSource="{Binding TopMlSignals}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="#172A3A" BorderBrush="#304759" BorderThickness="1" CornerRadius="9" Padding="16,14" Margin="0,0,0,12">
                              <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{Binding BarBrush}" CornerRadius="3"/>
                                <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                  <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding Name}"/>
                                  <Border Style="{StaticResource ModelSignalBar}" Margin="0,12,0,0">
                                    <Border Width="{Binding BarWidth}" Height="8" Background="{Binding BarBrush}" CornerRadius="4" HorizontalAlignment="Left"/>
                                  </Border>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#102232" CornerRadius="7" Padding="12,8" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding ValueLabel}" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="Bold"/>
                                </Border>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="No ML feature contribution data was recorded for this anomaly." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ElementName=TopSignalsItems, Path=HasItems}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </Grid>

                <!-- GA UI-151: cohesive context and response workspace, recorded data only. -->
                <Border Background="#0D2232" BorderBrush="#27485B" BorderThickness="1"
                        CornerRadius="12" Padding="18" Margin="0,0,0,16">
                  <StackPanel>
                    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="4,0,0,0"
                            Padding="12,2,0,2" Margin="0,0,0,16">
                      <StackPanel>
                        <TextBlock Text="EVIDENCE CONTEXT / RECORDED LINKS" Style="{StaticResource AnomalyOpsEyebrow}"/>
                        <TextBlock Text="Classification &amp; related detections" FontSize="19"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap" Margin="0,5,0,3"/>
                        <TextBlock Text="Tags and rule identifiers are shown only when present in the selected local record."
                                   Foreground="{StaticResource TextSubtleBrush}" FontSize="12" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                    <Border Background="#142C3D" BorderBrush="#2B4859" BorderThickness="1"
                            CornerRadius="9" Padding="16" Margin="0,0,0,12">
                      <StackPanel>
                        <TextBlock Text="CLASSIFICATION TAGS" Style="{StaticResource AnomalyFieldLabel}"/>
                        <ItemsControl ItemsSource="{Binding Selected.Tags}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Background="#183649" BorderBrush="#31566A" BorderThickness="1"
                                      CornerRadius="6" Padding="11,7" Margin="0,4,8,4">
                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextBrush}"
                                           FontSize="12" TextWrapping="Wrap"/>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                    <Border Background="#142C3D" BorderBrush="#2B4859" BorderThickness="1"
                            CornerRadius="9" Padding="16">
                      <StackPanel>
                        <TextBlock Text="RELATED DETECTION RULES" Style="{StaticResource AnomalyFieldLabel}"/>
                        <ItemsControl x:Name="RelatedRulesItems" ItemsSource="{Binding Selected.RelatedRuleIds}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Background="#103247" BorderBrush="#39758A" BorderThickness="1"
                                      CornerRadius="7" Padding="12,8" Margin="0,4,8,4">
                                <TextBlock Text="{Binding}" Foreground="{StaticResource AccentBrush}"
                                           FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"/>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No related rules were recorded for this anomaly."
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=RelatedRulesItems, Path=HasItems}" Value="False">
                                  <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <Border Background="#102B3B" BorderBrush="#376477" BorderThickness="1"
                        CornerRadius="12" Padding="20">
                  <StackPanel>
                    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="4,0,0,0"
                            Padding="12,2,0,2" Margin="0,0,0,16">
                      <StackPanel>
                        <TextBlock Text="ANALYST RESPONSE / EXISTING WORKFLOWS" Style="{StaticResource AnomalyOpsEyebrow}"/>
                        <TextBlock Text="Review &amp; respond" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,5,0,3"/>
                        <TextBlock Text="Actions remain subject to existing permissions and selection state."
                                   Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap" FontSize="12"/>
                      </StackPanel>
                    </Border>
                    <WrapPanel>
                      <Button Content="Mark Expected" Style="{StaticResource SecondaryButton}"
                              Click="MarkExpected_Click" IsEnabled="{Binding CanMarkExpected}"
                              MinHeight="38" Margin="0,0,10,10"/>
                      <Button Content="{Binding IncidentActionLabel}" Style="{StaticResource SecondaryButton}"
                              Click="ViewIncident_Click" IsEnabled="{Binding CanOpenIncident}"
                              MinHeight="38" Margin="0,0,10,10"/>
                      <Button Content="Open Raw Traffic" Style="{StaticResource SecondaryButton}"
                              Click="OpenRawTraffic_Click" IsEnabled="{Binding CanOpenRawTraffic}"
                              MinHeight="38" Margin="0,0,10,10"/>
                      <Button Content="⋯" Width="44" MinHeight="38" Style="{StaticResource SecondaryButton}"
                              Click="MoreActions_Click" IsEnabled="{Binding CanOpenIncident}"
                              Margin="0,0,0,10"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <Border x:Name="DetailsEmptyState" Style="{StaticResource EmptyStateCard}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                  <TextBlock Text="Select an anomaly to inspect"
                             FontSize="18"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="Select an anomaly to inspect baseline comparison, model signals, and recommended actions."
                             Margin="0,8,0,0"
                             Foreground="{StaticResource TextSubtleBrush}"
                             TextAlignment="Center"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Grid x:Name="SupportingWorkspaceGrid" Grid.Row="3">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="SupportingWorkspaceFirstRow" Height="Auto"/>
          <RowDefinition x:Name="SupportingWorkspaceSecondRow" Height="Auto"/>
          <RowDefinition x:Name="SupportingWorkspaceThirdRow" Height="0"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="SupportingWorkspaceFirstColumn" Width="1.12*"/>
          <ColumnDefinition x:Name="SupportingWorkspaceSecondColumn" Width="0.88*"/>
          <ColumnDefinition x:Name="SupportingWorkspaceThirdColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="EntityHistoryPanel" Grid.Column="0" Style="{StaticResource AnomalyOpsPanel}" Margin="0,0,14,14" BorderBrush="#356A80" BorderThickness="1.5">
          <StackPanel>
            <Border BorderBrush="{StaticResource SoftDividerBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="HISTORY / OBSERVED METRICS" Style="{StaticResource AnomalyOpsEyebrow}" Margin="0,0,0,7"/>
                <TextBlock Text="Entity Behavior History" Style="{StaticResource AnomalyOpsPanelTitle}" FontSize="23" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedWindowLabel}" Style="{StaticResource AnomalySectionMeta}" Margin="0,7,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <ItemsControl x:Name="EntityHistoryItems" ItemsSource="{Binding EntityHistoryRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#102233" BorderBrush="#315065" BorderThickness="1" CornerRadius="11" Margin="0,0,0,12" Padding="0">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Background="{StaticResource AccentBrush}" CornerRadius="10,0,0,10"/>
                      <StackPanel Grid.Column="1" Margin="14,13,13,14">
                        <Grid Margin="0,0,0,13">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Metric}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,10,0"/>
                          <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" FontSize="11" Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Observed" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Observed}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Baseline" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Baseline}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                          </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{StaticResource SoftDividerBrush}" Margin="0,13,0,10"/>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="DEVIATION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Deviation}" Foreground="{Binding DeviationBrush}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="TREND" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Trend}" Foreground="{StaticResource TextSubtleBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"/>
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border x:Name="BaselineDriftPanel" Grid.Column="1" Style="{StaticResource AnomalyOpsPanel}" Margin="0,0,0,14" BorderBrush="#31576B" BorderThickness="1.5">
          <StackPanel>
            <Border BorderBrush="{StaticResource SoftDividerBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="BASELINE / LOCAL COMPARISON" Style="{StaticResource AnomalyOpsEyebrow}" Margin="0,0,0,7"/>
                <TextBlock Text="Baseline Drift &amp; Peer Group" Style="{StaticResource AnomalyOpsPanelTitle}" FontSize="23" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding PeerGroupHeader}" Style="{StaticResource AnomalySectionMeta}" Margin="0,7,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <ItemsControl x:Name="DriftItems" ItemsSource="{Binding BaselineDriftRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#102233" BorderBrush="#315065" BorderThickness="1" CornerRadius="11" Margin="0,0,0,12" Padding="0">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Background="{StaticResource AccentBrush}" CornerRadius="10,0,0,10"/>
                      <StackPanel Grid.Column="1" Margin="14,13,13,14">
                        <Grid Margin="0,0,0,13">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Metric}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,10,0"/>
                          <TextBlock Grid.Column="1" Text="{Binding Trend}" FontSize="11" Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Current" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Observed}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Baseline" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Baseline}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                          </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{StaticResource SoftDividerBrush}" Margin="0,13,0,10"/>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="DEVIATION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Deviation}" Foreground="{Binding DeviationBrush}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="LOCAL TREND" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Trend}" Foreground="{StaticResource TextSubtleBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"/>
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border x:Name="ModelSummaryPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource AnomalyOpsPanel}" BorderBrush="#31576B" BorderThickness="1.5">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
              <TextBlock Text="WORKFLOW / EXISTING ACTIONS" Style="{StaticResource AnomalyOpsEyebrow}" Margin="0,0,0,6"/>
              <TextBlock Text="Analyst Actions &amp; Shortcuts" Style="{StaticResource AnomalyOpsPanelTitle}" FontSize="23"/>
              <TextBlock Text="Use the shell for deeper evidence and the closest live workspace for each action." Style="{StaticResource AnomalySectionMeta}"/>
            </StackPanel>

            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource AnalystActionTile}" Click="PivotToHost_Click" IsEnabled="{Binding CanPivotToHost}">
                <StackPanel>
                  <TextBlock Text="Pivot to Host" FontWeight="SemiBold"/>
                  <TextBlock Text="Open the host-focused workspace for this entity." Style="{StaticResource AnomalySectionMeta}" Margin="0,4,0,0"/>
                </StackPanel>
              </Button>

              <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource AnalystActionTile}" Click="OpenRawDetections_Click" IsEnabled="{Binding CanOpenRawDetections}" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="Query detections" FontWeight="SemiBold"/>
                  <TextBlock Text="Inspect rule hits and related detection evidence." Style="{StaticResource AnomalySectionMeta}" Margin="0,4,0,0"/>
                </StackPanel>
              </Button>

              <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource AnalystActionTile}" Click="OpenRawTraffic_Click" IsEnabled="{Binding CanOpenRawTraffic}">
                <StackPanel>
                  <TextBlock Text="Search in Raw Traffic" FontWeight="SemiBold"/>
                  <TextBlock Text="Move into packets and flows for the selected signal." Style="{StaticResource AnomalySectionMeta}" Margin="0,4,0,0"/>
                </StackPanel>
              </Button>

              <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource AnalystActionTile}" Click="CreateDetectionRule_Click" IsEnabled="{Binding CanOpenDetectionRules}" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="Create Detection Rule" FontWeight="SemiBold"/>
                  <TextBlock Text="Open governance and detection settings for rule tuning." Style="{StaticResource AnomalySectionMeta}" Margin="0,4,0,0"/>
                </StackPanel>
              </Button>

              <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource AnalystActionTile}" Click="AddToWatchlist_Click" IsEnabled="{Binding CanAddToWatchlist}">
                <StackPanel>
                  <TextBlock Text="Add to Watchlist" FontWeight="SemiBold"/>
                  <TextBlock Text="Use the closest available suppression or watch workflow honestly." Style="{StaticResource AnomalySectionMeta}" Margin="0,4,0,0"/>
                </StackPanel>
              </Button>

              <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource AnalystActionTile}" Click="CopyJson_Click" IsEnabled="{Binding CanCopyEvidence}" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="Export Evidence Pack" FontWeight="SemiBold"/>
                  <TextBlock Text="Copy structured anomaly evidence for reporting or handoff." Style="{StaticResource AnomalySectionMeta}" Margin="0,4,0,0"/>
                </StackPanel>
              </Button>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</Page>
