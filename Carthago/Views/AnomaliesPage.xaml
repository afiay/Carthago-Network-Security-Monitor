<!-- File: Views/AnomaliesPage.xaml -->
<Page x:Class="Carthago.Views.AnomaliesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Carthago.Views"
      Title="Anomalies"
      PreviewKeyDown="Page_PreviewKeyDown">

  <Page.Resources>
    <local:SeverityToBrushConverter x:Key="SeverityBrush"/>
    <Style x:Key="AnomalySectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
      <Setter Property="FontSize" Value="15.5"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="AnomalySectionMeta" TargetType="TextBlock" BasedOn="{StaticResource TinyStatusText}">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="AnomalyFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MicroLabel}">
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="AnomalyFieldValue" TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="AnomalyQueueHeader" TargetType="TextBlock" BasedOn="{StaticResource MicroLabel}">
      <Setter Property="FontSize" Value="11.25"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0"
          MinWidth="1180">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <UniformGrid Grid.Row="0"
                   Columns="5"
                   Margin="0,0,0,14">
        <Border Style="{StaticResource AnomalyKpiCard}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="New Anomalies (15m)" Style="{StaticResource TinyStatusText}"/>
            <TextBlock Text="{Binding NewAnomalies15m}" FontSize="24" FontWeight="Bold" Margin="0,6,0,2"/>
            <TextBlock Text="{Binding NewAnomaliesDeltaText}" Style="{StaticResource TinyStatusText}" Foreground="{StaticResource TextSuccessBrush}"/>
            <Border Height="3" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,11,0,0"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource AnomalyKpiCard}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="High Severity" Style="{StaticResource TinyStatusText}"/>
            <TextBlock Text="{Binding HighSeverityCount}" FontSize="24" FontWeight="Bold" Margin="0,6,0,2"/>
            <TextBlock Text="{Binding HighSeverityDeltaText}" Style="{StaticResource TinyStatusText}" Foreground="{StaticResource SeverityHighBrush}"/>
            <Border Height="3" Background="{StaticResource SeverityHighBrush}" CornerRadius="2" Margin="0,11,0,0"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource AnomalyKpiCard}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="Behavior Drift" Style="{StaticResource TinyStatusText}"/>
            <TextBlock Text="{Binding BehaviorDriftPercent, StringFormat={}{0}%}" FontSize="24" FontWeight="Bold" Margin="0,6,0,2"/>
            <TextBlock Text="{Binding BehaviorDriftDeltaText}" Style="{StaticResource TinyStatusText}" Foreground="#A855F7"/>
            <Border Height="3" Background="#8B5CF6" CornerRadius="2" Margin="0,11,0,0"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource AnomalyKpiCard}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="Linked Incidents" Style="{StaticResource TinyStatusText}"/>
            <TextBlock Text="{Binding LinkedIncidentsCount}" FontSize="24" FontWeight="Bold" Margin="0,6,0,2"/>
            <TextBlock Text="{Binding LinkedIncidentsDeltaText}" Style="{StaticResource TinyStatusText}" Foreground="{StaticResource AccentAltBrush}"/>
            <Border Height="3" Background="{StaticResource AccentAltBrush}" CornerRadius="2" Margin="0,11,0,0"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource AnomalyKpiCard}">
          <StackPanel>
            <TextBlock Text="Baseline Confidence" Style="{StaticResource TinyStatusText}"/>
            <TextBlock Text="{Binding BaselineConfidenceLabel}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource OkBrush}" Margin="0,6,0,2"/>
            <TextBlock Text="{Binding BaselineHealthText}" Style="{StaticResource TinyStatusText}" Foreground="{StaticResource TextSuccessBrush}" TextWrapping="Wrap"/>
            <UniformGrid Columns="5" Margin="0,11,0,0">
              <Border Height="7" CornerRadius="4" Margin="0,0,5,0" Background="{StaticResource OkBrush}"/>
              <Border Height="7" CornerRadius="4" Margin="0,0,5,0" Background="{StaticResource OkBrush}"/>
              <Border Height="7" CornerRadius="4" Margin="0,0,5,0" Background="{StaticResource OkBrush}"/>
              <Border Height="7" CornerRadius="4" Margin="0,0,5,0" Background="{StaticResource OkBrush}"/>
              <Border Height="7" CornerRadius="4" Background="{StaticResource OkBrush}"/>
            </UniformGrid>
          </StackPanel>
        </Border>
      </UniformGrid>

      <Grid Grid.Row="1" Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.45*"/>
          <ColumnDefinition Width="0.55*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource AnomalyQueuePanel}"
                Margin="0,0,12,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
              <TextBlock Text="Anomaly Triage Queue" Style="{StaticResource AnomalySectionTitle}"/>
              <TextBlock Text="Select the anomaly that matters, then pivot into baseline, host, rule, and model evidence." Style="{StaticResource AnomalySectionMeta}"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.0*"/>
                <ColumnDefinition Width="1.28*"/>
                <ColumnDefinition Width="0.82*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <ComboBox x:Name="CategoryFilter"
                        Grid.Column="0"
                        Height="36"
                        Margin="0,0,8,0"
                        ItemsSource="{Binding CategoryOptions}"
                        SelectedItem="{Binding FilterCategory}"/>

              <Grid Grid.Column="1" Margin="0,0,8,0">
                <TextBox x:Name="SearchBox"
                         Height="36"
                         Style="{StaticResource SearchBox}"
                         TextChanged="SearchBox_TextChanged"/>
                <TextBlock Text="Search anomalies, hosts, IPs..."
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=SearchBox, Path=Text}" Value="">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>

              <ComboBox x:Name="SeverityFilter"
                        Grid.Column="2"
                        Height="36"
                        Margin="0,0,8,0">
                <ComboBoxItem Content="All severities" IsSelected="True"/>
                <ComboBoxItem Content="Critical"/>
                <ComboBoxItem Content="High"/>
                <ComboBoxItem Content="Medium"/>
                <ComboBoxItem Content="Low"/>
              </ComboBox>

              <CheckBox x:Name="OnlyLinkedBox"
                        Grid.Column="3"
                        Content="Linked only"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Checked="OnlyLinkedBox_Changed"
                        Unchecked="OnlyLinkedBox_Changed"/>

              <Button Grid.Column="4"
                      Content="Reset"
                      Width="68"
                      Height="36"
                      Style="{StaticResource SecondaryButton}"
                      Click="ResetFilters_Click"/>
            </Grid>

            <Border Grid.Row="2"
                    Background="#081321"
                    BorderBrush="{StaticResource InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,8"
                    Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="66"/>
                  <ColumnDefinition Width="1.65*"/>
                  <ColumnDefinition Width="1.18*"/>
                  <ColumnDefinition Width="1.00*"/>
                  <ColumnDefinition Width="1.36*"/>
                  <ColumnDefinition Width="0.74*"/>
                  <ColumnDefinition Width="0.96*"/>
                  <ColumnDefinition Width="0.74*"/>
                  <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Score" Style="{StaticResource AnomalyQueueHeader}"/>
                <TextBlock Grid.Column="1" Text="Anomaly" Style="{StaticResource AnomalyQueueHeader}"/>
                <TextBlock Grid.Column="2" Text="Entity / Host" Style="{StaticResource AnomalyQueueHeader}"/>
                <TextBlock Grid.Column="3" Text="Category" Style="{StaticResource AnomalyQueueHeader}"/>
                <TextBlock Grid.Column="4" Text="Deviation / Reason" Style="{StaticResource AnomalyQueueHeader}"/>
                <TextBlock Grid.Column="5" Text="Severity" Style="{StaticResource AnomalyQueueHeader}"/>
                <TextBlock Grid.Column="6" Text="First / Last Seen" Style="{StaticResource AnomalyQueueHeader}"/>
                <TextBlock Grid.Column="7" Text="Status" Style="{StaticResource AnomalyQueueHeader}"/>
                <TextBlock Grid.Column="8" Text="" Style="{StaticResource AnomalyQueueHeader}"/>
              </Grid>
            </Border>

            <Grid Grid.Row="3">
              <ListBox x:Name="AnomaliesList"
                       ItemsSource="{Binding Visible}"
                       ItemContainerStyle="{StaticResource AnomalyQueueItemContainerStyle}"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       SelectionMode="Single">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66"/>
                        <ColumnDefinition Width="1.65*"/>
                        <ColumnDefinition Width="1.18*"/>
                        <ColumnDefinition Width="1.00*"/>
                        <ColumnDefinition Width="1.36*"/>
                        <ColumnDefinition Width="0.74*"/>
                        <ColumnDefinition Width="0.96*"/>
                        <ColumnDefinition Width="0.74*"/>
                        <ColumnDefinition Width="32"/>
                      </Grid.ColumnDefinitions>

                      <Grid Grid.Column="0" Width="42" Height="42" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource RiskScoreCircle}"
                                 Width="42"
                                 Height="42"
                                 Stroke="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                 StrokeThickness="3"/>
                        <TextBlock Text="{Binding ScoreNumber}"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                      </Grid>

                      <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayTitle}"
                                   Style="{StaticResource AnomalyQueueCellText}"
                                   FontWeight="SemiBold"
                                   ToolTip="{Binding DisplayTitle}"/>
                        <TextBlock Text="{Binding DestinationLabel}"
                                   Style="{StaticResource AnomalyQueueCellSubtleText}"
                                   Margin="0,3,0,0"
                                   ToolTip="{Binding DestinationLabel}"/>
                      </StackPanel>

                      <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SourceLabel}"
                                   Style="{StaticResource AnomalyQueueCellText}"
                                   ToolTip="{Binding SourceLabel}"/>
                        <TextBlock Text="{Binding OccurrenceLabel}"
                                   Style="{StaticResource AnomalyQueueCellSubtleText}"
                                   Margin="0,3,0,0"
                                   ToolTip="{Binding OccurrenceLabel}"/>
                      </StackPanel>

                      <TextBlock Grid.Column="3"
                                 Text="{Binding CategoryLabel}"
                                 Style="{StaticResource AnomalyQueueCellText}"
                                 Margin="0,0,10,0"
                                 ToolTip="{Binding CategoryLabel}"/>

                      <StackPanel Grid.Column="4" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PrimaryReason}"
                                   Style="{StaticResource AnomalyQueueCellText}"
                                   ToolTip="{Binding PrimaryReason}"/>
                        <TextBlock Text="{Binding DeviationSummary}"
                                   Style="{StaticResource AnomalyQueueCellSubtleText}"
                                   Margin="0,3,0,0"
                                   ToolTip="{Binding DeviationSummary}"/>
                      </StackPanel>

                      <Border Grid.Column="5"
                              Style="{StaticResource SmallPill}"
                              Background="#0B1626"
                              BorderBrush="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0">
                        <TextBlock Text="{Binding SeverityUpper}"
                                   Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                   FontSize="10.5"
                                   FontWeight="Bold"/>
                      </Border>

                      <StackPanel Grid.Column="6" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FirstSeenLabel}"
                                   Style="{StaticResource AnomalyQueueCellText}"
                                   ToolTip="{Binding FirstSeenLabel}"/>
                        <TextBlock Text="{Binding LastSeenLabel}"
                                   Style="{StaticResource AnomalyQueueCellSubtleText}"
                                   Margin="0,3,0,0"
                                   ToolTip="{Binding LastSeenLabel}"/>
                      </StackPanel>

                      <Border Grid.Column="7"
                              Style="{StaticResource SmallPill}"
                              Background="#10233B"
                              BorderBrush="#1D4ED8"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding QueueStatusLabel}"
                                   Foreground="{StaticResource AccentAltBrush}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   ToolTip="{Binding QueueStatusLabel}"/>
                      </Border>

                      <Button Grid.Column="8"
                              Content="⋯"
                              Width="28"
                              Height="28"
                              Padding="0"
                              Style="{StaticResource SecondaryButton}"
                              Click="QueueRowMenu_Click"
                              Tag="{Binding}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Border x:Name="AnomaliesEmptyState"
                      Style="{StaticResource EmptyStateCard}"
                      Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                  <TextBlock Text="No anomaly signals yet"
                             FontSize="18"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="Start monitoring or run demo mode to populate behavior signals."
                             Margin="0,8,0,0"
                             Foreground="{StaticResource TextSubtleBrush}"
                             TextAlignment="Center"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </Grid>

            <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
              <TextBlock Text="{Binding QueueCountText}"
                         Foreground="{StaticResource TextSubtleBrush}"
                         VerticalAlignment="Center"/>

              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding QueuePageText}"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>

                <Button Content="&lt;"
                        Width="30"
                        Height="28"
                        Style="{StaticResource SecondaryButton}"
                        Click="PreviousPage_Click"
                        IsEnabled="{Binding CanPageBack}"/>

                <ItemsControl ItemsSource="{Binding PageChips}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding Label}"
                              Tag="{Binding PageNumber}"
                              Style="{StaticResource AnomalyPageChipButton}"
                              Click="PageChip_Click"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="&gt;"
                        Width="30"
                        Height="28"
                        Style="{StaticResource SecondaryButton}"
                        Click="NextPage_Click"
                        IsEnabled="{Binding CanPageForward}"
                        Margin="6,0,0,0"/>
              </StackPanel>
            </DockPanel>
          </Grid>
        </Border>

        <Border Grid.Column="1"
                Style="{StaticResource AnomalyPageSurface}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
              <TextBlock Text="Selected Anomaly Investigation" Style="{StaticResource AnomalySectionTitle}"/>
              <TextBlock Text="{Binding SelectedWindowLabel}" Style="{StaticResource AnomalySectionMeta}"/>
            </StackPanel>

            <Grid Grid.Row="1">
              <StackPanel x:Name="InvestigationBody" Visibility="Collapsed">
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="118"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <Border Width="4"
                            Height="56"
                            Background="{Binding Selected.Severity, Converter={StaticResource SeverityBrush}}"
                            CornerRadius="2"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Selected.DisplayTitle}"
                               FontSize="19"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               ToolTip="{Binding Selected.DisplayTitle}"/>
                    <TextBlock Text="{Binding Selected.Description}"
                               Foreground="{StaticResource TextSubtleBrush}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                  </StackPanel>

                  <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="RISK SCORE"
                               Style="{StaticResource MicroLabel}"
                               HorizontalAlignment="Center"/>
                    <Grid Width="88" Height="88" Margin="0,8,0,0">
                      <Ellipse Style="{StaticResource RiskScoreCircle}"
                               Stroke="{Binding Selected.Severity, Converter={StaticResource SeverityBrush}}"/>
                      <TextBlock Text="{Binding Selected.ScoreNumber}"
                                 FontSize="18"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Grid>
                    <Border Style="{StaticResource SmallPill}"
                            Background="#421D22"
                            BorderBrush="{Binding Selected.Severity, Converter={StaticResource SeverityBrush}}"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0">
                      <TextBlock Text="{Binding Selected.Severity}"
                                 Foreground="{Binding Selected.Severity, Converter={StaticResource SeverityBrush}}"
                                 FontWeight="Bold"/>
                    </Border>
                  </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailGridCard}" Margin="0,0,8,8">
                    <StackPanel>
                      <TextBlock Text="Source host" Style="{StaticResource AnomalyFieldLabel}"/>
                      <TextBlock Text="{Binding Selected.SourceLabel}" Style="{StaticResource AnomalyFieldValue}" ToolTip="{Binding Selected.SourceLabel}"/>
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailGridCard}" Margin="4,0,4,8">
                    <StackPanel>
                      <TextBlock Text="Destination" Style="{StaticResource AnomalyFieldLabel}"/>
                      <TextBlock Text="{Binding Selected.DestinationLabel}" Style="{StaticResource AnomalyFieldValue}" ToolTip="{Binding Selected.DestinationLabel}"/>
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource DetailGridCard}" Margin="8,0,0,8">
                    <StackPanel>
                      <TextBlock Text="Protocol / port" Style="{StaticResource AnomalyFieldLabel}"/>
                      <TextBlock Text="{Binding Selected.ProtocolPortLabel}" Style="{StaticResource AnomalyFieldValue}" ToolTip="{Binding Selected.ProtocolPortLabel}"/>
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailGridCard}" Margin="0,0,8,0">
                    <StackPanel>
                      <TextBlock Text="Detected" Style="{StaticResource AnomalyFieldLabel}"/>
                      <TextBlock Text="{Binding Selected.CreatedLabelLong}" Style="{StaticResource AnomalyFieldValue}" ToolTip="{Binding Selected.CreatedLabelLong}"/>
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailGridCard}" Margin="4,0,4,0">
                    <StackPanel>
                      <TextBlock Text="Category" Style="{StaticResource AnomalyFieldLabel}"/>
                      <TextBlock Text="{Binding Selected.CategoryLabel}" Style="{StaticResource AnomalyFieldValue}" ToolTip="{Binding Selected.CategoryLabel}"/>
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource DetailGridCard}" Margin="8,0,0,0">
                    <StackPanel>
                      <TextBlock Text="Linked incident" Style="{StaticResource AnomalyFieldLabel}"/>
                      <TextBlock Text="{Binding Selected.RelatedIncidentTitle}" Style="{StaticResource AnomalyFieldValue}" ToolTip="{Binding Selected.RelatedIncidentTitle}"/>
                      <WrapPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource SmallPill}" Background="#10233B" BorderBrush="#1D4ED8" Margin="0,0,6,0">
                          <TextBlock Text="{Binding Selected.RelatedIncidentStatus}" Foreground="{StaticResource AccentAltBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                        </Border>
                        <Border Style="{StaticResource SmallPill}" Background="#421D22" BorderBrush="{Binding Selected.RelatedIncidentSeverity, Converter={StaticResource SeverityBrush}}">
                          <TextBlock Text="{Binding Selected.RelatedIncidentSeverity}" Foreground="{Binding Selected.RelatedIncidentSeverity, Converter={StaticResource SeverityBrush}}" FontSize="10.5" FontWeight="SemiBold"/>
                        </Border>
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.36*"/>
                    <ColumnDefinition Width="0.34*"/>
                    <ColumnDefinition Width="0.30*"/>
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0" Style="{StaticResource BaselineComparisonCard}" Margin="0,0,8,0">
                    <StackPanel>
                      <TextBlock Text="Baseline Comparison" Style="{StaticResource AnomalySectionTitle}" FontSize="13.5"/>
                      <TextBlock Text="{Binding BaselineStatusText}" Style="{StaticResource AnomalySectionMeta}" Margin="0,0,0,10"/>
                      <TextBlock Text="Normal behavior / baseline" Style="{StaticResource AnomalyFieldLabel}"/>
                      <TextBlock Text="{Binding BaselineNormalLabel}" Style="{StaticResource AnomalyFieldValue}" ToolTip="{Binding BaselineNormalLabel}" Margin="0,0,0,8"/>
                      <TextBlock Text="Current behavior" Style="{StaticResource AnomalyFieldLabel}"/>
                      <TextBlock Text="{Binding BaselineCurrentLabel}" Style="{StaticResource AnomalyFieldValue}" ToolTip="{Binding BaselineCurrentLabel}" Margin="0,0,0,8"/>
                      <TextBlock Text="Deviation" Style="{StaticResource AnomalyFieldLabel}"/>
                      <TextBlock Text="{Binding BaselineDeviationLabel}" Style="{StaticResource AnomalyFieldValue}" Foreground="{StaticResource WarnBrush}" Margin="0,0,0,8"/>
                      <TextBlock Text="Peer group position" Style="{StaticResource AnomalyFieldLabel}"/>
                      <TextBlock Text="{Binding PeerGroupLabel}" Style="{StaticResource AnomalyFieldValue}" ToolTip="{Binding PeerGroupLabel}"/>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Style="{StaticResource DetailGridCard}" Margin="4,0,4,0">
                    <StackPanel>
                      <TextBlock Text="Model Explanation" Style="{StaticResource AnomalySectionTitle}" FontSize="13.5"/>
                      <TextBlock Text="{Binding ModelSummary}" Style="{StaticResource AnomalySectionMeta}" Margin="0,0,0,10"/>
                      <ItemsControl x:Name="ExplanationItems" ItemsSource="{Binding ModelExplanationPoints}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <DockPanel Margin="0,0,0,8">
                              <Ellipse Width="5" Height="5" Fill="{StaticResource AccentAltBrush}" Margin="0,6,8,0" DockPanel.Dock="Left"/>
                              <TextBlock Text="{Binding}" Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap" ToolTip="{Binding}"/>
                            </DockPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="No explainable evidence beyond the base anomaly metadata was recorded for this signal."
                                 Foreground="{StaticResource TextMutedBrush}"
                                 TextWrapping="Wrap">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ElementName=ExplanationItems, Path=HasItems}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="2" Style="{StaticResource DetailGridCard}" Margin="8,0,0,0">
                    <StackPanel>
                      <TextBlock Text="Top ML Signals" Style="{StaticResource AnomalySectionTitle}" FontSize="13.5"/>
                      <TextBlock Text="Only the strongest recorded feature contributors are shown here." Style="{StaticResource AnomalySectionMeta}" Margin="0,0,0,10"/>
                      <ItemsControl x:Name="TopSignalsItems" ItemsSource="{Binding TopMlSignals}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,0,0,8">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource AnomalyQueueCellSubtleText}" ToolTip="{Binding Name}"/>
                                <Border Style="{StaticResource ModelSignalBar}" Margin="0,6,0,0">
                                  <Border Width="{Binding BarWidth}" Height="6" Background="{Binding BarBrush}" CornerRadius="4" HorizontalAlignment="Left"/>
                                </Border>
                              </StackPanel>
                              <TextBlock Grid.Column="1" Text="{Binding ValueLabel}" Style="{StaticResource AnomalyQueueCellText}" VerticalAlignment="Center"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="No ML feature contribution data was recorded for this anomaly."
                                 Foreground="{StaticResource TextMutedBrush}"
                                 TextWrapping="Wrap">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ElementName=TopSignalsItems, Path=HasItems}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.56*"/>
                    <ColumnDefinition Width="0.44*"/>
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0" Style="{StaticResource DetailGridCard}" Margin="0,0,8,0">
                    <StackPanel>
                      <TextBlock Text="Tags" Style="{StaticResource AnomalyFieldLabel}"/>
                      <ItemsControl ItemsSource="{Binding Selected.Tags}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource SmallPill}" Margin="0,0,8,8">
                              <TextBlock Text="{Binding}" Foreground="{StaticResource TextSubtleBrush}" FontSize="11" ToolTip="{Binding}"/>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Style="{StaticResource DetailGridCard}" Margin="8,0,0,0">
                    <StackPanel>
                      <TextBlock Text="Related rule IDs" Style="{StaticResource AnomalyFieldLabel}"/>
                      <ItemsControl x:Name="RelatedRulesItems" ItemsSource="{Binding Selected.RelatedRuleIds}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource SmallPill}" Margin="0,0,8,8">
                              <TextBlock Text="{Binding}" Foreground="{StaticResource TextBrush}" FontSize="11" ToolTip="{Binding}"/>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="No related rules were recorded for this anomaly."
                                 Foreground="{StaticResource TextMutedBrush}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ElementName=RelatedRulesItems, Path=HasItems}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Style="{StaticResource DetailGridCard}">
                  <StackPanel>
                    <TextBlock Text="Recommended actions" Style="{StaticResource AnomalyFieldLabel}"/>
                    <WrapPanel>
                      <Button Content="Mark Expected"
                              Style="{StaticResource SecondaryButton}"
                              Click="MarkExpected_Click"
                              IsEnabled="{Binding CanMarkExpected}"
                              Margin="0,0,8,0"/>
                      <Button Content="{Binding IncidentActionLabel}"
                              Style="{StaticResource SecondaryButton}"
                              Click="ViewIncident_Click"
                              IsEnabled="{Binding CanOpenIncident}"
                              Margin="0,0,8,0"/>
                      <Button Content="Open Raw Traffic"
                              Style="{StaticResource SecondaryButton}"
                              Click="OpenRawTraffic_Click"
                              IsEnabled="{Binding CanOpenRawTraffic}"
                              Margin="0,0,8,0"/>
                      <Button Content="⋯"
                              Width="42"
                              Style="{StaticResource SecondaryButton}"
                              Click="MoreActions_Click"
                              IsEnabled="{Binding CanOpenIncident}"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <Border x:Name="DetailsEmptyState" Style="{StaticResource EmptyStateCard}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                  <TextBlock Text="Select an anomaly to inspect"
                             FontSize="18"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="Select an anomaly to inspect baseline comparison, model signals, and recommended actions."
                             Margin="0,8,0,0"
                             Foreground="{StaticResource TextSubtleBrush}"
                             TextAlignment="Center"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.35*"/>
          <ColumnDefinition Width="0.37*"/>
          <ColumnDefinition Width="0.28*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource AnomalyPageSurface}" Margin="0,0,12,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
              <TextBlock Text="Entity Behavior History" Style="{StaticResource AnomalySectionTitle}"/>
              <TextBlock Text="{Binding SelectedWindowLabel}" Style="{StaticResource AnomalySectionMeta}"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.72*"/>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="0.86*"/>
                <ColumnDefinition Width="0.92*"/>
                <ColumnDefinition Width="0.90*"/>
                <ColumnDefinition Width="0.95*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Time" Style="{StaticResource AnomalyQueueHeader}"/>
              <TextBlock Grid.Column="1" Text="Metric" Style="{StaticResource AnomalyQueueHeader}"/>
              <TextBlock Grid.Column="2" Text="Observed" Style="{StaticResource AnomalyQueueHeader}"/>
              <TextBlock Grid.Column="3" Text="Baseline Avg" Style="{StaticResource AnomalyQueueHeader}"/>
              <TextBlock Grid.Column="4" Text="Deviation" Style="{StaticResource AnomalyQueueHeader}"/>
              <TextBlock Grid.Column="5" Text="Trend" Style="{StaticResource AnomalyQueueHeader}"/>
            </Grid>

            <ItemsControl x:Name="EntityHistoryItems" Grid.Row="2" ItemsSource="{Binding EntityHistoryRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource AnomalyQueueRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.72*"/>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="0.86*"/>
                        <ColumnDefinition Width="0.92*"/>
                        <ColumnDefinition Width="0.90*"/>
                        <ColumnDefinition Width="0.95*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding TimeLabel}" Style="{StaticResource AnomalyQueueCellSubtleText}" ToolTip="{Binding TimeLabel}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Metric}" Style="{StaticResource AnomalyQueueCellText}" ToolTip="{Binding Metric}"/>
                      <TextBlock Grid.Column="2" Text="{Binding Observed}" Style="{StaticResource AnomalyQueueCellText}" ToolTip="{Binding Observed}"/>
                      <TextBlock Grid.Column="3" Text="{Binding Baseline}" Style="{StaticResource AnomalyQueueCellSubtleText}" ToolTip="{Binding Baseline}"/>
                      <TextBlock Grid.Column="4" Text="{Binding Deviation}" Style="{StaticResource AnomalyQueueCellText}" Foreground="{Binding DeviationBrush}" ToolTip="{Binding Deviation}"/>
                      <TextBlock Grid.Column="5" Text="{Binding Trend}" Style="{StaticResource AnomalyQueueCellSubtleText}" ToolTip="{Binding Trend}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource AnomalyPageSurface}" Margin="0,0,12,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
              <TextBlock Text="Baseline Drift &amp; Peer Group" Style="{StaticResource AnomalySectionTitle}"/>
              <TextBlock Text="{Binding PeerGroupHeader}" Style="{StaticResource AnomalySectionMeta}"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.20*"/>
                <ColumnDefinition Width="0.86*"/>
                <ColumnDefinition Width="0.82*"/>
                <ColumnDefinition Width="0.90*"/>
                <ColumnDefinition Width="0.92*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Metric" Style="{StaticResource AnomalyQueueHeader}"/>
              <TextBlock Grid.Column="1" Text="Baseline" Style="{StaticResource AnomalyQueueHeader}"/>
              <TextBlock Grid.Column="2" Text="Current" Style="{StaticResource AnomalyQueueHeader}"/>
              <TextBlock Grid.Column="3" Text="Deviation" Style="{StaticResource AnomalyQueueHeader}"/>
              <TextBlock Grid.Column="4" Text="Trend" Style="{StaticResource AnomalyQueueHeader}"/>
            </Grid>

            <ItemsControl x:Name="DriftItems" Grid.Row="2" ItemsSource="{Binding BaselineDriftRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource AnomalyQueueRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.20*"/>
                        <ColumnDefinition Width="0.86*"/>
                        <ColumnDefinition Width="0.82*"/>
                        <ColumnDefinition Width="0.90*"/>
                        <ColumnDefinition Width="0.92*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Metric}" Style="{StaticResource AnomalyQueueCellText}" ToolTip="{Binding Metric}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Baseline}" Style="{StaticResource AnomalyQueueCellSubtleText}" ToolTip="{Binding Baseline}"/>
                      <TextBlock Grid.Column="2" Text="{Binding Observed}" Style="{StaticResource AnomalyQueueCellText}" ToolTip="{Binding Observed}"/>
                      <TextBlock Grid.Column="3" Text="{Binding Deviation}" Style="{StaticResource AnomalyQueueCellText}" Foreground="{Binding DeviationBrush}" ToolTip="{Binding Deviation}"/>
                      <TextBlock Grid.Column="4" Text="{Binding Trend}" Style="{StaticResource AnomalyQueueCellSubtleText}" ToolTip="{Binding Trend}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource AnomalyPageSurface}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
              <TextBlock Text="Analyst Actions &amp; Shortcuts" Style="{StaticResource AnomalySectionTitle}"/>
              <TextBlock Text="Use the shell for deeper evidence and the closest live workspace for each action." Style="{StaticResource AnomalySectionMeta}"/>
            </StackPanel>

            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource AnalystActionTile}" Click="PivotToHost_Click" IsEnabled="{Binding CanPivotToHost}">
                <StackPanel>
                  <TextBlock Text="Pivot to Host" FontWeight="SemiBold"/>
                  <TextBlock Text="Open the host-focused workspace for this entity." Style="{StaticResource AnomalySectionMeta}" Margin="0,4,0,0"/>
                </StackPanel>
              </Button>

              <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource AnalystActionTile}" Click="OpenRawDetections_Click" IsEnabled="{Binding CanOpenRawDetections}" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="Query detections" FontWeight="SemiBold"/>
                  <TextBlock Text="Inspect rule hits and related detection evidence." Style="{StaticResource AnomalySectionMeta}" Margin="0,4,0,0"/>
                </StackPanel>
              </Button>

              <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource AnalystActionTile}" Click="OpenRawTraffic_Click" IsEnabled="{Binding CanOpenRawTraffic}">
                <StackPanel>
                  <TextBlock Text="Search in Raw Traffic" FontWeight="SemiBold"/>
                  <TextBlock Text="Move into packets and flows for the selected signal." Style="{StaticResource AnomalySectionMeta}" Margin="0,4,0,0"/>
                </StackPanel>
              </Button>

              <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource AnalystActionTile}" Click="CreateDetectionRule_Click" IsEnabled="{Binding CanOpenDetectionRules}" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="Create Detection Rule" FontWeight="SemiBold"/>
                  <TextBlock Text="Open governance and detection settings for rule tuning." Style="{StaticResource AnomalySectionMeta}" Margin="0,4,0,0"/>
                </StackPanel>
              </Button>

              <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource AnalystActionTile}" Click="AddToWatchlist_Click" IsEnabled="{Binding CanAddToWatchlist}">
                <StackPanel>
                  <TextBlock Text="Add to Watchlist" FontWeight="SemiBold"/>
                  <TextBlock Text="Use the closest available suppression or watch workflow honestly." Style="{StaticResource AnomalySectionMeta}" Margin="0,4,0,0"/>
                </StackPanel>
              </Button>

              <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource AnalystActionTile}" Click="CopyJson_Click" IsEnabled="{Binding CanCopyEvidence}" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="Export Evidence Pack" FontWeight="SemiBold"/>
                  <TextBlock Text="Copy structured anomaly evidence for reporting or handoff." Style="{StaticResource AnomalySectionMeta}" Margin="0,4,0,0"/>
                </StackPanel>
              </Button>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</Page>
