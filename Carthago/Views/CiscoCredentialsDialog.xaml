<!-- GA UI-107: Cisco credential entry, presentation-only. -->
<Window x:Class="Carthago.Views.CiscoCredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device credentials" Width="540" Height="540"
        MinWidth="430" MinHeight="490"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False" Background="{StaticResource AppBgBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Padding="26,24" BorderBrush="#29516A" BorderThickness="0,0,0,1">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#12364C" Offset="0"/>
          <GradientStop Color="#0A1A2B" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <StackPanel>
        <TextBlock Text="CISCO OPERATIONS / DEVICE ACCESS" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
        <TextBlock Text="Device credentials" Foreground="{StaticResource TextBrush}" FontSize="27" FontWeight="Bold" Margin="0,7,0,4"/>
        <TextBlock Text="Enter credentials for the selected device. Password fields remain masked."
                   Foreground="{StaticResource TextSubtleBrush}" FontSize="12.5" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Border Margin="20,20,20,12" Padding="22,20" Background="{StaticResource CardBgBrush}"
              BorderBrush="#2C536B" BorderThickness="1" CornerRadius="14">
        <StackPanel>
          <TextBlock Text="ACCESS DETAILS" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11"/>
          <TextBlock Text="Device authentication" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,18"/>
          <TextBlock Text="Username" Foreground="{StaticResource TextSubtleBrush}" Margin="0,0,0,6"/>
          <TextBox x:Name="UsernameBox" Height="38" Margin="0,0,0,17" VerticalContentAlignment="Center"/>
          <TextBlock Text="Password" Foreground="{StaticResource TextSubtleBrush}" Margin="0,0,0,6"/>
          <PasswordBox x:Name="PasswordBox" Height="38" Margin="0,0,0,17"/>
          <TextBlock Text="Enable password" Foreground="{StaticResource TextSubtleBrush}" Margin="0,0,0,6"/>
          <PasswordBox x:Name="EnablePasswordBox" Height="38"/>
        </StackPanel>
      </Border>
    </ScrollViewer>
    <Border Grid.Row="2" Padding="20,14" Background="#0A1929" BorderBrush="#294257" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Width="100" Height="40" Margin="0,0,10,0"
                Style="{StaticResource SecondaryButton}" IsCancel="True" Click="Cancel_Click"/>
        <Button Content="Apply credentials" Width="150" Height="40"
                Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
