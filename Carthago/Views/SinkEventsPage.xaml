<!-- File: Views/SinkEventsPage.xaml -->
<Page x:Class="Carthago.Views.SinkEventsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Sink Events">
    <ScrollViewer Padding="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Vertical" MaxWidth="1280">
            <Border Style="{StaticResource PageSurface}" Margin="0,0,0,16"><StackPanel><TextBlock Text="External Delivery"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,12"/>
            <TextBlock Text="Delivery telemetry for external sinks. Use this advanced view for transport troubleshooting and export verification while the default dashboard stays anomaly-first."
                       Foreground="{StaticResource TextSubtleBrush}"
                       Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel></Border>

            <WrapPanel HorizontalAlignment="Right"
                    Margin="0,0,0,8">
                <ToggleButton x:Name="PauseToggle"
                              Width="100"
                              Content="Pause"/>
                <Button Content="Clear"
                        Width="100"
                        Margin="8,0,0,0"
                        Click="Clear_Click"/>
            </WrapPanel>

            <GroupBox Header="Emitted Detection Events"
                    Margin="0,0,0,12">
                <Border Padding="0"
                        Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <DataGrid x:Name="EmittedGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding Emitted}"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time (UTC)"
                                    Binding="{Binding TimestampUtc, StringFormat={}{0:u}}"
                                    Width="160"/>
                            <DataGridTextColumn Header="Sink"
                                    Binding="{Binding Sink}"
                                    Width="140"/>
                            <DataGridTextColumn Header="Severity"
                                    Binding="{Binding Severity}"
                                    Width="90"/>
                            <DataGridTextColumn Header="Rule"
                                    Binding="{Binding RuleId}"
                                    Width="160"/>
                            <DataGridTextColumn Header="Source"
                                    Binding="{Binding SourceIp}"
                                    Width="170"/>
                            <DataGridTextColumn Header="Destination"
                                    Binding="{Binding DestinationIp}"
                                    Width="170"/>
                            <DataGridTextColumn Header="Dst Port"
                                    Binding="{Binding DestinationPort}"
                                    Width="80"/>
                            <DataGridTextColumn Header="Protocol"
                                    Binding="{Binding Protocol}"
                                    Width="90"/>
                            <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </GroupBox>

            <GroupBox Header="Delivery Failures (recent)">
                <Border Padding="0"
                        Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <DataGrid x:Name="FailuresGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding Failures}"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time (UTC)"
                                    Binding="{Binding TimestampUtc, StringFormat={}{0:u}}"
                                    Width="160"/>
                            <DataGridTextColumn Header="Sink"
                                    Binding="{Binding Sink}"
                                    Width="140"/>
                            <DataGridTextColumn Header="Severity"
                                    Binding="{Binding Severity}"
                                    Width="90"/>
                            <DataGridTextColumn Header="Rule"
                                    Binding="{Binding RuleId}"
                                    Width="160"/>
                            <DataGridTextColumn Header="Source"
                                    Binding="{Binding SourceIp}"
                                    Width="170"/>
                            <DataGridTextColumn Header="Destination"
                                    Binding="{Binding DestinationIp}"
                                    Width="170"/>
                            <DataGridTextColumn Header="Dst Port"
                                    Binding="{Binding DestinationPort}"
                                    Width="80"/>
                            <DataGridTextColumn Header="Protocol"
                                    Binding="{Binding Protocol}"
                                    Width="90"/>
                            <DataGridTextColumn Header="Error"
                                    Binding="{Binding Error}"
                                    Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</Page>
