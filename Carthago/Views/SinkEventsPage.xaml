<!-- File: Views/SinkEventsPage.xaml -->
<Page x:Class="Carthago.Views.SinkEventsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Sink Events">
  <Page.Resources>
    <Style x:Key="DeliverySurface" TargetType="Border" BasedOn="{StaticResource PageSurface}">
      <Setter Property="Background" Value="#0B1B2C"/>
      <Setter Property="BorderBrush" Value="#25435A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
    <Style x:Key="DeliveryMetric" TargetType="Border" BasedOn="{StaticResource DeliverySurface}">
      <Setter Property="MinHeight" Value="124"/>
      <Setter Property="Padding" Value="20,18"/>
    </Style>
    <Style x:Key="DeliveryEyebrow" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#67D5E7"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="DeliverySectionHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="18,18,18,26">
      <!-- Operational header and existing local-display controls. -->
      <Grid x:Name="DeliveryHeaderGrid" Margin="0,0,0,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition x:Name="DeliveryHeaderActionRow" Height="0"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="DeliveryHeaderMainColumn" Width="2.15*"/>
          <ColumnDefinition x:Name="DeliveryHeaderActionColumn" Width="1*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="DeliveryHeroPanel" Grid.Row="0" Grid.Column="0"
                CornerRadius="16" BorderThickness="1" BorderBrush="#27526C" Padding="24,22">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#12324C" Offset="0"/>
              <GradientStop Color="#0A1C2F" Offset="0.62"/>
              <GradientStop Color="#133E44" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <StackPanel>
            <TextBlock Text="OPERATIONS / EXTERNAL DELIVERY" Style="{StaticResource DeliveryEyebrow}"
                       Margin="0,0,0,10"/>
            <TextBlock Text="External Delivery Monitor" FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="Inspect locally observed sink emissions and delivery failures. This is not a network capture or a guarantee of destination receipt."
                       Foreground="{StaticResource TextSubtleBrush}" FontSize="13"
                       TextWrapping="Wrap" Margin="0,10,0,0"/>
            <Border Background="#102A3A" BorderBrush="#2B5365" BorderThickness="1"
                    CornerRadius="7" Padding="11,8" HorizontalAlignment="Left" Margin="0,16,0,0">
              <TextBlock Text="LOCAL VIEW  ·  DELIVERY NOTIFICATIONS ONLY"
                         Style="{StaticResource DeliveryEyebrow}"/>
            </Border>
          </StackPanel>
        </Border>

        <Border x:Name="DeliveryActionsPanel" Grid.Row="0" Grid.Column="1"
                Style="{StaticResource DeliverySurface}" Margin="16,0,0,0">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="DISPLAY CONTROLS" Style="{StaticResource DeliveryEyebrow}" Margin="0,0,0,10"/>
            <TextBlock Text="Review or clear local rows" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,16,0,0">
              <ToggleButton x:Name="PauseToggle" Width="128" Height="38"
                            Content="Pause display" Margin="0,0,10,10"
                            ToolTip="Pause additions to this page; does not stop external sink delivery"/>
              <Button Content="Clear rows" Width="112" Height="38"
                      Style="{StaticResource SecondaryButton}" Margin="0,0,0,10"
                      Click="Clear_Click" ToolTip="Clear displayed emitted and failure rows only"/>
            </WrapPanel>
            <TextBlock Text="Pause and Clear affect this local display, not sink transport."
                       Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Counts bind to the existing in-memory ObservableCollections; no synthetic telemetry. -->
      <Grid x:Name="DeliveryMetricGrid" Margin="0,0,0,18">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="DeliveryMetricFirstRow" Height="Auto"/>
          <RowDefinition x:Name="DeliveryMetricSecondRow" Height="0"/>
          <RowDefinition x:Name="DeliveryMetricThirdRow" Height="0"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="DeliveryMetricFirstColumn" Width="1*"/>
          <ColumnDefinition x:Name="DeliveryMetricSecondColumn" Width="1*"/>
          <ColumnDefinition x:Name="DeliveryMetricThirdColumn" Width="1*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="DeliveryEmittedMetric" Grid.Column="0" Style="{StaticResource DeliveryMetric}" Margin="0,0,12,0">
          <StackPanel>
            <Border Height="3" Background="#28CBE6" CornerRadius="2" Margin="0,0,0,13"/>
            <TextBlock Text="EMITTED NOTIFICATIONS" Style="{StaticResource DeliveryEyebrow}"/>
            <TextBlock Text="{Binding Emitted.Count}" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" Margin="0,7,0,2"/>
            <TextBlock Text="Rows retained in this view (max 5,000)"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border x:Name="DeliveryFailuresMetric" Grid.Column="1" Style="{StaticResource DeliveryMetric}" Margin="0,0,12,0">
          <StackPanel>
            <Border Height="3" Background="#EFA65B" CornerRadius="2" Margin="0,0,0,13"/>
            <TextBlock Text="DELIVERY FAILURE NOTIFICATIONS" Style="{StaticResource DeliveryEyebrow}"/>
            <TextBlock Text="{Binding Failures.Count}" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" Margin="0,7,0,2"/>
            <TextBlock Text="Rows retained in this view (max 2,000)"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border x:Name="DeliveryDisplayMetric" Grid.Column="2" Style="{StaticResource DeliveryMetric}">
          <StackPanel>
            <Border Height="3" Background="#508B9D" CornerRadius="2" Margin="0,0,0,13"/>
            <TextBlock Text="LOCAL DISPLAY" Style="{StaticResource DeliveryEyebrow}"/>
            <TextBlock FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                       Margin="0,13,0,7" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="Rows updating"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Paused}" Value="True">
                      <Setter Property="Text" Value="Rows paused"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="View state only; no delivery-status claim"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Evidence tables retain every existing column, binding and read-only operation. -->
      <Border Style="{StaticResource DeliverySurface}" Margin="0,0,0,16">
        <StackPanel>
          <Border Height="3" Background="#28CBE6" CornerRadius="2" Margin="0,0,0,16"/>
          <DockPanel LastChildFill="True" Margin="0,0,0,15">
            <Border DockPanel.Dock="Right" Background="#0F3041" BorderBrush="#2A5967"
                    BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="12,0,0,0"
                    VerticalAlignment="Top">
              <TextBlock Text="EMITTED" Foreground="#6DDCEC" FontWeight="SemiBold" FontSize="11"/>
            </Border>
            <StackPanel>
              <TextBlock Text="Emitted Detection Events" Style="{StaticResource DeliverySectionHeading}"/>
              <TextBlock Text="Read-only local emission notifications, newest first. Horizontal scrolling preserves all evidence fields."
                         Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                         TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
          </DockPanel>
          <Border Background="#091827" BorderBrush="#254359" BorderThickness="1"
                  CornerRadius="10" Padding="1">
            <DataGrid x:Name="EmittedGrid"
                              AutoGenerateColumns="False"
                              Height="380"
                              RowHeight="38"
                              ColumnHeaderHeight="42"
                              RowBackground="#0B1A2A"
                              AlternatingRowBackground="#102337"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#243C4F"
                              BorderThickness="0"
                              Margin="0"
                              IsReadOnly="True"
                              ItemsSource="{Binding Emitted}"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time (UTC)"
                                    Binding="{Binding TimestampUtc, StringFormat={}{0:u}}"
                                    Width="160"/>
                            <DataGridTextColumn Header="Sink"
                                    Binding="{Binding Sink}"
                                    Width="140"/>
                            <DataGridTextColumn Header="Severity"
                                    Binding="{Binding Severity}"
                                    Width="90"/>
                            <DataGridTextColumn Header="Rule"
                                    Binding="{Binding RuleId}"
                                    Width="160"/>
                            <DataGridTextColumn Header="Source"
                                    Binding="{Binding SourceIp}"
                                    Width="170"/>
                            <DataGridTextColumn Header="Destination"
                                    Binding="{Binding DestinationIp}"
                                    Width="170"/>
                            <DataGridTextColumn Header="Dst Port"
                                    Binding="{Binding DestinationPort}"
                                    Width="80"/>
                            <DataGridTextColumn Header="Protocol"
                                    Binding="{Binding Protocol}"
                                    Width="90"/>
                            <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
          </Border>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource DeliverySurface}">
        <StackPanel>
          <Border Height="3" Background="#EFA65B" CornerRadius="2" Margin="0,0,0,16"/>
          <DockPanel LastChildFill="True" Margin="0,0,0,15">
            <Border DockPanel.Dock="Right" Background="#302418" BorderBrush="#74502D"
                    BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="12,0,0,0"
                    VerticalAlignment="Top">
              <TextBlock Text="FAILURES" Foreground="#F6BA79" FontWeight="SemiBold" FontSize="11"/>
            </Border>
            <StackPanel>
              <TextBlock Text="Recent Delivery Failures" Style="{StaticResource DeliverySectionHeading}"/>
              <TextBlock Text="Read-only local failure notifications. An error row describes an observed failure, not overall sink health."
                         Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                         TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
          </DockPanel>
          <Border Background="#091827" BorderBrush="#4D3A35" BorderThickness="1"
                  CornerRadius="10" Padding="1">
            <DataGrid x:Name="FailuresGrid"
                              AutoGenerateColumns="False"
                              Height="310"
                              RowHeight="38"
                              ColumnHeaderHeight="42"
                              RowBackground="#0B1A2A"
                              AlternatingRowBackground="#102337"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#243C4F"
                              BorderThickness="0"
                              Margin="0"
                              IsReadOnly="True"
                              ItemsSource="{Binding Failures}"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time (UTC)"
                                    Binding="{Binding TimestampUtc, StringFormat={}{0:u}}"
                                    Width="160"/>
                            <DataGridTextColumn Header="Sink"
                                    Binding="{Binding Sink}"
                                    Width="140"/>
                            <DataGridTextColumn Header="Severity"
                                    Binding="{Binding Severity}"
                                    Width="90"/>
                            <DataGridTextColumn Header="Rule"
                                    Binding="{Binding RuleId}"
                                    Width="160"/>
                            <DataGridTextColumn Header="Source"
                                    Binding="{Binding SourceIp}"
                                    Width="170"/>
                            <DataGridTextColumn Header="Destination"
                                    Binding="{Binding DestinationIp}"
                                    Width="170"/>
                            <DataGridTextColumn Header="Dst Port"
                                    Binding="{Binding DestinationPort}"
                                    Width="80"/>
                            <DataGridTextColumn Header="Protocol"
                                    Binding="{Binding Protocol}"
                                    Width="90"/>
                            <DataGridTextColumn Header="Error"
                                    Binding="{Binding Error}"
                                    Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
