<!-- File: Views/CiscoAnalyzerFlyout.xaml -->
<Window x:Class="Carthago.Views.CiscoAnalyzerFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cisco Analyzer"
        Height="500"
        Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Summary header -->
        <Border Grid.Row="0"
                Padding="8"
                CornerRadius="6"
                Background="#22252F"
                BorderBrush="#444A60"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Analyzer"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Total events"
                                       FontSize="11"
                                       Foreground="#999"/>
                            <TextBlock Text="{Binding TotalEvents}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Errors"
                                       FontSize="11"
                                       Foreground="#999"/>
                            <TextBlock Text="{Binding ErrorEvents}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#FF9800"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Critical"
                                       FontSize="11"
                                       Foreground="#999"/>
                            <TextBlock Text="{Binding CriticalEvents}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#F44336"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Timeline -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Last 60 minutes (weighted error activity)"
                               FontSize="11"
                               Foreground="#999"
                               Margin="0,0,0,4"/>
                    <Border Background="#1AFFFFFF"
                            CornerRadius="4"
                            Padding="4">
                        <Canvas Width="260"
                                Height="60">
                            <Polyline Points="{Binding TimelinePoints}"
                                      StrokeThickness="1.5"
                                      Stroke="#4CAF50"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tables -->
        <Grid Grid.Row="1"
              Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Top devices -->
            <GroupBox Header="Top devices by errors"
                      Grid.Column="0"
                      Margin="0,0,8,0">
                <DataGrid ItemsSource="{Binding TopErrorDevices}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="True"
                          CanUserReorderColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Device"
                                            Binding="{Binding DeviceLabel}"
                                            Width="2*"/>
                        <DataGridTextColumn Header="Critical"
                                            Binding="{Binding CriticalCount}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Error"
                                            Binding="{Binding ErrorCount}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Warning"
                                            Binding="{Binding WarningCount}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding TotalCount}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Top categories -->
            <GroupBox Header="Top categories"
                      Grid.Column="1"
                      Margin="8,0,0,0">
                <DataGrid ItemsSource="{Binding TopCategories}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="True"
                          CanUserReorderColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Category"
                                            Binding="{Binding Category}"
                                            Width="2*"/>
                        <DataGridTextColumn Header="Critical"
                                            Binding="{Binding CriticalCount}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Error"
                                            Binding="{Binding ErrorCount}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Warning"
                                            Binding="{Binding WarningCount}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding TotalCount}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
