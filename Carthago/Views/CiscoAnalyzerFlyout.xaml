<!-- File: Views/CiscoAnalyzerFlyout.xaml -->
<Window x:Class="Carthago.Views.CiscoAnalyzerFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cisco Analyzer"
        Height="650"
        Width="1000"
        MinWidth="680"
        MinHeight="480"
        Background="#07121F"
        Foreground="#F3F7FB"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="AnalyzerMetricCard" TargetType="Border">
            <Setter Property="Background" Value="#102234"/>
            <Setter Property="BorderBrush" Value="#24465B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="MinHeight" Value="128"/>
        </Style>
        <Style x:Key="AnalyzerMetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8BD7E3"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="AnalyzerMetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F3F7FB"/>
            <Setter Property="FontSize" Value="29"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,8,0,5"/>
        </Style>
        <Style x:Key="AnalyzerMetricNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#91A9BB"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0A1929"/>
            <Setter Property="Foreground" Value="#E6F0F8"/>
            <Setter Property="RowBackground" Value="#0A1929"/>
            <Setter Property="AlternatingRowBackground" Value="#102438"/>
            <Setter Property="BorderBrush" Value="#24465B"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#20374A"/>
            <Setter Property="RowHeight" Value="35"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="AlternationCount" Value="2"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- UI-104: Cisco local syslog analysis, never simulated telemetry. -->
        <StackPanel Grid.Row="0">
            <Border CornerRadius="12" BorderThickness="1" BorderBrush="#2A5567" Padding="22,18" Margin="0,0,0,14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#12354A" Offset="0"/>
                        <GradientStop Color="#0B1B2D" Offset="0.7"/>
                        <GradientStop Color="#12383D" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="CISCO / LOCAL SYSLOG EVIDENCE" Foreground="#5DD8E9" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="Cisco Event Analyzer" FontSize="27" FontWeight="Bold" Foreground="#F3F7FB"/>
                    <TextBlock Text="Observed event distribution, device priority and weighted error activity."
                               FontSize="12.5" Foreground="#B7CAD8" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <UniformGrid x:Name="AnalyzerMetricsGrid" Columns="4" Rows="1">
                <Border x:Name="TotalMetricCard" Style="{StaticResource AnalyzerMetricCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL EVENTS" Style="{StaticResource AnalyzerMetricLabel}"/>
                        <TextBlock Text="{Binding TotalEvents}" Style="{StaticResource AnalyzerMetricValue}"/>
                        <TextBlock Text="Observed syslog records" Style="{StaticResource AnalyzerMetricNote}"/>
                    </StackPanel>
                </Border>
                <Border x:Name="ErrorMetricCard" Style="{StaticResource AnalyzerMetricCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="ERROR EVENTS" Style="{StaticResource AnalyzerMetricLabel}"/>
                        <TextBlock Text="{Binding ErrorEvents}" Style="{StaticResource AnalyzerMetricValue}" Foreground="#F3B35B"/>
                        <TextBlock Text="Severity: Error" Style="{StaticResource AnalyzerMetricNote}"/>
                    </StackPanel>
                </Border>
                <Border x:Name="CriticalMetricCard" Style="{StaticResource AnalyzerMetricCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="CRITICAL EVENTS" Style="{StaticResource AnalyzerMetricLabel}"/>
                        <TextBlock Text="{Binding CriticalEvents}" Style="{StaticResource AnalyzerMetricValue}" Foreground="#FF7076"/>
                        <TextBlock Text="Severity: Critical" Style="{StaticResource AnalyzerMetricNote}"/>
                    </StackPanel>
                </Border>
                <Border x:Name="ActivityMetricCard" Style="{StaticResource AnalyzerMetricCard}">
                    <StackPanel>
                        <TextBlock Text="WEIGHTED ACTIVITY / LAST 60 MIN" Style="{StaticResource AnalyzerMetricLabel}" TextWrapping="Wrap"/>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,9,0,0">
                            <Canvas Width="260" Height="60">
                                <Polyline Points="{Binding TimelinePoints}" StrokeThickness="2" Stroke="#42D8F4" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- Tables -->
        <Grid x:Name="AnalyzerEvidenceGrid" Grid.Row="1" Margin="0,18,0,0">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="EvidenceFirstRow" Height="Auto"/>
                <RowDefinition x:Name="EvidenceSecondRow" Height="0"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EvidenceFirstColumn" Width="*"/>
                <ColumnDefinition x:Name="EvidenceSecondColumn" Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Top devices -->
            <GroupBox x:Name="TopDevicesPanel" Background="#0C1C2D" Foreground="#E8F4FA" BorderBrush="#29516A" BorderThickness="1" FontSize="14" FontWeight="SemiBold" Padding="14" Header="Top devices by errors"
                      Grid.Column="0"
                      Margin="0,0,8,0">
                <DataGrid Height="270" HorizontalScrollBarVisibility="Auto" ItemsSource="{Binding TopErrorDevices}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="True"
                          CanUserReorderColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Device"
                                            Binding="{Binding DeviceLabel}"
                                            Width="2*"/>
                        <DataGridTextColumn Header="Critical"
                                            Binding="{Binding CriticalCount}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Error"
                                            Binding="{Binding ErrorCount}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Warning"
                                            Binding="{Binding WarningCount}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding TotalCount}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Top categories -->
            <GroupBox x:Name="TopCategoriesPanel" Background="#0C1C2D" Foreground="#E8F4FA" BorderBrush="#29516A" BorderThickness="1" FontSize="14" FontWeight="SemiBold" Padding="14" Header="Top categories"
                      Grid.Column="1"
                      Margin="8,0,0,0">
                <DataGrid Height="270" HorizontalScrollBarVisibility="Auto" ItemsSource="{Binding TopCategories}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="True"
                          CanUserReorderColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Category"
                                            Binding="{Binding Category}"
                                            Width="2*"/>
                        <DataGridTextColumn Header="Critical"
                                            Binding="{Binding CriticalCount}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Error"
                                            Binding="{Binding ErrorCount}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Warning"
                                            Binding="{Binding WarningCount}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding TotalCount}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
