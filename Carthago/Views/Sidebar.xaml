<!-- File: Views/Sidebar.xaml -->
<UserControl x:Class="Carthago.Views.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="{StaticResource SidebarBgBrush}"
          BorderBrush="{StaticResource CardBorderBrush}"
          BorderThickness="0,0,1,0">
    <DockPanel>
      <Border DockPanel.Dock="Top" Padding="18,18,16,16" Background="#071321">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="38"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="36" Height="36" CornerRadius="11" BorderBrush="{StaticResource AccentAltBrush}" BorderThickness="1" Background="#0A1B2F">
            <TextBlock Text="◈" Foreground="{StaticResource OkBrush}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Carthago" FontWeight="Bold" FontSize="17"/>
            <TextBlock Text="AI Security Monitor" Foreground="{StaticResource TextSubtleBrush}" FontSize="11" Margin="0,1,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource SoftDividerBrush}" BorderThickness="0,1,0,0" Padding="16,10" Background="#07111F">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Carthago" FontWeight="Bold" FontSize="12"/>
            <TextBlock Text="AI Security Monitor" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="v2.1.0" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10,12,10,16">
          <TextBlock Text="SECURITY VIEW" Style="{StaticResource SidebarSectionLabel}"/>
          <Button x:Name="DashboardNavButton" Style="{StaticResource NavButton}" Click="Nav_Dashboard_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="▣" Foreground="{StaticResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Dashboard" Style="{StaticResource SidebarNavTitle}" Margin="9,0,0,0"/>
              
            </Grid>
          </Button>
          <Button x:Name="IncidentsNavButton" Style="{StaticResource NavButton}" Click="Nav_Incidents_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="▤" Foreground="{StaticResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Incidents" Style="{StaticResource SidebarNavTitle}" Margin="9,0,0,0"/>
              
            </Grid>
          </Button>
          <Button x:Name="AnomaliesNavButton" Style="{StaticResource NavButton}" Click="Nav_Anomalies_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="⌁" Foreground="{StaticResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Anomalies" Style="{StaticResource SidebarNavTitle}" Margin="9,0,0,0"/>
              <Border Grid.Column="2" Background="#203148" CornerRadius="999" Padding="7,2" VerticalAlignment="Center">
                <TextBlock Text="400" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSubtleBrush}"/>
              </Border>
            </Grid>
          </Button>
          <Button x:Name="IncidentQueueNavButton" Style="{StaticResource NavButton}" Click="Nav_IncidentQueue_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="▦" Foreground="{StaticResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Incident Queue" Style="{StaticResource SidebarNavTitle}" Margin="9,0,0,0"/>
              
            </Grid>
          </Button>
          <Button x:Name="ThreatFeedNavButton" Style="{StaticResource NavButton}" Click="Nav_ThreatFeed_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="◎" Foreground="{StaticResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Threat Feed" Style="{StaticResource SidebarNavTitle}" Margin="9,0,0,0"/>
              
            </Grid>
          </Button>

          <Separator Style="{StaticResource QuietSeparator}"/>
          <TextBlock Text="ADVANCED / FORENSICS" Style="{StaticResource SidebarSectionLabel}"/>
          <Button x:Name="RawTrafficNavButton" Style="{StaticResource NavButton}" Click="Nav_LiveTraffic_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="∿" Foreground="{StaticResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Raw Traffic" Style="{StaticResource SidebarNavTitle}" Margin="9,0,0,0"/>
              
            </Grid>
          </Button>
          <Expander x:Name="TrafficFilterExpander"
                    x:FieldModifier="public"
                    Header="Raw traffic filters"
                    Visibility="Collapsed"
                    IsExpanded="True"
                    Margin="6,0,6,6">
            <StackPanel Margin="6">
              <TextBlock Text="Search"
                         Foreground="{StaticResource TextSubtleBrush}"
                         Margin="0,4,0,2"/>
              <TextBox x:Name="TF_SearchText"
                       x:FieldModifier="public"
                       Style="{StaticResource SearchBox}"
                       ToolTip="IP, protocol, service, WHOIS org/country, HTTP host/URI"/>

              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Source IP"
                           Foreground="{StaticResource TextSubtleBrush}"
                           Grid.Row="0"/>
                <TextBox x:Name="TF_Src"
                         x:FieldModifier="public"
                         Grid.Row="1"
                         Style="{StaticResource SearchBox}"
                         Margin="0,2,6,0"/>

                <TextBlock Text="Destination IP"
                           Foreground="{StaticResource TextSubtleBrush}"
                           Grid.Row="0"
                           Grid.Column="1"/>
                <TextBox x:Name="TF_Dst"
                         x:FieldModifier="public"
                         Grid.Row="1"
                         Grid.Column="1"
                         Style="{StaticResource SearchBox}"
                         Margin="6,2,0,0"/>
              </Grid>

              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Protocol"
                             Foreground="{StaticResource TextSubtleBrush}"/>
                  <TextBox x:Name="TF_Proto"
                           x:FieldModifier="public"
                           Style="{StaticResource SearchBox}"
                           Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="6,0,0,0">
                  <TextBlock Text="Port"
                             Foreground="{StaticResource TextSubtleBrush}"/>
                  <TextBox x:Name="TF_Port"
                           x:FieldModifier="public"
                           Style="{StaticResource SearchBox}"
                           Margin="0,2,0,0"/>
                </StackPanel>

                <CheckBox x:Name="TF_OnlyMalicious"
                          x:FieldModifier="public"
                          Grid.Column="2"
                          Margin="6,24,0,0"
                          Content="Malicious only"/>
              </Grid>

              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="IP Version"
                             Foreground="{StaticResource TextSubtleBrush}"/>
                  <ComboBox x:Name="TF_IpVer"
                            x:FieldModifier="public"
                            Margin="0,2,0,0"
                            SelectedIndex="0">
                    <ComboBoxItem Content="Any"/>
                    <ComboBoxItem Content="IPv4"/>
                    <ComboBoxItem Content="IPv6"/>
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="6,0,0,0">
                  <TextBlock Text="L4 Len >="
                             Foreground="{StaticResource TextSubtleBrush}"/>
                  <TextBox x:Name="TF_L4LenMin"
                           x:FieldModifier="public"
                           Style="{StaticResource SearchBox}"
                           Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>

              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          Margin="0,10,0,0">
                <Button x:Name="TF_ApplyBtn"
                        Content="Apply"
                        Width="90"
                        Style="{StaticResource SecondaryButton}"
                        Click="TF_Apply_Click"/>
                <Button x:Name="TF_ClearBtn"
                        Content="Clear"
                        Width="90"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        Click="TF_Clear_Click"/>
              </StackPanel>
            </StackPanel>
          </Expander>
          <Button x:Name="RawDetectionsNavButton" Style="{StaticResource NavButton}" Click="Nav_Alerts_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="◇" Foreground="{StaticResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Raw Detections" Style="{StaticResource SidebarNavTitle}" Margin="9,0,0,0"/>
              
            </Grid>
          </Button>


          <Expander x:Name="IdsFilterExpander"
                    x:FieldModifier="public"
                    Header="Raw detection filters"
                    Visibility="Collapsed"
                    IsExpanded="True"
                    Margin="6,0,6,6">
            <StackPanel Margin="6">
              <TextBlock Text="Search (rule or description)"
                         Foreground="{StaticResource TextSubtleBrush}"
                         Margin="0,4,0,2"/>
              <TextBox x:Name="AF_SearchText"
                       x:FieldModifier="public"
                       Style="{StaticResource SearchBox}"
                       ToolTip="Rule ID or description"/>

              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Source IP"
                           Foreground="{StaticResource TextSubtleBrush}"
                           Grid.Row="0"/>
                <TextBox x:Name="AF_Src"
                         x:FieldModifier="public"
                         Grid.Row="1"
                         Style="{StaticResource SearchBox}"
                         Margin="0,2,6,0"/>

                <TextBlock Text="Destination IP"
                           Foreground="{StaticResource TextSubtleBrush}"
                           Grid.Row="0"
                           Grid.Column="1"/>
                <TextBox x:Name="AF_Dst"
                         x:FieldModifier="public"
                         Grid.Row="1"
                         Grid.Column="1"
                         Style="{StaticResource SearchBox}"
                         Margin="6,2,0,0"/>
              </Grid>

              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Severity"
                             Foreground="{StaticResource TextSubtleBrush}"/>
                  <ComboBox x:Name="AF_Severity"
                            x:FieldModifier="public"
                            SelectedIndex="0"
                            Margin="0,2,0,0">
                    <ComboBoxItem Content="Any"/>
                    <ComboBoxItem Content="Info"/>
                    <ComboBoxItem Content="Low"/>
                    <ComboBoxItem Content="Medium"/>
                    <ComboBoxItem Content="High"/>
                    <ComboBoxItem Content="Critical"/>
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="6,0,0,0">
                  <TextBlock Text="Protocol"
                             Foreground="{StaticResource TextSubtleBrush}"/>
                  <TextBox x:Name="AF_Proto"
                           x:FieldModifier="public"
                           Style="{StaticResource SearchBox}"
                           Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Margin="6,0,0,0">
                  <TextBlock Text="Dst Port"
                             Foreground="{StaticResource TextSubtleBrush}"/>
                  <TextBox x:Name="AF_Port"
                           x:FieldModifier="public"
                           Style="{StaticResource SearchBox}"
                           Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>

              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          Margin="0,10,0,0">
                <Button x:Name="AF_ApplyBtn"
                        Content="Apply"
                        Width="90"
                        Style="{StaticResource SecondaryButton}"
                        Click="AF_Apply_Click"/>
                <Button x:Name="AF_ClearBtn"
                        Content="Clear"
                        Width="90"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        Click="AF_Clear_Click"/>
              </StackPanel>
            </StackPanel>
          </Expander>
          <Button x:Name="SinkDeliveryNavButton" Style="{StaticResource NavButton}" Click="Nav_SinkEvents_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="◈" Foreground="{StaticResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Sink Delivery" Style="{StaticResource SidebarNavTitle}" Margin="9,0,0,0"/>
              
            </Grid>
          </Button>


          <Expander x:Name="SinkEventsFilterExpander"
                    x:FieldModifier="public"
                    Header="Sink delivery filters"
                    Visibility="Collapsed"
                    IsExpanded="True"
                    Margin="6,0,6,6">
            <StackPanel Margin="6">
              <TextBlock Text="Search (description or error)"
                         Foreground="{StaticResource TextSubtleBrush}"
                         Margin="0,4,0,2"/>
              <TextBox x:Name="SE_SearchText"
                       x:FieldModifier="public"
                       Style="{StaticResource SearchBox}"
                       ToolTip="Find in description or error message"/>

              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Source IP"
                           Foreground="{StaticResource TextSubtleBrush}"
                           Grid.Row="0"/>
                <TextBox x:Name="SE_Src"
                         x:FieldModifier="public"
                         Grid.Row="1"
                         Style="{StaticResource SearchBox}"
                         Margin="0,2,6,0"/>

                <TextBlock Text="Destination IP"
                           Foreground="{StaticResource TextSubtleBrush}"
                           Grid.Row="0"
                           Grid.Column="1"/>
                <TextBox x:Name="SE_Dst"
                         x:FieldModifier="public"
                         Grid.Row="1"
                         Grid.Column="1"
                         Style="{StaticResource SearchBox}"
                         Margin="6,2,0,0"/>
              </Grid>

              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Sink name"
                             Foreground="{StaticResource TextSubtleBrush}"/>
                  <TextBox x:Name="SE_SinkName"
                           x:FieldModifier="public"
                           Style="{StaticResource SearchBox}"
                           Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="6,0,0,0">
                  <TextBlock Text="Severity"
                             Foreground="{StaticResource TextSubtleBrush}"/>
                  <ComboBox x:Name="SE_Severity"
                            x:FieldModifier="public"
                            SelectedIndex="0"
                            Margin="0,2,0,0">
                    <ComboBoxItem Content="Any"/>
                    <ComboBoxItem Content="Info"/>
                    <ComboBoxItem Content="Low"/>
                    <ComboBoxItem Content="Medium"/>
                    <ComboBoxItem Content="High"/>
                    <ComboBoxItem Content="Critical"/>
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Margin="6,0,0,0">
                  <TextBlock Text="Proto / Port"
                             Foreground="{StaticResource TextSubtleBrush}"/>
                  <StackPanel Orientation="Horizontal"
                              Margin="0,2,0,0">
                    <TextBox x:Name="SE_Proto"
                             x:FieldModifier="public"
                             Style="{StaticResource SearchBox}"
                             Width="80"
                             Margin="0,0,6,0"/>
                    <TextBox x:Name="SE_Port"
                             x:FieldModifier="public"
                             Style="{StaticResource SearchBox}"
                             Width="80"/>
                  </StackPanel>
                </StackPanel>
              </Grid>

              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          Margin="0,10,0,0">
                <Button x:Name="SE_ApplyBtn"
                        Content="Apply"
                        Width="90"
                        Style="{StaticResource SecondaryButton}"
                        Click="SE_Apply_Click"/>
                <Button x:Name="SE_ClearBtn"
                        Content="Clear"
                        Width="90"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        Click="SE_Clear_Click"/>
              </StackPanel>
            </StackPanel>
          </Expander>
          <Button x:Name="PcapExplorerNavButton" Style="{StaticResource NavButton}" Click="Nav_LiveTraffic_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="▧" Foreground="{StaticResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="PCAP Explorer" Style="{StaticResource SidebarNavTitle}" Margin="9,0,0,0"/>
              
            </Grid>
          </Button>
          <Button x:Name="ForensicsNavButton" Style="{StaticResource NavButton}" Click="Nav_Alerts_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="⌕" Foreground="{StaticResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Forensics Workspace" Style="{StaticResource SidebarNavTitle}" Margin="9,0,0,0"/>
              
            </Grid>
          </Button>

          <Separator Style="{StaticResource QuietSeparator}"/>
          <TextBlock Text="PLATFORM" Style="{StaticResource SidebarSectionLabel}"/>
          <Button x:Name="AnalyticsNavButton" Style="{StaticResource NavButton}" Click="Nav_Analytics_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="▥" Foreground="{StaticResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Analytics" Style="{StaticResource SidebarNavTitle}" Margin="9,0,0,0"/>
              
            </Grid>
          </Button>
          <Button x:Name="IntegrationsNavButton" Style="{StaticResource NavButton}" Click="Nav_Integrations_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="▨" Foreground="{StaticResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Integrations" Style="{StaticResource SidebarNavTitle}" Margin="9,0,0,0"/>
              
            </Grid>
          </Button>
          <Button x:Name="HostIntegrityNavButton" Style="{StaticResource NavButton}" Click="Nav_HostIntegrity_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="▱" Foreground="{StaticResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Host Integrity" Style="{StaticResource SidebarNavTitle}" Margin="9,0,0,0"/>
              
            </Grid>
          </Button>
          <Button x:Name="CiscoToolsNavButton" Style="{StaticResource NavButton}" Click="Nav_CiscoTools_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="▤" Foreground="{StaticResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Cisco Tools" Style="{StaticResource SidebarNavTitle}" Margin="9,0,0,0"/>
              
            </Grid>
          </Button>

          <Separator Style="{StaticResource QuietSeparator}"/>
          <TextBlock Text="SETTINGS" Style="{StaticResource SidebarSectionLabel}"/>
          <Button x:Name="CaptureSourcesNavButton" Style="{StaticResource NavButton}" Click="Nav_Settings_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="▦" Foreground="{StaticResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Capture &amp; Sources" Style="{StaticResource SidebarNavTitle}" Margin="9,0,0,0"/>
              
            </Grid>
          </Button>
          <Button x:Name="DetectionRulesNavButton" Style="{StaticResource NavButton}" Click="Nav_Settings_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="◇" Foreground="{StaticResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Detection Rules" Style="{StaticResource SidebarNavTitle}" Margin="9,0,0,0"/>
              
            </Grid>
          </Button>
          <Button x:Name="ReputationNavButton" Style="{StaticResource NavButton}" Click="Nav_Settings_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="◎" Foreground="{StaticResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Reputation" Style="{StaticResource SidebarNavTitle}" Margin="9,0,0,0"/>
              
            </Grid>
          </Button>
          <Button x:Name="UsersRolesNavButton" Style="{StaticResource NavButton}" Click="Nav_Settings_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="♙" Foreground="{StaticResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Users &amp; Roles" Style="{StaticResource SidebarNavTitle}" Margin="9,0,0,0"/>
              
            </Grid>
          </Button>
          <Button x:Name="SystemSettingsNavButton" Style="{StaticResource NavButton}" Click="Nav_Settings_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="⚙" Foreground="{StaticResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="System Settings" Style="{StaticResource SidebarNavTitle}" Margin="9,0,0,0"/>
              
            </Grid>
          </Button>

          <Separator Style="{StaticResource QuietSeparator}"/>
          <Button Style="{StaticResource NavButton}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="≪" Foreground="{StaticResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Collapse" Style="{StaticResource SidebarNavTitle}" Margin="9,0,0,0"/>
            </Grid>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
