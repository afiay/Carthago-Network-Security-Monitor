<UserControl x:Class="Carthago.Views.NetworkInvestigationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
  <UserControl.Resources>
    <Style x:Key="InvestigationSelectedRowStyle" TargetType="DataGridRow">
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#205D78"/>
          <Setter Property="Foreground" Value="White"/>
          <Setter Property="BorderBrush" Value="#63D8E7"/>
          <Setter Property="BorderThickness" Value="1"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="EvidenceInspectorFieldTemplate">
      <Grid Margin="0,0,0,8">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsMatch}" Value="True">
                <Setter Property="Background" Value="#204E5D"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsProvenance}" Value="True">
                <Setter Property="Background" Value="#17435B"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="195"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Key}"
                   FontSize="12" TextWrapping="Wrap" Margin="5,3,12,3">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsMatch}" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource AccentAltBrush}"/>
                  <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProvenance}" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource AccentAltBrush}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap"
                 ToolTip="Read-only recorded value · select text to copy"/>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="16,16,16,24" MinWidth="330">
      <Border Background="#102D42" BorderBrush="#2B5870" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="FORENSICS  /  RETAINED LOCAL EVIDENCE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentAltBrush}"/>
          <TextBlock Text="Network Investigation Explorer" FontSize="27" FontWeight="Bold"
                     Foreground="{StaticResource TextBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
          <TextBlock Text="Explore observed hosts and related detection records from the retained UI buffers. Matching an IP is not proof that events belong to the same incident."
                     Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <WrapPanel Margin="0,16,0,0">
            <TextBox x:Name="InvestigationSearchText" Width="270" MinHeight="36" MaxLength="256" Margin="0,0,8,8"
                     Style="{StaticResource SearchBox}" KeyDown="InvestigationSearchText_KeyDown"
                     ToolTip="Exact IP, port:443, event:&lt;exact-event-id&gt;, or text from retained DNS question names, rule IDs, domains, flow IDs and other traffic/detection metadata"
                     AutomationProperties.Name="Network investigation search"/>
            <Button Content="Investigate" MinWidth="116" Height="36" Margin="0,0,8,8"
                    Style="{StaticResource PrimaryButton}" Click="Investigate_Click"/>
            <Button Content="Refresh snapshot" MinWidth="132" Height="36" Margin="0,0,8,8"
                    Style="{StaticResource SecondaryButton}" Click="Refresh_Click"/>
          </WrapPanel>
          <WrapPanel Margin="0,4,0,2" VerticalAlignment="Center">
            <Button x:Name="InvestigationBackButton" Content="← Previous investigation" IsEnabled="False"
                    MinWidth="165" Height="34" Margin="0,0,8,8" Style="{StaticResource SecondaryButton}"
                    Click="InvestigationBack_Click" AutomationProperties.Name="Go to previous investigation"/>
            <Button x:Name="InvestigationForwardButton" Content="Next investigation →" IsEnabled="False"
                    MinWidth="155" Height="34" Margin="0,0,8,8" Style="{StaticResource SecondaryButton}"
                    Click="InvestigationForward_Click" AutomationProperties.Name="Go to next investigation"/>
            <Button x:Name="ClearInvestigationHistoryButton" Content="Clear history" IsEnabled="False"
                    MinWidth="112" Height="34" Margin="0,0,8,8" Style="{StaticResource SecondaryButton}"
                    Click="ClearInvestigationHistory_Click" AutomationProperties.Name="Clear session investigation history"/>
          </WrapPanel>
          <TextBlock x:Name="InvestigationHistoryStatusText" Text="Session history is empty · no searches saved automatically"
                     Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                     AutomationProperties.LiveSetting="Polite"/>
          <WrapPanel Margin="0,4,0,0">
            <ComboBox x:Name="SavedSearches" Width="230" Height="34" Margin="0,0,8,8"
                      AutomationProperties.Name="Saved local investigation searches"
                      ToolTip="Only queries you intentionally bookmark are stored in local application preferences"/>
            <Button Content="Open saved" MinWidth="98" Height="34" Margin="0,0,8,8"
                    Style="{StaticResource SecondaryButton}" Click="OpenSavedSearch_Click"/>
            <Button Content="Save current" MinWidth="106" Height="34" Margin="0,0,8,8"
                    Style="{StaticResource SecondaryButton}" Click="SaveCurrentSearch_Click"/>
            <Button Content="Remove saved" MinWidth="110" Height="34" Margin="0,0,8,8"
                    Style="{StaticResource SecondaryButton}" Click="RemoveSavedSearch_Click"/>
          </WrapPanel>
          <TextBlock x:Name="SavedSearchStatusText" Text="Saved investigation queries remain on this computer until removed."
                     Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
          <TextBlock x:Name="ScopeText" Text="No local snapshot loaded" Foreground="{StaticResource TextMutedBrush}"
                     TextWrapping="Wrap" Margin="0,3,0,0"/>
          <TextBlock Text="Keyboard: focus a result grid, then Alt+Up / Alt+Down for previous / next match. Standard arrows remain available."
                     Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>


      <!-- Local network discovery is distinct from capture-source selection. -->
      <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
              BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="LAN DEVICES / LOCAL NETWORK" Style="{StaticResource DashboardSectionTitle}"/>
          <TextBlock Text="Displays observed local IPs and Windows neighbor-cache entries. 'Discover IPv4 devices' sends bounded ICMP probes on private LAN subnets. Neither a cached entry nor a missing response proves whether a device is online."
                     TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,10"/>
          <WrapPanel>
            <Button x:Name="LanDiscoverButton" Content="Discover IPv4 devices" Click="LanDiscover_Click"
                    Height="34" MinWidth="168" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}"
                    ToolTip="Opt-in ICMP discovery of up to 512 private local IPv4 targets; no port scan."/>
            <Button x:Name="LanRefreshButton" Content="Refresh neighbor cache" Click="LanRefresh_Click"
                    Height="34" MinWidth="160" Margin="0,0,8,8" Style="{StaticResource SecondaryButton}"
                    ToolTip="No network probes; reads Windows ARP cache and retained traffic rows."/>
          </WrapPanel>
          <TextBlock x:Name="LanDeviceStatusText" Text="No local inventory loaded."
                     Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                     Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
          <DataGrid x:Name="LanDevicesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    Height="220" EnableRowVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                    AutomationProperties.Name="Discovered local network device inventory">
            <DataGrid.Columns>
              <DataGridTextColumn Header="IP address" Binding="{Binding Address}" Width="165"/>
              <DataGridTextColumn Header="MAC (if known)" Binding="{Binding Mac}" Width="175"/>
              <DataGridTextColumn Header="State" Binding="{Binding State}" Width="195"/>
              <DataGridTextColumn Header="Evidence / source" Binding="{Binding Evidence}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
              BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="OBSERVED ASSETS / CAPTURE SESSION" Style="{StaticResource DashboardSectionTitle}"/>
          <TextBlock x:Name="ObservedAssetStatus" Text="No observed assets yet."
                     TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,10"/>
          <DataGrid x:Name="ObservedAssetsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    Height="220" EnableRowVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                    AutomationProperties.Name="Observed asset identities">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Identity / evidence" Binding="{Binding Evidence}" Width="180"/>
              <DataGridTextColumn Header="Interface scope" Binding="{Binding InterfaceScope}" Width="180"/>
              <DataGridTextColumn Header="MAC claim" Binding="{Binding Mac}" Width="150"/>
              <DataGridTextColumn Header="Observed IPs" Binding="{Binding Addresses}" Width="200"/>
              <DataGridTextColumn Header="TCP SYN-ACK ports" Binding="{Binding Services}" Width="150"/>
              <DataGridTextColumn Header="First seen UTC" Binding="{Binding FirstSeenUtc}" Width="155"/>
              <DataGridTextColumn Header="Last seen UTC" Binding="{Binding LastSeenUtc}" Width="155"/>
              <DataGridTextColumn Header="Observations" Binding="{Binding Observations}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
              BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="SAVED ASSET HISTORY / PREVIOUS CHECKPOINTS" Style="{StaticResource DashboardSectionTitle}"/>
          <TextBlock x:Name="AssetHistoryStatus" Text="No history loaded."
                     TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,10"/>
          <DataGrid x:Name="AssetHistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    Height="220" EnableRowVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                    AutomationProperties.Name="Saved capture-session asset history">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Session started UTC" Binding="{Binding SessionStartedUtc}" Width="155"/>
              <DataGridTextColumn Header="Identity / evidence" Binding="{Binding Asset.Evidence}" Width="165"/>
              <DataGridTextColumn Header="Interface scope" Binding="{Binding Asset.InterfaceScope}" Width="180"/>
              <DataGridTextColumn Header="MAC claim" Binding="{Binding Asset.Mac}" Width="150"/>
              <DataGridTextColumn Header="Observed IPs" Binding="{Binding Asset.Addresses}" Width="200"/>
              <DataGridTextColumn Header="TCP SYN-ACK ports" Binding="{Binding Asset.Services}" Width="150"/>
              <DataGridTextColumn Header="First seen UTC" Binding="{Binding Asset.FirstSeenUtc}" Width="155"/>
              <DataGridTextColumn Header="Last seen UTC" Binding="{Binding Asset.LastSeenUtc}" Width="155"/>
              <DataGridTextColumn Header="Observations" Binding="{Binding Asset.Observations}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
              BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
        <StackPanel>
          <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Open Live Traffic" Style="{StaticResource SecondaryButton}"
                    MinWidth="145" Height="32" Click="OpenTraffic_Click"/>
            <StackPanel>
              <TextBlock Text="Observed communication" Style="{StaticResource DashboardSectionTitle}"/>
              <TextBlock x:Name="TrafficCountText" Text="0 matching retained records"
                         Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
          <DataGrid x:Name="InvestigationTrafficGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    RowStyle="{StaticResource InvestigationSelectedRowStyle}"
                    Height="260" FrozenColumnCount="1" EnableRowVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                    SelectionChanged="InvestigationTrafficGrid_SelectionChanged" PreviewKeyDown="InvestigationMatchGrid_PreviewKeyDown"
                    AutomationProperties.Name="Matching retained network traffic">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="155"/>
              <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="150"/>
              <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="150"/>
              <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="85"/>
              <DataGridTextColumn Header="DNS question (if recorded)" Binding="{Binding DnsQname}" Width="205"/>
              <DataGridTextColumn Header="Src port" Binding="{Binding SourcePort}" Width="80"/>
              <DataGridTextColumn Header="Dst port" Binding="{Binding DestinationPort}" Width="80"/>
              <DataGridTextColumn Header="Service" Binding="{Binding ApplicationService}" Width="145"/>
              <DataGridTextColumn Header="Process (if known)" Binding="{Binding ProcessName}" Width="170"/>
              <DataGridTextColumn Header="Country (if known)" Binding="{Binding WhoisCountry}" Width="150"/>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
            <Button x:Name="PreviousTrafficMatchButton" Content="← Previous record" IsEnabled="False" Height="32" Margin="0,0,8,6"
                    Style="{StaticResource SecondaryButton}" Click="PreviousTrafficMatch_Click"/>
            <Button x:Name="NextTrafficMatchButton" Content="Next record →" IsEnabled="False" Height="32" Margin="0,0,10,6"
                    Style="{StaticResource SecondaryButton}" Click="NextTrafficMatch_Click"/>
            <TextBlock x:Name="TrafficMatchPositionText" Text="No record selected" VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite"/>
          </WrapPanel>
          <Expander x:Name="TrafficEvidenceExpander" Header="Selected traffic evidence · choose a row above"
                    IsExpanded="False" Margin="0,12,0,0" Foreground="{StaticResource TextBrush}"
                    AutomationProperties.Name="Selected traffic evidence inspector">
            <Border Background="#102D42" BorderBrush="#2B5870" BorderThickness="1" CornerRadius="9" Padding="14">
              <StackPanel>
                <TextBlock Text="Search provenance names the recorded fields matched by the current query; it does not prove linkage. Optional fields say Not recorded when absent. Address scope uses default local ranges, not network inventory."
                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <ScrollViewer MaxHeight="295" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="TrafficEvidenceFields" ItemTemplate="{StaticResource EvidenceInspectorFieldTemplate}"/>
                </ScrollViewer>
                <TextBlock Text="Process names, WHOIS and GeoIP are optional enrichments; an unknown value is not evidence of absence. Raw payloads, HTTP headers and credentials are not displayed."
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
          </Expander>
        </StackPanel>
      </Border>

      <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
              BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
        <StackPanel>
          <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Open Raw Detections" Style="{StaticResource SecondaryButton}"
                    MinWidth="155" Height="32" Click="OpenDetections_Click"/>
            <StackPanel>
              <TextBlock Text="Matching detection records" Style="{StaticResource DashboardSectionTitle}"/>
              <TextBlock x:Name="DetectionCountText" Text="0 matching retained detections"
                         Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
          <DataGrid x:Name="InvestigationDetectionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    RowStyle="{StaticResource InvestigationSelectedRowStyle}"
                    Height="250" FrozenColumnCount="1" EnableRowVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                    SelectionChanged="InvestigationDetectionsGrid_SelectionChanged" PreviewKeyDown="InvestigationMatchGrid_PreviewKeyDown"
                    AutomationProperties.Name="Matching retained detection events">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Timestamp (UTC)" Binding="{Binding TimestampUtc, StringFormat={}{0:u}}" Width="160"/>
              <DataGridTextColumn Header="Rule" Binding="{Binding RuleId}" Width="90"/>
              <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
              <DataGridTextColumn Header="Source" Binding="{Binding SourceIp}" Width="155"/>
              <DataGridTextColumn Header="Destination" Binding="{Binding DestinationIp}" Width="155"/>
              <DataGridTextColumn Header="Src port" Binding="{Binding SourcePort}" Width="80"/>
              <DataGridTextColumn Header="Dst port" Binding="{Binding DestinationPort}" Width="80"/>
              <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="150"/>
              <DataGridTextColumn Header="Flow ID" Binding="{Binding FlowId}" Width="150"/>
              <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="370"/>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
            <Button x:Name="PreviousDetectionMatchButton" Content="← Previous detection" IsEnabled="False" Height="32" Margin="0,0,8,6"
                    Style="{StaticResource SecondaryButton}" Click="PreviousDetectionMatch_Click"/>
            <Button x:Name="NextDetectionMatchButton" Content="Next detection →" IsEnabled="False" Height="32" Margin="0,0,10,6"
                    Style="{StaticResource SecondaryButton}" Click="NextDetectionMatch_Click"/>
            <TextBlock x:Name="DetectionMatchPositionText" Text="No detection selected" VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite"/>
          </WrapPanel>
          <Expander x:Name="DetectionEvidenceExpander" Header="Selected detection evidence · choose a row above"
                    IsExpanded="False" Margin="0,12,0,0" Foreground="{StaticResource TextBrush}"
                    AutomationProperties.Name="Selected detection evidence inspector">
            <Border Background="#102D42" BorderBrush="#2B5870" BorderThickness="1" CornerRadius="9" Padding="14">
              <StackPanel>
                <TextBlock Text="Search provenance names matching event fields, not evidence of case association. Structured evidence values appear only for approved typed metadata; all unreviewed, legacy and sensitive values are withheld."
                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <ScrollViewer MaxHeight="295" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="DetectionEvidenceFields" ItemTemplate="{StaticResource EvidenceInspectorFieldTemplate}"/>
                </ScrollViewer>
                <TextBlock Text="Confidence score is not a calibrated probability; flow and correlation identifiers do not prove membership in an incident. Free-form/raw evidence is intentionally excluded."
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <Border x:Name="LinkedCasesPanel" Visibility="Collapsed" BorderBrush="#2B5870" BorderThickness="1,1,0,0"
                        Margin="0,14,0,0" Padding="0,12,0,0">
                  <StackPanel>
                    <TextBlock Text="EXACT EVENT-TO-CASE REFERENCES" Foreground="{StaticResource AccentAltBrush}"
                               FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="LinkedCasesStatusText" Text="Select a detection to check actual cached case references."
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/>
                    <WrapPanel>
                      <ComboBox x:Name="LinkedCasesCombo" Width="365" Height="34" Margin="0,0,8,8"
                                DisplayMemberPath="Key" SelectionChanged="LinkedCasesCombo_SelectionChanged"
                                AutomationProperties.Name="Cases explicitly referencing selected detection event"/>
                      <Button x:Name="OpenLinkedCaseButton" Content="Open linked case" IsEnabled="False"
                              Style="{StaticResource SecondaryButton}" MinWidth="140" Height="34" Margin="0,0,0,8"
                              Click="OpenLinkedCase_Click"
                              ToolTip="Opens only an actual cached incident whose related event IDs explicitly include this event"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </Expander>
        </StackPanel>
      </Border>

      <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
              BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
        <StackPanel>
          <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Open selected incident" Style="{StaticResource SecondaryButton}"
                    MinWidth="165" Height="32" Click="OpenSelectedIncident_Click"
                    ToolTip="Open the selected actual incident cache entry, without inferring correlation from a matching IP"/>
            <StackPanel>
              <TextBlock Text="Matching incident cases" Style="{StaticResource DashboardSectionTitle}"/>
              <TextBlock x:Name="IncidentCountText" Text="Enter a query to search cached incidents"
                         Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
          <DataGrid x:Name="InvestigationIncidentsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    RowStyle="{StaticResource InvestigationSelectedRowStyle}"
                    Height="185" FrozenColumnCount="1" EnableRowVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                    SelectionChanged="InvestigationIncidentsGrid_SelectionChanged" PreviewKeyDown="InvestigationMatchGrid_PreviewKeyDown"
                    AutomationProperties.Name="Matching cached incident case records">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Case ID" Binding="{Binding Id}" Width="185"/>
              <DataGridTextColumn Header="Created UTC" Binding="{Binding CreatedUtc, StringFormat={}{0:u}}" Width="160"/>
              <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="270"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/>
              <DataGridTextColumn Header="Source" Binding="{Binding PrimarySourceIp}" Width="145"/>
              <DataGridTextColumn Header="Destination" Binding="{Binding PrimaryDestinationIp}" Width="145"/>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
            <Button x:Name="PreviousIncidentMatchButton" Content="← Previous case" IsEnabled="False" Height="32" Margin="0,0,8,6"
                    Style="{StaticResource SecondaryButton}" Click="PreviousIncidentMatch_Click"/>
            <Button x:Name="NextIncidentMatchButton" Content="Next case →" IsEnabled="False" Height="32" Margin="0,0,10,6"
                    Style="{StaticResource SecondaryButton}" Click="NextIncidentMatch_Click"/>
            <TextBlock x:Name="IncidentMatchPositionText" Text="No case selected" VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite"/>
          </WrapPanel>
          <Expander x:Name="IncidentEvidenceExpander" Header="Selected incident case context · choose a row above"
                    IsExpanded="False" Margin="0,12,0,0" Foreground="{StaticResource TextBrush}"
                    AutomationProperties.Name="Selected incident case context inspector">
            <Border Background="#102D42" BorderBrush="#2B5870" BorderThickness="1" CornerRadius="9" Padding="14">
              <StackPanel>
                <TextBlock Text="This is an actual cached incident, not a case inferred from matching IP addresses. Open the selected incident for its authoritative timeline."
                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <ScrollViewer MaxHeight="255" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="IncidentEvidenceFields" ItemTemplate="{StaticResource EvidenceInspectorFieldTemplate}"/>
                </ScrollViewer>
                <Border x:Name="LinkedDetectionsPanel" Visibility="Collapsed" BorderBrush="#2B5870" BorderThickness="1,1,0,0"
                        Margin="0,14,0,0" Padding="0,12,0,0">
                  <StackPanel>
                    <TextBlock Text="EXPLICITLY RELATED DETECTION EVENTS" Foreground="{StaticResource AccentAltBrush}"
                               FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="LinkedDetectionsStatusText" Text="Select a case to inspect event IDs recorded as related to it."
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/>
                    <WrapPanel>
                      <ComboBox x:Name="LinkedDetectionsCombo" Width="365" Height="34" Margin="0,0,8,8"
                                DisplayMemberPath="Key" SelectionChanged="LinkedDetectionsCombo_SelectionChanged"
                                AutomationProperties.Name="Retained detections explicitly listed in selected case"/>
                      <Button x:Name="InspectLinkedDetectionButton" Content="Inspect linked event" IsEnabled="False"
                              Style="{StaticResource SecondaryButton}" MinWidth="152" Height="34" Margin="0,0,0,8"
                              Click="InspectLinkedDetection_Click"
                              ToolTip="Opens an exact event-ID search in this investigation workspace; does not infer links from IP addresses"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </Expander>
        </StackPanel>
      </Border>

      <Border Background="#0B2034" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
              CornerRadius="12" Padding="16">
        <StackPanel>
          <TextBlock Text="EVIDENCE BOUNDARY" Foreground="{StaticResource AccentAltBrush}" FontWeight="Bold" FontSize="11"/>
          <TextBlock Text="Traffic and detections are limited to the last 200 and 500 local UI rows; incident searches use up to 250 actual cached cases, not the complete journal. Exact event-ID links require the case to explicitly list that event; no link can be inferred from an IP match. Missing process, location, event or payload fields do not prove that activity did not occur."
                     TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,7,0,12"/>
          <WrapPanel>
            <Button Content="Analytics / Geographic Context" Style="{StaticResource SecondaryButton}"
                    MinWidth="210" Height="33" Margin="0,0,8,8" Click="OpenAnalytics_Click"/>
            <Button Content="Incident Queue" Style="{StaticResource SecondaryButton}"
                    MinWidth="125" Height="33" Margin="0,0,8,8" Click="OpenIncidentQueue_Click"/>
            <Button Content="Detection Rules" Style="{StaticResource SecondaryButton}"
