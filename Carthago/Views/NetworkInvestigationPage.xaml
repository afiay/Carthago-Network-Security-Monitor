<UserControl x:Class="Carthago.Views.NetworkInvestigationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="16,16,16,24" MinWidth="330">
      <Border Background="#102D42" BorderBrush="#2B5870" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="FORENSICS  /  RETAINED LOCAL EVIDENCE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentAltBrush}"/>
          <TextBlock Text="Network Investigation Explorer" FontSize="27" FontWeight="Bold"
                     Foreground="{StaticResource TextBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
          <TextBlock Text="Explore observed hosts and related detection records from the retained UI buffers. Matching an IP is not proof that events belong to the same incident."
                     Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <WrapPanel Margin="0,16,0,0">
            <TextBox x:Name="InvestigationSearchText" Width="270" MinHeight="36" MaxLength="256" Margin="0,0,8,8"
                     Style="{StaticResource SearchBox}" KeyDown="InvestigationSearchText_KeyDown"
                     ToolTip="Exact source/destination IP, or text from retained traffic and detection metadata"
                     AutomationProperties.Name="Network investigation search"/>
            <Button Content="Investigate" MinWidth="116" Height="36" Margin="0,0,8,8"
                    Style="{StaticResource PrimaryButton}" Click="Investigate_Click"/>
            <Button Content="Refresh snapshot" MinWidth="132" Height="36" Margin="0,0,8,8"
                    Style="{StaticResource SecondaryButton}" Click="Refresh_Click"/>
          </WrapPanel>
          <TextBlock x:Name="ScopeText" Text="No local snapshot loaded" Foreground="{StaticResource TextMutedBrush}"
                     TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>
      </Border>

      <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
              BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
        <StackPanel>
          <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Open Live Traffic" Style="{StaticResource SecondaryButton}"
                    MinWidth="145" Height="32" Click="OpenTraffic_Click"/>
            <StackPanel>
              <TextBlock Text="Observed communication" Style="{StaticResource DashboardSectionTitle}"/>
              <TextBlock x:Name="TrafficCountText" Text="0 matching retained records"
                         Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
          <DataGrid x:Name="InvestigationTrafficGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    Height="260" FrozenColumnCount="1" EnableRowVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                    AutomationProperties.Name="Matching retained network traffic">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="155"/>
              <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="150"/>
              <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="150"/>
              <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="85"/>
              <DataGridTextColumn Header="Src port" Binding="{Binding SourcePort}" Width="80"/>
              <DataGridTextColumn Header="Dst port" Binding="{Binding DestinationPort}" Width="80"/>
              <DataGridTextColumn Header="Service" Binding="{Binding ApplicationService}" Width="145"/>
              <DataGridTextColumn Header="Process (if known)" Binding="{Binding ProcessName}" Width="170"/>
              <DataGridTextColumn Header="Country (if known)" Binding="{Binding WhoisCountry}" Width="150"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
              BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
        <StackPanel>
          <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Open Raw Detections" Style="{StaticResource SecondaryButton}"
                    MinWidth="155" Height="32" Click="OpenDetections_Click"/>
            <StackPanel>
              <TextBlock Text="Matching detection records" Style="{StaticResource DashboardSectionTitle}"/>
              <TextBlock x:Name="DetectionCountText" Text="0 matching retained detections"
                         Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
          <DataGrid x:Name="InvestigationDetectionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    Height="250" FrozenColumnCount="1" EnableRowVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                    AutomationProperties.Name="Matching retained detection events">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Timestamp (UTC)" Binding="{Binding TimestampUtc, StringFormat={}{0:u}}" Width="160"/>
              <DataGridTextColumn Header="Rule" Binding="{Binding RuleId}" Width="90"/>
              <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
              <DataGridTextColumn Header="Source" Binding="{Binding SourceIp}" Width="155"/>
              <DataGridTextColumn Header="Destination" Binding="{Binding DestinationIp}" Width="155"/>
              <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="370"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Background="#0B2034" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
              CornerRadius="12" Padding="16">
        <StackPanel>
          <TextBlock Text="EVIDENCE BOUNDARY" Foreground="{StaticResource AccentAltBrush}" FontWeight="Bold" FontSize="11"/>
          <TextBlock Text="Only the last 200 traffic rows and last 500 detection events retained by this local application can be examined here. Missing process names, country fields, packet payloads or connections are unavailable, not evidence that activity did not occur."
                     TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,7,0,12"/>
          <WrapPanel>
            <Button Content="Analytics / Geographic Context" Style="{StaticResource SecondaryButton}"
                    MinWidth="210" Height="33" Margin="0,0,8,8" Click="OpenAnalytics_Click"/>
            <Button Content="Incident Queue" Style="{StaticResource SecondaryButton}"
                    MinWidth="125" Height="33" Margin="0,0,8,8" Click="OpenIncidentQueue_Click"/>
            <Button Content="Detection Rules" Style="{StaticResource SecondaryButton}"
                    MinWidth="130" Height="33" Margin="0,0,8,8" Click="OpenDetectionRules_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
