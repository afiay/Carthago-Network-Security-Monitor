<!-- File: Controls/WorldMapControl.xaml -->
<UserControl x:Class="Carthago.Controls.WorldMapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid Background="#081724" ClipToBounds="True">
        <!-- Status overlay must be ABOVE the WebView to be visible -->
        <Border x:Name="StatusOverlay"
                Panel.ZIndex="99"
                Background="#E51A3040"
                CornerRadius="8"
                Padding="12,8"
                Margin="14"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Collapsed">
            <TextBlock x:Name="StatusText"
                    Foreground="White"
                    FontSize="12"/>
        </Border>

        <!-- The actual map host -->
        <wpf:WebView2 x:Name="MapView"/>
        <Border Panel.ZIndex="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="14" Padding="10,6" CornerRadius="6" Background="#E6112535"
                IsHitTestVisible="False">
            <TextBlock Foreground="#B6D3E2" FontSize="11"
                       Text="Geographic context · approximate positions only"/>
        </Border>
    </Grid>
</UserControl>
