<!-- File: Views/HostIntegrityPage.xaml -->
<!-- GA UI-96: visual-only local inventory workspace; scan and context-menu handlers remain original. -->
<Page x:Class="Carthago.Views.HostIntegrityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Host Integrity">

  <Page.Resources>
    <LinearGradientBrush x:Key="HostIntegrityHeroGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#10243A" Offset="0"/>
      <GradientStop Color="#0B1C2F" Offset="0.62"/>
      <GradientStop Color="#0B2834" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HostIntegrityMetricGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#101F32" Offset="0"/>
      <GradientStop Color="#0B192A" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="HostIntegrityEyebrow" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>
    <Style x:Key="HostIntegrityMetricCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource HostIntegrityMetricGradient}"/>
      <Setter Property="BorderBrush" Value="#2A465A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="MinHeight" Value="102"/>
    </Style>
    <Style x:Key="HostIntegrityGridHeader" TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
      <Setter Property="Background" Value="#12283A"/>
      <Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="HostInventoryGrid" TargetType="DataGrid"
           BasedOn="{StaticResource {x:Type DataGrid}}">
      <Setter Property="Background" Value="#091828"/>
      <Setter Property="BorderBrush" Value="#264157"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="RowHeight" Value="38"/>
      <Setter Property="ColumnHeaderHeight" Value="42"/>
      <Setter Property="AlternatingRowBackground" Value="#102337"/>
      <Setter Property="ColumnHeaderStyle" Value="{StaticResource HostIntegrityGridHeader}"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    </Style>
  </Page.Resources>

  <Grid Background="{StaticResource AppBackdropGradient}">
    <Grid Margin="18,12,18,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Local scan provenance and action, not an active-capture indicator. -->
      <Border Grid.Row="0"
              Background="{StaticResource HostIntegrityHeroGradient}"
              BorderBrush="#2A5264"
              BorderThickness="1"
              CornerRadius="16"
              Padding="22,20"
              Margin="0,0,0,14">
        <Grid x:Name="HostHeroGrid">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="LOCAL ENDPOINT  /  INVENTORY REVIEW"
                       Style="{StaticResource HostIntegrityEyebrow}"/>
            <TextBlock Text="Host Integrity &amp; Software Hygiene"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,8"/>
            <TextBlock x:Name="SummaryText"
                       Text="Awaiting local inventory scan"
                       FontSize="12.5"
                       Foreground="{StaticResource TextSubtleBrush}"
                       TextWrapping="Wrap"/>
          </StackPanel>
          <Border x:Name="HostHeroAction" Grid.Row="0" Grid.Column="1"
                  Background="#0B2638" BorderBrush="#326078"
                  BorderThickness="1" CornerRadius="12"
                  Padding="12" VerticalAlignment="Center">
            <StackPanel>
              <TextBlock Text="INVENTORY ACTION"
                         Style="{StaticResource HostIntegrityEyebrow}"
                         Margin="0,0,0,8"/>
              <Button x:Name="RescanButton" Content="Rescan"
                      Width="124" Height="38"
                      Style="{StaticResource PrimaryButton}"
                      Click="RescanButton_Click"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Score/risk are derived from the existing local driver and software scan. -->
      <Grid x:Name="HostMetricGrid" Grid.Row="1" Margin="0,0,0,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition x:Name="HostMetricSecondRow" Height="0"/>
          <RowDefinition x:Name="HostMetricThirdRow" Height="0"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="HostMetricFirstColumn" Width="1*"/>
          <ColumnDefinition x:Name="HostMetricSecondColumn" Width="1*"/>
          <ColumnDefinition x:Name="HostMetricThirdColumn" Width="1.25*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="HostScoreCard" Grid.Row="0" Grid.Column="0"
                Style="{StaticResource HostIntegrityMetricCard}"
                Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="HIGHEST OBSERVED SCORE"
                       Style="{StaticResource HostIntegrityEyebrow}"/>
            <TextBlock x:Name="HostScoreText" Text="—"
                       FontSize="31" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,5,0,0"/>
            <TextBlock Text="Maximum score across local scan records"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
          </StackPanel>
        </Border>

        <Border x:Name="HostRiskCard" Grid.Row="0" Grid.Column="1"
                Style="{StaticResource HostIntegrityMetricCard}"
                Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="HIGHEST OBSERVED RISK"
                       Style="{StaticResource HostIntegrityEyebrow}"/>
            <TextBlock x:Name="HostRiskText" Text="Not scanned"
                       FontSize="26" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,6,0,0"/>
            <TextBlock Text="Local score classification, not a security guarantee"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
          </StackPanel>
        </Border>

        <Border x:Name="HostScanCard" Grid.Row="0" Grid.Column="2"
                Style="{StaticResource HostIntegrityMetricCard}">
          <StackPanel>
            <TextBlock Text="SCAN PROVENANCE"
                       Style="{StaticResource HostIntegrityEyebrow}"/>
            <TextBlock Text="Local driver &amp; software inventory"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       TextWrapping="Wrap" Margin="0,7,0,6"/>
            <TextBlock x:Name="ScanTimeText" Text="Not scanned"
                       FontSize="11.5" Foreground="{StaticResource TextSubtleBrush}"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Evidence tables remain read-only, virtualized and horizontally scrollable. -->
      <Border Grid.Row="2"
              Background="{StaticResource CardSurfaceGradient}"
              BorderBrush="#29475B"
              BorderThickness="1"
              CornerRadius="16"
              Padding="16,14,16,16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="2,0,2,12">
            <TextBlock Text="LOCAL EVIDENCE  /  INVENTORY"
                       Style="{StaticResource HostIntegrityEyebrow}"/>
            <TextBlock Text="Driver &amp; software review"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,5,0,4"/>
            <TextBlock Text="Read-only local scan results. Use the existing tabs and suspicious-only filters to inspect inventory records."
                       Foreground="{StaticResource TextSubtleBrush}"
                       FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
          <TabControl x:Name="IntegrityTabControl" Grid.Row="1"
                      Style="{StaticResource TabControl.Themed}">
            <TabItem Header="Kernel &amp; Drivers">
              <Grid Margin="4,12,4,4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="DriverFilterGrid" Grid.Row="0" Margin="0,0,0,6">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Kernel &amp; driver inventory"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Local driver state, signatures, paths and risk indicators"
                               FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,3,0,0"/>
                  </StackPanel>
                  <CheckBox x:Name="ShowOnlySuspiciousDriversCheck"
                            Grid.Row="0" Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Show only suspicious"
                            IsChecked="True"
                            Checked="ShowOnlySuspiciousDriversCheck_Changed"
                            Unchecked="ShowOnlySuspiciousDriversCheck_Changed"/>
                </Grid>
                <DataGrid x:Name="DriversGrid"
                                      Style="{StaticResource HostInventoryGrid}"
                                      Grid.Row="1"
                                      Margin="0,10,0,0"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                       CanUserDeleteRows="False"
                                       EnableRowVirtualization="True"
                                       EnableColumnVirtualization="True"
                                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open driver location"
                                                  Click="OpenDriverLocation_Click"/>
                                        <MenuItem Header="Copy driver path"
                                                  Click="CopyDriverPath_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name"
                                                        Binding="{Binding Name}"
                                                        Width="160"/>
                                    <DataGridTextColumn Header="Display Name"
                                                        Binding="{Binding DisplayName}"
                                                        Width="220"/>
                                    <DataGridTextColumn Header="Path"
                                                        Binding="{Binding Path}"
                                                        Width="260"/>
                                    <DataGridTextColumn Header="State"
                                                        Binding="{Binding State}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Start"
                                                        Binding="{Binding StartMode}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Kernel"
                                                        Binding="{Binding IsKernelDriver}"
                                                        Width="70"/>
                                    <DataGridTextColumn Header="Signed"
                                                        Binding="{Binding IsSigned}"
                                                        Width="70"/>
                                    <DataGridTextColumn Header="Publisher"
                                                        Binding="{Binding Publisher}"
                                                        Width="180"/>
                                    <DataGridTextColumn Header="Susp Path"
                                                        Binding="{Binding SuspiciousPath}"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="UnsigKernel"
                                                        Binding="{Binding SuspiciousUnsigned}"
                                                        Width="100"/>
                                    <DataGridTextColumn Header="Score"
                                                        Binding="{Binding Score}"
                                                        Width="70"/>
                                    <DataGridTextColumn Header="Risk"
                                                        Binding="{Binding Risk}"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="Flags"
                                                        Binding="{Binding Flags}"
                                                        Width="220"/>
                                </DataGrid.Columns>
                            </DataGrid>
              </Grid>
            </TabItem>

            <TabItem Header="Installed Software">
              <Grid Margin="4,12,4,4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="AppFilterGrid" Grid.Row="0" Margin="0,0,0,6">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Installed software inventory"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Local publisher, installation, exposure and hygiene observations"
                               FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,3,0,0"/>
                  </StackPanel>
                  <CheckBox x:Name="ShowOnlySuspiciousAppsCheck"
                            Grid.Row="0" Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Show only suspicious"
                            IsChecked="True"
                            Checked="ShowOnlySuspiciousAppsCheck_Changed"
                            Unchecked="ShowOnlySuspiciousAppsCheck_Changed"/>
                </Grid>
                <DataGrid x:Name="AppsGrid"
                                      Style="{StaticResource HostInventoryGrid}"
                                      Grid.Row="1"
                                      Margin="0,10,0,0"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                       CanUserDeleteRows="False"
                                       EnableRowVirtualization="True"
                                       EnableColumnVirtualization="True"
                                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open install location"
                                                  Click="OpenAppLocation_Click"/>
                                        <MenuItem Header="Copy uninstall command"
                                                  Click="CopyUninstallString_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Uninstall..."
                                                  Click="UninstallApp_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name"
                                                        Binding="{Binding Name}"
                                                        Width="220"/>
                                    <DataGridTextColumn Header="Version"
                                                        Binding="{Binding Version}"
                                                        Width="120"/>
                                    <DataGridTextColumn Header="Publisher"
                                                        Binding="{Binding Publisher}"
                                                        Width="180"/>
                                    <DataGridTextColumn Header="Category"
                                                        Binding="{Binding Category}"
                                                        Width="110"/>
                                    <DataGridTextColumn Header="Install Date"
                                                        Binding="{Binding InstallDate, StringFormat={}{0:yyyy-MM-dd}}"
                                                        Width="110"/>
                                    <DataGridTextColumn Header="Age (days)"
                                                        Binding="{Binding AgeInDays}"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="Location"
                                                        Binding="{Binding InstallLocation}"
                                                        Width="260"/>
                                    <DataGridTextColumn Header="Arch"
                                                        Binding="{Binding Architecture}"
                                                        Width="70"/>
                                    <DataGridTextColumn Header="Source"
                                                        Binding="{Binding Source}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Exposure"
                                                        Binding="{Binding ExposureScore}"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="Hygiene"
                                                        Binding="{Binding HygieneScore}"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="Score"
                                                        Binding="{Binding Score}"
                                                        Width="70"/>
                                    <DataGridTextColumn Header="Risk"
                                                        Binding="{Binding Risk}"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="Flags"
                                                        Binding="{Binding Flags}"
                                                        Width="260"/>
                                </DataGrid.Columns>
                            </DataGrid>
              </Grid>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
