<Page x:Class="Carthago.Views.IncidentQueuePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Carthago.Views"
      Title="Incident Queue">

  <Page.Resources>
    <local:SeverityToBrushConverter x:Key="SeverityBrush"/>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <Style x:Key="AnomalySectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
      <Setter Property="FontSize" Value="15.5"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="AnomalySectionMeta" TargetType="TextBlock" BasedOn="{StaticResource TinyStatusText}">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="AnomalyFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MicroLabel}">
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="AnomalyFieldValue" TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="AnomalyQueueHeader" TargetType="TextBlock" BasedOn="{StaticResource MicroLabel}">
      <Setter Property="FontSize" Value="11.25"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- GA UI-108: a two-zone command surface separates queue identity from real case volume. -->
      <Border Grid.Row="0" Style="{StaticResource IncidentOpsHeroCard}" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="INCIDENT OPERATIONS  /  LOCAL CASEWORK"
                       Style="{StaticResource IncidentOpsEyebrow}"/>
            <TextBlock Text="Incident Command"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,9,0,7" TextWrapping="Wrap"/>
            <TextBlock Text="Prioritize recorded cases, review supporting evidence and coordinate investigation."
                       Foreground="{StaticResource TextSubtleBrush}"
                       FontSize="13" TextWrapping="Wrap" MaxWidth="630"
                       HorizontalAlignment="Left"/>
            <WrapPanel Margin="0,19,0,0">
              <Border Background="#103246" BorderBrush="#356D80" BorderThickness="1"
                      CornerRadius="8" Padding="11,6" Margin="0,0,9,8">
                <TextBlock Text="01  TRIAGE" Foreground="{StaticResource AccentAltBrush}"
                           FontSize="11" FontWeight="SemiBold"/>
              </Border>
              <Border Background="#0D2636" BorderBrush="#29485C" BorderThickness="1"
                      CornerRadius="8" Padding="11,6" Margin="0,0,9,8">
                <TextBlock Text="02  INVESTIGATE" Foreground="{StaticResource TextSubtleBrush}"
                           FontSize="11" FontWeight="SemiBold"/>
              </Border>
              <Border Background="#0D2636" BorderBrush="#29485C" BorderThickness="1"
                      CornerRadius="8" Padding="11,6" Margin="0,0,0,8">
                <TextBlock Text="03  REVIEW" Foreground="{StaticResource TextSubtleBrush}"
                           FontSize="11" FontWeight="SemiBold"/>
              </Border>
            </WrapPanel>
          </StackPanel>
          <Border Grid.Column="1" Background="#091C2C" BorderBrush="#39798A"
                  BorderThickness="1" CornerRadius="14" Padding="22,16"
                  MinWidth="190" VerticalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="LOCAL QUEUE" Style="{StaticResource IncidentOpsEyebrow}"
                         Foreground="{StaticResource AccentAltBrush}"/>
              <TextBlock Text="{Binding QueueCountLabel}" FontSize="22"
                         FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                         Margin="0,12,0,8" TextWrapping="Wrap"/>
              <Border Height="3" Background="{StaticResource AccentBrush}"
                      CornerRadius="2" Margin="0,5,0,10"/>
              <TextBlock Text="Recorded incidents" FontSize="11"
                         Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <ItemsControl Grid.Row="1"
                    ItemsSource="{Binding Kpis}"
                    Margin="0,0,0,20">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource IncidentOpsKpiCard}"
                    Width="268"
                    MinHeight="172"
                    Margin="0,0,14,14"
                    BorderBrush="{Binding AccentBrush}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="False">
                  <TextBlock Text="{Binding Title}"
                             Style="{StaticResource TinyStatusText}"/>
                  <TextBlock Text="{Binding Glyph}"
                             Foreground="{Binding AccentBrush}"
                             FontWeight="Bold"
                             FontSize="13"
                             DockPanel.Dock="Right"/>
                </DockPanel>
                <TextBlock Grid.Row="1"
                           Text="{Binding Value}"
                           FontSize="32"
                           FontWeight="Bold"
                           Margin="0,12,0,0"/>
                <TextBlock Grid.Row="2"
                           Text="{Binding Delta}"
                           Foreground="{Binding AccentBrush}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Margin="0,5,0,0"/>
                <StackPanel Grid.Row="3"
                            Margin="0,10,0,0">
                  <TextBlock Text="{Binding Detail}"
                             Foreground="{StaticResource TextMutedBrush}"
                             FontSize="11.5"
                             TextWrapping="Wrap"/>
                  <Border Height="4"
                          Margin="0,10,0,0"
                          CornerRadius="3"
                          Background="{Binding AccentBrush}"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid x:Name="PrimaryWorkspaceGrid" Grid.Row="2"
            Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="PrimaryWorkspaceTopRow" Height="Auto"/>
          <RowDefinition x:Name="PrimaryWorkspaceBottomRow" Height="0"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="PrimaryWorkspaceQueueColumn" Width="0.49*"/>
          <ColumnDefinition x:Name="PrimaryWorkspaceDetailColumn" Width="0.51*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="QueuePanel" Grid.Column="0"
                Style="{StaticResource IncidentOpsPanel}"
                Margin="0,0,14,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
              <StackPanel>
                <StackPanel>
                  <TextBlock Text="LOCAL TRIAGE / PRIORITY" Style="{StaticResource IncidentOpsEyebrow}" Margin="0,0,0,6"/>
                  <TextBlock Text="Incident Queue"
                             Style="{StaticResource IncidentOpsPanelTitle}"/>
                  <TextBlock Text="Operational triage board for severity, status, ownership, and next-case priority."
                             Style="{StaticResource AnomalySectionMeta}"/>
                </StackPanel>
                <TextBlock Text="{Binding QueueCountLabel}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontWeight="SemiBold"
                           Margin="0,10,0,0"/>
              </StackPanel>

              <WrapPanel Margin="0,14,0,0">
                <ComboBox x:Name="SeverityFilter"
                          Width="150"
                          Height="38"
                          Margin="0,0,8,8"
                          VerticalContentAlignment="Center">
                  <ComboBoxItem Content="All severities" IsSelected="True"/>
                  <ComboBoxItem Content="Critical"/>
                  <ComboBoxItem Content="High"/>
                  <ComboBoxItem Content="Medium"/>
                  <ComboBoxItem Content="Low"/>
                </ComboBox>
                <ComboBox x:Name="StatusFilter"
                          Width="150"
                          Height="38"
                          Margin="0,0,8,8"
                          VerticalContentAlignment="Center">
                  <ComboBoxItem Content="All statuses" IsSelected="True"/>
                  <ComboBoxItem Content="New"/>
                  <ComboBoxItem Content="Acknowledged"/>
                  <ComboBoxItem Content="Investigating"/>
                  <ComboBoxItem Content="Resolved"/>
                </ComboBox>
                <ComboBox x:Name="OwnerFilter"
                          Width="142"
                          Height="38"
                          Margin="0,0,8,8"
                          VerticalContentAlignment="Center">
                  <ComboBoxItem Content="All owners" IsSelected="True"/>
                  <ComboBoxItem Content="Unassigned"/>
                </ComboBox>
                <TextBox x:Name="SearchBox"
                         Width="260"
                         Height="38"
                         Margin="0,0,8,8"
                         Style="{StaticResource SearchBox}"
                         VerticalContentAlignment="Center"
                         ToolTip="Search incident titles, hosts, destinations, evidence, rules, or summary"/>
                <Button Width="42"
                        Height="38"
                        Margin="0,0,0,8"
                        Style="{StaticResource SecondaryButton}"
                        Click="MoreActions_Click"
                        ToolTip="More queue actions"
                        Content="..."/>
              </WrapPanel>
            </StackPanel>

            <!-- GA UI-112: severity-first case cards replace the 900px horizontal table. -->
            <Grid Grid.Row="1" Margin="0,14,0,0">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Grid.Row="0" Background="{StaticResource CardElevatedBg}" CornerRadius="8"
                      BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                      Padding="12,8" Margin="0,0,0,9">
                <DockPanel>
                  <TextBlock Text="PRIORITIZED CASES" Style="{StaticResource IncidentOpsEyebrow}" DockPanel.Dock="Left"/>
                  <TextBlock Text="Select a case to inspect evidence →"
                             Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                             HorizontalAlignment="Right"/>
                </DockPanel>
              </Border>
              <Grid Grid.Row="1">
                <ListBox x:Name="QueueList" ItemsSource="{Binding VisibleQueue}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource AnomalyQueueItemContainerStyle}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource CardElevatedBg}"
                              BorderBrush="{StaticResource CardBorderBrush}"
                              BorderThickness="1" CornerRadius="10" Margin="0,0,0,8"
                              Padding="12,11">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                  CornerRadius="2"/>
                          <Grid Grid.Column="1" Margin="12,0,12,0">
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="15"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap" ToolTip="{Binding Title}"/>
                            <TextBlock Grid.Row="1" Text="{Binding Summary}" Margin="0,5,0,0"
                                       Foreground="{StaticResource TextSubtleBrush}" FontSize="12"
                                       TextWrapping="Wrap" MaxHeight="42" ToolTip="{Binding Summary}"/>
                            <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                              <TextBlock Text="{Binding SourceLabel}" FontFamily="Consolas"
                                         Foreground="{StaticResource AccentBrush}" FontSize="11.5"
                                         Margin="0,0,8,3" ToolTip="{Binding SourceLabel}"/>
                              <TextBlock Text="→" Foreground="{StaticResource TextMutedBrush}"
                                         Margin="0,0,8,3"/>
                              <TextBlock Text="{Binding DestinationLabel}" FontFamily="Consolas"
                                         Foreground="{StaticResource TextSubtleBrush}" FontSize="11.5"
                                         Margin="0,0,8,3" ToolTip="{Binding DestinationLabel}"/>
                            </WrapPanel>
                            <WrapPanel Grid.Row="3" Margin="0,9,0,0">
                              <Border Style="{StaticResource RiskBadge}" Background="#0D1D31"
                                      BorderBrush="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                      Padding="7,3" Margin="0,0,8,4">
                                <TextBlock Text="{Binding SeverityUpper}" FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                              </Border>
                              <Border Style="{StaticResource RiskBadge}" Background="#0A1A2B"
                                      BorderBrush="#2C4663" Padding="7,3" Margin="0,0,8,4">
                                <TextBlock Text="{Binding Status}" FontSize="10.5"
                                           Foreground="{StaticResource TextSubtleBrush}"/>
                              </Border>
                              <TextBlock Text="{Binding Category}" FontSize="11"
                                         Foreground="{StaticResource TextMutedBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,4"/>
                              <TextBlock Text="{Binding UpdatedUtc, StringFormat={}{0:MM-dd HH:mm}}"
                                         FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                         VerticalAlignment="Center" Margin="0,0,0,4"/>
                            </WrapPanel>
                          </Grid>
                          <StackPanel Grid.Column="2" VerticalAlignment="Top">
                            <Grid Width="48" Height="48" HorizontalAlignment="Right">
                              <Ellipse Style="{StaticResource RiskScoreCircle}"
                                       Stroke="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                       Width="48" Height="48" StrokeThickness="3"/>
                              <TextBlock Text="{Binding RiskScoreNumber}" FontSize="14"
                                         FontWeight="Bold" HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Grid>
                            <Button Content="..." Style="{StaticResource SecondaryButton}"
                                    Width="34" Height="28" Padding="0" Margin="0,10,0,0"
                                    HorizontalAlignment="Right" Click="QueueRowMore_Click"
                                    ToolTip="Row actions"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Border x:Name="QueueEmptyState" Style="{StaticResource EmptyStateCard}"
                        Visibility="Collapsed">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                              MaxWidth="360">
                    <TextBlock Text="No incidents match the current queue filters"
                               FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Clear a filter or continue monitoring to populate the queue."
                               Foreground="{StaticResource TextSubtleBrush}"
                               Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>

            <DockPanel Grid.Row="3"
                       Margin="0,14,0,0">
              <TextBlock Text="{Binding PageSummary}"
                         Foreground="{StaticResource TextSubtleBrush}"
                         VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal"
                          DockPanel.Dock="Right">
                <Button Content="Prev"
                        Width="56"
                        Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}"
                        IsEnabled="{Binding HasPreviousPage}"
                        Click="PreviousPage_Click"/>
                <ItemsControl ItemsSource="{Binding PageNumbers}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding Label}"
                              Style="{StaticResource AnomalyPageChipButton}"
                              Width="34"
                              Click="PageNumber_Click"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Next"
                        Width="56"
                        Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        IsEnabled="{Binding HasNextPage}"
                        Click="NextPage_Click"/>
              </StackPanel>
            </DockPanel>
          </Grid>
        </Border>

        <!-- GA UI-113: a responsive, severity-first case dossier; no evidence or action contract changes. -->
        <Border x:Name="InvestigationPanel" Grid.Column="1"
                Style="{StaticResource IncidentOpsPanel}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                <Button Content="Open Incident" MinWidth="104" Style="{StaticResource SecondaryButton}" Click="OpenIncidentWorkspace_Click"/>
                <Button Content="..." Width="40" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="MoreActions_Click"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="INVESTIGATION  /  SELECTED CASE" Style="{StaticResource IncidentOpsEyebrow}"/>
                <TextBlock Text="Case Dossier" Style="{StaticResource IncidentOpsPanelTitle}" Margin="0,5,0,0"/>
              </StackPanel>
            </DockPanel>
            <StackPanel x:Name="InvestigationBody" Grid.Row="1">
              <!-- One coherent case identity card replaces the oversized title and floating risk ring. -->
              <Border Background="#0A2233" BorderBrush="#315366" BorderThickness="1" CornerRadius="12" Padding="16">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Grid.Column="0" CornerRadius="3" Background="{Binding Selected.Severity, Converter={StaticResource SeverityBrush}}"/>
                  <StackPanel Grid.Column="1" Margin="14,0,12,0">
                    <TextBlock Text="{Binding Selected.IncidentIdLabel}" Style="{StaticResource IncidentOpsEyebrow}"/>
                    <TextBlock Text="{Binding Selected.Title}" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,7,0,6"/>
                    <TextBlock Text="{Binding Selected.Summary}" Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap" FontSize="12.5"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" HorizontalAlignment="Right" MinWidth="74">
                    <TextBlock Text="RISK" Style="{StaticResource TinyStatusText}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Selected.RiskScoreNumber}" FontSize="27" FontWeight="Bold" Foreground="{Binding Selected.Severity, Converter={StaticResource SeverityBrush}}" HorizontalAlignment="Center" Margin="0,4,0,3"/>
                    <Border Style="{StaticResource RiskBadge}" BorderBrush="{Binding Selected.Severity, Converter={StaticResource SeverityBrush}}">
                      <TextBlock Text="{Binding Selected.Severity}" FontWeight="Bold" Foreground="{Binding Selected.Severity, Converter={StaticResource SeverityBrush}}"/>
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Two-column facts stay readable inside the half-width investigation workspace. -->
              <TextBlock Text="CASE CONTEXT" Style="{StaticResource IncidentOpsEyebrow}" Margin="0,17,0,9"/>
              <UniformGrid Columns="2">
                <Border Style="{StaticResource DetailGridCard}" Margin="0,0,5,8"><StackPanel><TextBlock Text="Source host" Style="{StaticResource AnomalyFieldLabel}"/><TextBlock Text="{Binding Selected.SourceLabel}" Style="{StaticResource AnomalyFieldValue}" ToolTip="{Binding Selected.SourceLabel}"/></StackPanel></Border>
                <Border Style="{StaticResource DetailGridCard}" Margin="5,0,0,8"><StackPanel><TextBlock Text="Destination" Style="{StaticResource AnomalyFieldLabel}"/><TextBlock Text="{Binding Selected.DestinationLabel}" Style="{StaticResource AnomalyFieldValue}" ToolTip="{Binding Selected.DestinationLabel}"/></StackPanel></Border>
                <Border Style="{StaticResource DetailGridCard}" Margin="0,0,5,8"><StackPanel><TextBlock Text="Category" Style="{StaticResource AnomalyFieldLabel}"/><TextBlock Text="{Binding Selected.Category}" Style="{StaticResource AnomalyFieldValue}" ToolTip="{Binding Selected.Category}"/></StackPanel></Border>
                <Border Style="{StaticResource DetailGridCard}" Margin="5,0,0,8"><StackPanel><TextBlock Text="Detected" Style="{StaticResource AnomalyFieldLabel}"/><TextBlock Text="{Binding Selected.CreatedLabel}" Style="{StaticResource AnomalyFieldValue}" ToolTip="{Binding Selected.CreatedLabel}"/></StackPanel></Border>
                <Border Style="{StaticResource DetailGridCard}" Margin="0,0,5,0"><StackPanel><TextBlock Text="Status" Style="{StaticResource AnomalyFieldLabel}"/><TextBlock Text="{Binding Selected.Status}" Style="{StaticResource AnomalyFieldValue}" ToolTip="{Binding Selected.Status}"/></StackPanel></Border>
                <Border Style="{StaticResource DetailGridCard}" Margin="5,0,0,0"><StackPanel><TextBlock Text="Owner" Style="{StaticResource AnomalyFieldLabel}"/><TextBlock Text="{Binding SelectedOwnerLabel}" Style="{StaticResource AnomalyFieldValue}" ToolTip="{Binding SelectedOwnerLabel}"/></StackPanel></Border>
              </UniformGrid>

              <!-- Evidence is primary, with tags and rule provenance in distinct subordinate bands. -->
              <Border Style="{StaticResource BaselineComparisonCard}" Margin="0,16,0,0">
                <StackPanel>
                  <TextBlock Text="EVIDENCE  /  DETECTION REASONS" Style="{StaticResource IncidentOpsEyebrow}" Margin="0,0,0,9"/>
                  <ItemsControl ItemsSource="{Binding SelectedEvidenceAndReasons}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Border BorderBrush="#2C4A5D" BorderThickness="0,0,0,1" Padding="0,7">
                        <DockPanel LastChildFill="True">
                          <Border Width="5" Height="5" CornerRadius="3" Background="{StaticResource AccentBrush}" Margin="0,6,10,0" DockPanel.Dock="Left" VerticalAlignment="Top"/>
                          <TextBlock Text="{Binding}" Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap"/>
                        </DockPanel>
                      </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource BaselineComparisonCard}" Margin="0,10,0,0">
                <StackPanel>
                  <TextBlock Text="RELATED RULE IDS" Style="{StaticResource IncidentOpsEyebrow}" Margin="0,0,0,8"/>
                  <ItemsControl ItemsSource="{Binding SelectedRuleIds}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SmallPill}" Margin="0,0,6,6"><TextBlock Text="{Binding}" Foreground="{StaticResource TextSubtleBrush}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="CASE TAGS" Style="{StaticResource IncidentOpsEyebrow}" Margin="0,8,0,8"/>
                  <ItemsControl ItemsSource="{Binding SelectedTags}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SmallPill}" Margin="0,0,6,6"><TextBlock Text="{Binding}" Foreground="{StaticResource TextSubtleBrush}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <TextBlock Text="ANALYST ACTIONS" Style="{StaticResource IncidentOpsEyebrow}" Margin="0,17,0,10"/>
              <WrapPanel>
                <Button Content="Investigate Host" MinWidth="140" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Click="InvestigateHost_Click"/>
                <Button Content="View Incident Workspace" MinWidth="168" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="OpenIncidentWorkspace_Click"/>
                <Button Content="Query Detections" MinWidth="132" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="OpenRawDetections_Click"/>
                <Button Content="Open Raw Traffic" MinWidth="132" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="OpenRawTraffic_Click"/>
              </WrapPanel>
            </StackPanel>
            <Border x:Name="DetailsEmptyState" Grid.Row="1" Style="{StaticResource EmptyStateCard}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                <TextBlock Text="Select an incident from the triage queue" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock Text="The selected case will show its context, evidence, rule IDs and investigation actions." Foreground="{StaticResource TextSubtleBrush}" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="3"
            Margin="0,14,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="SupportingWorkspaceGrid" Grid.Row="0">
          <Grid.RowDefinitions>
            <RowDefinition x:Name="SupportingWorkspaceFirstRow" Height="Auto"/>
            <RowDefinition x:Name="SupportingWorkspaceSecondRow" Height="0"/>
            <RowDefinition x:Name="SupportingWorkspaceThirdRow" Height="0"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SupportingWorkspaceFirstColumn" Width="1.08*"/>
            <ColumnDefinition x:Name="SupportingWorkspaceSecondColumn" Width="1.05*"/>
            <ColumnDefinition x:Name="SupportingWorkspaceThirdColumn" Width="0.92*"/>
          </Grid.ColumnDefinitions>

          <Border x:Name="TimelinePanel" Style="{StaticResource IncidentOpsPanel}"
                  Margin="0,0,10,0">
            <StackPanel>
              <TextBlock Text="Incident Timeline / Activity"
                         Style="{StaticResource AnomalySectionTitle}"/>
              <ItemsControl ItemsSource="{Binding Selected.TimelineItems}"
                            Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource DetailGridCard}"
                            Margin="0,0,0,8"
                            BorderBrush="{Binding Severity, Converter={StaticResource SeverityBrush}}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="110"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TimeLabel}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11.5"
                                   Margin="0,2,12,0"
                                   TextWrapping="Wrap"/>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Title}"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Description}"
                                     Foreground="{StaticResource TextSubtleBrush}"
                                     Margin="0,4,0,0"
                                     TextWrapping="Wrap"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border x:Name="AffectedHostsPanel" Grid.Column="1"
                  Style="{StaticResource IncidentOpsPanel}"
                  Margin="0,0,10,0">
            <StackPanel>
              <DockPanel>
                <TextBlock Text="Affected Hosts"
                           Style="{StaticResource AnomalySectionTitle}"/>
                <TextBlock Text="Top impacted entities"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11.5"
                           DockPanel.Dock="Right"
                           Margin="12,4,0,0"/>
              </DockPanel>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.6*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="0.7*"/>
                  <ColumnDefinition Width="1.4*"/>
                  <ColumnDefinition Width="0.8*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Host" Style="{StaticResource AnomalyQueueHeader}"/>
                <TextBlock Grid.Column="1" Text="Role" Style="{StaticResource AnomalyQueueHeader}"/>
                <TextBlock Grid.Column="2" Text="Risk" Style="{StaticResource AnomalyQueueHeader}"/>
                <TextBlock Grid.Column="3" Text="Trend" Style="{StaticResource AnomalyQueueHeader}"/>
                <TextBlock Grid.Column="4" Text="Incidents" Style="{StaticResource AnomalyQueueHeader}"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding AffectedHosts}"
                            Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource DetailGridCard}"
                            Margin="0,0,0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="1.6*"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="0.7*"/>
                          <ColumnDefinition Width="1.4*"/>
                          <ColumnDefinition Width="0.8*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding HostDisplay}"
                                   Style="{StaticResource AnomalyQueueCellText}"
                                   ToolTip="{Binding Host}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Role}"
                                   Style="{StaticResource AnomalyQueueCellSubtleText}"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding RiskScoreLabel}"
                                   Style="{StaticResource AnomalyQueueCellText}"
                                   Foreground="{StaticResource TextWarningBrush}"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding TrendText}"
                                   Style="{StaticResource AnomalyQueueCellSubtleText}"
                                   ToolTip="{Binding TrendText}"/>
                        <TextBlock Grid.Column="4"
                                   Text="{Binding IncidentCountLabel}"
                                   Style="{StaticResource AnomalyQueueCellText}"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border x:Name="ResponseChecklistPanel" Grid.Column="2"
                  Style="{StaticResource IncidentOpsPanel}">
            <StackPanel>
              <DockPanel>
                <TextBlock Text="Response Checklist"
                           Style="{StaticResource AnomalySectionTitle}"/>
                <TextBlock Text="{Binding ChecklistSummary}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11.5"
                           DockPanel.Dock="Right"
                           Margin="12,4,0,0"/>
              </DockPanel>
              <ItemsControl ItemsSource="{Binding ResponseChecklist}"
                            Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource DetailGridCard}"
                            Margin="0,0,0,8">
                      <DockPanel LastChildFill="True">
                        <Border Style="{StaticResource SmallPill}"
                                DockPanel.Dock="Left"
                                Padding="8,2"
                                Margin="0,0,10,0">
                          <TextBlock Text="{Binding Index}"
                                     Foreground="{StaticResource TextSubtleBrush}"
                                     FontWeight="SemiBold"/>
                        </Border>
                        <Border Style="{StaticResource RiskBadge}"
                                BorderBrush="{Binding StatusBrush}"
                                DockPanel.Dock="Right">
                          <TextBlock Text="{Binding Status}"
                                     Foreground="{Binding StatusBrush}"
                                     FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{StaticResource TextSubtleBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource ShellSurface}"
                Margin="0,16,0,0"
                Padding="16,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Use Incident Queue for triage, prioritization, and routing; use Incidents for full case investigation and analyst response."
                       Foreground="{StaticResource TextSubtleBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding FooterSeveritySummary}"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</Page>
