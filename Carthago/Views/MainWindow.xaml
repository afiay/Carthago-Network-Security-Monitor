        <!-- ===== Analytics: local evidence charts + map ===== -->
        <Grid x:Name="AnalyticsView"
              Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- UI-110: ranked horizontal bars keep long source labels readable. -->
          <Border Grid.Row="0" Grid.ColumnSpan="2"
                  Style="{StaticResource DashboardFocusPanel}"
                  Margin="5" Padding="16">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,8" LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Export analysis Excel…" MinWidth="166" Height="32"
                        Style="{StaticResource SecondaryButton}" Click="FileExportExcel_Click"
                        ToolTip="Export the available local-analysis snapshot across worksheets, not only this chart"/>
                <StackPanel>
                  <TextBlock Text="Top Talkers" Style="{StaticResource DashboardSectionTitle}"/>
                  <TextBlock Text="Top 10 locally observed source addresses by packet count"
                             Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                </StackPanel>
              </DockPanel>
              <ScottPlot:WpfPlot x:Name="TopTalkersPlot_Analytics"
                                Grid.Row="1" MinHeight="180"
                                AutomationProperties.Name="Top local source addresses by packet count"/>
            </Grid>
          </Border>

          <Border Grid.Row="1" Grid.Column="0"
                  Style="{StaticResource DashboardFocusPanel}"
                  Margin="5" Padding="16">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Network Traffic" Style="{StaticResource DashboardSectionTitle}"/>
                  <TextBlock x:Name="AnalyticsTrafficWindowLabel" Text="Local PPS · last 120 seconds of retained timer samples"
                             Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                  <WrapPanel Margin="0,6,0,0">
                    <Button x:Name="AnalyticsRange30Button" Content="30s" Tag="30" Width="51" Height="26"
                            Margin="0,0,5,0" Style="{StaticResource SecondaryButton}" Opacity="0.68"
                            Click="AnalyticsTrafficRange_Click"/>
                    <Button x:Name="AnalyticsRange60Button" Content="60s" Tag="60" Width="51" Height="26"
                            Margin="0,0,5,0" Style="{StaticResource SecondaryButton}" Opacity="0.68"
                            Click="AnalyticsTrafficRange_Click"/>
                    <Button x:Name="AnalyticsRange120Button" Content="120s" Tag="120" Width="58" Height="26"
                            Style="{StaticResource SecondaryButton}" Click="AnalyticsTrafficRange_Click"
                            FontWeight="Bold"/>
                  </WrapPanel>
                </StackPanel>
                <TextBlock x:Name="AnalyticsChartRefreshCountdownText"
                           Grid.Column="1"
                           Text="Charts refresh in 3s"
                           Foreground="{StaticResource AccentAltBrush}"
                           FontSize="11" FontWeight="SemiBold"
                           Margin="12,2,0,0"
                           AutomationProperties.Name="Seconds until the next chart redraw"/>
              </Grid>
              <ScottPlot:WpfPlot x:Name="TrafficPlot_Analytics"
                                Grid.Row="1" MinHeight="180"
                                AutomationProperties.Name="Local packets per second analytics history"/>
            </Grid>
          </Border>

          <Border Grid.Row="1" Grid.Column="1"
                  Style="{StaticResource DashboardFocusPanel}"
                  Margin="5" Padding="16">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Margin="0,0,0,8">
                <TextBlock Text="Protocol Mix" Style="{StaticResource DashboardSectionTitle}"/>
                <TextBlock Text="Locally observed protocol packet counts"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
              </StackPanel>
              <ScottPlot:WpfPlot x:Name="ProtocolPlot_Analytics"
                                Grid.Row="1" MinHeight="180"
                                AutomationProperties.Name="Local protocol packet distribution"/>
            </Grid>
          </Border>

          <Border Grid.Row="2" Grid.Column="0"
                  Style="{StaticResource DashboardFocusPanel}"
                  Margin="5" Padding="16">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Margin="0,0,0,8">
                <TextBlock Text="Alert Severity" Style="{StaticResource DashboardSectionTitle}"/>
                <TextBlock Text="Current locally observed detection distribution"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
              </StackPanel>
              <ScottPlot:WpfPlot x:Name="SeverityPlot_Analytics"
                                Grid.Row="1" MinHeight="180"
                                AutomationProperties.Name="Local alert severity distribution"/>
            </Grid>
          </Border>

          <Border Grid.Row="2" Grid.Column="1"
                  Style="{StaticResource DashboardFocusPanel}"
                  Margin="5" Padding="16">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Margin="0,0,0,8">
                <TextBlock Text="Geographic Context" Style="{StaticResource DashboardSectionTitle}"/>
                <TextBlock Text="Contextual geography · locations are not precise host positions"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                <TextBlock Text="Click a public-IP marker to investigate it · local, shared and reserved addresses are excluded"
                           Foreground="{StaticResource AccentAltBrush}" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock x:Name="AnalyticsMapSamplingText"
                           Text="The map shows sampled visual observations while Analytics is open. Capture and detections are unaffected."
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
              </StackPanel>
              <Border Grid.Row="1" CornerRadius="12" BorderThickness="1"
                      BorderBrush="#274B60" Background="#081724" ClipToBounds="True">
                <controls:WorldMapControl x:Name="WorldMap" Margin="0"
                                          MinHeight="190" ShowGraticule="True"/>
              </Border>
            </Grid>
          </Border>
        </Grid>

