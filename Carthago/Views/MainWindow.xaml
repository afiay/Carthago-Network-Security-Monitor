                        <Button Grid.Column="2" Content="All detections &#x2192;"
                                VerticalAlignment="Center" Margin="12,0,0,0"
                                ToolTip="Open the existing Raw Detections view. Navigation only; no evidence export or capture starts here."
                                ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                                AutomationProperties.Name="Open Raw Detections"
                                AutomationProperties.HelpText="Opens the existing Raw Detections view and its sidebar filters. Dashboard Live Events filters are unchanged; this action does not export evidence, start capture or verify delivery."
                                MinWidth="130" Height="32" Style="{StaticResource SecondaryButton}"
                                Click="DashboardLiveEventsOpenDetections_Click"/>
                      </Grid>
                    </Border>
                    <!-- GA UI-159: responsive two-lane filter workspace; original controls and handlers preserved. -->
                    <Border Grid.Row="1" Margin="0,8,0,10" Style="{StaticResource DashboardLiveEventsToolbar}">
                      <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                          <Border DockPanel.Dock="Left" Width="4" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,12,0"/>
                          <StackPanel>
                            <TextBlock Text="REFINE EVENT STREAM" Foreground="{StaticResource TextSubtleBrush}" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="Classify signals or narrow reported event metadata" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                          </StackPanel>
                        </DockPanel>
                        <UniformGrid x:Name="DashboardLiveFilterCardsGrid" Columns="2">
                          <Border x:Name="DashboardLiveClassificationCard" MinHeight="128" Margin="0,0,8,0" Padding="16,14"
                                  Background="#102A3B" BorderBrush="{StaticResource CardBorderBrush}"
                                  BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                              <TextBlock Text="01  EVENT CLASSIFICATION" FontSize="14" FontWeight="Bold"
                                         Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                              <TextBlock Text="Severity and reported protocol" FontSize="11"
                                         Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14"/>
                              <WrapPanel>
                                <StackPanel Orientation="Horizontal" Height="38" Margin="0,0,10,6">
                        <TextBlock x:Name="DashboardLiveSeverityFilterLabel"
                                   Text="Severity"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <ComboBox x:Name="DashboardLiveSeverityFilter"
                                  FocusVisualStyle="{StaticResource KeyboardFocusVisual}"
                                  Width="142" Height="36"
                                  SelectedIndex="0"
                                  ToolTip="Filter locally observed detection severity"
                                   ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                                  AutomationProperties.HelpText="Filter the retained local detection events by reported severity. This does not change detection or capture."
                                  AutomationProperties.Name="Live events severity"
                                  AutomationProperties.LabeledBy="{Binding ElementName=DashboardLiveSeverityFilterLabel}"
                                  SelectionChanged="DashboardLiveEventsFilterChanged">
                          <ComboBoxItem Content="All severities" Tag=""/>
                          <ComboBoxItem Content="Critical" Tag="Critical"/>
                          <ComboBoxItem Content="High" Tag="High"/>
                          <ComboBoxItem Content="Medium" Tag="Medium"/>
                          <ComboBoxItem Content="Low" Tag="Low"/>
                          <ComboBoxItem Content="Info" Tag="Info"/>
                        </ComboBox>
                      </StackPanel>
                                <StackPanel Orientation="Horizontal" Height="38" Margin="0,0,10,6">
                        <TextBlock x:Name="DashboardLiveProtocolFilterLabel"
                                   Text="Protocol"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <ComboBox x:Name="DashboardLiveProtocolFilter"
                                  FocusVisualStyle="{StaticResource KeyboardFocusVisual}"
                                  Width="142" Height="36"
                                  SelectedIndex="0"
                                  ToolTip="Filter by observed protocol; other protocols remain available under All"
                                   ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                                  AutomationProperties.HelpText="Filter retained local detection events by reported protocol. All protocols also includes protocols not listed individually."
                                  AutomationProperties.Name="Live events protocol"
                                  AutomationProperties.LabeledBy="{Binding ElementName=DashboardLiveProtocolFilterLabel}"
                                  SelectionChanged="DashboardLiveEventsFilterChanged">
                          <ComboBoxItem Content="All protocols" Tag=""/>
                          <ComboBoxItem Content="TCP" Tag="TCP"/>
                          <ComboBoxItem Content="UDP" Tag="UDP"/>
                          <ComboBoxItem Content="ICMP" Tag="ICMP"/>
                        </ComboBox>
                      </StackPanel>
                              </WrapPanel>
                            </StackPanel>
                          </Border>
                          <Border x:Name="DashboardLiveMetadataCard" MinHeight="128" Margin="8,0,0,0" Padding="16,14"
                                  Background="#0E2534" BorderBrush="{StaticResource CardBorderBrush}"
                                  BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                              <TextBlock Text="02  INVESTIGATE METADATA" FontSize="14" FontWeight="Bold"
                                         Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                              <TextBlock Text="Rule ID and reported endpoints; no evidence payload search"
                                         FontSize="11" TextWrapping="Wrap"
                                         Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14"/>
                              <WrapPanel>
                                <StackPanel Orientation="Horizontal" Height="38" Margin="0,0,10,6">
                        <TextBlock x:Name="DashboardLiveRuleFilterLabel"
                                   Text="Rule"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <TextBox x:Name="DashboardLiveRuleFilter"
                                  FocusVisualStyle="{StaticResource KeyboardFocusVisual}"
                                 Width="116" Height="36"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Filter by exact rule ID or part of a rule ID"
                                  ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                                 AutomationProperties.HelpText="Filter retained local detection events by exact or partial rule ID; this does not enable, disable or evaluate rules."
                                 AutomationProperties.Name="Live events rule ID"
                                 AutomationProperties.LabeledBy="{Binding ElementName=DashboardLiveRuleFilterLabel}"
                                 TextChanged="DashboardLiveEventsTextChanged"/>
                      </StackPanel>
                                <StackPanel Orientation="Horizontal" Height="38" Margin="0,0,10,6">
                        <TextBlock x:Name="DashboardLiveSearchFilterLabel"
                                   Text="Search"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <TextBox x:Name="DashboardLiveSearchFilter"
                                  FocusVisualStyle="{StaticResource KeyboardFocusVisual}"
                                 Width="200" Height="36"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Search visible event source, destination, rule or protocol; no evidence payload search"
                                  ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                                 AutomationProperties.HelpText="Search retained local event source, destination, rule ID or protocol metadata; not raw evidence payloads or archived events."
                                 AutomationProperties.Name="Search live event endpoints"
                                 AutomationProperties.LabeledBy="{Binding ElementName=DashboardLiveSearchFilterLabel}"
                                 TextChanged="DashboardLiveEventsTextChanged"/>
                      </StackPanel>
                                <Button Content="Clear filters"
                      ToolTip="Reset only the four dashboard Live Events filters. Retained local detection events and filters in other views are not cleared."
                      ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                      AutomationProperties.HelpText="Reset only the four dashboard Live Events filters. Retained detection events and other views are not cleared."
                              Height="30" MinWidth="104"
                              Margin="0,0,0,6"
                              Style="{StaticResource SecondaryButton}"
                              Click="DashboardLiveEventsClearFilters_Click"/>
                              </WrapPanel>
                            </StackPanel>
                          </Border>
                        </UniformGrid>
                      </StackPanel>
                    </Border>
<!-- GA UI-153: cohesive local evidence-stream surface; original read-only grid, columns and consumers retained. -->
                    <Border Grid.Row="2" Background="#081827" BorderBrush="#2B4B60"
                            BorderThickness="1" CornerRadius="14" Padding="14,14,14,12">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- GA UI-171: severity-first record scanning with a larger evidence viewport; all displayed values remain source-backed. -->
                        <!-- GA UI-160: evidence table and provenance occupy one compact scan line. -->
                        <Grid Grid.Row="0" Margin="4,0,4,9">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="3" Background="#4AC8DB" CornerRadius="2"
                                    Margin="0,2,10,2"/>
                            <StackPanel>
                              <TextBlock Text="OBSERVED DETECTION RECORDS" FontSize="12"
                                         FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                              <TextBlock Text="Local metadata · read-only · received order"
                                         Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                                         Margin="0,3,0,0"/>
                            </StackPanel>
                          </StackPanel>
                          <Border Grid.Column="1" Background="#123343" BorderBrush="#2B6372"
                                  BorderThickness="1" CornerRadius="8" Padding="10,6"
                                  VerticalAlignment="Center" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="LOCAL VIEW" Foreground="#69DCEC" FontSize="10"
                                         FontWeight="Bold" Margin="0,0,9,0"/>
                              <TextBlock Text="80 displayed / 500 retained max"
                                         Foreground="{StaticResource TextSubtleBrush}" FontSize="10"/>
                            </StackPanel>
                          </Border>
                        </Grid>
                        <Border Grid.Row="1" Background="#0C2031" BorderBrush="#25445B"
                                BorderThickness="1" CornerRadius="10" Padding="1">
                          <Grid>
                            <DataGrid x:Name="DashboardLiveEventsGrid"
                                Height="610"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                SelectionMode="Single"
                                HeadersVisibility="Column"
                                GridLinesVisibility="Horizontal"
                                HorizontalGridLinesBrush="{StaticResource SoftDividerBrush}"
                                RowHeight="62"
                                AlternationCount="2"
                                ColumnHeaderHeight="48"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.VirtualizationMode="Recycling"
                                EnableRowVirtualization="True"
                                EnableColumnVirtualization="True"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                FrozenColumnCount="2"
                                AutomationProperties.Name="Recent local detection events"
                                AutomationProperties.HelpText="Read-only local detections, up to 80 rows. The Event time and Severity columns remain visible during horizontal scrolling; navigate remaining columns with the grid keyboard controls or horizontal scroll. Event time is recorded as supplied; timezone is unverified. Evidence is reported presence or count only, not a verified chain. Delivery is transport status, not incident resolution."
                                AutomationProperties.ItemStatus="{Binding Text, ElementName=DashboardLiveEventsStatusText}">
                        <!-- GA UI-15: reuse the theme's keyboard-only focus outline for the read-only event cells. -->
                        <!-- GA UI-155: layered, scannable operational evidence rows; no new event state. -->
                        <!-- GA UI-171: severity-first 62px scan rows and a 610px viewport, preserving the 80-row displayed limit. -->
                        <DataGrid.RowStyle>
                          <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="Background" Value="#102537"/>
                            <Setter Property="BorderBrush" Value="#29455A"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Style.Triggers>
                              <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#152D40"/>
                              </Trigger>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#204258"/>
                              </Trigger>
                              <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1B4B5D"/>
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                          <Style TargetType="{x:Type DataGridCell}"
                                 BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="Padding" Value="7,3"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FocusVisualStyle"
                                    Value="{StaticResource KeyboardFocusVisual}"/>
                          </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                          <!-- GA UI-171: severity immediately follows the frozen recorded time; reported route and provenance remain source-bound. -->
                          <DataGridTextColumn Header="TIME" Binding="{Binding EventTime}" Width="138"
                                              ElementStyle="{StaticResource DashboardLiveMetadataCellText}">
                            <DataGridTextColumn.HeaderStyle>
                              <Style TargetType="{x:Type DataGridColumnHeader}"
                                     BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ToolTip"
                                        Value="Recorded detection-event timestamp as supplied, shown without timezone conversion or verification. Not proof of capture health or event delivery."/>
                                <Setter Property="AutomationProperties.HelpText"
                                        Value="Timestamp recorded on the local detection event, formatted as supplied. Timezone is unverified; the time does not establish active capture or successful delivery."/>
                              </Style>
                            </DataGridTextColumn.HeaderStyle>
                          </DataGridTextColumn>
                          <DataGridTemplateColumn Header="SEVERITY" Width="148">
                             <DataGridTemplateColumn.CellTemplate>
                               <DataTemplate>
                                 <Grid Margin="3,2,8,2">
                                   <Grid.ColumnDefinitions><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                   <Border Grid.Column="0" Background="#47CFE4" CornerRadius="3" Margin="0,2,0,2"/>
                                   <Border Grid.Column="1" Style="{StaticResource DashboardLiveEventsSeverityPill}" Margin="9,0,0,0" Padding="10,8">
                                     <TextBlock Text="{Binding Severity}" FontSize="12" FontWeight="Bold"
                                                Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                   </Border>
                                 </Grid>
                               </DataTemplate>
                             </DataGridTemplateColumn.CellTemplate>
                             <DataGridTemplateColumn.HeaderStyle>
                               <Style TargetType="{x:Type DataGridColumnHeader}"
                                      BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                 <Setter Property="ToolTip"
                                         Value="Severity reported by the local detection event. It is not an independently verified impact assessment or incident priority."/>
                                 <Setter Property="AutomationProperties.HelpText"
                                         Value="Reported detection-event severity classification, not independently verified impact or incident priority."/>
                               </Style>
                             </DataGridTemplateColumn.HeaderStyle>
                           </DataGridTemplateColumn>
                          <DataGridTemplateColumn Header="SOURCE" Width="2*" MinWidth="178">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                <Border Background="#112D3E" BorderBrush="#315269" BorderThickness="1"
                                        CornerRadius="7" Padding="9,3" Margin="2,1,5,1">
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="3"/>
                                      <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#39B6D6" CornerRadius="2"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                      <TextBlock Text="REPORTED ORIGIN"
                                                 Foreground="#73D4EC"
                                                 FontSize="9" FontWeight="Bold"/>
                                      <TextBlock Text="{Binding Source}"
                                                 FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                                 Foreground="{StaticResource TextBrush}"
                                                 TextTrimming="CharacterEllipsis"
                                                 ToolTip="{Binding Source}"/>
                                    </StackPanel>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderStyle>
                              <Style TargetType="{x:Type DataGridColumnHeader}"
                                     BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ToolTip"
                                        Value="Source endpoint reported by the local detection event. Not a verified host identity or independently corroborated packet attribution."/>
                                <Setter Property="AutomationProperties.HelpText"
                                        Value="Reported detection-event source endpoint metadata; host identity and packet attribution are not independently verified here."/>
                              </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                          </DataGridTemplateColumn>
                          <DataGridTemplateColumn Header="DESTINATION" Width="2*" MinWidth="178">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                <Border Background="#112D3E" BorderBrush="#315269" BorderThickness="1"
                                        CornerRadius="7" Padding="9,3" Margin="2,1,5,1">
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="3"/>
                                      <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#2E998F" CornerRadius="2"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                      <TextBlock Text="REPORTED TARGET"
                                                 Foreground="#75CFC4"
                                                 FontSize="9" FontWeight="Bold"/>
                                      <TextBlock Text="{Binding Destination}"
                                                 FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                                 Foreground="{StaticResource TextBrush}"
                                                 TextTrimming="CharacterEllipsis"
                                                 ToolTip="{Binding Destination}"/>
                                    </StackPanel>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderStyle>
                              <Style TargetType="{x:Type DataGridColumnHeader}"
                                     BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ToolTip"
                                        Value="Destination endpoint reported by the local detection event. Not proof that the endpoint was reached or a connection succeeded."/>
                                <Setter Property="AutomationProperties.HelpText"
                                        Value="Reported detection-event destination endpoint metadata; endpoint reachability and successful connection are not established by this column."/>
                              </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                          </DataGridTemplateColumn>
                          <DataGridTextColumn Header="RULE" Binding="{Binding RuleId}" Width="96"
                                              ElementStyle="{StaticResource DashboardLiveMetadataCellText}">
                            <DataGridTextColumn.HeaderStyle>
                              <Style TargetType="{x:Type DataGridColumnHeader}"
                                     BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ToolTip"
                                        Value="Rule ID reported on the local detection event. This label does not verify rule evaluation quality or current rule enablement."/>
                                <Setter Property="AutomationProperties.HelpText"
                                        Value="Reported detection-event rule identifier only; not proof of rule accuracy, evaluation or current enablement."/>
                              </Style>
                            </DataGridTextColumn.HeaderStyle>
                          </DataGridTextColumn>
                          <DataGridTextColumn Header="PROTOCOL" Binding="{Binding Protocol}" Width="92"
                                              ElementStyle="{StaticResource DashboardLiveMetadataCellText}">
                            <DataGridTextColumn.HeaderStyle>
                              <Style TargetType="{x:Type DataGridColumnHeader}"
                                     BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ToolTip"
                                        Value="Protocol label supplied by the local detection event. This display does not independently verify packets or protocol decoding."/>
                                <Setter Property="AutomationProperties.HelpText"
                                        Value="Reported detection-event protocol metadata only; not independently verified packet inspection or protocol decoding."/>
                              </Style>
                            </DataGridTextColumn.HeaderStyle>
                          </DataGridTextColumn>
                          <DataGridTemplateColumn Header="EVIDENCE" Width="205" MinWidth="178">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                <Border Background="#122C3D" BorderBrush="#345168" BorderThickness="1"
                                        CornerRadius="7" Padding="8,3" Margin="2,1,4,1">
                                  <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="#93B9CB" CornerRadius="2" Margin="0,2,0,2"/>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                      <TextBlock Text="REPORTED EVIDENCE" FontSize="9" FontWeight="Bold" Foreground="#93B9CB"/>
                                      <TextBlock Text="{Binding EvidenceSummary}" FontSize="12" FontWeight="SemiBold"
                                                 Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                                                 ToolTip="{Binding EvidenceSummary}"/>
                                    </StackPanel>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderStyle>
                              <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ToolTip" Value="Reported evidence presence or structured-item count only. Raw evidence is not shown and chain of custody is not verified."/>
                                <Setter Property="AutomationProperties.HelpText" Value="Reported evidence presence or structured-item count only; not evidence payload or verified chain of custody."/>
                              </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                          </DataGridTemplateColumn>
                          <DataGridTemplateColumn Header="DELIVERY" Width="176" MinWidth="152">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                <Border Background="#102C34" BorderBrush="#2B5961" BorderThickness="1"
                                        CornerRadius="7" Padding="8,3" Margin="2,1,4,1">
                                  <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="#73C9BD" CornerRadius="2" Margin="0,2,0,2"/>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                      <TextBlock Text="TRANSPORT STATUS" FontSize="9" FontWeight="Bold" Foreground="#73C9BD"/>
                                      <TextBlock Text="{Binding DeliveryStatus}" FontSize="12" FontWeight="SemiBold"
                                                 Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                                                 ToolTip="{Binding DeliveryStatus}"/>
                                    </StackPanel>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderStyle>
                              <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ToolTip" Value="Recorded detection-event delivery status, not investigation progress, remediation or incident resolution."/>
                                <Setter Property="AutomationProperties.HelpText" Value="Detection-event delivery transport status only; not investigation or incident resolution."/>
                              </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                          </DataGridTemplateColumn>
                        </DataGrid.Columns>
                      </DataGrid>
                      <!-- GA UI-71: visually distinguish the existing source-driven empty/no-match message from event rows; no new data or state. -->
                      <Border Visibility="{Binding Visibility, ElementName=DashboardLiveEmptyText}"
                              IsHitTestVisible="False"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              MaxWidth="460"
                              Margin="12"
                              Padding="18,12"
                              Background="{StaticResource PillBgBrush}"
                              BorderBrush="{StaticResource SoftDividerBrush}"
                              BorderThickness="1"
                              CornerRadius="10">
                        <StackPanel>
                          <TextBlock Text="NO ROWS TO DISPLAY"
                                     Foreground="{StaticResource AccentBrush}"
                                     FontSize="10"
                                     FontWeight="SemiBold"
                                     TextAlignment="Center"
                                     Margin="0,0,0,5"/>
                          <TextBlock x:Name="DashboardLiveEmptyText"
                                     Text="No local detection events observed in this session."
                                     Foreground="{StaticResource TextSubtleBrush}"
                                     FontSize="12"
                                     TextAlignment="Center"
                                     TextWrapping="Wrap"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     MaxWidth="420"
                                     IsHitTestVisible="False"/>
                        </StackPanel>
                      </Border>
                          </Grid>
                        </Border>
                        <Border Grid.Row="2" Margin="4,12,4,0" Padding="10,8"
                                Background="#102A39" BorderBrush="#2B4E60"
                                BorderThickness="1" CornerRadius="8">
                          <TextBlock Text="RECORDED METADATA ONLY  ·  No raw payloads or verified capture-health claim"
                                     Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                     TextWrapping="Wrap"/>
                        </Border>
                      </Grid>
                    </Border>
                    <!-- GA UI-79: keep local event status and provenance together in a subdued, non-interactive footer. -->
                    <Border Grid.Row="3" Margin="0,14,0,0" Style="{StaticResource DashboardLiveEventsFooter}">
                      <StackPanel>
                        <TextBlock x:Name="DashboardLiveEventsStatusText"
                                   Text="Waiting for local detection events."
                                   AutomationProperties.LiveSetting="Off"
                                   Foreground="{StaticResource TextSubtleBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="DashboardLiveEventsProvenanceText"
                                   Text="Evidence column reports presence/count only; delivery is not incident resolution."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   Margin="0,3,0,0"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>

                
                <!-- GA UI-161: a proportioned, visual-only terminal companion. No executable CLI. -->
                <Border x:Name="DashboardCliCompanionPanel"
                        Grid.Row="0" Grid.Column="1"
                        Style="{StaticResource PageSurface}"
                        Background="#0A1928" BorderBrush="#2B4B60" BorderThickness="1"
                        CornerRadius="14" Padding="16" Margin="0"
                        MinHeight="560"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Carthago CLI companion, unavailable">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition x:Name="DashboardCliCapabilityRow" Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="TERMINAL COMPANION" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,0,5"/>
                        <TextBlock Text="Carthago CLI" Style="{StaticResource DashboardSectionTitle}"
                                   FontSize="19" FontWeight="Bold"/>
                      </StackPanel>
                      <Border Grid.Column="1" VerticalAlignment="Top" Margin="8,0,0,0"
                              Background="#24303E" BorderBrush="#455568" BorderThickness="1"
                              CornerRadius="6" Padding="9,5">
                        <TextBlock Text="UNAVAILABLE" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSubtleBrush}"/>
                      </Border>
                    </Grid>
                    <Border Grid.Row="1" Background="#06111D" BorderBrush="#25445B"
                            BorderThickness="1" CornerRadius="10" Margin="0,0,0,12">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#102639" CornerRadius="9,9,0,0"
                                Padding="11,9">
                          <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                              <Ellipse Width="7" Height="7" Fill="#526477" Margin="4,0"/>
                              <Ellipse Width="7" Height="7" Fill="#526477" Margin="4,0"/>
                              <Ellipse Width="7" Height="7" Fill="#526477" Margin="4,0"/>
                            </StackPanel>
                            <TextBlock Text="LOCAL CONSOLE / OFFLINE" FontSize="10"
                                       FontFamily="Consolas" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                          </DockPanel>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="14,20,14,22">
                          <TextBlock Text="&gt;_" FontFamily="Consolas" FontSize="26"
                                     FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                     Margin="0,0,0,14"/>
                          <TextBlock Text="No CLI session connected" FontFamily="Consolas"
                                     FontSize="13" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextSubtleBrush}"
                                     TextWrapping="Wrap"/>
                          <TextBlock Text="Command execution and terminal output are not implemented in this Windows GUI."
                                     FontFamily="Consolas" FontSize="11"
                                     Foreground="{StaticResource TextMutedBrush}"
                                     TextWrapping="Wrap" Margin="0,9,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border x:Name="DashboardCliCapabilityPanel" Grid.Row="2" Background="#0F2535" BorderBrush="#25445B"
                            BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PRESENTATION ONLY" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,12">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <Border Background="#47778A" CornerRadius="2"/>
                          <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="No command input" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSubtleBrush}"/>
                            <TextBlock Text="This panel cannot accept or run commands."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                          </StackPanel>
                        </Grid>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <Border Background="#47778A" CornerRadius="2"/>
                          <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="No terminal output" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSubtleBrush}"/>
                            <TextBlock Text="No session, process or simulated events are attached."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Border Grid.Row="3" BorderBrush="{StaticResource SoftDividerBrush}"
                            BorderThickness="0,1,0,0" Padding="0,12,0,0">
                      <TextBlock Text="Visual companion only  ·  not a live telemetry source"
                                 FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                 TextWrapping="Wrap"/>
                    </Border>
                  </Grid>
                </Border>
                </Grid>
                <Expander Header="Layout manager" IsExpanded="False" Visibility="Collapsed" Margin="0,0,0,18">
                  <Border Style="{StaticResource CommandBarSurface}" Padding="14">
                    <StackPanel>
                      <WrapPanel Margin="0,0,0,10">
                        <Button Content="Add widget" Width="118" Margin="0,0,8,6" Style="{StaticResource PrimaryButton}" Click="DashboardAddSelectedWidget_Click"/>
                        <Button Content="Open Settings" Width="130" Margin="0,0,8,6" Style="{StaticResource SecondaryButton}" Click="DashboardOpenSettings_Click"/>
                        <Button Content="Reset to empty" Width="130" Margin="0,0,8,6" Style="{StaticResource SecondaryButton}" Click="DashboardResetLayout_Click"/>
                      </WrapPanel>
                      <ItemsControl x:Name="DashboardWidgetItemsControl">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel IsItemsHost="True" Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource DashboardWidgetCard}"
                                    Width="260"
                                    MinHeight="130"
                                    Tag="{Binding Id}"
                                    AllowDrop="True"
                                    PreviewMouseLeftButtonDown="DashboardWidgetCard_MouseLeftButtonDown"
                                    MouseMove="DashboardWidgetCard_MouseMove"
                                    Drop="DashboardWidgetCard_Drop">
                              <StackPanel>
                                <DockPanel>
                                  <TextBlock Text="&#x2630;" DockPanel.Dock="Left" Style="{StaticResource DragHandle}" ToolTip="Drag to reorder"/>
                                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="&#x2190;" Width="28" Height="26" Style="{StaticResource MinimalIconButton}" Tag="{Binding Id}" ToolTip="Move left" Click="DashboardWidgetMoveLeft_Click"/>
                                    <Button Content="&#x2192;" Width="28" Height="26" Style="{StaticResource MinimalIconButton}" Tag="{Binding Id}" ToolTip="Move right" Click="DashboardWidgetMoveRight_Click" Margin="4,0,0,0"/>
                                    <Button Content="&#x00D7;" Width="28" Height="26" Style="{StaticResource MinimalIconButton}" Tag="{Binding Id}" ToolTip="Remove widget" Click="DashboardWidgetRemove_Click" Margin="4,0,0,0"/>
                                  </StackPanel>
                                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </Expander>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Grid>


        <!-- ===== Live Traffic (table) ===== -->
        <Grid x:Name="LiveTrafficView"
              Visibility="Collapsed">
          <Border Background="{StaticResource CardBgBrush}"
                  CornerRadius="18"
                  Padding="0"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  BorderThickness="1">
            <DataGrid x:Name="TrafficGrid"
                      AutoGenerateColumns="False"
                      MouseDoubleClick="TrafficGrid_MouseDoubleClick"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True">
              <DataGrid.Resources>
                <Style TargetType="DataGridCell"
                       BasedOn="{StaticResource {x:Type DataGridCell}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ReputationIsMalicious}"
                                 Value="True">
                      <Setter Property="Background"
                              Value="#4B0000"/>
                      <Setter Property="Foreground"
                              Value="White"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.Resources>

              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Blacklist for 10 minutes"
                            Click="Blacklist_10min_Click"/>
                  <MenuItem Header="Blacklist for 1 hour"
                            Click="Blacklist_1h_Click"/>
                  <MenuItem Header="Blacklist indefinitely"
                            Click="Blacklist_Indef_Click"/>
                  <Separator/>
                  <MenuItem Header="Check Reputation Now"
                            Click="LookupReputation_Click"/>
                  <Separator/>
                  <MenuItem Header="Investigate selected source IP"
                            Click="TrafficInvestigateSource_Click"/>
                  <MenuItem Header="Investigate selected destination IP"
                            Click="TrafficInvestigateDestination_Click"/>
                </ContextMenu>
              </DataGrid.ContextMenu>

              <!-- columns -->
              <DataGrid.Columns>
                <DataGridTextColumn Header="Timestamp"
                                    Binding="{Binding Timestamp, StringFormat={}{0:u}}"
                                    Width="150"/>
                <DataGridTextColumn Header="Source IP"
                                    Binding="{Binding Source}"
                                    Width="170"/>
                <DataGridTextColumn Header="Destination IP"
                                    Binding="{Binding Destination}"
                                    Width="170"/>
                <DataGridTextColumn Header="Protocol"
                                    Binding="{Binding Protocol}"
                                    Width="80"/>
                <DataGridTextColumn Header="IP Ver"
                                    Binding="{Binding IpVersion}"
                                    Width="70"/>
                <DataGridTextColumn Header="Length"
                                    Binding="{Binding Length}"
                                    Width="70"/>
                <DataGridTextColumn Header="L4 Len"
                                    Binding="{Binding L4Len}"
                                    Width="80"/>
                <DataGridTextColumn Header="Source Port"
                                    Binding="{Binding SourcePort}"
                                    Width="90"/>
                <DataGridTextColumn Header="Destination Port"
                                    Binding="{Binding DestinationPort}"
                                    Width="110"/>
                <DataGridTextColumn Header="Service"
                                    Binding="{Binding ApplicationService}"
                                    Width="120"/>
                <DataGridTextColumn Header="Protocol Version"
                                    Binding="{Binding ProtocolVersion}"
                                    Width="120"/>
                <DataGridTextColumn Header="ICMP t/c"
                                    Binding="{Binding IcmpTypeCode}"
                                    Width="100"/>
                <DataGridTextColumn Header="Flags"
                                    Binding="{Binding Flags}"
                                    Width="120"/>
                <DataGridTextColumn Header="TCP Flags (raw)"
                                    Binding="{Binding TcpFlags}"
                                    Width="110"/>
                <DataGridTextColumn Header="TTL"
                                    Binding="{Binding TTL}"
                                    Width="60"/>
                <DataGridTextColumn Header="MAC Source"
                                    Binding="{Binding MacSource}"
                                    Width="170"/>
                <DataGridTextColumn Header="MAC Destination"
                                    Binding="{Binding MacDestination}"
                                    Width="170"/>
                <DataGridTextColumn Header="Registrar"
                                    Binding="{Binding WhoisRegistrar}"
                                    Width="150"/>
                <DataGridTextColumn Header="Organization"
                                    Binding="{Binding WhoisOrganization}"
                                    Width="200"/>
                <DataGridTextColumn Header="Country"
                                    Binding="{Binding WhoisCountry}"
                                    Width="80"/>
                <DataGridTextColumn Header="Reputation Score"
                                    Binding="{Binding ReputationScore}"
                                    Width="120"/>
                <DataGridTextColumn Header="Malicious"
                                    Binding="{Binding ReputationIsMalicious}"
                                    Width="90"/>
                <DataGridTextColumn Header="Reports"
                                    Binding="{Binding ReputationReports}"
                                    Width="90"/>
                <DataGridTextColumn Header="Last Seen"
                                    Binding="{Binding ReputationLastSeen, StringFormat={}{0:u}}"
                                    Width="160"/>
                <DataGridTextColumn Header="VPN"
                                    Binding="{Binding IsVpn}"
                                    Width="60"/>
                <DataGridTextColumn Header="Proxy"
                                    Binding="{Binding IsProxy}"
                                    Width="60"/>
                <DataGridTextColumn Header="Network Type"
                                    Binding="{Binding NetworkType}"
                                    Width="120"/>
                <DataGridTextColumn Header="Process Name"
                                    Binding="{Binding ProcessName}"
                                    Width="180"/>
                <DataGridTextColumn Header="PID"
                                    Binding="{Binding ProcessId}"
                                    Width="80"/>

                <!-- QUIC metadata -->
                <DataGridTextColumn Header="QUIC ALPN"
                                    Binding="{Binding QuicAlpn}"
                                    Width="130"/>
                <DataGridTextColumn Header="QUIC CID"
                                    Binding="{Binding QuicConnectionIdHash}"
                                    Width="130"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>

