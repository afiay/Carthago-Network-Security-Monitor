                  <Separator/>
                  <MenuItem Header="Investigate selected source IP"
                            Click="DetectionInvestigateSource_Click"/>
                  <MenuItem Header="Investigate selected destination IP"
                            Click="DetectionInvestigateDestination_Click"/>
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time (UTC)"
                                    Binding="{Binding Timestamp, StringFormat={}{0:u}}"
