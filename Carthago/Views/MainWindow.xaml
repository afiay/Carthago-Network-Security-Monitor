<!-- File: Views/MainWindow.xaml -->
<Window x:Class="Carthago.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:views="clr-namespace:Carthago.Views"
        xmlns:controls="clr-namespace:Carthago.Controls"
        Title="Carthago AI Security Monitor"
        Height="900"
        Width="1440"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_SessionFileKeyDown"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

  <!-- Theme -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Views/Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <views:SeverityToBrushConverter x:Key="SeverityBrush"/>
      <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
      <ItemsPanelTemplate x:Key="DashboardKpiWidePanel">
        <UniformGrid IsItemsHost="True" Columns="5"/>
      </ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="DashboardKpiStandardPanel">
        <UniformGrid IsItemsHost="True" Columns="3"/>
      </ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="DashboardKpiCompactPanel">
        <UniformGrid IsItemsHost="True" Columns="2"/>
      </ItemsPanelTemplate>
      <!-- UI-07: preserve two-column Compact at 1024-1099; stack below 1024. -->
      <ItemsPanelTemplate x:Key="DashboardKpiNarrowPanel">
        <UniformGrid IsItemsHost="True" Columns="1"/>
      </ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="DashboardOverviewKpiWidePanel">
        <UniformGrid IsItemsHost="True" Columns="4"/>
      </ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="DashboardOverviewKpiStandardPanel">
        <UniformGrid IsItemsHost="True" Columns="2"/>
      </ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="DashboardOverviewKpiCompactPanel">
        <UniformGrid IsItemsHost="True" Columns="2"/>
      </ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="DashboardOverviewKpiNarrowPanel">
        <UniformGrid IsItemsHost="True" Columns="1"/>
      </ItemsPanelTemplate>
      <!-- GA UI-03: reusable card template for overview and preference metrics. -->
      <Style x:Key="DashboardKpiItemContainerStyle" TargetType="{x:Type ContentPresenter}">
                      <Setter Property="Margin" Value="0,0,10,10"/>
                    </Style>
      <!-- GA UI-46: preserve original endpoint-cell typography and spacing; expose full current text on hover. -->
      <Style x:Key="DashboardLiveEndpointCellText"
             TargetType="{x:Type TextBlock}"
             BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Margin" Value="2,0,2,0"/>
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      </Style>
      <!-- GA UI-50: reveal full current recorded text in the remaining narrow event-metadata cells without changing values. -->
      <Style x:Key="DashboardLiveMetadataCellText"
             TargetType="{x:Type TextBlock}"
             BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Margin" Value="2,0,2,0"/>
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      </Style>
      <!-- GA UI-47: source-accurate cell-level context for reported evidence and delivery status. -->
      <Style x:Key="DashboardLiveEvidenceCellText"
             TargetType="{x:Type TextBlock}"
             BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Margin" Value="2,0,2,0"/>
        <Setter Property="ToolTip" Value="Reported evidence presence or count only; no raw evidence or verified chain of custody is displayed."/>
        <Setter Property="AutomationProperties.HelpText" Value="This cell reports evidence presence or structured-item count only, not raw evidence or a verified chain of custody."/>
      </Style>
      <Style x:Key="DashboardLiveDeliveryCellText"
             TargetType="{x:Type TextBlock}"
             BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Margin" Value="2,0,2,0"/>
        <Setter Property="ToolTip" Value="Recorded detection-event delivery transport status, not investigation progress, remediation or incident resolution."/>
        <Setter Property="AutomationProperties.HelpText" Value="This cell reports detection-event delivery transport status only, not investigation progress, remediation or incident resolution."/>
      </Style>
      <DataTemplate x:Key="DashboardKpiCardTemplate">
                      <Border Style="{StaticResource DashboardOverviewKpiCard}" Height="132">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                          </Grid.RowDefinitions>
                          <Border Grid.RowSpan="3" Width="3" HorizontalAlignment="Left" Margin="-17,0,0,0"
                                  Background="{Binding AccentBrush}" CornerRadius="2" Opacity="0.9" IsHitTestVisible="False"/>

                          <DockPanel LastChildFill="True">
                            <!-- KPI card has no overflow command; use the existing information glyph. -->
                            <StackPanel Orientation="Horizontal">
                              <TextBlock x:Name="DashboardKpiCardTitle" Text="{Binding Title}" Style="{StaticResource MicroLabel}"/>
                              <!-- GA UI-36: informational glyph is keyboard-focusable; no command or menu is introduced. -->
                              <TextBlock Text="  &#x24D8;"
                                          Style="{StaticResource SocInfoGlyph}"
                                          Focusable="True"
                                          KeyboardNavigation.IsTabStop="True"
                                          FocusVisualStyle="{StaticResource KeyboardFocusVisual}"
                                          ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                                          ToolTip="{Binding InformationText}"
                                          AutomationProperties.Name="{Binding InformationAccessibilityName}"
                                          AutomationProperties.HelpText="{Binding InformationText}"/>
                            </StackPanel>
                          </DockPanel>

                          <Grid Grid.Row="1" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Value}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=DashboardKpiCardTitle}"
                                          AutomationProperties.HelpText="{Binding InformationText}"
                                         FontSize="27"
                                         FontWeight="Bold"/>
                              <TextBlock Text="{Binding DeltaText}"
                                         Foreground="{Binding AccentBrush}"
                                         FontSize="11"
                                         FontWeight="SemiBold"
                                         Margin="8,6,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="46"
                                    Height="46"
                                    CornerRadius="12"
                                    Background="#0B1728"
                                    BorderBrush="{Binding AccentBrush}"
                                    BorderThickness="1"
                                    Opacity="0.98">
                              <TextBlock Text="{Binding Icon}"
                                         FontSize="22"
                                         Foreground="{Binding AccentBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>
                          </Grid>

                          <TextBlock Grid.Row="2"
                                     Text="{Binding TrendText}"
                                     FontFamily="Consolas"
                                     Foreground="{Binding AccentBrush}"
                                     FontSize="12"
                                     Height="16"
                                     Opacity="0.95"
                                     TextWrapping="NoWrap"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip="{Binding TrendText}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>

  <!-- ======= LAYOUT: Sidebar + Main ======= -->
  <Grid x:Name="ApplicationShell" Background="{StaticResource AppBackdropGradient}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="216"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <views:Sidebar x:Name="SidebarPanel"
                   Grid.Column="0"
                   Panel.ZIndex="10"/>

    <!-- ===== Main Area ===== -->
    <Grid x:Name="MainContentHost"
          Grid.Column="1"
          Margin="18,0,18,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Native session files and analytical workbook export; deliberately outside the capture hot path. -->
      <DockPanel Grid.Row="0" Margin="0,8,0,12" LastChildFill="True">
      <Menu DockPanel.Dock="Left"
            Padding="8,4"
            Background="#0B2034"
            Foreground="#E6EEF8"
            BorderBrush="#274D62"
            BorderThickness="1"
            FontSize="12"
            AutomationProperties.Name="Carthago application menu">
        <MenuItem Header="_File">
          <MenuItem Header="_Open Session..." InputGestureText="Ctrl+O" Click="FileOpen_Click"/>
          <Separator/>
          <MenuItem Header="_Save Session" InputGestureText="Ctrl+S" Click="FileSave_Click"/>
          <MenuItem Header="Save Session _As..." InputGestureText="Ctrl+Shift+S" Click="FileSaveAs_Click"/>
          <Separator/>
          <MenuItem Header="Export to _Excel..." Click="FileExportExcel_Click"/>
        </MenuItem>
      </Menu>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock Text="Investigate" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                   Margin="0,0,8,0" FontSize="11"/>
        <TextBox x:Name="GlobalInvestigationSearchText" Width="180" Height="32" MaxLength="256"
                 Style="{StaticResource SearchBox}" KeyDown="GlobalInvestigationSearch_KeyDown"
                 ToolTip="Search retained metadata by exact IP, port:443, domain, rule ID, event/flow ID or recorded text"
                 AutomationProperties.Name="Global retained-evidence search"/>
        <Button Content="Find" MinWidth="66" Height="32" Margin="7,0,0,0"
                Style="{StaticResource SecondaryButton}" Click="GlobalInvestigationSearch_Click"
                AutomationProperties.Name="Investigate retained evidence"/>
      </StackPanel>
      </DockPanel>

      <!-- ===== Header bar ===== -->
      <Border x:Name="CommandHeader"
              Grid.Row="1"
              Style="{StaticResource TopCommandSurface}"
              Margin="0,0,0,18"
              Padding="18,16,18,16"
              BorderBrush="#285269"
              BorderThickness="1"
              CornerRadius="14"
              MinHeight="110">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#112D44" Offset="0"/>
            <GradientStop Color="#0A1B2B" Offset="0.57"/>
            <GradientStop Color="#12383F" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid x:Name="CommandHeaderGrid">
          <Grid.RowDefinitions>
            <RowDefinition x:Name="CommandHeaderPrimaryRow" Height="Auto"/>
            <RowDefinition x:Name="CommandHeaderSecondaryRow" Height="0"/>
            <RowDefinition x:Name="CommandHeaderTertiaryRow" Height="0"/>
            <RowDefinition x:Name="CommandHeaderQuaternaryRow" Height="0"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="CommandHeaderStatusColumn" Width="250"/>
            <ColumnDefinition x:Name="CommandHeaderSourceColumn" Width="290"/>
            <ColumnDefinition x:Name="CommandHeaderAnalysisColumn" Width="210"/>
            <ColumnDefinition x:Name="CommandHeaderActionsColumn" Width="*"/>
          </Grid.ColumnDefinitions>

          <Border x:Name="CommandHeaderStatusGroup"
                  Grid.Column="0"
                  Background="#10273B"
                  CornerRadius="10"
                  BorderBrush="#2B5267"
                  BorderThickness="1"
                  Padding="12,10"
                  Margin="0,0,12,0">
            <WrapPanel VerticalAlignment="Center">
              <Border x:Name="MonitoringStatusBadge"
                      Style="{StaticResource Pill}"
                      Background="{StaticResource StatusMonitoringBgBrush}"
                      BorderBrush="{StaticResource StatusMonitoringBorderBrush}"
                      CornerRadius="10"
                      Padding="12,5"
                      Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="9" Height="9" Fill="{Binding BorderBrush, ElementName=MonitoringStatusBadge}" Margin="0,0,7,0"/>
                  <TextBlock x:Name="CaptureStatusText" Text="Paused" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
              </Border>
              <Border x:Name="AnomalyModeBadge"
                      Style="{StaticResource Pill}"
                      Background="{StaticResource PillAccentBgBrush}"
                      CornerRadius="10"
                      Padding="12,5">
                <!-- GA UI-62: the badge reflects the presentation preference, not capture or detection health. -->
                <TextBlock x:Name="AnomalyModeText"
                           Text="Anomalies only"
                           ToolTip="Current dashboard presentation preference: Anomalies only or Expanded telemetry. Not a capture, sensor-health or detection-accuracy indicator."
                           AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                           AutomationProperties.HelpText="Current ShowAnomaliesOnly dashboard preference: Anomalies only or Expanded telemetry. Not proof of active capture, sensor health or verified detection."
                           FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentAltBrush}"/>
              </Border>
            </WrapPanel>
          </Border>

          <Border x:Name="CommandHeaderSourceGroup"
                  Grid.Column="1"
                  Background="#10273B"
                  CornerRadius="10"
                  BorderBrush="#2B5267"
                  BorderThickness="1"
                  Padding="12,10"
                  Margin="0,0,12,0">
            <Grid VerticalAlignment="Center">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                  <Button x:Name="AddLanCaptureTargetButton"
                          Content="Add IP" Click="AddLanCaptureTarget_Click"
                          Height="24" Padding="6,1" Margin="0,0,5,0"
                          Style="{StaticResource SecondaryButton}"
                          ToolTip="Add a known local IPv4 address even when a sleeping phone does not answer discovery."/>
                  <Button x:Name="DiscoverLanCaptureButton"
                          Content="Scan LAN" Click="DiscoverLanCapture_Click"
                          Height="24" Padding="6,1"
                          Style="{StaticResource SecondaryButton}"
                          ToolTip="Find local IPv4 peers and add visible-to-this-PC host filters. Discovery does not turn a phone into a remote capture source. Capture must be stopped."/>
                </StackPanel>
                <TextBlock x:Name="HeaderCaptureSourceLabel" Text="Capture source / host filter"
                           VerticalAlignment="Center" Style="{StaticResource MicroLabel}"/>
              </DockPanel>
              <ComboBox x:Name="DeviceComboBox"
                        Grid.Row="1"
                        MinWidth="120"
                        MaxWidth="320"
                        Height="32"
                        HorizontalAlignment="Stretch"
                        Margin="0,5,0,0"
                        Background="{StaticResource InputBgBrush}"
                        Foreground="{StaticResource TextBrush}"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        TextElement.Foreground="{StaticResource TextBrush}"
                        ToolTip="Choose a local capture source or a discovered host filter. A host filter shows only traffic that reaches this PC; it is not a remote sensor."
                        AutomationProperties.LabeledBy="{Binding ElementName=HeaderCaptureSourceLabel}"
                        AutomationProperties.HelpText="Choose a local capture device or host filter, then use Start Monitoring. LAN host filters can show only packets already visible to this PC.">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock x:Name="HeaderCaptureSourceText" Visibility="Collapsed" Text="Source: waiting for selection"/>
            </Grid>
          </Border>

          <Border x:Name="CommandHeaderAnalysisGroup"
                  Grid.Column="2"
                  Background="#10273B"
                  CornerRadius="10"
                  BorderBrush="#2B5267"
                  BorderThickness="1"
                  Padding="12,10"
                  Margin="0,0,12,0">
            <Grid VerticalAlignment="Center">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock x:Name="HeaderLastAnalysisLabel" Text="Last analysis" Style="{StaticResource MicroLabel}"/>
              <TextBlock x:Name="HeaderLastAnalysisText"
                         Grid.Row="1"
                         Text="Waiting for traffic"
                         Foreground="{StaticResource TextSubtleBrush}"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Margin="0,5,0,0"
                         AutomationProperties.LabeledBy="{Binding ElementName=HeaderLastAnalysisLabel}"
                         AutomationProperties.HelpText="Last recorded local analysis time or existing capture and flow diagnostic. A recorded timestamp does not prove active capture, current traffic or healthy event delivery."
                         AutomationProperties.LiveSetting="Off"/>
            </Grid>
          </Border>

          <Border x:Name="CommandHeaderActionsSurface" Grid.Column="3"
                  Background="#10273B" BorderBrush="#2B5267" BorderThickness="1"
                  CornerRadius="10" Padding="12,10">
          <StackPanel x:Name="CommandHeaderActionsGroup" VerticalAlignment="Center" HorizontalAlignment="Stretch">
            <WrapPanel HorizontalAlignment="Right">
              <Button x:Name="StartButton" Content="&#x25B6;  Start Monitoring" Width="164" Height="42" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" Click="StartButton_Click"/>
              <Button x:Name="StopButton" Content="&#x23F8;  Pause Monitoring" Width="148" Height="42" Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Click="StopButton_Click" IsEnabled="False" Visibility="Collapsed"/>
              <Button x:Name="TestRepButton" Content="Test Reputation" Width="132" Height="42" Style="{StaticResource SecondaryButton}" Click="TestReputation_Click" Margin="0,0,8,8"/>
              <!-- GA UI-28: the ellipsis has no connected menu, command or click handler. -->
              <Button Content="&#x22EE;"
                      Width="40" Height="42"
                      Style="{StaticResource SecondaryButton}"
                      IsEnabled="False"
                      ToolTipService.ShowOnDisabled="True"
                      ToolTip="Additional dashboard actions are unavailable in this view."
                      AutomationProperties.Name="More dashboard actions unavailable"
                      AutomationProperties.HelpText="No additional dashboard actions menu is implemented here. Use the available visible controls."
                      Margin="0,0,0,8"/>
            </WrapPanel>
            <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
              <CheckBox x:Name="AnomaliesOnlyToggle"
                        Content="Show anomalies only"
                        VerticalAlignment="Center"
                        ToolTip="Changes the existing anomaly-first dashboard presentation preference. The header badge shows Anomalies only or Expanded telemetry; this does not start or stop capture."
                        ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                        AutomationProperties.HelpText="Changes the existing ShowAnomaliesOnly dashboard preference; the header badge reflects the selected setting. Not a capture or detection-quality control."
                        Checked="AnomaliesOnlyToggle_Changed"
                        Unchecked="AnomaliesOnlyToggle_Changed"/>
              <Button Content="Customize" Width="104" Height="30"
                      Style="{StaticResource SecondaryButton}"
                      Click="DashboardOpenSettings_Click"
                      ToolTip="Opens the existing System Settings view. Navigation only; this does not edit the dashboard layout or start capture."
                      ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                      AutomationProperties.Name="Open System Settings"
                      AutomationProperties.HelpText="Navigates to the existing Settings view, selects System Settings in the sidebar, and hides sidebar filters. Does not change dashboard layout or activate capture."
                      Margin="12,0,0,0"/>
            </WrapPanel>
          </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- ===== Content views ===== -->
      <Grid Grid.Row="2">

        <!-- ===== Legacy analytics infrastructure =====
             Legacy protocol and spark plots remain hidden for existing update paths.
             The original TrafficPlot is now visible in the Security Overview.
             MainWindow.Core.cs and MainWindow.Plots.cs continue to update it. -->
        <Grid x:Name="DashboardLegacyInfrastructure"
              Visibility="Collapsed"
              IsHitTestVisible="False"
              Width="1"
              Height="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock x:Name="PpsValueText"/>
            <TextBlock x:Name="ThroughputValueText"/>
            <TextBlock x:Name="ActiveHostsText"/>
            <TextBlock x:Name="ActiveConnsText"/>
            <TextBlock x:Name="TopProcessText"/>
            <TextBlock x:Name="Alerts60sText"/>
          </StackPanel>
          <StackPanel Grid.Row="1">

            <ScottPlot:WpfPlot x:Name="ProtocolPlot"/>
            <ScottPlot:WpfPlot x:Name="TopTalkersPlot"/>
            <ScottPlot:WpfPlot x:Name="SeverityPlot"/>
            <ScottPlot:WpfPlot x:Name="PpsSpark"/>
            <ScottPlot:WpfPlot x:Name="ThroughputSpark"/>
          </StackPanel>
        </Grid>

        <!-- ===== Dashboard ===== -->
        <Grid x:Name="DashboardView" Visibility="Visible">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0"
                  Visibility="Collapsed"
                  Style="{StaticResource CommandBarSurface}"
                  Padding="12"
                  Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Security workspace"
                           Style="{StaticResource SectionHeader}"
                           FontSize="16"
                           VerticalAlignment="Center"/>
                <Border Style="{StaticResource Pill}"
                        Margin="14,0,0,0"
                        Background="#0B2035"
                        BorderBrush="#214465">
                  <TextBlock Text="Minimal &#x2022; anomaly-first &#x2022; settings-driven"
                             FontSize="11"
                             Foreground="{StaticResource TextSubtleBrush}"/>
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Use recommended layout"
                        Width="180"
                        Height="32"
                        Style="{StaticResource SecondaryButton}"
                        Click="DashboardUseRecommendedLayout_Click"/>
                <Button Content="Settings"
                        Width="92"
                        Height="32"
                        Style="{StaticResource SecondaryButton}"
                        Click="DashboardOpenSettings_Click"
                        Margin="8,0,0,0"/>
              </StackPanel>

              <!-- Hidden picker state used by the existing dashboard preference pipeline and empty-state actions. -->
              <Grid Visibility="Collapsed">
                <ComboBox x:Name="DashboardWidgetPickerCombo" DisplayMemberPath="DisplayName"/>
                <ComboBox x:Name="DashboardMetricPickerCombo" DisplayMemberPath="DisplayName"/>
              </Grid>
            </Grid>
          </Border>

          <ScrollViewer x:Name="DashboardScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <Grid Width="{Binding ViewportWidth, ElementName=DashboardScrollViewer}">
              <Border x:Name="DashboardEmptyStateCard"
                      Style="{StaticResource EmptyDashboardCard}"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Margin="0,52,0,0"
                      MaxWidth="720">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="Your dashboard is empty"
                             FontSize="28"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="Enable a recommended SOC layout or add widgets from Settings. Raw telemetry remains available in Advanced / Forensics."
                             Foreground="{StaticResource TextSubtleBrush}"
                             FontSize="14"
                             Margin="0,8,0,0"
                             TextAlignment="Center"
                             TextWrapping="Wrap"/>
                  <WrapPanel HorizontalAlignment="Center" Margin="0,22,0,0">
                    <Button Content="Add widget"
                            Width="120"
                            Style="{StaticResource PrimaryButton}"
                            Click="DashboardAddSelectedWidget_Click"
                            Margin="0,0,8,6"/>
                    <Button Content="Open Settings"
                            Width="130"
                            Style="{StaticResource SecondaryButton}"
                            Click="DashboardOpenSettings_Click"
                            Margin="0,0,8,6"/>
                    <Button Content="Use recommended layout"
                            Width="190"
                            Style="{StaticResource SecondaryButton}"
                            Click="DashboardUseRecommendedLayout_Click"
                            Margin="0,0,8,6"/>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <StackPanel x:Name="SocDashboardWorkspace" Visibility="Collapsed" Margin="0,0,0,4">
                <!-- GA UI-90: reference-led operations hero, grounded in existing capture status. -->
                <Border Style="{StaticResource DashboardHeroCard}" Margin="0,0,0,16">
                  <Grid x:Name="DashboardHeroGrid">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,16,0">
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="26" Height="3" Background="{StaticResource AccentBrush}" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock Text="CARTHAGO  /  LOCAL SECURITY OPERATIONS"
                                   Foreground="{StaticResource AccentAltBrush}"
                                   FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock Text="Security Overview"
                                 FontSize="30" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextBrush}"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="Local packet-rate history, prioritized signals and investigation context."
                                 Foreground="{StaticResource TextSubtleBrush}"
                                 FontSize="12" TextWrapping="Wrap"
                                 Margin="0,7,0,0" MaxWidth="650"/>
                    </StackPanel>
                    <Border x:Name="DashboardHeroStatusCard"
                            Grid.Row="0" Grid.Column="1"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="{StaticResource PillBgBrush}"
                            BorderBrush="{StaticResource SoftDividerBrush}"
                            BorderThickness="1" CornerRadius="11"
                            Padding="14,10" MinWidth="154">
                      <StackPanel>
                        <TextBlock Text="LOCAL CAPTURE STATE"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                          <Ellipse Width="9" Height="9"
                                   Fill="{Binding BorderBrush, ElementName=MonitoringStatusBadge}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                          <TextBlock Text="{Binding Text, ElementName=CaptureStatusText}"
                                     Foreground="{Binding BorderBrush, ElementName=MonitoringStatusBadge}"
                                     FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="Health details" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Height="29" MinWidth="116" Margin="0,9,0,0"
                                Click="DashboardOpenMonitoringHealth_Click"
                                AutomationProperties.Name="Open Monitoring Health details"/>
                        <Button Content="Rule coverage" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Height="29" MinWidth="116" Margin="0,7,0,0"
                                Click="DashboardOpenDetectionCoverage_Click"
                                AutomationProperties.Name="Open Detection Coverage Center"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>
                <!-- GA UI-03: screenshot-aligned four-card operational strip.
                     Unavailable sensor and coverage contracts are never substituted with invented counts. -->
                <ItemsControl x:Name="DashboardOverviewKpiItemsControl"
                              AutomationProperties.Name="Security overview metric cards"
                              Margin="0,0,0,8"
                              HorizontalContentAlignment="Stretch"
                              ItemTemplate="{StaticResource DashboardKpiCardTemplate}"
                              ItemContainerStyle="{StaticResource DashboardKpiItemContainerStyle}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid IsItemsHost="True" Columns="4"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <!-- GA UI-90: reference-aligned three-panel operational composition at Wide.
                     Standard and Compact stack chart before triage through the existing responsive partial. -->
                <Grid x:Name="DashboardFocusGrid" Height="540" Margin="0,0,0,18">
                  <Grid.RowDefinitions>
                    <RowDefinition x:Name="DashboardFocusPrimaryRow" Height="*"/>
                    <RowDefinition x:Name="DashboardFocusSecondaryRow" Height="0"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DashboardFocusTrafficColumn" Width="2.35*"/>
                    <ColumnDefinition x:Name="DashboardFocusTriageColumn" Width="2.05*"/>
                  </Grid.ColumnDefinitions>
                <!-- GA UI-08: existing local PPS ScottPlot, moved from collapsed legacy infrastructure. -->
                <Border x:Name="DashboardTrafficChartPanel"
                        Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource DashboardFocusPanel}"
                        Padding="18"
                        Margin="0,0,16,0"
                        AutomationProperties.Name="Local packet-rate history chart">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="01  /  LIVE TRAFFIC" Style="{StaticResource MicroLabel}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,7"/>
                        <TextBlock Text="Network Traffic (Local PPS)"
                                   FontSize="20" FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Local capture samples, rolling 120-second window"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel x:Name="DashboardTrafficChartCaptureStatus"
                                  Grid.Column="1"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Margin="12,0,0,0">
                        <Ellipse Width="8" Height="8"
                                 Fill="{Binding BorderBrush, ElementName=MonitoringStatusBadge}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"/>
                        <!-- GA UI-61: clarify the chart's local capture/flow status without claiming packet reception. -->
                        <TextBlock Text="{Binding Text, ElementName=CaptureStatusText}"
                                   ToolTip="Current local capture/flow status from the monitoring header (Monitoring, Paused, Degraded, Error or Offline). Monitoring does not prove packet flow; local PPS timer samples can be zero without active capture."
                                   AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   AutomationProperties.HelpText="Current local capture/flow projection for the PPS chart, not verified packet reception, sensor health or network-wide traffic. Monitoring is not proof of observed packets; timer zeros can occur without active capture."
                                   Foreground="{Binding BorderBrush, ElementName=MonitoringStatusBadge}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                      </StackPanel>
                    </Grid>
                    <ScottPlot:WpfPlot x:Name="TrafficPlot"
                                      Grid.Row="1"
                                      Height="240"
                                      MinHeight="180"
                                      AutomationProperties.Name="Local packets per second history"
                                      AutomationProperties.HelpText="Local timer PPS and ten-sample moving average only; not inbound/outbound Mbps or proof of active capture. The current local timer summary is available as item status."
                                      AutomationProperties.ItemStatus="{Binding Text, ElementName=DashboardTrafficChartTextSummary}"
                                      AutomationProperties.LiveSetting="Off"/>
                    <!-- GA UI-10: truthful waiting state; no additional telemetry. -->
                    <Border x:Name="DashboardTrafficChartWaitingPanel"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#E60B1220"
                            BorderBrush="{StaticResource SoftDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            IsHitTestVisible="False"
                            Visibility="Visible">
                      <TextBlock Text="Waiting for local PPS timer samples (two ticks required to draw)."
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 TextAlignment="Center"
                                 MaxWidth="340"/>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                      <!-- GA UI-82: source-accurate plot key, matching the existing ScottPlot series; no new telemetry. -->
                      <WrapPanel Margin="0,0,0,6"
                                 AutomationProperties.Name="Local PPS plot series key"
                                 AutomationProperties.HelpText="Cyan solid line shows local timer packets per second. Amber dashed line is the ten-sample moving average, drawn once eleven timer samples provide a visible line segment. Neither line proves active capture or network-wide traffic.">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                          <Line X1="0" Y1="5" X2="24" Y2="5" Width="26" Height="10"
                                Stroke="#31D4E7" StrokeThickness="2" VerticalAlignment="Center" IsHitTestVisible="False"/>
                          <TextBlock Text="Local PPS · solid cyan" FontSize="11"
                                     Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                          <Line X1="0" Y1="5" X2="24" Y2="5" Width="26" Height="10"
                                Stroke="#F4B860" StrokeThickness="2" StrokeDashArray="3,2"
                                VerticalAlignment="Center" IsHitTestVisible="False"/>
                          <TextBlock Text="10-sample average · dashed amber (11+ samples)" FontSize="11"
                                     Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                      </WrapPanel>
                       <TextBlock x:Name="DashboardChartRefreshCountdownText"
                                  Text="Charts refresh in 3s"
                                  Foreground="{StaticResource TextMutedBrush}"
                                  FontSize="11"
                                  FontWeight="SemiBold"
                                  AutomationProperties.Name="Seconds until the next chart redraw"
                                  Margin="0,0,0,4"/>
                       <TextBlock x:Name="DashboardTrafficChartTextSummary"
                                  Text="Waiting for local PPS timer samples; no packet-rate observation is available yet."
                                  Foreground="{StaticResource TextMutedBrush}"
                                  FontSize="11"
                                  TextWrapping="Wrap"
                                  AutomationProperties.LiveSetting="Off"
                                  Margin="0,0,0,4"/>
                      <TextBlock Text="PPS and 10-sample average only; no inbound/outbound or Mbps series are available here."
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontSize="11"
                                 TextWrapping="Wrap"/>
                      <TextBlock Text="Capture not fully active: retained history and timer-generated zeros may not reflect new observations."
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontSize="11"
                                 Margin="0,4,0,0"
                                 TextWrapping="Wrap">
                        <TextBlock.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Text, ElementName=CaptureStatusText}" Value="MONITORING">
                                <Setter Property="Visibility" Value="Collapsed"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                </Border>
                <!-- Main triage area -->
                <Grid x:Name="DashboardTriageGrid" Grid.Row="0" Grid.Column="1" Height="660" Margin="0">
                  <Grid.RowDefinitions>
                    <RowDefinition x:Name="DashboardTriagePrimaryRow" Height="*"/>
                    <RowDefinition x:Name="DashboardTriageSecondaryRow" Height="0"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DashboardTriageTimelineColumn" Width="1.4*"/>
                    <ColumnDefinition x:Name="DashboardTriageDetailColumn" Width="1.6*"/>
                  </Grid.ColumnDefinitions>

                  <Border x:Name="DashboardTimelinePanel"
                          Grid.Column="0"
                          Style="{StaticResource DashboardFocusPanel}"
                          BorderBrush="{StaticResource AccentBrush}"
                          BorderThickness="2,1,1,1"
                          Padding="20"
                          Margin="0,0,16,0">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <StackPanel>
                        <TextBlock Text="02  /  PRIORITY QUEUE" Style="{StaticResource MicroLabel}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,7"/>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Recent High-Priority Incidents" Style="{StaticResource DashboardSectionTitle}"/>
                          <TextBlock Text="  &#x24D8;" Style="{StaticResource SocInfoGlyph}" VerticalAlignment="Center"
                                     Focusable="True"
                                     KeyboardNavigation.IsTabStop="True"
                                     FocusVisualStyle="{StaticResource KeyboardFocusVisual}"
                                     ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                                     ToolTip="Local snapshot: unresolved correlated incidents are prioritized before anomaly signals. Risk scores are local ranking estimates, not detection confidence or verified impact."
                                     AutomationProperties.Name="About prioritized incidents"
                                     AutomationProperties.HelpText="The queue prioritizes unresolved correlated incidents and then anomaly signals. Risk scores are local estimates, not detection confidence or verified impact."/>
                        </StackPanel>
                        <TextBlock Text="Prioritized local findings · select a card to inspect its context."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                      </StackPanel>

                      <!-- Static source-only queue: no nonfunctional filter or search affordances. -->
                      <TextBlock Grid.Row="1" Margin="0,9,0,8"
                                 Text="LOCAL SNAPSHOT  ·  INCIDENTS BY RISK, THEN SIGNALS"
                                 Style="{StaticResource MicroLabel}"
                                 TextWrapping="Wrap"/>

                      <ListBox x:Name="DashboardAnomalyList"
                               Grid.Row="2"
                               AutomationProperties.Name="Prioritized local incidents and anomaly signals"
                               AutomationProperties.HelpText="Use arrow keys to select an item and update Incident Investigation. The current bounded local queue summary is available as item status. Local risk scores are not detection confidence."
                               AutomationProperties.ItemStatus="{Binding Text, ElementName=DashboardAnomalyFooterText}"
                               AutomationProperties.LiveSetting="Off"
                               SelectionChanged="DashboardAnomalyList_SelectionChanged"
                               ScrollViewer.VerticalScrollBarVisibility="Auto"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                               BorderThickness="0"
                               Padding="0"
                               Background="Transparent"
                               ClipToBounds="True"
                               HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                          <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibilityLabel}"/>
                            <!-- GA UI-51: explain local-clock queue time without a new focus stop or selection change. -->
                            <Setter Property="AutomationProperties.HelpText" Value="The row time is local HH:mm:ss without a date. Correlated incidents show last update; anomaly signals show creation. This is not a packet-capture or event-delivery timestamp."/>
                            <Setter Property="Template">
                              <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                  <Border x:Name="ItemShell" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="10" Padding="0">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                  </Border>
                                  <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                      <Setter TargetName="ItemShell" Property="Opacity" Value="0.96"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                      <Setter TargetName="ItemShell" Property="Opacity" Value="1"/>
                                      <Setter TargetName="ItemShell" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                      <Setter TargetName="ItemShell" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                  </ControlTemplate.Triggers>
                                </ControlTemplate>
                              </Setter.Value>
                            </Setter>
                          </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <!-- GA UI-138: two-tier triage cards keep priority, title and context legible at narrow queue widths. -->
                            <!-- GA UI-142: severity-rail triage cards with a stable three-tier reading order. -->
                            <Border x:Name="TriageRowCard" Style="{StaticResource SocTimelineItem}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    MinHeight="104"
                                    Margin="0,0,0,9"
                                    Padding="0"
                                    ClipToBounds="True">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="6"/>
                                  <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{Binding AccentBrush}" CornerRadius="3,0,0,3"/>
                                <Grid Grid.Column="1" Margin="16,13,15,12">
                                  <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                  </Grid.RowDefinitions>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                  </Grid.ColumnDefinitions>
                                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource RiskBadge}" BorderBrush="{Binding AccentBrush}"
                                            Background="#0B1728" Margin="0,0,9,0">
                                      <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="Bold"
                                                 Foreground="{Binding AccentBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSubtleBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                  </StackPanel>
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                              Margin="10,0,0,0">
                                    <TextBlock Text="{Binding RiskScore}" FontSize="22" FontWeight="Bold"
                                               Foreground="{Binding AccentBrush}"
                                               ToolTip="Local risk score (0–100); not detection confidence"/>
                                    <TextBlock Text="/100" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Bottom" Margin="3,0,0,3"/>
                                  </StackPanel>
                                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                             Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"
                                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                             Margin="0,10,0,8" ToolTip="{Binding Title}"/>
                                  <Border Grid.Row="2" Grid.ColumnSpan="2"
                                          BorderBrush="{StaticResource SoftDividerBrush}"
                                          BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                    <Grid>
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                      </Grid.ColumnDefinitions>
                                      <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                                 Foreground="{StaticResource TextMutedBrush}"
                                                 TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                 ToolTip="{Binding Subtitle}" Margin="0,0,10,0"/>
                                      <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="10"
                                                 Foreground="{StaticResource TextMutedBrush}"
                                                 ToolTip="Local HH:mm:ss. Incidents: last update; signals: creation. Not a capture timestamp."/>
                                    </Grid>
                                  </Border>
                                </Grid>
                              </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                              <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                <Setter TargetName="TriageRowCard" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                <Setter TargetName="TriageRowCard" Property="Background" Value="{StaticResource SelectionBgBrush}"/>
                                <Setter TargetName="TriageRowCard" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="TriageRowCard" Property="BorderThickness" Value="2"/>
                              </DataTrigger>
                            </DataTemplate.Triggers>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>

                      <TextBlock x:Name="DashboardAnomalyFooterText"
                                 Grid.Row="3"
                                 Text="Showing recent anomaly signals"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                  ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                  Margin="0,6,0,0"/>
                    </Grid>
                  </Border>

                  <Border x:Name="DashboardSignalPanel"
                          Grid.Column="1"
                          Style="{StaticResource DashboardFocusPanel}"
                          BorderBrush="{StaticResource AccentBrush}"
                          BorderThickness="2,1,1,1"
                          Padding="22">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                      </Grid.RowDefinitions>

                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="03  /  SELECTED FINDING" Style="{StaticResource MicroLabel}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,7"/>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Incident Investigation" Style="{StaticResource DashboardSectionTitle}"/>
                            <TextBlock Text="  &#x24D8;" Style="{StaticResource SocInfoGlyph}" VerticalAlignment="Center"
                                       Focusable="True"
                                       KeyboardNavigation.IsTabStop="True"
                                       FocusVisualStyle="{StaticResource KeyboardFocusVisual}"
                                       ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                                       ToolTip="Investigation displays the currently selected correlated incident or anomaly signal. Its local risk score is not detection confidence, verified impact or proof of capture health."
                                       AutomationProperties.Name="About incident investigation"
                                       AutomationProperties.HelpText="Details reflect the selected local incident or anomaly signal. Risk is an estimate, not detection confidence, verified impact or proof of capture health."/>
                          </StackPanel>
                          <TextBlock Text="Selected correlated incident or anomaly signal; risk is not a confidence claim."
                                     Foreground="{StaticResource TextMutedBrush}"
                                     FontSize="12"
                                     TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                          <TextBlock Text="RISK SCORE" Style="{StaticResource MicroLabel}" HorizontalAlignment="Right"/>
                          <Border x:Name="DashboardDetailRiskRing" Width="92" Height="92" CornerRadius="46" BorderThickness="6" BorderBrush="{StaticResource WarnBrush}" Margin="0,4,0,0"
                                  ToolTip="Local risk score unavailable; baseline learning is not proof of capture health.">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                              <TextBlock x:Name="DashboardDetailRiskText" Text="&#x2014;" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"
                                         AutomationProperties.Name="Local risk score unavailable"
                                         AutomationProperties.HelpText="Local risk scores are estimates, not detection confidence or verified accuracy."/>
                              <TextBlock x:Name="DashboardDetailRiskBadgeText" Text="Learning" Foreground="{StaticResource WarnBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                          </Border>
                          <Button x:Name="DashboardOpenSignalDetailButton"
                                  Content="Full detail"
                                  ToolTip="Opens the existing Signal Investigation dialog for the current local incident or anomaly context. Opening it does not start capture or verify evidence."
                                  ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                                  AutomationProperties.Name="Open signal investigation detail"
                                  AutomationProperties.HelpText="Opens a modal detail view of the current local incident or anomaly context. The dialog can copy a summary or offer navigation to incident or anomaly views; opening it does not capture traffic, export raw evidence or remediate."
                                  Width="94"
                                  Height="28"
                                  HorizontalAlignment="Right"
                                  Margin="0,10,0,0"
                                  Style="{StaticResource SecondaryButton}"
                                  Visibility="Collapsed"
                                  Click="DashboardOpenSignalDetail_Click"/>
                        </StackPanel>
                      </Grid>

                      <Border x:Name="DashboardDetailSeverityStripe" Grid.Row="1" Margin="0,14,0,16" Background="{StaticResource CardElevatedBg}" BorderBrush="{StaticResource WarnBrush}" BorderThickness="6,1,1,1" CornerRadius="12" Padding="22,18,20,18">
                        <StackPanel>
                          <TextBlock x:Name="DashboardDetailTitleText" Text="No selected signal" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="54" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                          <TextBlock x:Name="DashboardDetailSubtitleText" Text="Start monitoring or run demo mode to populate the workspace." Foreground="{StaticResource TextSubtleBrush}" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" Margin="0,4,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                      </Border>

                      <UniformGrid x:Name="DashboardDetailFactsGrid" Grid.Row="2" Columns="3" Margin="0,0,0,12">
                        <Border Style="{StaticResource DetailGridCard}" Margin="0,0,8,6" Background="{StaticResource CardElevatedBg}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2,1,1,1" Padding="14,12">
                          <StackPanel>
                            <TextBlock x:Name="DashboardDetailSourceLabel" Text="Source host" Style="{StaticResource MicroLabel}"/>
                            <TextBlock x:Name="DashboardDetailSourceText" AutomationProperties.LabeledBy="{Binding ElementName=DashboardDetailSourceLabel}" Text="&#x2014;" Style="{StaticResource MonoValue}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                          </StackPanel>
                        </Border>
                        <Border x:Name="DashboardDetailDestinationCard" Style="{StaticResource DetailGridCard}" Margin="0,0,8,6" Background="{StaticResource CardElevatedBg}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2,1,1,1" Padding="14,12">
                          <StackPanel>
                            <TextBlock x:Name="DashboardDetailDestinationLabel" Text="Destination" Style="{StaticResource MicroLabel}"/>
                            <TextBlock x:Name="DashboardDetailDestinationText" AutomationProperties.LabeledBy="{Binding ElementName=DashboardDetailDestinationLabel}" Text="&#x2014;" Style="{StaticResource MonoValue}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                          </StackPanel>
                        </Border>
                        <Border x:Name="DashboardDetailProtocolCard" Style="{StaticResource DetailGridCard}" Margin="0,0,0,6" Background="{StaticResource CardElevatedBg}" Padding="14,12">
                          <StackPanel>
                            <TextBlock x:Name="DashboardDetailProtocolLabel" Text="Protocol / port" Style="{StaticResource MicroLabel}"/>
                            <TextBlock x:Name="DashboardDetailProtocolText" AutomationProperties.LabeledBy="{Binding ElementName=DashboardDetailProtocolLabel}" Text="&#x2014;" Style="{StaticResource MonoValue}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                          </StackPanel>
                        </Border>
                        <Border x:Name="DashboardDetailCategoryCard" Style="{StaticResource DetailGridCard}" Margin="0,0,8,0">
                          <StackPanel>
                            <TextBlock x:Name="DashboardDetailCategoryLabel" Text="Category" Style="{StaticResource MicroLabel}"/>
                            <TextBlock x:Name="DashboardDetailCategoryText" AutomationProperties.LabeledBy="{Binding ElementName=DashboardDetailCategoryLabel}" Text="&#x2014;" Style="{StaticResource MonoValue}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                          </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DetailGridCard}" Margin="0,0,8,0">
                          <StackPanel>
                            <TextBlock x:Name="DashboardDetailDetectedLabel" Text="Detected" Style="{StaticResource MicroLabel}"/>
                            <TextBlock x:Name="DashboardDetailDetectedText" AutomationProperties.LabeledBy="{Binding ElementName=DashboardDetailDetectedLabel}" Text="&#x2014;" Style="{StaticResource MonoValue}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                          </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DetailGridCard}">
                          <StackPanel>
                            <TextBlock x:Name="DashboardDetailRelatedIncidentLabel" Text="Related incident" Style="{StaticResource MicroLabel}"/>
                            <TextBlock x:Name="DashboardDetailRelatedIncidentText" AutomationProperties.LabeledBy="{Binding ElementName=DashboardDetailRelatedIncidentLabel}" Text="&#x2014;" Style="{StaticResource MonoValue}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                          </StackPanel>
                        </Border>
                      </UniformGrid>

                      <ScrollViewer Grid.Row="3"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled"
                                    Padding="0,0,4,0">
                        <Grid x:Name="DashboardDetailEvidenceGrid">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition x:Name="DashboardEvidencePrimaryColumn" Width="*"/>
                              <ColumnDefinition x:Name="DashboardEvidenceSecondaryColumn" Width="*"/>
                            </Grid.ColumnDefinitions>
