<!-- File: Views/MainWindow.xaml -->
<Window x:Class="Carthago.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:views="clr-namespace:Carthago.Views"
        xmlns:controls="clr-namespace:Carthago.Controls"
        Title="Carthago AI Security Monitor"
        Height="900"
        Width="1440"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

  <!-- Theme -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Views/Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <views:SeverityToBrushConverter x:Key="SeverityBrush"/>
      <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
      <ItemsPanelTemplate x:Key="DashboardKpiWidePanel">
        <UniformGrid IsItemsHost="True" Columns="5"/>
      </ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="DashboardKpiStandardPanel">
        <UniformGrid IsItemsHost="True" Columns="3"/>
      </ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="DashboardKpiCompactPanel">
        <UniformGrid IsItemsHost="True" Columns="2"/>
      </ItemsPanelTemplate>
      <!-- UI-07: preserve two-column Compact at 1024-1099; stack below 1024. -->
      <ItemsPanelTemplate x:Key="DashboardKpiNarrowPanel">
        <UniformGrid IsItemsHost="True" Columns="1"/>
      </ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="DashboardOverviewKpiWidePanel">
        <UniformGrid IsItemsHost="True" Columns="4"/>
      </ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="DashboardOverviewKpiStandardPanel">
        <UniformGrid IsItemsHost="True" Columns="2"/>
      </ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="DashboardOverviewKpiCompactPanel">
        <UniformGrid IsItemsHost="True" Columns="2"/>
      </ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="DashboardOverviewKpiNarrowPanel">
        <UniformGrid IsItemsHost="True" Columns="1"/>
      </ItemsPanelTemplate>
      <!-- GA UI-03: reusable card template for overview and preference metrics. -->
      <Style x:Key="DashboardKpiItemContainerStyle" TargetType="{x:Type ContentPresenter}">
                      <Setter Property="Margin" Value="0,0,10,10"/>
                    </Style>
      <DataTemplate x:Key="DashboardKpiCardTemplate">
                      <Border Style="{StaticResource KpiTileCard}" Height="102">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                          </Grid.RowDefinitions>

                          <DockPanel LastChildFill="True">
                            <!-- KPI card has no overflow command; use the existing information glyph. -->
                            <StackPanel Orientation="Horizontal">
                              <TextBlock x:Name="DashboardKpiCardTitle" Text="{Binding Title}" Style="{StaticResource MicroLabel}"/>
                              <TextBlock Text="  &#x24D8;"
                                          Style="{StaticResource SocInfoGlyph}"
                                          ToolTip="{Binding InformationText}"
                                          AutomationProperties.Name="{Binding InformationAccessibilityName}"
                                          AutomationProperties.HelpText="{Binding InformationText}"/>
                            </StackPanel>
                          </DockPanel>

                          <Grid Grid.Row="1" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Value}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=DashboardKpiCardTitle}"
                                          AutomationProperties.HelpText="{Binding InformationText}"
                                         FontSize="21"
                                         FontWeight="Bold"/>
                              <TextBlock Text="{Binding DeltaText}"
                                         Foreground="{Binding AccentBrush}"
                                         FontSize="11"
                                         FontWeight="SemiBold"
                                         Margin="8,6,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    CornerRadius="12"
                                    Background="#0B1728"
                                    BorderBrush="{Binding AccentBrush}"
                                    BorderThickness="1"
                                    Opacity="0.98">
                              <TextBlock Text="{Binding Icon}"
                                         FontSize="20"
                                         Foreground="{Binding AccentBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>
                          </Grid>

                          <TextBlock Grid.Row="2"
                                     Text="{Binding TrendText}"
                                     FontFamily="Consolas"
                                     Foreground="{Binding AccentBrush}"
                                     FontSize="12"
                                     Height="16"
                                     Opacity="0.95"
                                     TextWrapping="NoWrap"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip="{Binding TrendText}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>

  <!-- ======= LAYOUT: Sidebar + Main ======= -->
  <Grid x:Name="ApplicationShell" Background="{StaticResource AppBackdropGradient}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="216"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <views:Sidebar x:Name="SidebarPanel"
                   Grid.Column="0"
                   Panel.ZIndex="10"/>

    <!-- ===== Main Area ===== -->
    <Grid x:Name="MainContentHost"
          Grid.Column="1"
          Margin="18,0,18,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ===== Header bar ===== -->
      <Border x:Name="CommandHeader"
              Grid.Row="0"
              Style="{StaticResource TopCommandSurface}"
              Margin="0,0,0,14"
              Padding="12,12,12,10"
              MinHeight="92">
        <Grid x:Name="CommandHeaderGrid">
          <Grid.RowDefinitions>
            <RowDefinition x:Name="CommandHeaderPrimaryRow" Height="Auto"/>
            <RowDefinition x:Name="CommandHeaderSecondaryRow" Height="0"/>
            <RowDefinition x:Name="CommandHeaderTertiaryRow" Height="0"/>
            <RowDefinition x:Name="CommandHeaderQuaternaryRow" Height="0"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="CommandHeaderStatusColumn" Width="250"/>
            <ColumnDefinition x:Name="CommandHeaderSourceColumn" Width="290"/>
            <ColumnDefinition x:Name="CommandHeaderAnalysisColumn" Width="210"/>
            <ColumnDefinition x:Name="CommandHeaderActionsColumn" Width="*"/>
          </Grid.ColumnDefinitions>

          <Border x:Name="CommandHeaderStatusGroup"
                  Grid.Column="0"
                  BorderBrush="{StaticResource SoftDividerBrush}"
                  BorderThickness="0,0,1,0"
                  Padding="0,0,14,0"
                  Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="MonitoringStatusBadge"
                      Style="{StaticResource Pill}"
                      Background="{StaticResource StatusMonitoringBgBrush}"
                      BorderBrush="{StaticResource StatusMonitoringBorderBrush}"
                      CornerRadius="10"
                      Padding="12,5"
                      Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="9" Height="9" Fill="{Binding BorderBrush, ElementName=MonitoringStatusBadge}" Margin="0,0,7,0"/>
                  <TextBlock x:Name="CaptureStatusText" Text="Paused" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
              </Border>
              <Border x:Name="AnomalyModeBadge"
                      Style="{StaticResource Pill}"
                      Background="{StaticResource PillAccentBgBrush}"
                      CornerRadius="10"
                      Padding="12,5">
                <TextBlock x:Name="AnomalyModeText" Text="Anomalies only" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentAltBrush}"/>
              </Border>
            </StackPanel>
          </Border>

          <Border x:Name="CommandHeaderSourceGroup"
                  Grid.Column="1"
                  BorderBrush="{StaticResource SoftDividerBrush}"
                  BorderThickness="0,0,1,0"
                  Padding="0,0,14,0"
                  Margin="0,0,12,0">
            <Grid VerticalAlignment="Center">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="Capture source" Style="{StaticResource MicroLabel}"/>
              <ComboBox x:Name="DeviceComboBox"
                        Grid.Row="1"
                        MinWidth="180"
                        MaxWidth="320"
                        Height="32"
                        HorizontalAlignment="Stretch"
                        Margin="0,5,0,0"
                        Background="{StaticResource InputBgBrush}"
                        Foreground="{StaticResource TextBrush}"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        TextElement.Foreground="{StaticResource TextBrush}"
                        ToolTip="Choose a network device to monitor">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock x:Name="HeaderCaptureSourceText" Visibility="Collapsed" Text="Source: waiting for selection"/>
            </Grid>
          </Border>

          <Border x:Name="CommandHeaderAnalysisGroup"
                  Grid.Column="2"
                  BorderBrush="{StaticResource SoftDividerBrush}"
                  BorderThickness="0,0,1,0"
                  Padding="0,0,14,0"
                  Margin="0,0,12,0">
            <Grid VerticalAlignment="Center">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="Last analysis" Style="{StaticResource MicroLabel}"/>
              <TextBlock x:Name="HeaderLastAnalysisText" Grid.Row="1" Text="Waiting for traffic" Foreground="{StaticResource TextSubtleBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </Grid>
          </Border>

          <StackPanel x:Name="CommandHeaderActionsGroup" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
            <WrapPanel HorizontalAlignment="Right">
              <Button x:Name="StartButton" Content="&#x25B6;  Start Monitoring" Width="164" Height="36" Style="{StaticResource PrimaryButton}" Click="StartButton_Click"/>
              <Button x:Name="StopButton" Content="&#x23F8;  Pause Monitoring" Width="148" Height="36" Style="{StaticResource SecondaryButton}" Click="StopButton_Click" IsEnabled="False" Visibility="Collapsed"/>
              <Button x:Name="TestRepButton" Content="Test Reputation" Width="132" Height="36" Style="{StaticResource SecondaryButton}" Click="TestReputation_Click" Margin="8,0,0,0"/>
              <!-- GA UI-28: the ellipsis has no connected menu, command or click handler. -->
              <Button Content="&#x22EE;"
                      Width="40" Height="36"
                      Style="{StaticResource SecondaryButton}"
                      IsEnabled="False"
                      ToolTipService.ShowOnDisabled="True"
                      ToolTip="Additional dashboard actions are unavailable in this view."
                      AutomationProperties.Name="More dashboard actions unavailable"
                      AutomationProperties.HelpText="No additional dashboard actions menu is implemented here. Use the available visible controls."
                      Margin="8,0,0,0"/>
            </WrapPanel>
            <WrapPanel HorizontalAlignment="Right" Margin="0,5,0,0">
              <CheckBox x:Name="AnomaliesOnlyToggle" Content="Show anomalies only" VerticalAlignment="Center" Checked="AnomaliesOnlyToggle_Changed" Unchecked="AnomaliesOnlyToggle_Changed"/>
              <Button Content="Customize" Width="104" Height="30" Style="{StaticResource SecondaryButton}" Click="DashboardOpenSettings_Click" Margin="12,0,0,0"/>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===== Content views ===== -->
      <Grid Grid.Row="1">

        <!-- ===== Legacy analytics infrastructure =====
             Legacy protocol and spark plots remain hidden for existing update paths.
             The original TrafficPlot is now visible in the Security Overview.
             MainWindow.Core.cs and MainWindow.Plots.cs continue to update it. -->
        <Grid x:Name="DashboardLegacyInfrastructure"
              Visibility="Collapsed"
              IsHitTestVisible="False"
              Width="1"
              Height="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock x:Name="PpsValueText"/>
            <TextBlock x:Name="ThroughputValueText"/>
            <TextBlock x:Name="ActiveHostsText"/>
            <TextBlock x:Name="ActiveConnsText"/>
            <TextBlock x:Name="TopProcessText"/>
            <TextBlock x:Name="Alerts60sText"/>
          </StackPanel>
          <StackPanel Grid.Row="1">

            <ScottPlot:WpfPlot x:Name="ProtocolPlot"/>
            <ScottPlot:WpfPlot x:Name="TopTalkersPlot"/>
            <ScottPlot:WpfPlot x:Name="SeverityPlot"/>
            <ScottPlot:WpfPlot x:Name="PpsSpark"/>
            <ScottPlot:WpfPlot x:Name="ThroughputSpark"/>
          </StackPanel>
        </Grid>

        <!-- ===== Dashboard ===== -->
        <Grid x:Name="DashboardView" Visibility="Visible">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0"
                  Visibility="Collapsed"
                  Style="{StaticResource CommandBarSurface}"
                  Padding="12"
                  Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Security workspace"
                           Style="{StaticResource SectionHeader}"
                           FontSize="16"
                           VerticalAlignment="Center"/>
                <Border Style="{StaticResource Pill}"
                        Margin="14,0,0,0"
                        Background="#0B2035"
                        BorderBrush="#214465">
                  <TextBlock Text="Minimal &#x2022; anomaly-first &#x2022; settings-driven"
                             FontSize="11"
                             Foreground="{StaticResource TextSubtleBrush}"/>
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Use recommended layout"
                        Width="180"
                        Height="32"
                        Style="{StaticResource SecondaryButton}"
                        Click="DashboardUseRecommendedLayout_Click"/>
                <Button Content="Settings"
                        Width="92"
                        Height="32"
                        Style="{StaticResource SecondaryButton}"
                        Click="DashboardOpenSettings_Click"
                        Margin="8,0,0,0"/>
              </StackPanel>

              <!-- Hidden picker state used by the existing dashboard preference pipeline and empty-state actions. -->
              <Grid Visibility="Collapsed">
                <ComboBox x:Name="DashboardWidgetPickerCombo" DisplayMemberPath="DisplayName"/>
                <ComboBox x:Name="DashboardMetricPickerCombo" DisplayMemberPath="DisplayName"/>
              </Grid>
            </Grid>
          </Border>

          <ScrollViewer x:Name="DashboardScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <Grid Width="{Binding ViewportWidth, ElementName=DashboardScrollViewer}">
              <Border x:Name="DashboardEmptyStateCard"
                      Style="{StaticResource EmptyDashboardCard}"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Margin="0,52,0,0"
                      MaxWidth="720">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="Your dashboard is empty"
                             FontSize="28"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="Enable a recommended SOC layout or add widgets from Settings. Raw telemetry remains available in Advanced / Forensics."
                             Foreground="{StaticResource TextSubtleBrush}"
                             FontSize="14"
                             Margin="0,8,0,0"
                             TextAlignment="Center"
                             TextWrapping="Wrap"/>
                  <WrapPanel HorizontalAlignment="Center" Margin="0,22,0,0">
                    <Button Content="Add widget"
                            Width="120"
                            Style="{StaticResource PrimaryButton}"
                            Click="DashboardAddSelectedWidget_Click"
                            Margin="0,0,8,6"/>
                    <Button Content="Open Settings"
                            Width="130"
                            Style="{StaticResource SecondaryButton}"
                            Click="DashboardOpenSettings_Click"
                            Margin="0,0,8,6"/>
                    <Button Content="Use recommended layout"
                            Width="190"
                            Style="{StaticResource SecondaryButton}"
                            Click="DashboardUseRecommendedLayout_Click"
                            Margin="0,0,8,6"/>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <StackPanel x:Name="SocDashboardWorkspace" Visibility="Collapsed" Margin="0,0,0,4">
                <!-- GA UI-02: the overview heading is scoped to the dashboard, not the global command bar.
                     Monitoring state and severity color come from the existing capture status pipeline. -->
                <Grid Margin="0,0,0,14" MinHeight="42">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Security Overview"
                             FontSize="24"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="16,0,0,0">
                    <Ellipse Width="9"
                             Height="9"
                             Fill="{Binding BorderBrush, ElementName=MonitoringStatusBadge}"
                             VerticalAlignment="Center"
                             Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding Text, ElementName=CaptureStatusText}"
                               Foreground="{Binding BorderBrush, ElementName=MonitoringStatusBadge}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
                <!-- GA UI-03: screenshot-aligned four-card operational strip.
                     Unavailable sensor and coverage contracts are never substituted with invented counts. -->
                <ItemsControl x:Name="DashboardOverviewKpiItemsControl"
                              AutomationProperties.Name="Security overview metric cards"
                              Margin="0,0,0,8"
                              HorizontalContentAlignment="Stretch"
                              ItemTemplate="{StaticResource DashboardKpiCardTemplate}"
                              ItemContainerStyle="{StaticResource DashboardKpiItemContainerStyle}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid IsItemsHost="True" Columns="4"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <!-- GA UI-08: existing local PPS ScottPlot, moved from collapsed legacy infrastructure. -->
                <Border x:Name="DashboardTrafficChartPanel"
                        Style="{StaticResource PageSurface}"
                        Padding="14"
                        Margin="0,0,0,12"
                        AutomationProperties.Name="Local packet-rate history chart">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Network Traffic (Local PPS)"
                                   Style="{StaticResource DashboardSectionTitle}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Local capture samples, rolling 120-second window"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel x:Name="DashboardTrafficChartCaptureStatus"
                                  Grid.Column="1"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Margin="12,0,0,0">
                        <Ellipse Width="8" Height="8"
                                 Fill="{Binding BorderBrush, ElementName=MonitoringStatusBadge}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Text, ElementName=CaptureStatusText}"
                                   Foreground="{Binding BorderBrush, ElementName=MonitoringStatusBadge}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                      </StackPanel>
                    </Grid>
                    <ScottPlot:WpfPlot x:Name="TrafficPlot"
                                      Grid.Row="1"
                                      Height="240"
                                      MinHeight="180"
                                      AutomationProperties.Name="Local packets per second history"
                                      AutomationProperties.HelpText="Local timer PPS and ten-sample moving average only; not inbound/outbound Mbps or proof of active capture. The current local timer summary is available as item status."
                                      AutomationProperties.ItemStatus="{Binding Text, ElementName=DashboardTrafficChartTextSummary}"
                                      AutomationProperties.LiveSetting="Off"/>
                    <!-- GA UI-10: truthful waiting state; no additional telemetry. -->
                    <Border x:Name="DashboardTrafficChartWaitingPanel"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#E60B1220"
                            BorderBrush="{StaticResource SoftDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            IsHitTestVisible="False"
                            Visibility="Visible">
                      <TextBlock Text="Waiting for local PPS timer samples (two ticks required to draw)."
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 TextAlignment="Center"
                                 MaxWidth="340"/>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                       <TextBlock x:Name="DashboardTrafficChartTextSummary"
                                  Text="Waiting for local PPS timer samples; no packet-rate observation is available yet."
                                  Foreground="{StaticResource TextMutedBrush}"
                                  FontSize="11"
                                  TextWrapping="Wrap"
                                  AutomationProperties.LiveSetting="Off"
                                  Margin="0,0,0,4"/>
                      <TextBlock Text="PPS and 10-sample average only; no inbound/outbound or Mbps series are available here."
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontSize="11"
                                 TextWrapping="Wrap"/>
                      <TextBlock Text="Capture not fully active: retained history and timer-generated zeros may not reflect new observations."
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontSize="11"
                                 Margin="0,4,0,0"
                                 TextWrapping="Wrap">
                        <TextBlock.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Text, ElementName=CaptureStatusText}" Value="MONITORING">
                                <Setter Property="Visibility" Value="Collapsed"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                </Border>
                <!-- Existing preference-controlled statistics remain accessible below the overview. -->
                <TextBlock Text="Additional metrics"
                           Style="{StaticResource DashboardSectionTitle}"
                           FontSize="13"
                           Margin="0,2,0,8"/>
                <ItemsControl x:Name="DashboardKpiItemsControl" AutomationProperties.Name="Additional dashboard metric cards" Margin="0,0,0,12"
                              HorizontalContentAlignment="Stretch"
                              ItemTemplate="{StaticResource DashboardKpiCardTemplate}"
                              ItemContainerStyle="{StaticResource DashboardKpiItemContainerStyle}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid IsItemsHost="True" Columns="5"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  
                  
                </ItemsControl>

                <!-- Main triage area -->
                <Grid x:Name="DashboardTriageGrid" Height="404" Margin="0,0,0,10">
                  <Grid.RowDefinitions>
                    <RowDefinition x:Name="DashboardTriagePrimaryRow" Height="*"/>
                    <RowDefinition x:Name="DashboardTriageSecondaryRow" Height="0"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DashboardTriageTimelineColumn" Width="1.05*"/>
                    <ColumnDefinition x:Name="DashboardTriageDetailColumn" Width="1.65*"/>
                  </Grid.ColumnDefinitions>

                  <Border x:Name="DashboardTimelinePanel"
                          Grid.Column="0"
                          Style="{StaticResource PageSurface}"
                          Padding="14"
                          Margin="0,0,12,0">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Recent High-Priority Incidents" Style="{StaticResource DashboardSectionTitle}"/>
                          <TextBlock Text="  &#x24D8;" Style="{StaticResource SocInfoGlyph}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Unresolved correlated incidents first; anomaly signals remain available below."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                      </StackPanel>

                      <!-- Static source-only queue: no nonfunctional filter or search affordances. -->
                      <TextBlock Grid.Row="1" Margin="0,9,0,8"
                                 Text="LOCAL SNAPSHOT  ·  INCIDENTS BY RISK, THEN SIGNALS"
                                 Style="{StaticResource MicroLabel}"
                                 TextTrimming="CharacterEllipsis"/>

                      <ListBox x:Name="DashboardAnomalyList"
                               Grid.Row="2"
                               AutomationProperties.Name="Prioritized local incidents and anomaly signals"
                               AutomationProperties.HelpText="Use arrow keys to select an item and update Incident Investigation. The current bounded local queue summary is available as item status. Local risk scores are not detection confidence."
                               AutomationProperties.ItemStatus="{Binding Text, ElementName=DashboardAnomalyFooterText}"
                               AutomationProperties.LiveSetting="Off"
                               SelectionChanged="DashboardAnomalyList_SelectionChanged"
                               ScrollViewer.VerticalScrollBarVisibility="Auto"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                               BorderThickness="0"
                               Padding="0"
                               Background="Transparent"
                               ClipToBounds="True"
                               HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                          <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibilityLabel}"/>
                            <Setter Property="Template">
                              <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                  <Border x:Name="ItemShell" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="0">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                  </Border>
                                  <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                      <Setter TargetName="ItemShell" Property="Opacity" Value="0.96"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                      <Setter TargetName="ItemShell" Property="Opacity" Value="1"/>
                                      <Setter TargetName="ItemShell" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                      <Setter TargetName="ItemShell" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                  </ControlTemplate.Triggers>
                                </ControlTemplate>
                              </Setter.Value>
                            </Setter>
                          </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource SocTimelineItem}"
                                    BorderBrush="{Binding AccentBrush}"
                                    Height="64"
                                    Margin="0,0,0,3"
                                    ClipToBounds="True">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="38"/>
                                  <ColumnDefinition Width="*"/>
                                  <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="15"
                                        BorderThickness="2"
                                        BorderBrush="{Binding AccentBrush}"
                                        VerticalAlignment="Center">
                                  <TextBlock Text="{Binding RiskScore}"
                                             ToolTip="Local risk score (0–100); not a confidence percentage"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             FontSize="12"
                                             FontWeight="Bold"
                                             Foreground="{Binding AccentBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center" ClipToBounds="True">
                                  <TextBlock Text="{Binding Kind}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,2"/>
                                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                  <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Subtitle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                  <Border Style="{StaticResource RiskBadge}" BorderBrush="{Binding AccentBrush}" Background="#0B1728">
                                    <TextBlock Text="{Binding Severity}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding AccentBrush}" TextTrimming="CharacterEllipsis"/>
                                  </Border>
                                  <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>

                      <TextBlock x:Name="DashboardAnomalyFooterText"
                                 Grid.Row="3"
                                 Text="Showing recent anomaly signals"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontSize="11"
                                 Margin="0,6,0,0"/>
                    </Grid>
                  </Border>

                  <Border x:Name="DashboardSignalPanel"
                          Grid.Column="1"
                          Style="{StaticResource PageSurface}"
                          Padding="14">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                      </Grid.RowDefinitions>

                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Incident Investigation" Style="{StaticResource DashboardSectionTitle}"/>
                            <TextBlock Text="  &#x24D8;" Style="{StaticResource SocInfoGlyph}" VerticalAlignment="Center"/>
                          </StackPanel>
                          <TextBlock Text="Selected correlated incident or anomaly signal; risk is not a confidence claim."
                                     Foreground="{StaticResource TextMutedBrush}"
                                     FontSize="12"
                                     TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                          <TextBlock Text="RISK SCORE" Style="{StaticResource MicroLabel}" HorizontalAlignment="Right"/>
                          <Border x:Name="DashboardDetailRiskRing" Width="84" Height="84" CornerRadius="42" BorderThickness="6" BorderBrush="{StaticResource WarnBrush}" Margin="0,4,0,0"
                                  ToolTip="Local risk score unavailable; baseline learning is not proof of capture health.">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                              <TextBlock x:Name="DashboardDetailRiskText" Text="&#x2014;" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"
                                         AutomationProperties.Name="Local risk score unavailable"
                                         AutomationProperties.HelpText="Local risk scores are estimates, not detection confidence or verified accuracy."/>
                              <TextBlock x:Name="DashboardDetailRiskBadgeText" Text="Learning" Foreground="{StaticResource WarnBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                          </Border>
                          <Button x:Name="DashboardOpenSignalDetailButton"
                                  Content="Full detail"
                                  Width="94"
                                  Height="28"
                                  HorizontalAlignment="Right"
                                  Margin="0,10,0,0"
                                  Style="{StaticResource SecondaryButton}"
                                  Visibility="Collapsed"
                                  Click="DashboardOpenSignalDetail_Click"/>
                        </StackPanel>
                      </Grid>

                      <Border x:Name="DashboardDetailSeverityStripe" Grid.Row="1" Margin="0,12,0,12" BorderBrush="{StaticResource WarnBrush}" BorderThickness="3,0,0,0" Padding="12,0,0,0">
                        <StackPanel>
                          <TextBlock x:Name="DashboardDetailTitleText" Text="No selected signal" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="54"/>
                          <TextBlock x:Name="DashboardDetailSubtitleText" Text="Start monitoring or run demo mode to populate the workspace." Foreground="{StaticResource TextSubtleBrush}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" Margin="0,4,0,0"/>
                        </StackPanel>
                      </Border>

                      <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,10">
                        <Border Style="{StaticResource DetailGridCard}" Margin="0,0,8,6">
                          <StackPanel>
                            <TextBlock x:Name="DashboardDetailSourceLabel" Text="Source host" Style="{StaticResource MicroLabel}"/>
                            <TextBlock x:Name="DashboardDetailSourceText" AutomationProperties.LabeledBy="{Binding ElementName=DashboardDetailSourceLabel}" Text="&#x2014;" Style="{StaticResource MonoValue}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                          </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DetailGridCard}" Margin="0,0,8,6">
                          <StackPanel>
                            <TextBlock x:Name="DashboardDetailDestinationLabel" Text="Destination" Style="{StaticResource MicroLabel}"/>
                            <TextBlock x:Name="DashboardDetailDestinationText" AutomationProperties.LabeledBy="{Binding ElementName=DashboardDetailDestinationLabel}" Text="&#x2014;" Style="{StaticResource MonoValue}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                          </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DetailGridCard}" Margin="0,0,0,6">
                          <StackPanel>
                            <TextBlock x:Name="DashboardDetailProtocolLabel" Text="Protocol / port" Style="{StaticResource MicroLabel}"/>
                            <TextBlock x:Name="DashboardDetailProtocolText" AutomationProperties.LabeledBy="{Binding ElementName=DashboardDetailProtocolLabel}" Text="&#x2014;" Style="{StaticResource MonoValue}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                          </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DetailGridCard}" Margin="0,0,8,0">
                          <StackPanel>
                            <TextBlock x:Name="DashboardDetailCategoryLabel" Text="Category" Style="{StaticResource MicroLabel}"/>
                            <TextBlock x:Name="DashboardDetailCategoryText" AutomationProperties.LabeledBy="{Binding ElementName=DashboardDetailCategoryLabel}" Text="&#x2014;" Style="{StaticResource MonoValue}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                          </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DetailGridCard}" Margin="0,0,8,0">
                          <StackPanel>
                            <TextBlock x:Name="DashboardDetailDetectedLabel" Text="Detected" Style="{StaticResource MicroLabel}"/>
                            <TextBlock x:Name="DashboardDetailDetectedText" AutomationProperties.LabeledBy="{Binding ElementName=DashboardDetailDetectedLabel}" Text="&#x2014;" Style="{StaticResource MonoValue}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                          </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DetailGridCard}">
                          <StackPanel>
                            <TextBlock x:Name="DashboardDetailRelatedIncidentLabel" Text="Related incident" Style="{StaticResource MicroLabel}"/>
                            <TextBlock x:Name="DashboardDetailRelatedIncidentText" AutomationProperties.LabeledBy="{Binding ElementName=DashboardDetailRelatedIncidentLabel}" Text="&#x2014;" Style="{StaticResource MonoValue}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                          </StackPanel>
                        </Border>
                      </UniformGrid>

                      <ScrollViewer Grid.Row="3"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled"
                                    Padding="0,0,4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="1.2*"/>
                              <ColumnDefinition Width="0.9*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource DetailGridCard}" Margin="0,0,8,6">
                              <StackPanel>
                                <TextBlock x:Name="DashboardDetailReasonsLabel" Text="Reasons" Style="{StaticResource SocSubHeader}"/>
                                <ItemsControl x:Name="DashboardDetailReasonsItems"
                                              AutomationProperties.LabeledBy="{Binding ElementName=DashboardDetailReasonsLabel}"
                                              AutomationProperties.HelpText="Local triage explanations for the selected incident or anomaly signal; not independently verified evidence.">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <TextBlock Text="{Binding}" Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource DetailGridCard}" Margin="0,0,0,6">
                              <StackPanel>
                                <TextBlock x:Name="DashboardDetailTagsLabel" Text="Tags" Style="{StaticResource SocSubHeader}"/>
                                <ItemsControl x:Name="DashboardDetailTagsItems"
                                              AutomationProperties.LabeledBy="{Binding ElementName=DashboardDetailTagsLabel}"
                                              AutomationProperties.HelpText="Tags from the selected local incident or anomaly signal; not independent confirmation of a threat.">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel IsItemsHost="True"/></ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <Border Style="{StaticResource Pill}" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding}" FontSize="11"/>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource DetailGridCard}" Margin="0,0,8,0">
                              <StackPanel>
                                <TextBlock x:Name="DashboardDetailRulesLabel" Text="Related rule IDs" Style="{StaticResource SocSubHeader}"/>
                                <ItemsControl x:Name="DashboardDetailRulesItems"
                                              AutomationProperties.LabeledBy="{Binding ElementName=DashboardDetailRulesLabel}"
                                              AutomationProperties.HelpText="Reported rule links for the selected local incident or anomaly signal; a rule ID is not proof of detection accuracy.">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel IsItemsHost="True"/></ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <Border Style="{StaticResource Pill}" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"/>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailGridCard}">
                              <StackPanel>
                                <TextBlock Text="Recommended actions" Style="{StaticResource SocSubHeader}"/>
                                <WrapPanel>
                                  <Button x:Name="DashboardInvestigateHostButton"
                                           Content="Review finding"
                                           MinWidth="126" Height="30"
                                           Style="{StaticResource PrimaryButton}"
                                           ToolTip="Opens a correlated incident workspace when available; otherwise opens Anomalies."
                                           AutomationProperties.Name="Review local finding"
                                           AutomationProperties.HelpText="Opens a correlated incident workspace when available; otherwise opens the Anomalies view. Does not isolate a host."
                                           Click="DashboardInvestigateHost_Click" Margin="0,0,8,6"/>
                                  <Button x:Name="DashboardViewRelatedIncidentButton" Content="View Related Incident" MinWidth="154" Height="30" Style="{StaticResource SecondaryButton}" Click="DashboardViewRelatedIncident_Click" Margin="0,0,8,6"/>
                                  <Button Content="Full Detail" MinWidth="96" Height="30" Style="{StaticResource SecondaryButton}" Click="DashboardOpenSignalDetail_Click" Margin="0,0,8,6"/>
                                </WrapPanel>
                              </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource DetailGridCard}" Margin="0,6,0,0">
                              <StackPanel>
                                <TextBlock x:Name="DashboardDetailEvidenceSummaryLabel" Text="Evidence provenance (reported, not verified)" Style="{StaticResource SocSubHeader}"/>
                                <TextBlock x:Name="DashboardDetailEvidenceSummaryText"
                                           AutomationProperties.LabeledBy="{Binding ElementName=DashboardDetailEvidenceSummaryLabel}"
                                           Text="No directly selected incident evidence."
                                           Foreground="{StaticResource TextSubtleBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                              </StackPanel>
                            </Border>
                        </Grid>
                      </ScrollViewer>
                    </Grid>
                  </Border>
                </Grid>

                <!-- Lower widgets -->
                <Grid x:Name="DashboardSummaryGrid" Height="202" Margin="0,0,0,10">
                  <Grid.RowDefinitions>
                    <RowDefinition x:Name="DashboardSummaryFirstRow" Height="*"/>
                    <RowDefinition x:Name="DashboardSummarySecondRow" Height="0"/>
                    <RowDefinition x:Name="DashboardSummaryThirdRow" Height="0"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DashboardSummaryFirstColumn" Width="1.02*"/>
                    <ColumnDefinition x:Name="DashboardSummarySecondColumn" Width="1*"/>
                    <ColumnDefinition x:Name="DashboardSummaryThirdColumn" Width="1*"/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="DashboardHostsPanel" Grid.Column="0" Style="{StaticResource PageSurface}" Padding="14" Margin="0,0,12,0">
                    <StackPanel>
                      <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Text="&#x2197;" Style="{StaticResource SocPanelMenuGlyph}"/>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="High-Risk Hosts" Style="{StaticResource DashboardSectionTitle}"/>
                          <TextBlock Text="  &#x24D8;" Style="{StaticResource SocInfoGlyph}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </DockPanel>
                      <Grid Margin="0,6,0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" MinWidth="170"/>
                          <ColumnDefinition Width="48"/>
                          <ColumnDefinition Width="62"/>
                          <ColumnDefinition Width="84"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Host" Style="{StaticResource MicroLabel}"/>
                        <TextBlock Grid.Column="1" Text="Risk" Style="{StaticResource MicroLabel}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="Items" Style="{StaticResource MicroLabel}" HorizontalAlignment="Right"
                                   ToolTip="Related correlated incidents, or anomaly signals when no incident hosts are available."/>
                        <TextBlock Grid.Column="3" Text="Activity" Style="{StaticResource MicroLabel}" Margin="12,0,0,0"
                                   ToolTip="Relative activity over the past 60 minutes in eight time buckets, oldest to newest. Based on incident updates or anomaly creations, not packet traffic or changes in risk."/>
                      </Grid>
                      <ScrollViewer VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled"
                                    MaxHeight="112">
                        <ItemsControl x:Name="DashboardHostItemsControl"
                                      AutomationProperties.Name="High-risk hosts from local observations"
                                      AutomationProperties.HelpText="Up to five host rows. Items counts correlated incidents, or anomaly signals when no incident hosts are available. Risk is a local ranking score, not detection confidence. Activity bars show relative timestamp density over 60 minutes, not traffic or risk trends.">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid Margin="0,1,0,1" MinHeight="20">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" MinWidth="170"/>
                                  <ColumnDefinition Width="48"/>
                                  <ColumnDefinition Width="62"/>
                                  <ColumnDefinition Width="84"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding HostDisplay}"
                                           AutomationProperties.Name="{Binding AccessibilityLabel}"
                                           ToolTip="{Binding Host}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{StaticResource TextBrush}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding RiskScore}"
                                           FontSize="12"
                                           Foreground="{Binding AccentBrush}"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ActiveIncidents}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSubtleBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding TrendText}"
                                           ToolTip="{Binding ActivityAccessibilityLabel}"
                                           AutomationProperties.Name="{Binding ActivityAccessibilityLabel}"
                                           FontSize="12"
                                           FontFamily="Consolas"
                                           Foreground="{Binding AccentBrush}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                      <Button Content="Review findings  &#x2192;"
                               Width="190" Height="30" HorizontalAlignment="Left"
                               Style="{StaticResource SecondaryButton}"
                               ToolTip="Opens a correlated incident workspace when available; otherwise opens Anomalies. This is not a host inventory."
                               AutomationProperties.Name="Review local findings"
                               AutomationProperties.HelpText="Opens a correlated incident workspace when available; otherwise opens the Anomalies view. Does not open a complete host inventory."
                               Click="DashboardInvestigateHost_Click" Margin="0,8,0,0"/>
                    </StackPanel>
                  </Border>

                  <Border x:Name="DashboardActionsPanel" Grid.Column="1" Style="{StaticResource PageSurface}" Padding="14" Margin="0,0,12,0">
                    <StackPanel>
                      <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Text="&#x2197;" Style="{StaticResource SocPanelMenuGlyph}"/>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Recommended Actions" Style="{StaticResource DashboardSectionTitle}"/>
                          <TextBlock Text="  &#x24D8;" Style="{StaticResource SocInfoGlyph}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </DockPanel>
                      <ScrollViewer VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled"
                                    MaxHeight="118"
                                    Margin="0,8,0,0">
                        <ItemsControl x:Name="DashboardActionItemsControl"
                                       AutomationProperties.Name="Suggested local review actions"
                                       AutomationProperties.HelpText="Suggestions are informational, not executed here. Badges indicate action-list position, local anomaly risk, or no numeric value depending on the source.">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource QueueListItem}">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Text="{Binding Icon}" FontSize="18" Foreground="{Binding AccentBrush}" VerticalAlignment="Center"/>
                                  <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                  </StackPanel>
                                  <Border Grid.Column="2" Style="{StaticResource RiskBadge}" BorderBrush="{Binding AccentBrush}" Background="#0B1728" VerticalAlignment="Center"
                                           ToolTip="{Binding BadgeDescription}">
                                    <TextBlock Text="{Binding CountText}" AutomationProperties.Name="{Binding BadgeDescription}" Foreground="{Binding AccentBrush}" FontWeight="Bold" FontSize="11"/>
                                  </Border>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </StackPanel>
                  </Border>

                  <Border x:Name="DashboardOperationsPanel" Grid.Column="2" Style="{StaticResource PageSurface}" Padding="12" Margin="0">
                    <StackPanel>
                      <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Text="&#x2197;" Style="{StaticResource SocPanelMenuGlyph}"/>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Raw / Advanced Shortcuts" Style="{StaticResource DashboardSectionTitle}"/>
                          <TextBlock Text="  &#x24D8;" Style="{StaticResource SocInfoGlyph}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </DockPanel>
                      <UniformGrid Columns="2" Margin="0,8,0,0">
                        <Button Style="{StaticResource ShortcutTile}" Click="DashboardRawTraffic_Click"
                                AutomationProperties.Name="Raw Traffic"
                                AutomationProperties.HelpText="Opens the existing Live Traffic view and its traffic filters.">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#x2301;" FontSize="20" Foreground="{StaticResource TextSubtleBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="Raw Traffic" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="Inspect packets &amp; flows" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            </StackPanel>
                          </Grid>
                        </Button>
                        <Button Style="{StaticResource ShortcutTile}" Click="DashboardRawDetections_Click"
                                AutomationProperties.Name="Raw Detections"
                                AutomationProperties.HelpText="Opens the existing Detection Events view and its detection filters.">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#x25C7;" FontSize="20" Foreground="{StaticResource TextSubtleBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="Raw Detections" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="View rule hits" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            </StackPanel>
                          </Grid>
                        </Button>
                        <Button Style="{StaticResource ShortcutTile}" Click="DashboardPcapExplorer_Click"
                                AutomationProperties.Name="Traffic Analysis"
                                AutomationProperties.HelpText="Opens the existing Live Traffic view, not a separate PCAP Explorer.">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#x25A4;" FontSize="19" Foreground="{StaticResource TextSubtleBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="Traffic Analysis" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="Opens Live Traffic" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            </StackPanel>
                          </Grid>
                        </Button>
                        <Button Style="{StaticResource ShortcutTile}" Click="DashboardForensicsWorkspace_Click"
                                AutomationProperties.Name="Detection Investigation"
                                AutomationProperties.HelpText="Opens the existing Detection Events view, not a separate Forensics Workspace.">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#x2315;" FontSize="20" Foreground="{StaticResource TextSubtleBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="Detection Investigation" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="Opens Detection Events" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            </StackPanel>
                          </Grid>
                        </Button>
                      </UniformGrid>
                      <Button Content="Open Live Traffic  &#x2192;" Width="180" Height="30" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="DashboardRawTraffic_Click" Margin="0,8,0,0"
                              AutomationProperties.Name="Open Live Traffic"
                              AutomationProperties.HelpText="Opens the existing Live Traffic view."/>
                    </StackPanel>
                  </Border>
                </Grid>


                <!-- GA UI-05: bounded, observed detection events; never a fabricated incident chronology. -->
                <Border x:Name="DashboardLiveEventsPanel"
                        Style="{StaticResource PageSurface}"
                        Padding="14"
                        Margin="0,0,0,10">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="True">
                      <Button DockPanel.Dock="Right"
                              Content="All detections &#x2192;"
                              MinWidth="130"
                              Height="30"
                              Style="{StaticResource SecondaryButton}"
                              Click="DashboardLiveEventsOpenDetections_Click"/>
                      <StackPanel>
                        <TextBlock Text="Live Events" Style="{StaticResource DashboardSectionTitle}"/>
                        <TextBlock Text="Recent local detection events, not incident-resolution or evidence-chain records."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,3,8,0"/>
                      </StackPanel>
                    </DockPanel>
                    <WrapPanel Grid.Row="1" Margin="0,12,0,9">
                      <!-- GA UI-26: visible captions for the two remaining dropdown filters. -->
                      <StackPanel Orientation="Horizontal" Height="30" Margin="0,0,8,6">
                        <TextBlock x:Name="DashboardLiveSeverityFilterLabel"
                                   Text="Severity"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <ComboBox x:Name="DashboardLiveSeverityFilter"
                                  Width="142" Height="30"
                                  SelectedIndex="0"
                                  ToolTip="Filter locally observed detection severity"
                                  AutomationProperties.Name="Live events severity"
                                  AutomationProperties.LabeledBy="{Binding ElementName=DashboardLiveSeverityFilterLabel}"
                                  SelectionChanged="DashboardLiveEventsFilterChanged">
                          <ComboBoxItem Content="All severities" Tag=""/>
                          <ComboBoxItem Content="Critical" Tag="Critical"/>
                          <ComboBoxItem Content="High" Tag="High"/>
                          <ComboBoxItem Content="Medium" Tag="Medium"/>
                          <ComboBoxItem Content="Low" Tag="Low"/>
                          <ComboBoxItem Content="Info" Tag="Info"/>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Height="30" Margin="0,0,8,6">
                        <TextBlock x:Name="DashboardLiveProtocolFilterLabel"
                                   Text="Protocol"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <ComboBox x:Name="DashboardLiveProtocolFilter"
                                  Width="142" Height="30"
                                  SelectedIndex="0"
                                  ToolTip="Filter by observed protocol; other protocols remain available under All"
                                  AutomationProperties.Name="Live events protocol"
                                  AutomationProperties.LabeledBy="{Binding ElementName=DashboardLiveProtocolFilterLabel}"
                                  SelectionChanged="DashboardLiveEventsFilterChanged">
                          <ComboBoxItem Content="All protocols" Tag=""/>
                          <ComboBoxItem Content="TCP" Tag="TCP"/>
                          <ComboBoxItem Content="UDP" Tag="UDP"/>
                          <ComboBoxItem Content="ICMP" Tag="ICMP"/>
                        </ComboBox>
                      </StackPanel>
                      <!-- GA UI-16: visible, non-interactive labels for the two free-text filters. -->
                      <StackPanel Orientation="Horizontal" Height="30" Margin="0,0,8,6">
                        <TextBlock x:Name="DashboardLiveRuleFilterLabel"
                                   Text="Rule"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <TextBox x:Name="DashboardLiveRuleFilter"
                                 Width="90" Height="30"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Filter by exact rule ID or part of a rule ID"
                                 AutomationProperties.Name="Live events rule ID"
                                 AutomationProperties.LabeledBy="{Binding ElementName=DashboardLiveRuleFilterLabel}"
                                 TextChanged="DashboardLiveEventsTextChanged"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Height="30" Margin="0,0,8,6">
                        <TextBlock x:Name="DashboardLiveSearchFilterLabel"
                                   Text="Search"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <TextBox x:Name="DashboardLiveSearchFilter"
                                 Width="182" Height="30"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Search visible event source, destination, rule or protocol; no evidence payload search"
                                 AutomationProperties.Name="Search live event endpoints"
                                 AutomationProperties.LabeledBy="{Binding ElementName=DashboardLiveSearchFilterLabel}"
                                 TextChanged="DashboardLiveEventsTextChanged"/>
                      </StackPanel>
                      <Button Content="Clear filters"
                              Height="30" MinWidth="104"
                              Margin="0,0,0,6"
                              Style="{StaticResource SecondaryButton}"
                              Click="DashboardLiveEventsClearFilters_Click"/>
                    </WrapPanel>
                    <Grid Grid.Row="2">
                      <DataGrid x:Name="DashboardLiveEventsGrid"
                                Height="190"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                SelectionMode="Single"
                                HeadersVisibility="Column"
                                GridLinesVisibility="None"
                                RowHeight="27"
                                ColumnHeaderHeight="30"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.VirtualizationMode="Recycling"
                                EnableRowVirtualization="True"
                                EnableColumnVirtualization="True"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                FrozenColumnCount="1"
                                AutomationProperties.Name="Recent local detection events"
                                AutomationProperties.HelpText="Read-only local detections, up to 80 rows. The first Event time column remains visible during horizontal scrolling; navigate remaining columns with the grid keyboard controls or horizontal scroll. Event time is recorded as supplied; timezone is unverified. Evidence is reported presence or count only, not a verified chain. Delivery is transport status, not incident resolution."
                                AutomationProperties.ItemStatus="{Binding Text, ElementName=DashboardLiveEventsStatusText}">
                        <!-- GA UI-15: reuse the theme's keyboard-only focus outline for the read-only event cells. -->
                        <DataGrid.CellStyle>
                          <Style TargetType="{x:Type DataGridCell}"
                                 BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="FocusVisualStyle"
                                    Value="{StaticResource KeyboardFocusVisual}"/>
                          </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Event time" Binding="{Binding EventTime}" Width="144"/>
                          <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*"
                                              MinWidth="120"/>
                          <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="*"
                                              MinWidth="120"/>
                          <DataGridTextColumn Header="Rule" Binding="{Binding RuleId}" Width="76"/>
                          <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="85"/>
                          <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80"/>
                          <DataGridTextColumn Header="Evidence" Binding="{Binding EvidenceSummary}" Width="128"/>
                          <DataGridTextColumn Header="Delivery" Binding="{Binding DeliveryStatus}" Width="105"/>
                        </DataGrid.Columns>
                      </DataGrid>
                      <TextBlock x:Name="DashboardLiveEmptyText"
                                 Text="No local detection events observed in this session."
                                 Foreground="{StaticResource TextSubtleBrush}"
                                 FontSize="12"
                                 TextAlignment="Center"
                                 TextWrapping="Wrap"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 MaxWidth="420"
                                 IsHitTestVisible="False"/>
                    </Grid>
                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                      <TextBlock x:Name="DashboardLiveEventsStatusText"
                                 Text="Waiting for local detection events."
                                 AutomationProperties.LiveSetting="Off"
                                 Foreground="{StaticResource TextSubtleBrush}"
                                 FontSize="11"
                                 TextWrapping="Wrap"/>
                      <TextBlock x:Name="DashboardLiveEventsProvenanceText"
                                 Text="Evidence column reports presence/count only; delivery is not incident resolution."
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontSize="11"
                                 Margin="0,3,0,0"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                  </Grid>
                </Border>

                
                <!-- GA UI-06: reference-aligned terminal companion, visual only.
                     No CLI command dispatcher, process, output stream or simulated telemetry is connected. -->
                <Border x:Name="DashboardCliCompanionPanel"
                        Style="{StaticResource PageSurface}"
                        Width="408"
                        HorizontalAlignment="Right"
                        Padding="12"
                        Margin="0,0,0,10"
                        AutomationProperties.Name="Carthago CLI companion, unavailable">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10" LastChildFill="True">
                      <Border DockPanel.Dock="Right"
                              Background="{StaticResource PillBgBrush}"
                              BorderBrush="{StaticResource CardBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="5"
                              Padding="8,3">
                        <TextBlock Text="UNAVAILABLE"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                      </Border>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&gt;_"
                                   FontFamily="Consolas"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,9,0"/>
                        <TextBlock Text="Carthago CLI"
                                   Style="{StaticResource DashboardSectionTitle}"
                                   VerticalAlignment="Center"/>
                      </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1"
                            Background="{StaticResource AppBgBrush}"
                            BorderBrush="{StaticResource SoftDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            MinHeight="88">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="No CLI session connected"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSubtleBrush}"/>
                        <TextBlock Text="Command execution and terminal output are not implemented in this Windows GUI."
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                      </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="2"
                               Text="Visual companion only · no commands are accepted or executed."
                               FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                  </Grid>
                </Border>
                <Expander Header="Layout manager" IsExpanded="False" Visibility="Collapsed" Margin="0,0,0,18">
                  <Border Style="{StaticResource CommandBarSurface}" Padding="14">
                    <StackPanel>
                      <WrapPanel Margin="0,0,0,10">
                        <Button Content="Add widget" Width="118" Margin="0,0,8,6" Style="{StaticResource PrimaryButton}" Click="DashboardAddSelectedWidget_Click"/>
                        <Button Content="Open Settings" Width="130" Margin="0,0,8,6" Style="{StaticResource SecondaryButton}" Click="DashboardOpenSettings_Click"/>
                        <Button Content="Reset to empty" Width="130" Margin="0,0,8,6" Style="{StaticResource SecondaryButton}" Click="DashboardResetLayout_Click"/>
                      </WrapPanel>
                      <ItemsControl x:Name="DashboardWidgetItemsControl">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel IsItemsHost="True" Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource DashboardWidgetCard}"
                                    Width="260"
                                    MinHeight="130"
                                    Tag="{Binding Id}"
                                    AllowDrop="True"
                                    PreviewMouseLeftButtonDown="DashboardWidgetCard_MouseLeftButtonDown"
                                    MouseMove="DashboardWidgetCard_MouseMove"
                                    Drop="DashboardWidgetCard_Drop">
                              <StackPanel>
                                <DockPanel>
                                  <TextBlock Text="&#x2630;" DockPanel.Dock="Left" Style="{StaticResource DragHandle}" ToolTip="Drag to reorder"/>
                                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="&#x2190;" Width="28" Height="26" Style="{StaticResource MinimalIconButton}" Tag="{Binding Id}" ToolTip="Move left" Click="DashboardWidgetMoveLeft_Click"/>
                                    <Button Content="&#x2192;" Width="28" Height="26" Style="{StaticResource MinimalIconButton}" Tag="{Binding Id}" ToolTip="Move right" Click="DashboardWidgetMoveRight_Click" Margin="4,0,0,0"/>
                                    <Button Content="&#x00D7;" Width="28" Height="26" Style="{StaticResource MinimalIconButton}" Tag="{Binding Id}" ToolTip="Remove widget" Click="DashboardWidgetRemove_Click" Margin="4,0,0,0"/>
                                  </StackPanel>
                                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </Expander>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Grid>


        <!-- ===== Live Traffic (table) ===== -->
        <Grid x:Name="LiveTrafficView"
              Visibility="Collapsed">
          <Border Background="{StaticResource CardBgBrush}"
                  CornerRadius="18"
                  Padding="0"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  BorderThickness="1">
            <DataGrid x:Name="TrafficGrid"
                      AutoGenerateColumns="False"
                      MouseDoubleClick="TrafficGrid_MouseDoubleClick"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True">
              <DataGrid.Resources>
                <Style TargetType="DataGridCell"
                       BasedOn="{StaticResource {x:Type DataGridCell}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ReputationIsMalicious}"
                                 Value="True">
                      <Setter Property="Background"
                              Value="#4B0000"/>
                      <Setter Property="Foreground"
                              Value="White"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.Resources>

              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Blacklist for 10 minutes"
                            Click="Blacklist_10min_Click"/>
                  <MenuItem Header="Blacklist for 1 hour"
                            Click="Blacklist_1h_Click"/>
                  <MenuItem Header="Blacklist indefinitely"
                            Click="Blacklist_Indef_Click"/>
                  <Separator/>
                  <MenuItem Header="Check Reputation Now"
                            Click="LookupReputation_Click"/>
                </ContextMenu>
              </DataGrid.ContextMenu>

              <!-- columns -->
              <DataGrid.Columns>
                <DataGridTextColumn Header="Timestamp"
                                    Binding="{Binding Timestamp, StringFormat={}{0:u}}"
                                    Width="150"/>
                <DataGridTextColumn Header="Source IP"
                                    Binding="{Binding Source}"
                                    Width="170"/>
                <DataGridTextColumn Header="Destination IP"
                                    Binding="{Binding Destination}"
                                    Width="170"/>
                <DataGridTextColumn Header="Protocol"
                                    Binding="{Binding Protocol}"
                                    Width="80"/>
                <DataGridTextColumn Header="IP Ver"
                                    Binding="{Binding IpVersion}"
                                    Width="70"/>
                <DataGridTextColumn Header="Length"
                                    Binding="{Binding Length}"
                                    Width="70"/>
                <DataGridTextColumn Header="L4 Len"
                                    Binding="{Binding L4Len}"
                                    Width="80"/>
                <DataGridTextColumn Header="Source Port"
                                    Binding="{Binding SourcePort}"
                                    Width="90"/>
                <DataGridTextColumn Header="Destination Port"
                                    Binding="{Binding DestinationPort}"
                                    Width="110"/>
                <DataGridTextColumn Header="Service"
                                    Binding="{Binding ApplicationService}"
                                    Width="120"/>
                <DataGridTextColumn Header="Protocol Version"
                                    Binding="{Binding ProtocolVersion}"
                                    Width="120"/>
                <DataGridTextColumn Header="ICMP t/c"
                                    Binding="{Binding IcmpTypeCode}"
                                    Width="100"/>
                <DataGridTextColumn Header="Flags"
                                    Binding="{Binding Flags}"
                                    Width="120"/>
                <DataGridTextColumn Header="TCP Flags (raw)"
                                    Binding="{Binding TcpFlags}"
                                    Width="110"/>
                <DataGridTextColumn Header="TTL"
                                    Binding="{Binding TTL}"
                                    Width="60"/>
                <DataGridTextColumn Header="MAC Source"
                                    Binding="{Binding MacSource}"
                                    Width="170"/>
                <DataGridTextColumn Header="MAC Destination"
                                    Binding="{Binding MacDestination}"
                                    Width="170"/>
                <DataGridTextColumn Header="Registrar"
                                    Binding="{Binding WhoisRegistrar}"
                                    Width="150"/>
                <DataGridTextColumn Header="Organization"
                                    Binding="{Binding WhoisOrganization}"
                                    Width="200"/>
                <DataGridTextColumn Header="Country"
                                    Binding="{Binding WhoisCountry}"
                                    Width="80"/>
                <DataGridTextColumn Header="Reputation Score"
                                    Binding="{Binding ReputationScore}"
                                    Width="120"/>
                <DataGridTextColumn Header="Malicious"
                                    Binding="{Binding ReputationIsMalicious}"
                                    Width="90"/>
                <DataGridTextColumn Header="Reports"
                                    Binding="{Binding ReputationReports}"
                                    Width="90"/>
                <DataGridTextColumn Header="Last Seen"
                                    Binding="{Binding ReputationLastSeen, StringFormat={}{0:u}}"
                                    Width="160"/>
                <DataGridTextColumn Header="VPN"
                                    Binding="{Binding IsVpn}"
                                    Width="60"/>
                <DataGridTextColumn Header="Proxy"
                                    Binding="{Binding IsProxy}"
                                    Width="60"/>
                <DataGridTextColumn Header="Network Type"
                                    Binding="{Binding NetworkType}"
                                    Width="120"/>
                <DataGridTextColumn Header="Process Name"
                                    Binding="{Binding ProcessName}"
                                    Width="180"/>
                <DataGridTextColumn Header="PID"
                                    Binding="{Binding ProcessId}"
                                    Width="80"/>

                <!-- QUIC metadata -->
                <DataGridTextColumn Header="QUIC ALPN"
                                    Binding="{Binding QuicAlpn}"
                                    Width="130"/>
                <DataGridTextColumn Header="QUIC CID"
                                    Binding="{Binding QuicConnectionIdHash}"
                                    Width="130"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>

        <!-- ===== Alerts / IDS (table) ===== -->
        <Grid x:Name="AlertsView"
              Visibility="Collapsed">
          <GroupBox Header="IDS Alerts"
                    Margin="5">
            <DataGrid x:Name="AlertsGrid"
                      AutoGenerateColumns="False"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True">
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Blacklist Source for 1 hour"
                            Click="Alert_Blacklist_1h_Click"/>
                  <MenuItem Header="Blacklist Source indefinitely"
                            Click="Alert_Blacklist_Indef_Click"/>
                  <Separator/>
                  <MenuItem Header="Copy Alert"
                            Click="CopyAlert_Click"/>
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time (UTC)"
                                    Binding="{Binding Timestamp, StringFormat={}{0:u}}"
                                    Width="160"/>
                <DataGridTextColumn Header="Severity"
                                    Binding="{Binding Severity}"
                                    Width="90"/>
                <DataGridTextColumn Header="Rule"
                                    Binding="{Binding RuleId}"
                                    Width="140"/>
                <DataGridTextColumn Header="Source"
                                    Binding="{Binding SourceIp}"
                                    Width="170"/>
                <DataGridTextColumn Header="Destination"
                                    Binding="{Binding DestinationIp}"
                                    Width="170"/>
                <DataGridTextColumn Header="Dst Port"
                                    Binding="{Binding DestinationPort}"
                                    Width="80"/>
                <DataGridTextColumn Header="Protocol"
                                    Binding="{Binding Protocol}"
                                    Width="80"/>
                <DataGridTextColumn Header="Count"
                                    Binding="{Binding Count}"
                                    Width="70"/>
                <DataGridTextColumn Header="Window(s)"
                                    Binding="{Binding WindowSeconds}"
                                    Width="80"/>
                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="*"/>

                <!-- QUIC metadata -->
                <DataGridTextColumn Header="QUIC ALPN"
                                    Binding="{Binding QuicAlpn}"
                                    Width="130"/>
                <DataGridTextColumn Header="QUIC CID"
                                    Binding="{Binding QuicConnectionIdHash}"
                                    Width="130"/>
              </DataGrid.Columns>
            </DataGrid>
          </GroupBox>
        </Grid>

        <!-- ===== Sink Events (EDR/XDR Delivery tables) ===== -->
        <Grid x:Name="SinkEventsView"
              Visibility="Collapsed">
          <Border Background="{StaticResource CardBgBrush}"
                  CornerRadius="18"
                  Padding="0"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  BorderThickness="1"
                  Margin="5">
            <Frame x:Name="SinkEventsFrame"
                   NavigationUIVisibility="Hidden"/>
          </Border>
        </Grid>

        <!-- ===== Host Integrity (rootkit + versions) ===== -->
        <Grid x:Name="HostIntegrityView"
              Visibility="Collapsed">
          <Border Background="{StaticResource CardBgBrush}"
                  CornerRadius="18"
                  Padding="0"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  BorderThickness="1"
                  Margin="5">
            <Frame x:Name="HostIntegrityFrame"
                   NavigationUIVisibility="Hidden"/>
          </Border>
        </Grid>

        <!-- ===== Analytics (Top Talkers on top, charts + map under) ===== -->
        <Grid x:Name="AnalyticsView"
              Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- TopTalkers full width -->
            <RowDefinition Height="*"/>
            <!-- Traffic + Protocol -->
            <RowDefinition Height="*"/>
            <!-- Severity + Map -->
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Top Talkers as a single full-width row -->
          <GroupBox Header="Top Talkers"
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Margin="5">
            <ScottPlot:WpfPlot x:Name="TopTalkersPlot_Analytics"/>
          </GroupBox>

          <!-- Charts under -->
          <GroupBox Header="Traffic Over Time"
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="5">
            <ScottPlot:WpfPlot x:Name="TrafficPlot_Analytics"/>
          </GroupBox>

          <GroupBox Header="Protocol Distribution"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="5">
            <ScottPlot:WpfPlot x:Name="ProtocolPlot_Analytics"/>
          </GroupBox>

          <GroupBox Header="Severity"
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="5">
            <ScottPlot:WpfPlot x:Name="SeverityPlot_Analytics"/>
          </GroupBox>

          <!-- NEW: Geography Map -->
          <GroupBox Header="Geography Map"
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="5">
            <controls:WorldMapControl x:Name="WorldMap"
                                      Margin="6"
                                      ShowGraticule="True"/>
          </GroupBox>
        </Grid>

        <!-- ===== Integrations (EDR/XDR) - side view (no popup) ===== -->
        <Grid x:Name="IntegrationsView"
              Visibility="Collapsed">
          <Border Background="{StaticResource CardBgBrush}"
                  CornerRadius="18"
                  Padding="0"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  BorderThickness="1"
                  Margin="5">
            <Frame x:Name="IntegrationsFrame"
                   NavigationUIVisibility="Hidden"/>
          </Border>
        </Grid>

        <!-- ===== Anomalies - side view ===== -->
        <Grid x:Name="AnomaliesView"
              Visibility="Collapsed">
          <Frame x:Name="AnomaliesFrame"
                 NavigationUIVisibility="Hidden"/>
        </Grid>

        <!-- ===== Incidents (AI) - side view (no popup) ===== -->
        <Grid x:Name="IncidentsView"
              Visibility="Collapsed">
          <Border Background="{StaticResource CardBgBrush}"
                  CornerRadius="18"
                  Padding="0"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  BorderThickness="1"
                  Margin="5">
            <Frame x:Name="IncidentsFrame"
                   NavigationUIVisibility="Hidden"/>
          </Border>
        </Grid>

        <!-- ===== Threat Feed / IOC reputation workspace ===== -->
        <Grid x:Name="ThreatFeedView"
              Visibility="Collapsed">
          <Frame x:Name="ThreatFeedFrame"
                 NavigationUIVisibility="Hidden"/>
        </Grid>

        <!-- ===== Cisco Tools ===== -->
        <Grid x:Name="CiscoToolsView"
              Visibility="Collapsed">
          <Border Background="{StaticResource CardBgBrush}"
                  CornerRadius="18"
                  Padding="0"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  BorderThickness="1"
                  Margin="5">
            <views:CiscoToolsPanel x:Name="CiscoToolsPanel"/>
          </Border>
        </Grid>

        <!-- ===== Settings ===== -->
        <Grid x:Name="SettingsView"
              Visibility="Collapsed">
          <Border Background="{StaticResource CardBgBrush}"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="30"
                  MaxWidth="800"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Stretch">
            <ScrollViewer x:Name="SettingsScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch">
              <StackPanel>
              <TextBlock Text="Settings"
                         FontSize="20"
                         FontWeight="Bold"
                         Margin="0,0,0,10"/>

              <!-- Sensitivity -->
              <GroupBox Header="Detection Sensitivity"
                        Margin="0,4,0,0">
                <Grid Margin="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <TextBlock Text="Sensitivity"
                             VerticalAlignment="Center"/>
                  <ComboBox x:Name="SensitivityCombo"
                            Grid.Column="1"
                            Width="220"
                            SelectedIndex="1"
                            SelectionChanged="SensitivityCombo_SelectionChanged">
                    <ComboBoxItem Content="Relaxed"/>
                    <ComboBoxItem Content="Balanced"/>
                    <ComboBoxItem Content="Aggressive"/>
                  </ComboBox>

                  <Border Grid.Row="1"
                          Grid.ColumnSpan="2"
                          Margin="0,8,0,0"
                          Background="#0E1526"
                          BorderBrush="{StaticResource CardBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0">
                        <TextBlock Text="Relaxed"
                                   FontWeight="SemiBold"/>
                        <TextBlock Foreground="{StaticResource TextSubtleBrush}"
                                   Margin="0,4,0,0"
                                   Text="Factor: 0.50&#x0a;AbuseIPDB cutoff: &#x2265; 90"/>
                      </StackPanel>

                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Balanced"
                                   FontWeight="SemiBold"/>
                        <TextBlock Foreground="{StaticResource TextSubtleBrush}"
                                   Margin="0,4,0,0"
                                   Text="Factor: 1.00&#x0a;AbuseIPDB cutoff: &#x2265; 75"/>
                      </StackPanel>

                      <StackPanel Grid.Column="2">
                        <TextBlock Text="Aggressive"
                                   FontWeight="SemiBold"/>
                        <TextBlock Foreground="{StaticResource TextSubtleBrush}"
                                   Margin="0,4,0,0"
                                   Text="Factor: 1.50&#x0a;AbuseIPDB cutoff: &#x2265; 50"/>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <TextBlock Grid.Row="2"
                             Grid.ColumnSpan="2"
                             Foreground="{StaticResource TextSubtleBrush}"
                             Margin="0,8,0,0"
                             Text="Higher sensitivity lowers rule thresholds (e.g., fewer packets/bytes needed to trigger) and flags lower reputation scores."
                             TextWrapping="Wrap"/>

                  <StackPanel Grid.Row="3"
                              Grid.ColumnSpan="2"
                              Orientation="Horizontal"
                              HorizontalAlignment="Right"
                              Margin="0,8,0,0">
                    <Button Content="Save"
                            Width="100"
                            Style="{StaticResource PrimaryButton}"
                            Click="SaveSettings_Click"/>
                    <Button Content="Reset"
                            Width="100"
                            Margin="8,0,0,0"
                            Click="ResetSettings_Click"/>
                  </StackPanel>
                </Grid>
              </GroupBox>

              <!-- Enrichment & Capture -->
               <GroupBox Header="Enrichment &amp; Capture"
                         Margin="0,8,0,0">
                <Grid Margin="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <!-- Auto-start -->
                  <TextBlock Text="Auto-Start Capture"
                             VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal">
                    <CheckBox x:Name="AutoStartCheck"
                              Content="Start capture on launch"/>
                  </StackPanel>
                  <TextBlock Grid.Row="1"
                             Grid.ColumnSpan="2"
                             Margin="0,4,0,8"
                             Foreground="{StaticResource TextSubtleBrush}"
                             Text="Tip: Useful for appliances or headless deployments."/>

                  <!-- WHOIS -->
                  <TextBlock Grid.Row="2"
                             Text="Enable WHOIS"
                             VerticalAlignment="Center"/>
                  <StackPanel Grid.Row="2"
                              Grid.Column="1"
                              Orientation="Horizontal">
                    <CheckBox x:Name="EnableWhoisCheck"
                              Content="Resolve WHOIS / ASN / Org"/>
                  </StackPanel>

                  <!-- Reputation -->
                  <TextBlock Grid.Row="3"
                             Text="Enable Reputation"
                             VerticalAlignment="Center"/>
                  <StackPanel Grid.Row="3"
                              Grid.Column="1"
                              Orientation="Horizontal">
                    <CheckBox x:Name="EnableRepCheck"
                              Content="AbuseIPDB reputation lookups"/>
                  </StackPanel>
                  <TextBlock Grid.Row="4"
                             Grid.ColumnSpan="2"
                             Margin="0,4,0,8"
                             Foreground="{StaticResource TextWarningBrush}"
                             Text="Requires a valid AbuseIPDB API key. For best results, set ABUSEIPDB_API_KEY in a .env file or environment variable."/>

                  <!-- BPF filter -->
                  <TextBlock Grid.Row="5"
                             Text="Default BPF Filter"
                             VerticalAlignment="Center"/>
                  <StackPanel Grid.Row="5"
                              Grid.Column="1"
                              Orientation="Horizontal">
                    <TextBox x:Name="DefaultFilterText"
                             Width="300"
                             ToolTip="Example: tcp or port 443"/>
                  </StackPanel>

                  <!-- API key -->
                  <TextBlock Grid.Row="6"
                             Text="AbuseIPDB API Key"
                             VerticalAlignment="Center"/>
                  <WrapPanel Grid.Row="6"
                             Grid.Column="1">
                    <PasswordBox x:Name="AbuseApiKeyBox"
                                 Width="300"
                                 ToolTip="Prefer .env / environment variables for persistence"
                                 Margin="0,0,8,0"/>
                    <Button Content="Use for this session"
                            Click="ApplyApiKey_Click"
                            MinWidth="160"/>
                  </WrapPanel>

                  <!-- Status line -->
                  <TextBlock x:Name="ApiKeyStatusText"
                             Grid.Row="7"
                             Grid.ColumnSpan="2"
                             Margin="0,8,0,0"
                             Foreground="{StaticResource TextSubtleBrush}"
                             Text="Key status: unknown"/>
                </Grid>
              </GroupBox>


              <GroupBox Header="Dashboard &amp; Sections"
                        Margin="0,8,0,0">
                <Grid Margin="10">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <TextBlock Text="Keep the main dashboard empty unless you explicitly activate sections or add widgets."
                             Foreground="{StaticResource TextSubtleBrush}"
                             TextWrapping="Wrap"/>

                  <UniformGrid Grid.Row="1"
                               Columns="2"
                               Margin="0,8,0,0">
                    <CheckBox x:Name="DashboardShowIncidentsCheck"
                              Content="Show Incidents"
                              ToolTip="Display correlated security incidents on the dashboard."
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                    <CheckBox x:Name="DashboardShowAnomaliesCheck"
                              Content="Show Anomalies"
                              ToolTip="Display anomaly-first behavior signals."
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                    <CheckBox x:Name="DashboardShowStatisticsCheck"
                              Content="Show Statistics"
                              ToolTip="Display selected security metrics as configurable cards."
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                    <CheckBox x:Name="DashboardShowTimelineCheck"
                              Content="Show Timeline"
                              ToolTip="Display recent anomaly and incident timeline events."
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                    <CheckBox x:Name="DashboardShowBaselineCheck"
                              Content="Show Baseline learning"
                              ToolTip="Display deterministic baseline learning status."
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                    <CheckBox x:Name="DashboardShowMlCheck"
                              Content="Show ML-assisted scoring"
                              ToolTip="Display optional ML-assisted behavior score status."
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                    <CheckBox x:Name="DashboardShowRecommendedActionsCheck"
                              Content="Show Recommended actions"
                              ToolTip="Display response guidance from the highest-priority incident."
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                    <CheckBox x:Name="DashboardShowRawSummaryCheck"
                              Content="Show Raw/Advanced shortcuts"
                              ToolTip="Show quick links to raw forensic data. Raw data remains available from navigation even if this is disabled."
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                    <CheckBox x:Name="DashboardShowCiscoCheck"
                              Content="Show Cisco section"
                              ToolTip="Display Cisco/syslog shortcut widgets."
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                    <CheckBox x:Name="DashboardShowSinkCheck"
                              Content="Show External delivery"
                              ToolTip="Display sink delivery shortcut widgets."
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                    <CheckBox x:Name="DashboardShowForensicsCheck"
                              Content="Show Forensics shortcuts"
                              ToolTip="Display raw traffic, raw detections, and advanced investigation shortcuts."
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                    <CheckBox x:Name="DashboardShowDemoCheck"
                              Content="Show Developer demo section"
                              ToolTip="Available only when demo mode is enabled."
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                  </UniformGrid>

                  <WrapPanel Grid.Row="2"
                             Margin="0,14,0,0">
                    <CheckBox x:Name="DashboardMinimalModeCheck"
                              Content="Use minimal dashboard"
                              Margin="0,0,18,0"
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                    <CheckBox x:Name="DashboardEmptyByDefaultCheck"
                              Content="Empty dashboard by default"
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                  </WrapPanel>

                  <Border Grid.Row="3"
                          Style="{StaticResource PresetCard}"
                          Margin="0,14,0,0">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <StackPanel>
                        <TextBlock Text="Recommended layouts"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Apply a preset, then customize or reorder widgets."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,3,0,0"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                      <WrapPanel Grid.Row="1"
                                 Margin="0,10,0,0"
                                 HorizontalAlignment="Left">
                        <ComboBox x:Name="DashboardPresetCombo"
                                  Width="240"
                                  DisplayMemberPath="Name"/>
                        <Button Content="Apply preset"
                                Width="120"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="DashboardApplyPreset_Click"/>
                        <Button Content="Reset dashboard"
                                Width="130"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="DashboardResetLayout_Click"/>
                      </WrapPanel>
                    </Grid>
                  </Border>

                  <TextBlock Grid.Row="4"
                             Text="Disabled sections are removed from the main dashboard. Raw Traffic, Raw Detections, Sink Delivery, Cisco Tools, and other forensic views remain accessible from Advanced navigation."
                             Foreground="{StaticResource TextMutedBrush}"
                             TextWrapping="Wrap"
                             Margin="0,8,0,0"/>
                </Grid>
              </GroupBox>

              <GroupBox x:Name="DemoModeGroup"
                        Header="Developer Demo Mode"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">
                <Grid Margin="10">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <TextBlock Text="Developer-only simulated security scenario. Run the app with --demo-mode to reveal this section outside debug builds."
                             Foreground="{StaticResource TextSubtleBrush}"
                             TextWrapping="Wrap"/>

                  <TextBlock Grid.Row="1"
                             Margin="0,8,0,0"
                             Text="This injects labeled anomaly and detection data into the analytics pipeline only. Raw packet, sink, and forensic views continue to show real capture data."
                             Foreground="{StaticResource TextMutedBrush}"
                             TextWrapping="Wrap"/>

                  <WrapPanel Grid.Row="2"
                             Margin="0,8,0,0">
                    <Button Content="Simulate compromised laptop"
                            Width="220"
                            Style="{StaticResource PrimaryButton}"
                            Click="RunDemoIncident_Click"/>
                    <Button Content="Clear demo data"
                            Width="140"
                            Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButton}"
                            Click="ClearDemoData_Click"/>
                    <Button Content="Open incident queue"
                            Width="150"
                            Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButton}"
                            Click="OpenDemoIncidentQueue_Click"/>
                  </WrapPanel>

                  <Border Grid.Row="3"
                          Margin="0,8,0,0"
                          Background="{StaticResource PillBgBrush}"
                          BorderBrush="{StaticResource CardBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="10">
                    <TextBlock x:Name="DemoModeStatusText"
                               Text="Demo mode is enabled. No demo data has been generated yet."
                               Foreground="{StaticResource TextSubtleBrush}"
                               TextWrapping="Wrap"/>
                  </Border>
                </Grid>
              </GroupBox>

              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>

      </Grid>

      <!-- ===== Global status footer ===== -->
      <Border Grid.Row="2"
              Background="{StaticResource AppFooterSurface}"
              BorderBrush="{StaticResource CardBorderBrush}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="14,9"
              Margin="0,14,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      ToolTip="This indicator reflects local capture state, not overall system, database or sensor health."
                      AutomationProperties.HelpText="Local capture state only; no overall system, database or sensor health check is implied.">
            <Ellipse Width="8" Height="8"
                     Fill="{Binding Foreground, ElementName=FooterTelemetryStateText}"
                     Margin="0,0,8,0"/>
            <TextBlock Text="Local capture state" Foreground="{StaticResource TextSubtleBrush}"/>
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <TextBlock Text="Capture:" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
            <TextBlock x:Name="FooterTelemetryStateText" Text="Unknown" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,18,0"/>
            <TextBlock x:Name="FooterUtcText" Text="UTC --:--:--" Foreground="{StaticResource TextMutedBrush}"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>

