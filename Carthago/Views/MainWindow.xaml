        <!-- ===== Settings ===== -->
        <Grid x:Name="SettingsView"
              Visibility="Collapsed">
          <Border Style="{StaticResource SettingsOpsFrame}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
            <ScrollViewer x:Name="SettingsScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch">
              <StackPanel>
                <!-- GA UI-94: screen-visible Settings visual architecture, source candidate. -->
                <!-- GA UI-131: a responsive configuration command header, not an operational health indicator. -->
                <Grid x:Name="SettingsHeroLayout" Margin="0,0,0,20">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SettingsHeroPrimaryColumn" Width="1.65*"/>
                    <ColumnDefinition x:Name="SettingsHeroSecondaryColumn" Width="1*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Border x:Name="SettingsHeroIntro" Grid.Row="0" Grid.Column="0"
                          Style="{StaticResource SettingsOpsHero}" Margin="0,0,16,0"
                          BorderBrush="#27718B" BorderThickness="1,1,1,1">
                    <StackPanel>
                      <TextBlock Text="CONFIGURATION  /  LOCAL WORKSPACE"
                                 FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                      <TextBlock Text="Settings" FontSize="38" FontWeight="Bold"
                                 Foreground="{StaticResource TextBrush}" Margin="0,10,0,9"/>
                      <TextBlock Text="Control how Carthago presents findings, enriches eligible traffic and organizes the analyst workspace."
                                 FontSize="14" Foreground="{StaticResource TextSubtleBrush}"
                                 TextWrapping="Wrap" Margin="0,0,0,16"/>
                      <Border Height="1" Background="#28506B" Margin="0,0,0,13"/>
                      <TextBlock Text="Changes to Dashboard section visibility apply immediately. Save persists the main application preferences."
                                 FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                  <Border x:Name="SettingsHeroGuidance" Grid.Row="0" Grid.Column="1"
                          Background="#101F31" BorderBrush="#2C5871" BorderThickness="1"
                          CornerRadius="14" Padding="22,20">
                    <StackPanel>
                      <TextBlock Text="CONFIGURATION WORKFLOW" FontSize="11" FontWeight="Bold"
                                 Foreground="{StaticResource AccentBrush}" Margin="0,0,0,13"/>
                      <TextBlock Text="01   Review detection sensitivity" FontSize="14" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                      <TextBlock Text="02   Choose capture and enrichment defaults" FontSize="14"
                                 Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                      <TextBlock Text="03   Arrange visible Dashboard sections" FontSize="14"
                                 Foreground="{StaticResource TextBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>
                      <Border Height="1" Background="#28506B" Margin="0,0,0,12"/>
                      <TextBlock Text="This guide describes configuration steps; it does not report capture or detection health."
                                 FontSize="11" Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </Grid>
                <!-- GA UI-116: persistent operational configuration map; labels are navigation context, not health telemetry. -->
                <UniformGrid x:Name="SettingsWorkspaceMap" Columns="3" Margin="0,0,0,18">
                  <Border Style="{StaticResource SettingsWorkspaceTile}" Margin="0,0,10,0">
                    <StackPanel>
                      <TextBlock Text="01  /  DETECTION" Style="{StaticResource SettingsWorkspaceEyebrow}"/>
                      <TextBlock Text="Signal policy" Style="{StaticResource SettingsWorkspaceTitle}"/>
                      <TextBlock Text="Sensitivity and threshold selection" Style="{StaticResource SettingsWorkspaceDescription}"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource SettingsWorkspaceTile}" Margin="0,0,10,0">
                    <StackPanel>
                      <TextBlock Text="02  /  DATA SOURCES" Style="{StaticResource SettingsWorkspaceEyebrow}"/>
                      <TextBlock Text="Capture &amp; enrichment" Style="{StaticResource SettingsWorkspaceTitle}"/>
                      <TextBlock Text="Local capture defaults and optional external lookups" Style="{StaticResource SettingsWorkspaceDescription}"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource SettingsWorkspaceTile}">
                    <StackPanel>
                      <TextBlock Text="03  /  WORKSPACE" Style="{StaticResource SettingsWorkspaceEyebrow}"/>
                      <TextBlock Text="Dashboard composition" Style="{StaticResource SettingsWorkspaceTitle}"/>
                      <TextBlock Text="Choose visible operational sections and layouts" Style="{StaticResource SettingsWorkspaceDescription}"/>
                    </StackPanel>
                  </Border>
                </UniformGrid>
                <!-- GA UI-172: full-width configuration stages with a responsive three-lane dashboard module matrix. -->
                <!-- GA UI-132: numbered, full-height operational configuration architecture. -->
                <Grid x:Name="SettingsOpsLayout">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SettingsOpsLeftColumn" Width="*"/>
                    <ColumnDefinition x:Name="SettingsOpsRightColumn" Width="0"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

              <!-- Sensitivity -->
              <GroupBox x:Name="SettingsDetectionGroup" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        Header="Detection Sensitivity" Tag="01  /  SIGNAL POLICY" Style="{StaticResource SettingsOpsGroup}"
                        Margin="0,0,0,14">
                <Grid Margin="14,16,14,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SettingsSensitivityLabelColumn" Width="160"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <!-- GA UI-65: clarify staged sensitivity selection and the scope of Save/Reset without changing preference handlers. -->
                  <TextBlock x:Name="SettingsSensitivityLabel" Text="Sensitivity"
                             VerticalAlignment="Center"/>
                  <ComboBox x:Name="SensitivityCombo"
                            Grid.Column="1"
                            Width="220"
                            SelectedIndex="1"
                            ToolTip="Choose Relaxed, Balanced or Aggressive detection sensitivity. Changing selection alone does not save it; Save persists this and other settings and reapplies runtime preferences."
                            ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                            AutomationProperties.LabeledBy="{Binding ElementName=SettingsSensitivityLabel}"
                            AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                            SelectionChanged="SensitivityCombo_SelectionChanged">
                    <ComboBoxItem Content="Relaxed"/>
                    <ComboBoxItem Content="Balanced"/>
                    <ComboBoxItem Content="Aggressive"/>
                  </ComboBox>

                  <!-- GA UI-118: substantial three-profile visual comparison, no new preference or detection behavior. -->
                  <UniformGrid x:Name="SettingsSensitivityProfiles" Grid.Row="1" Grid.ColumnSpan="2" Columns="3" Margin="0,16,0,8">
                    <Border Background="#101D2D" BorderBrush="#49A9CC" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,10,0" MinHeight="130">
                      <StackPanel>
                        <TextBlock Text="RELAXED" Foreground="#49A9CC" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="0.50" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="Threshold factor" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                        <Border Background="#17283A" CornerRadius="5" Padding="8,5" Margin="0,10,0,0">
                          <TextBlock Text="AbuseIPDB cutoff: ≥ 90" Foreground="{StaticResource TextSubtleBrush}" FontSize="12"/>
                        </Border>
                        <TextBlock Text="Higher reputation cutoff; less sensitive thresholds." Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0"/>
                      </StackPanel>
                    </Border>
                    <Border Background="#101D2D" BorderBrush="#34C9C0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,10,0" MinHeight="130">
                      <StackPanel>
                        <TextBlock Text="BALANCED" Foreground="#34C9C0" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="1.00" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="Threshold factor" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                        <Border Background="#17283A" CornerRadius="5" Padding="8,5" Margin="0,10,0,0">
                          <TextBlock Text="AbuseIPDB cutoff: ≥ 75" Foreground="{StaticResource TextSubtleBrush}" FontSize="12"/>
                        </Border>
                        <TextBlock Text="Default reference threshold profile." Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0"/>
                      </StackPanel>
                    </Border>
                    <Border Background="#101D2D" BorderBrush="#E8AC55" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,0" MinHeight="130">
                      <StackPanel>
                        <TextBlock Text="AGGRESSIVE" Foreground="#E8AC55" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="1.50" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="Threshold factor" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                        <Border Background="#17283A" CornerRadius="5" Padding="8,5" Margin="0,10,0,0">
                          <TextBlock Text="AbuseIPDB cutoff: ≥ 50" Foreground="{StaticResource TextSubtleBrush}" FontSize="12"/>
                        </Border>
                        <TextBlock Text="Lower trigger thresholds; more sensitive alerts." Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0"/>
                      </StackPanel>
                    </Border>
                  </UniformGrid>

                  <TextBlock Grid.Row="2"
                             Grid.ColumnSpan="2"
                             Foreground="{StaticResource TextSubtleBrush}"
                             Margin="0,8,0,0"
                             Text="Higher sensitivity lowers rule thresholds (e.g., fewer packets/bytes needed to trigger) and flags lower reputation scores."
                             TextWrapping="Wrap"/>

                  <WrapPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0">
                    <Button Content="Open Detection Coverage Center" MinWidth="220" Height="36"
                            Style="{StaticResource SecondaryButton}" Click="SettingsOpenDetectionCoverage_Click"
                            AutomationProperties.Name="Inspect registered rules, evaluations and telemetry coverage"/>
                    <TextBlock Text="Read-only rule status and catalog diagnostics; does not change sensitivity."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,5,0,0"/>
                  </WrapPanel>


                </Grid>
              </GroupBox>

              <!-- Enrichment & Capture -->
               <GroupBox x:Name="SettingsCaptureGroup" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                         Header="Capture &amp; Enrichment Configuration" Tag="02  /  DATA SOURCES" Style="{StaticResource SettingsOpsGroup}"
                         Margin="0,0,0,14">
                <Grid Margin="18,20,18,18">
                  <!-- GA UI-117: three visibly distinct operational zones; existing named inputs and handlers stay in place. -->
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SettingsCaptureLabelColumn" Width="160"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <!-- Section-scale card surfaces are behind all controls and remain presentation-only. -->
                  <Border Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2"
                          Style="{StaticResource SettingsCaptureZone}"
                          BorderBrush="#28728B" Margin="-9,-9,-9,9"
                          IsHitTestVisible="False"/>
                  <Border Grid.Row="2" Grid.RowSpan="3" Grid.ColumnSpan="2"
                          Style="{StaticResource SettingsCaptureZone}"
                          BorderBrush="#2B566B" Margin="-9,-5,-9,9"
                          IsHitTestVisible="False"/>
                  <Border Grid.Row="5" Grid.RowSpan="4" Grid.ColumnSpan="2"
                          Style="{StaticResource SettingsCaptureZone}"
                          BorderBrush="#28728B" Margin="-9,-5,-9,-7"
                          IsHitTestVisible="False"/>
                  <!-- Auto-start -->
                  <TextBlock Text="Auto-Start Capture"
                             FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="12,0,6,0"
                             VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal">
                    <CheckBox x:Name="AutoStartCheck"
                              Content="Start capture on launch"
                              ToolTip="Save to request capture at the next application launch when a capture source and enabled Start control are available. Checking alone does not start capture or confirm packet flow."
                              ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                              AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
                  </StackPanel>
                  <TextBlock Grid.Row="1"
                             Grid.ColumnSpan="2"
                             Margin="12,4,0,8"
                             Foreground="{StaticResource TextSubtleBrush}"
                             Text="Tip: Useful for appliances or headless deployments."/>

                  <!-- External enrichment settings: distinct operational zone. -->
                  <!-- WHOIS -->
                  <TextBlock Grid.Row="2"
                             Text="Enable WHOIS"
                             FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="12,0,6,0"
                             VerticalAlignment="Center"/>
                  <StackPanel Grid.Row="2"
                              Grid.Column="1"
                              Orientation="Horizontal">
                    <CheckBox x:Name="EnableWhoisCheck"
                              Content="Resolve WHOIS / ASN / Org"
                              ToolTip="Save to enable external WHOIS, ASN and organization lookups for eligible public IPs in processed traffic. Checking alone does not make a request; lookup results are not guaranteed."
                              ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                              AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
                  </StackPanel>

                  <!-- Reputation -->
                  <TextBlock Grid.Row="3"
                             Text="Enable Reputation"
                             FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="12,0,6,0"
                             VerticalAlignment="Center"/>
                  <StackPanel Grid.Row="3"
                              Grid.Column="1"
                              Orientation="Horizontal">
                    <CheckBox x:Name="EnableRepCheck"
                              Content="AbuseIPDB reputation lookups"
                              ToolTip="Save to enable external AbuseIPDB reputation lookups for eligible public IPs in processed traffic. A valid API key is required. Checking alone does not validate credentials or make a request."
                              ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                              AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
                  </StackPanel>
                  <TextBlock Grid.Row="4"
                             Grid.ColumnSpan="2"
                             Margin="12,4,0,8"
                             Foreground="{StaticResource TextWarningBrush}"
                             TextWrapping="Wrap"
                             Text="Requires a valid AbuseIPDB API key. For best results, set ABUSEIPDB_API_KEY in a .env file or environment variable."/>

                  <!-- GA UI-133: full-width local filter and stacked session credential actions, preventing narrow-width collisions. -->
                  <!-- Local filter and session credential settings: distinct operational zone. -->
                  <!-- BPF filter -->
                  <!-- GA UI-66: label the existing BPF field and disclose Save's active-Npcap effect without changing capture logic. -->
                  <TextBlock x:Name="SettingsDefaultBpfLabel"
                             Grid.Row="5"
                             Text="Default BPF Filter"
                             FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="12,0,6,0"
                             VerticalAlignment="Center"/>
                  <Grid Grid.Row="5" Grid.Column="1" Margin="0,6,0,6">
                    <TextBox x:Name="DefaultFilterText"
                             HorizontalAlignment="Stretch"
                             MinWidth="0"
                             ToolTip="Default BPF expression for Npcap capture (for example, tcp or port 443). Editing alone does not apply it. Save stores the default; when Npcap capture is active, Save also reapplies the filter and may briefly restart capture. Blank clears the saved default. This is not an ETW filter."
                             ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                             AutomationProperties.LabeledBy="{Binding ElementName=SettingsDefaultBpfLabel}"
                             AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
                  </Grid>

                  <!-- API key -->
                  <!-- GA UI-68: make the existing session-only credential action discoverable without exposing the secret. -->
                  <TextBlock x:Name="SettingsAbuseApiKeyLabel"
                             Grid.Row="6"
                             Text="AbuseIPDB API Key"
                             FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="12,0,6,0"
                             VerticalAlignment="Center"/>
                  <Grid Grid.Row="6" Grid.Column="1" Margin="0,8,0,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <PasswordBox x:Name="AbuseApiKeyBox"
                                 HorizontalAlignment="Stretch"
                                 MinWidth="0"
                                 ToolTip="Enter an AbuseIPDB API key. This masked field and Save settings do not persist the key. Use the adjacent session button to apply an in-memory override; it does not validate credentials or initiate a lookup. For persistence, use the existing environment or .env configuration."
                                 ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                                 AutomationProperties.LabeledBy="{Binding ElementName=SettingsAbuseApiKeyLabel}"
                                 AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                 Margin="0,0,0,10"/>
                    <Button Grid.Row="1"
                            HorizontalAlignment="Left"
                            Content="Use for this session"
                            ToolTip="Applies a nonempty key for this running session only and refreshes the displayed key status. Does not save preferences, validate credentials, enable reputation lookups, or initiate a request. Empty input shows a warning."
                            ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                            AutomationProperties.Name="Use AbuseIPDB API key for this session"
                            AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                            Click="ApplyApiKey_Click"
                            MinWidth="160"
            Style="{StaticResource SecondaryButton}"/>
                  </Grid>

                  <!-- Status line -->
                  <!-- GA UI-84: key configuration status is not credential validation or lookup success. -->
                  <TextBlock x:Name="ApiKeyStatusText"
                             Grid.Row="7"
                             Grid.ColumnSpan="2"
                             Margin="0,8,0,0"
                             Foreground="{StaticResource TextSubtleBrush}"
                             TextWrapping="Wrap"
                             AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                             AutomationProperties.HelpText="Configuration status only; not proof of valid credentials or a successful lookup. The existing status producer can describe an environment-provided key as a session override."
                             Text="Key status: unknown"/>
                  <TextBlock Grid.Row="8"
                             Grid.ColumnSpan="2"
                             Margin="0,3,0,0"
                             Foreground="{StaticResource TextMutedBrush}"
                             FontSize="11"
                             TextWrapping="Wrap"
                             Text="Configuration status only &#x2022; not a credential validation or lookup result."/>
                </Grid>
              </GroupBox>


              <GroupBox x:Name="SettingsDashboardGroup" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        Header="Dashboard &amp; Sections" Tag="03  /  WORKSPACE" Style="{StaticResource SettingsOpsGroup}"
                        Margin="0,0,0,14">
                <Grid Margin="14,16,14,12">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="DASHBOARD COMPOSITION" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="Shape your operational workspace" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,4"/>
                    <TextBlock Text="Section visibility, workspace defaults and layout presets are separate controls." Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap"/>
                    <Button Content="Manage saved investigation searches" Height="33" MinWidth="226"
                            HorizontalAlignment="Left" Margin="0,11,0,0" Style="{StaticResource SecondaryButton}"
                            Click="SettingsOpenNetworkInvestigation_Click"
                            ToolTip="Opens the Network Explorer where explicitly saved search pivots can be reopened or removed"/>
                  </StackPanel>

                  <!-- GA UI-119: section selection becomes a visually distinct composition card. -->
                  <Border Grid.Row="1" Style="{StaticResource PresetCard}" Margin="0,14,0,0" Padding="14">
                    <StackPanel>
                      <TextBlock Text="01  VISIBLE SECTIONS" FontWeight="Bold" FontSize="14"/>
                      <TextBlock Text="Choose which operational modules appear on the dashboard." Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                  <!-- GA UI-63: existing dashboard-section guidance on keyboard focus and via UI Automation; original preference handlers unchanged. -->
                  <!-- GA UI-135: three visible module zones, original named checkboxes and handlers retained. -->
                  <UniformGrid x:Name="SettingsDashboardModuleMatrix" Columns="1" Margin="0,12,0,0">
                      <Border Background="{StaticResource AppBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                          <TextBlock Text="01 / OPERATIONAL OVERVIEW" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                          <TextBlock Text="Incidents, anomaly signals, metrics and the event timeline." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                          <UniformGrid x:Name="SettingsDashboardCoreSectionsGrid" Columns="2">
                            <UniformGrid.Resources><Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource SettingsSectionChoice}"/></UniformGrid.Resources>
                    <CheckBox x:Name="DashboardShowIncidentsCheck"
                              Content="Show Incidents"
                              ToolTip="Display correlated security incidents on the dashboard."
                              ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                              AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                    <CheckBox x:Name="DashboardShowAnomaliesCheck"
                              Content="Show Anomalies"
                              ToolTip="Display anomaly-first behavior signals."
                              ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                              AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                    <CheckBox x:Name="DashboardShowStatisticsCheck"
                              Content="Show Statistics"
                              ToolTip="Display selected security metrics as configurable cards."
                              ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                              AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                    <CheckBox x:Name="DashboardShowTimelineCheck"
                              Content="Show Timeline"
                              ToolTip="Display recent anomaly and incident timeline events."
                              ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                              AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                          </UniformGrid>
                        </StackPanel>
                      </Border>
                      <Border Background="{StaticResource AppBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                          <TextBlock Text="02 / ANALYSIS &amp; RESPONSE" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                          <TextBlock Text="Baseline context, optional scoring, response guidance and forensic shortcuts." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                          <UniformGrid x:Name="SettingsDashboardAnalysisSectionsGrid" Columns="2">
                            <UniformGrid.Resources><Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource SettingsSectionChoice}"/></UniformGrid.Resources>
                    <CheckBox x:Name="DashboardShowBaselineCheck"
                              Content="Show Baseline learning"
                              ToolTip="Display deterministic baseline learning status."
                              ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                              AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                    <CheckBox x:Name="DashboardShowMlCheck"
                              Content="Show ML-assisted scoring"
                              ToolTip="Display optional ML-assisted behavior score status."
                              ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                              AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                    <CheckBox x:Name="DashboardShowRecommendedActionsCheck"
                              Content="Show Recommended actions"
                              ToolTip="Display response guidance from the highest-priority incident."
                              ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                              AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                    <CheckBox x:Name="DashboardShowForensicsCheck"
                              Content="Show Forensics shortcuts"
                              ToolTip="Display raw traffic, raw detections, and advanced investigation shortcuts."
                              ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                              AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                          </UniformGrid>
                        </StackPanel>
                      </Border>
                      <Border Background="{StaticResource AppBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                          <TextBlock Text="03 / ADVANCED &amp; INTEGRATIONS" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                          <TextBlock Text="Raw data, Cisco, external delivery and developer-demo shortcuts." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                          <UniformGrid x:Name="SettingsDashboardAdvancedSectionsGrid" Columns="2">
                            <UniformGrid.Resources><Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource SettingsSectionChoice}"/></UniformGrid.Resources>
                    <CheckBox x:Name="DashboardShowRawSummaryCheck"
                              Content="Show Raw/Advanced shortcuts"
                              ToolTip="Show quick links to raw forensic data. Raw data remains available from navigation even if this is disabled."
                              ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                              AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                    <CheckBox x:Name="DashboardShowCiscoCheck"
                              Content="Show Cisco section"
                              ToolTip="Display Cisco/syslog shortcut widgets."
                              ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                              AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                    <CheckBox x:Name="DashboardShowSinkCheck"
                              Content="Show External delivery"
                              ToolTip="Display sink delivery shortcut widgets."
                              ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                              AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                    <CheckBox x:Name="DashboardShowDemoCheck"
                              Content="Show Developer demo section"
                              ToolTip="Available only when demo mode is enabled."
                              ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                              AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                          </UniformGrid>
                        </StackPanel>
                      </Border>
                  </UniformGrid>
                    </StackPanel>
                  </Border>

                  <!-- GA UI-136: visually separate passive saved workspace flags from immediate layout-replacement actions. -->
                  <Border Grid.Row="2" Style="{StaticResource PresetCard}" Margin="0,16,0,0" Padding="20,18">
                    <StackPanel>
                      <TextBlock Text="02 / WORKSPACE DEFAULTS" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold"/>
                      <TextBlock Text="Startup presentation" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,4"/>
                      <TextBlock Text="Saved display preferences; existing configured widgets and retained evidence remain intact."
                                 Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                      <UniformGrid x:Name="SettingsWorkspaceDefaultsGrid" Columns="2">
                        <Border Background="{StaticResource AppBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                          <StackPanel>
                            <TextBlock Text="MINIMAL PRESENTATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                            <CheckBox x:Name="DashboardMinimalModeCheck"
                              Content="Use minimal dashboard"
                              ToolTip="Saves the minimal-dashboard preference immediately. The visible workspace is populated from enabled configured widgets; toggling this flag alone does not remove widgets, reset the layout, or control capture."
                              ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                              AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                          </StackPanel>
                        </Border>
                        <Border Background="{StaticResource AppBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                          <StackPanel>
                            <TextBlock Text="EMPTY-START PREFERENCE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                            <CheckBox x:Name="DashboardEmptyByDefaultCheck"
                              Content="Empty dashboard by default"
                              ToolTip="Saves the empty-by-default preference immediately. Existing enabled widgets remain configured and this flag alone does not clear the current workspace. Use Reset dashboard to replace the layout with an empty minimal dashboard; retained events and incidents are not deleted."
                              ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                              AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                              Checked="DashboardSectionToggle_Changed"
                              Unchecked="DashboardSectionToggle_Changed"/>
                          </StackPanel>
                        </Border>
                      </UniformGrid>
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="3" Style="{StaticResource PresetCard}" Margin="0,16,0,0" Padding="20,18">
                    <StackPanel>
                      <TextBlock Text="03 / LAYOUT PRESETS" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold"/>
                      <TextBlock Text="Apply a workspace layout" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,4"/>
                      <TextBlock Text="Applying a preset replaces current layout preferences; selecting alone makes no change."
                                 Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                      <Border Background="{StaticResource AppBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                              BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                          <TextBlock x:Name="DashboardPresetsLabel" Text="Recommended layouts" FontWeight="SemiBold" Margin="0,0,0,8"/>
                          <ComboBox x:Name="DashboardPresetCombo"
                                  MinWidth="180" HorizontalAlignment="Stretch"
                                  DisplayMemberPath="Name"
                                  ToolTip="Select a dashboard layout preset. Selection alone does not change the dashboard; Apply preset replaces the current dashboard layout preferences."
                                  ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                                  AutomationProperties.LabeledBy="{Binding ElementName=DashboardPresetsLabel}"
                                  AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
                          <TextBlock Text="Choose a layout, then apply it. You can customize widgets afterwards."
                                     Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                        </StackPanel>
                      </Border>
                      <TextBlock Text="LAYOUT ACTIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,16,0,10"/>
                      <WrapPanel HorizontalAlignment="Left">
                        <Button Content="Apply preset"
                                MinWidth="140"
                                Margin="0,0,10,8"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="Replace current dashboard layout and section visibility with the selected preset, or the minimal Security Overview if none is selected. Applies without confirmation; does not start capture or delete incidents or retained events."
                                ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                                AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                Click="DashboardApplyPreset_Click"/>
                        <Button Content="Reset dashboard"
                                MinWidth="140"
                                Margin="0,0,10,8"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="Replace current dashboard layout preferences with an empty minimal dashboard. Applies without confirmation; does not delete incidents or retained events or start or stop capture."
                                ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                                AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                Click="DashboardResetLayout_Click"/>
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <TextBlock Grid.Row="4"
                             Text="Disabled sections are removed from the main dashboard. Raw Traffic, Raw Detections, Sink Delivery, Cisco Tools, and other forensic views remain accessible from Advanced navigation."
                             Foreground="{StaticResource TextMutedBrush}"
                             TextWrapping="Wrap"
                             Margin="0,8,0,0"/>
                </Grid>
              </GroupBox>

              <!-- GA UI-121: dedicated, provenance-first developer simulation workspace. -->
              <GroupBox x:Name="DemoModeGroup" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        Header="Developer Demo Mode" Style="{StaticResource SettingsOpsGroup}"
                        Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel Margin="10">
                  <Border Background="#112C3E" BorderBrush="{StaticResource CardBorderBrush}"
                          BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,0,14">
                    <StackPanel>
                      <Border Background="#173C4E" BorderBrush="{StaticResource CardBorderBrush}"
                              BorderThickness="1" CornerRadius="5" Padding="10,5"
                              HorizontalAlignment="Left" Margin="0,0,0,12">
                        <TextBlock Text="DEVELOPER SIMULATION · NOT LIVE CAPTURE"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                      </Border>
                      <TextBlock Text="Explore simulated detection scenarios"
                                 FontSize="22" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                      <TextBlock Text="Available only in debug builds or when launched with --demo-mode. Scenario output is labeled demonstration analytics, never proof of capture health or real network activity."
                                 Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap"
                                 Margin="0,8,0,0"/>
                    </StackPanel>
                  </Border>

                  <Border Background="{StaticResource PillBgBrush}"
                          BorderBrush="{StaticResource CardBorderBrush}"
                          BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,0,14">
                    <StackPanel>
                      <TextBlock Text="01  SCENARIO CONTROLS" FontSize="11" FontWeight="Bold"
                                 Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                      <TextBlock Text="Generate or clear demo analytics" FontSize="18" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                      <TextBlock Text="The scenario injects labeled anomaly and detection data into analytics only. Raw packets, sink delivery and forensic views continue to reflect real capture data."
                                 Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap"
                                 Margin="0,7,0,16"/>
                      <WrapPanel>
                        <Button Content="Simulate compromised laptop"
                                MinWidth="220" Margin="0,0,10,10"
                                Style="{StaticResource PrimaryButton}"
                                Click="RunDemoIncident_Click"/>
                        <Button Content="Clear demo data"
                                MinWidth="145" Margin="0,0,10,10"
                                Style="{StaticResource SecondaryButton}"
                                Click="ClearDemoData_Click"/>
                        <Button Content="Open incident queue"
                                MinWidth="165" Margin="0,0,0,10"
                                Style="{StaticResource SecondaryButton}"
                                Click="OpenDemoIncidentQueue_Click"/>
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <Border Background="#102634" BorderBrush="{StaticResource CardBorderBrush}"
                          BorderThickness="1" CornerRadius="10" Padding="20,18">
                    <StackPanel>
                      <TextBlock Text="02  DEMONSTRATION STATUS" FontSize="11" FontWeight="Bold"
                                 Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                      <TextBlock Text="Scenario feedback" FontSize="18" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                      <Border Background="{StaticResource PillBgBrush}"
                              BorderBrush="{StaticResource CardBorderBrush}"
                              BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <TextBlock x:Name="DemoModeStatusText"
                                   Text="Demo mode is enabled. No demo data has been generated yet."
                                   Foreground="{StaticResource TextSubtleBrush}"
                                   TextWrapping="Wrap"/>
                      </Border>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </GroupBox>
                </Grid>
                <!-- GA UI-137: separated operational action cards; original action handlers preserved. -->
                <Border Style="{StaticResource SettingsOpsHero}" Margin="0,12,0,16" Padding="24,22">
                  <StackPanel>
                    <TextBlock Text="04  /  APPLICATION PREFERENCES" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Apply or restore your workspace" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Choose the scope of the operation below. Changes to live capture configuration may take effect when preferences are applied."
                               Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <UniformGrid x:Name="SettingsFooterActionsGrid" Columns="2">
                      <Border Background="#102C3C" BorderBrush="{StaticResource CardBorderBrush}"
                              BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,12,0">
                        <StackPanel>
                          <Border Width="4" Height="24" Background="{StaticResource AccentBrush}"
                                  HorizontalAlignment="Left" CornerRadius="2" Margin="0,0,0,12"/>
                          <TextBlock Text="SAVE CONFIGURATION" FontSize="11" FontWeight="Bold"
                                     Foreground="{StaticResource AccentBrush}" Margin="0,0,0,7"/>
                          <TextBlock Text="Keep current preferences" FontSize="19" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                          <TextBlock Text="Applies sensitivity, capture, enrichment and dashboard preferences."
                                     Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap" Margin="0,8,0,18"/>
                          <Button Content="Save all settings"
                                                  MinWidth="170"
                                                  Style="{StaticResource PrimaryButton}"
                                                  ToolTip="Save sensitivity, capture auto-start, default BPF filter, WHOIS, reputation, anomaly presentation and dashboard section preferences. Runtime preferences are reapplied, including the active Npcap filter when applicable."
                                                  ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                                                  AutomationProperties.Name="Save settings"
                                                  AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                                  Click="SaveSettings_Click"/>
                        </StackPanel>
                      </Border>
                      <Border Background="#142735" BorderBrush="{StaticResource CardBorderBrush}"
                              BorderThickness="1" CornerRadius="10" Padding="20,18">
                        <StackPanel>
                          <Border Width="4" Height="24" Background="{StaticResource TextMutedBrush}"
                                  HorizontalAlignment="Left" CornerRadius="2" Margin="0,0,0,12"/>
                          <TextBlock Text="RESTORE DEFAULTS" FontSize="11" FontWeight="Bold"
                                     Foreground="{StaticResource TextSubtleBrush}" Margin="0,0,0,7"/>
                          <TextBlock Text="Reset application preferences" FontSize="19" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                          <TextBlock Text="Restores all application defaults, not just dashboard layout or sensitivity."
                                     Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap" Margin="0,8,0,18"/>
                          <Button Content="Reset all preferences"
                                                  MinWidth="170"
                                                  Margin="10,0,0,8"
                                                  ToolTip="Reset all application preferences to defaults, not only sensitivity. Applies without a confirmation prompt and reapplies runtime preferences, including the active Npcap filter when applicable."
                                                  ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                                                  AutomationProperties.Name="Reset all settings"
                                                  AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                                  Click="ResetSettings_Click"
                                                  Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                      </Border>
                    </UniformGrid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>

      </Grid>

      <!-- ===== Global status footer ===== -->
      <Border Grid.Row="3"
              Background="{StaticResource AppFooterSurface}"
              BorderBrush="{StaticResource CardBorderBrush}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="14,9"
              Margin="0,14,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      ToolTip="This indicator reflects local capture state, not overall system, database or sensor health."
                      AutomationProperties.HelpText="Local capture state only; no overall system, database or sensor health check is implied.">
            <Ellipse Width="8" Height="8"
                     Fill="{Binding Foreground, ElementName=FooterTelemetryStateText}"
                     Margin="0,0,8,0"/>
            <TextBlock Text="Local capture state" Foreground="{StaticResource TextSubtleBrush}"/>
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <TextBlock Text="Capture:" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
            <!-- GA UI-60: expose the existing local capture-state projection, not a global health verdict. -->
            <TextBlock x:Name="FooterTelemetryStateText"
                       Text="Unknown"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,0,18,0"
                       ToolTip="Current local capture-state projection at the last monitoring-header refresh. On does not prove packet flow; Paused, Degraded, Error and Offline are local capture states. Unknown before refresh. Not overall system, database or sensor health."
                       AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                       AutomationProperties.HelpText="Current local capture state, refreshed by the existing monitoring header. On is the Monitoring projection, not proof of received packets. Paused, Degraded, Error and Offline reflect local capture and flow conditions. Unknown before refresh. No overall system, database or sensor-health claim."/>
            <!-- GA UI-59: expose the sampled UTC clock's current text and its provenance without altering the producer. -->
            <TextBlock x:Name="FooterUtcText"
                       Text="UTC --:--:--"
                       Foreground="{StaticResource TextMutedBrush}"
                       ToolTip="UTC system-clock time-of-day (HH:mm:ss) sampled at the last monitoring-header refresh; date omitted. Not an event timestamp or proof of clock synchronization."
                       AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                       AutomationProperties.HelpText="UTC system-clock time-of-day sampled at the last monitoring-header refresh; date omitted. This display does not represent packet, detection or incident time or verify clock synchronization."/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>

