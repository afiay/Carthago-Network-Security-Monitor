<!-- File: Views/IntegrationsPage.xaml -->
<!-- SPDX-License-Identifier: MIT -->
<Page x:Class="Carthago.Views.IntegrationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Integrations">


  <Page.Resources>
    <Style x:Key="IntegrationDestinationCard" TargetType="Border">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="#285268"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="Width" Value="290"/>
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#102B40" Offset="0"/>
            <GradientStop Color="#091A2B" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IntegrationConfigurationCard" TargetType="Border">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="#274A60"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="22,20"/>
      <Setter Property="Margin" Value="10,16,10,10"/>
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#10273B" Offset="0"/>
            <GradientStop Color="#091725" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <!-- UI-98: configuration-only presentation, not sink status or telemetry. -->
  <Grid Background="{StaticResource AppBackdropGradient}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" CornerRadius="14" BorderBrush="#28556C"
            BorderThickness="1" Padding="24,20" Margin="0,0,0,16">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#13334A" Offset="0"/>
          <GradientStop Color="#0C1D31" Offset="0.58"/>
          <GradientStop Color="#123B3D" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <StackPanel>
        <TextBlock Text="PLATFORM / INTEGRATION DESTINATIONS" FontSize="11"
                   FontWeight="Bold" Foreground="#55D7E8" Margin="0,0,0,8"/>
        <TextBlock Text="Integration Control Center" FontSize="28"
                   FontWeight="Bold" Foreground="#F2F8FF" TextWrapping="Wrap"/>
        <TextBlock Text="Configure telemetry, security exports and local delivery using the existing destination settings."
                   FontSize="13" Foreground="#B7CCDB" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <Border Background="#102C3B" BorderBrush="#2C596A" BorderThickness="1"
                CornerRadius="7" Padding="10,7" Margin="0,14,0,0"
                HorizontalAlignment="Left">
          <TextBlock Text="CONFIGURATION ONLY  ·  NO CONNECTIVITY STATUS IMPLIED"
                     FontSize="11" FontWeight="SemiBold" Foreground="#89D7E4" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>
    </Border>
    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
      <Border Style="{StaticResource IntegrationDestinationCard}">
        <StackPanel>
          <TextBlock Text="01  TELEMETRY &amp; CLOUD" FontSize="11" FontWeight="Bold" Foreground="#54D4E8"/>
          <TextBlock Text="OTLP · Azure" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,4"/>
          <TextBlock Text="Collector and cloud ingestion settings" Foreground="#A9C1D2" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource IntegrationDestinationCard}">
        <StackPanel>
          <TextBlock Text="02  SECURITY EXPORT" FontSize="11" FontWeight="Bold" Foreground="#54D4E8"/>
          <TextBlock Text="CEF · Splunk · Elastic" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,4"/>
          <TextBlock Text="Security platform destination settings" Foreground="#A9C1D2" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource IntegrationDestinationCard}">
        <StackPanel>
          <TextBlock Text="03  STREAM &amp; LOCAL" FontSize="11" FontWeight="Bold" Foreground="#54D4E8"/>
          <TextBlock Text="Kafka · JSONL · Webhook" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,4"/>
          <TextBlock Text="Streaming and file/webhook delivery settings" Foreground="#A9C1D2" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </WrapPanel>
    <Border Grid.Row="2" Style="{StaticResource PageSurface}" Padding="12" Margin="0">

                        <!-- Use the themed TabControl -->
                        <TabControl x:Name="IntegrationsTabs" Style="{StaticResource TabControl.Themed}"
                                    TabStripPlacement="Left"
                                    MinHeight="400" Margin="0">

                                <!-- =============== OTLP ================= -->
                                <TabItem Header="OTLP / OpenTelemetry">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      Background="Transparent">
                                                <Border Style="{StaticResource IntegrationConfigurationCard}">
                                                <StackPanel Margin="0"
                                                            Orientation="Vertical">
                                                  <TextBlock Text="DESTINATION CONFIGURATION" FontSize="11"
                                                             Foreground="#55D5E7" FontWeight="Bold" Margin="0,0,0,7"/>
                                                  <TextBlock Text="OTLP telemetry export" FontSize="23" FontWeight="Bold"
                                                             Foreground="#EDF6FF" TextWrapping="Wrap"/>
                                                  <TextBlock Text="Configure the collector endpoint and the existing OTLP controls." FontSize="12.5" Foreground="#ADC4D4"
                                                             TextWrapping="Wrap" Margin="0,7,0,12"/>
                                                  <Border Height="1" Background="#29485A" Margin="0,0,0,16"/>
                                                        <CheckBox Content="Enable OTLP"
                                                                  IsChecked="{Binding EnableOtlp, Mode=TwoWay}"/>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,8,0,0">
                                                                <TextBlock Text="Endpoint"
                                                                           Width="140"
                                                                           VerticalAlignment="Center"/>
                                                                <!-- Examples:
                                     http(s)://collector:4318/v1/metrics  -> HTTP/protobuf
                                     grpc(s)://collector:4317              -> gRPC
                                -->
                                                                <TextBox Text="{Binding OtlpEndpoint, Mode=TwoWay}"
                                                                         Width="420"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    Margin="0,12,0,0">
                                                                <Button Content="Save"
                                                                        Width="120"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Click="Otlp_Save_Click"/>
                                                                <Button Content="Save + Reload"
                                                                        Width="150"
                                                                        Margin="8,0,0,0"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Click="Otlp_Reload_Click"/>
                                                                <!-- ✅ Test metric button (requires Otlp_Test_Click in code-behind) -->
                                                                <Button Content="Send Test Metric"
                                                                        Width="160"
                                                                        Margin="8,0,0,0"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Click="Otlp_Test_Click"/>
                                                        </StackPanel>
                                                </StackPanel>
                                                </Border>
                                        </ScrollViewer>
                                </TabItem>

                                <!-- =============== Azure ================= -->
                                <TabItem Header="Azure (DCE/DCR)">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      Background="Transparent">
                                                <Border Style="{StaticResource IntegrationConfigurationCard}">
                                                <StackPanel Margin="0">
                                                  <TextBlock Text="DESTINATION CONFIGURATION" FontSize="11"
                                                             Foreground="#55D5E7" FontWeight="Bold" Margin="0,0,0,7"/>
                                                  <TextBlock Text="Azure ingestion" FontSize="23" FontWeight="Bold"
                                                             Foreground="#EDF6FF" TextWrapping="Wrap"/>
                                                  <TextBlock Text="Configure cloud ingestion identifiers and stream routing." FontSize="12.5" Foreground="#ADC4D4"
                                                             TextWrapping="Wrap" Margin="0,7,0,12"/>
                                                  <Border Height="1" Background="#29485A" Margin="0,0,0,16"/>
                                                        <CheckBox Content="Enable Azure"
                                                                  IsChecked="{Binding EnableAzure, Mode=TwoWay}"/>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,8,0,0">
                                                                <TextBlock Text="DCE URI"
                                                                           Width="140"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding AzureDceUri, Mode=TwoWay}"
                                                                         Width="420"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,8,0,0">
                                                                <TextBlock Text="DCR ID"
                                                                           Width="140"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding AzureDcrId, Mode=TwoWay}"
                                                                         Width="420"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,8,0,0">
                                                                <TextBlock Text="Stream"
                                                                           Width="140"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding AzureStream, Mode=TwoWay}"
                                                                         Width="420"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    Margin="0,12,0,0">
                                                                <Button Content="Save"
                                                                        Width="120"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Click="Azure_Save_Click"/>
                                                                <Button Content="Save + Reload"
                                                                        Width="150"
                                                                        Margin="8,0,0,0"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Click="Azure_Reload_Click"/>
                                                        </StackPanel>
                                                </StackPanel>
                                                </Border>
                                        </ScrollViewer>
                                </TabItem>

                                <!-- =============== CEF (Syslog) ================= -->
                                <TabItem Header="CEF (Syslog)">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      Background="Transparent">
                                                <Border Style="{StaticResource IntegrationConfigurationCard}">
                                                <StackPanel Margin="0">
                                                  <TextBlock Text="DESTINATION CONFIGURATION" FontSize="11"
                                                             Foreground="#55D5E7" FontWeight="Bold" Margin="0,0,0,7"/>
                                                  <TextBlock Text="CEF syslog delivery" FontSize="23" FontWeight="Bold"
                                                             Foreground="#EDF6FF" TextWrapping="Wrap"/>
                                                  <TextBlock Text="Set the destination host, port and TLS preference." FontSize="12.5" Foreground="#ADC4D4"
                                                             TextWrapping="Wrap" Margin="0,7,0,12"/>
                                                  <Border Height="1" Background="#29485A" Margin="0,0,0,16"/>
                                                        <CheckBox Content="Enable CEF"
                                                                  IsChecked="{Binding EnableCef, Mode=TwoWay}"/>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,8,0,0">
                                                                <TextBlock Text="Host"
                                                                           Width="140"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding CefHost, Mode=TwoWay}"
                                                                         Width="280"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,8,0,0">
                                                                <TextBlock Text="Port"
                                                                           Width="140"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding CefPort, Mode=TwoWay}"
                                                                         Width="120"/>
                                                        </StackPanel>

                                                        <CheckBox Content="Use TLS"
                                                                  Margin="0,8,0,0"
                                                                  IsChecked="{Binding CefTls, Mode=TwoWay}"/>

                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    Margin="0,12,0,0">
                                                                <Button Content="Save"
                                                                        Width="120"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Click="Cef_Save_Click"/>
                                                                <Button Content="Save + Reload"
                                                                        Width="150"
                                                                        Margin="8,0,0,0"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Click="Cef_Reload_Click"/>
                                                        </StackPanel>
                                                </StackPanel>
                                                </Border>
                                        </ScrollViewer>
                                </TabItem>

                                <!-- =============== Splunk HEC ================= -->
                                <TabItem Header="Splunk HEC">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      Background="Transparent">
                                                <Border Style="{StaticResource IntegrationConfigurationCard}">
                                                <StackPanel Margin="0">
                                                  <TextBlock Text="DESTINATION CONFIGURATION" FontSize="11"
                                                             Foreground="#55D5E7" FontWeight="Bold" Margin="0,0,0,7"/>
                                                  <TextBlock Text="Splunk HEC delivery" FontSize="23" FontWeight="Bold"
                                                             Foreground="#EDF6FF" TextWrapping="Wrap"/>
                                                  <TextBlock Text="Set HEC routing fields and the existing protected token input." FontSize="12.5" Foreground="#ADC4D4"
                                                             TextWrapping="Wrap" Margin="0,7,0,12"/>
                                                  <Border Height="1" Background="#29485A" Margin="0,0,0,16"/>
                                                        <CheckBox Content="Enable Splunk HEC"
                                                                  IsChecked="{Binding EnableSplunkHec, Mode=TwoWay}"/>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,8,0,0">
                                                                <TextBlock Text="Base URL"
                                                                           Width="140"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding SplunkBaseUrl, Mode=TwoWay}"
                                                                         Width="420"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,8,0,0">
                                                                <TextBlock Text="Index"
                                                                           Width="140"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding SplunkIndex, Mode=TwoWay}"
                                                                         Width="220"/>
                                                                <TextBlock Text="Source"
                                                                           Margin="16,0,0,0"
                                                                           Width="80"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding SplunkSource, Mode=TwoWay}"
                                                                         Width="220"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,8,0,0">
                                                                <TextBlock Text="Sourcetype"
                                                                           Width="140"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding SplunkSourcetype, Mode=TwoWay}"
                                                                         Width="220"/>
                                                                <TextBlock Text="Host"
                                                                           Margin="16,0,0,0"
                                                                           Width="80"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding SplunkHost, Mode=TwoWay}"
                                                                         Width="220"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,8,0,0">
                                                                <TextBlock Text="Token"
                                                                           Width="140"
                                                                           VerticalAlignment="Center"/>
                                                                <PasswordBox x:Name="SplunkTokenBox"
                                                                             Width="420"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    Margin="0,12,0,0">
                                                                <Button Content="Save"
                                                                        Width="120"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Click="Splunk_Save_Click"/>
                                                                <Button Content="Save + Reload"
                                                                        Width="150"
                                                                        Margin="8,0,0,0"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Click="Splunk_Reload_Click"/>
                                                        </StackPanel>
                                                </StackPanel>
                                                </Border>
                                        </ScrollViewer>
                                </TabItem>

                                <!-- =============== Elastic ================= -->
                                <TabItem Header="Elastic">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      Background="Transparent">
                                                <Border Style="{StaticResource IntegrationConfigurationCard}">
                                                <StackPanel Margin="0">
                                                  <TextBlock Text="DESTINATION CONFIGURATION" FontSize="11"
                                                             Foreground="#55D5E7" FontWeight="Bold" Margin="0,0,0,7"/>
                                                  <TextBlock Text="Elastic export" FontSize="23" FontWeight="Bold"
                                                             Foreground="#EDF6FF" TextWrapping="Wrap"/>
                                                  <TextBlock Text="Configure the destination, index and authentication field." FontSize="12.5" Foreground="#ADC4D4"
                                                             TextWrapping="Wrap" Margin="0,7,0,12"/>
                                                  <Border Height="1" Background="#29485A" Margin="0,0,0,16"/>
                                                        <CheckBox Content="Enable Elastic"
                                                                  IsChecked="{Binding EnableElastic, Mode=TwoWay}"/>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,8,0,0">
                                                                <TextBlock Text="Base URL"
                                                                           Width="140"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding ElasticBaseUrl, Mode=TwoWay}"
                                                                         Width="420"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,8,0,0">
                                                                <TextBlock Text="Index"
                                                                           Width="140"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding ElasticIndex, Mode=TwoWay}"
                                                                         Width="420"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,8,0,0">
                                                                <TextBlock Text="API Key"
                                                                           Width="140"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding ElasticApiKey, Mode=TwoWay}"
                                                                         Width="420"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    Margin="0,12,0,0">
                                                                <Button Content="Save"
                                                                        Width="120"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Click="Elastic_Save_Click"/>
                                                                <Button Content="Save + Reload"
                                                                        Width="150"
                                                                        Margin="8,0,0,0"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Click="Elastic_Reload_Click"/>
                                                        </StackPanel>
                                                </StackPanel>
                                                </Border>
                                        </ScrollViewer>
                                </TabItem>

                                <!-- =============== Kafka ================= -->
                                <TabItem Header="Kafka">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      Background="Transparent">
                                                <Border Style="{StaticResource IntegrationConfigurationCard}">
                                                <StackPanel Margin="0">
                                                  <TextBlock Text="DESTINATION CONFIGURATION" FontSize="11"
                                                             Foreground="#55D5E7" FontWeight="Bold" Margin="0,0,0,7"/>
                                                  <TextBlock Text="Kafka streaming" FontSize="23" FontWeight="Bold"
                                                             Foreground="#EDF6FF" TextWrapping="Wrap"/>
                                                  <TextBlock Text="Set brokers, topic and the existing protected SASL password input." FontSize="12.5" Foreground="#ADC4D4"
                                                             TextWrapping="Wrap" Margin="0,7,0,12"/>
                                                  <Border Height="1" Background="#29485A" Margin="0,0,0,16"/>
                                                        <CheckBox Content="Enable Kafka"
                                                                  IsChecked="{Binding EnableKafka, Mode=TwoWay}"/>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,8,0,0">
                                                                <TextBlock Text="Bootstrap"
                                                                           Width="140"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding KafkaBootstrap, Mode=TwoWay}"
                                                                         Width="420"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,8,0,0">
                                                                <TextBlock Text="Topic"
                                                                           Width="140"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding KafkaTopic, Mode=TwoWay}"
                                                                         Width="420"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,8,0,0">
                                                                <TextBlock Text="SASL User"
                                                                           Width="140"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding KafkaSaslUser, Mode=TwoWay}"
                                                                         Width="200"/>
                                                                <TextBlock Text="SASL Pass"
                                                                           Margin="16,0,0,0"
                                                                           Width="100"
                                                                           VerticalAlignment="Center"/>
                                                                <PasswordBox x:Name="KafkaSaslPassBox"
                                                                             Width="220"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    Margin="0,12,0,0">
                                                                <Button Content="Save"
                                                                        Width="120"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Click="Kafka_Save_Click"/>
                                                                <Button Content="Save + Reload"
                                                                        Width="150"
                                                                        Margin="8,0,0,0"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Click="Kafka_Reload_Click"/>
                                                        </StackPanel>
                                                </StackPanel>
                                                </Border>
                                        </ScrollViewer>
                                </TabItem>

                                <!-- =============== File (JSONL) ================= -->
                                <TabItem Header="File (JSONL)">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      Background="Transparent">
                                                <Border Style="{StaticResource IntegrationConfigurationCard}">
                                                <StackPanel Margin="0">
                                                  <TextBlock Text="DESTINATION CONFIGURATION" FontSize="11"
                                                             Foreground="#55D5E7" FontWeight="Bold" Margin="0,0,0,7"/>
                                                  <TextBlock Text="Local JSONL delivery" FontSize="23" FontWeight="Bold"
                                                             Foreground="#EDF6FF" TextWrapping="Wrap"/>
                                                  <TextBlock Text="Choose the output directory and existing file rotation options." FontSize="12.5" Foreground="#ADC4D4"
                                                             TextWrapping="Wrap" Margin="0,7,0,12"/>
                                                  <Border Height="1" Background="#29485A" Margin="0,0,0,16"/>
                                                        <CheckBox Content="Enable File Sink"
                                                                  IsChecked="{Binding EnableFileSink, Mode=TwoWay}"/>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,8,0,0">
                                                                <TextBlock Text="Directory"
                                                                           Width="140"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding FileSinkDirectory, Mode=TwoWay}"
                                                                         Width="420"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,8,0,0">
                                                                <TextBlock Text="Max Size (MB)"
                                                                           Width="140"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding FileSinkMaxSizeMB, Mode=TwoWay}"
                                                                         Width="120"/>
                                                                <CheckBox Content="Roll Daily"
                                                                          Margin="24,0,0,0"
                                                                          IsChecked="{Binding FileSinkRollDaily, Mode=TwoWay}"/>
                                                                <CheckBox Content="Compress on Rotate"
                                                                          Margin="24,0,0,0"
                                                                          IsChecked="{Binding FileSinkCompressOnRotate, Mode=TwoWay}"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    Margin="0,12,0,0">
                                                                <Button Content="Save"
                                                                        Width="120"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Click="File_Save_Click"/>
                                                                <Button Content="Save + Reload"
                                                                        Width="150"
                                                                        Margin="8,0,0,0"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Click="File_Reload_Click"/>
                                                        </StackPanel>
                                                </StackPanel>
                                                </Border>
                                        </ScrollViewer>
                                </TabItem>

                                <!-- =============== Webhook ================= -->
                                <TabItem Header="Webhook">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      Background="Transparent">
                                                <Border Style="{StaticResource IntegrationConfigurationCard}">
                                                <StackPanel Margin="0">
                                                  <TextBlock Text="DESTINATION CONFIGURATION" FontSize="11"
                                                             Foreground="#55D5E7" FontWeight="Bold" Margin="0,0,0,7"/>
                                                  <TextBlock Text="Webhook delivery" FontSize="23" FontWeight="Bold"
                                                             Foreground="#EDF6FF" TextWrapping="Wrap"/>
                                                  <TextBlock Text="Configure the outbound webhook destination URL." FontSize="12.5" Foreground="#ADC4D4"
                                                             TextWrapping="Wrap" Margin="0,7,0,12"/>
                                                  <Border Height="1" Background="#29485A" Margin="0,0,0,16"/>
                                                        <CheckBox Content="Enable Webhook"
                                                                  IsChecked="{Binding EnableWebhook, Mode=TwoWay}"/>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,8,0,0">
                                                                <TextBlock Text="URL"
                                                                           Width="140"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding WebhookUrl, Mode=TwoWay}"
                                                                         Width="420"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    Margin="0,12,0,0">
                                                                <Button Content="Save"
                                                                        Width="120"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Click="Webhook_Save_Click"/>
                                                                <Button Content="Save + Reload"
                                                                        Width="150"
                                                                        Margin="8,0,0,0"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Click="Webhook_Reload_Click"/>
                                                        </StackPanel>
                                                </StackPanel>
                                                </Border>
                                        </ScrollViewer>
                                </TabItem>

                        </TabControl>
                </Border>
        </Grid>
</Page>
