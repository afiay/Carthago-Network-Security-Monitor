<!-- GA UI-107: Cisco device configuration, presentation-only. -->
<Window x:Class="Carthago.Views.CiscoDeviceEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Cisco device" Width="590" Height="670"
        MinWidth="450" MinHeight="520" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource AppBgBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Padding="26,24" BorderBrush="#29516A" BorderThickness="0,0,0,1">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#12364C" Offset="0"/>
          <GradientStop Color="#0A1A2B" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <StackPanel>
        <TextBlock Text="CISCO OPERATIONS / DEVICE INVENTORY" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
        <TextBlock Text="Edit Cisco device" Foreground="{StaticResource TextBrush}" FontSize="27" FontWeight="Bold" Margin="0,7,0,4"/>
        <TextBlock Text="Update the local device record and its syslog endpoint."
                   Foreground="{StaticResource TextSubtleBrush}" FontSize="12.5" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,20,20,12">
        <Border Padding="22,20" Background="{StaticResource CardBgBrush}"
                BorderBrush="#2C536B" BorderThickness="1" CornerRadius="14">
          <StackPanel>
            <TextBlock Text="DEVICE IDENTITY" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11"/>
            <TextBlock Text="Inventory details" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,18"/>
            <TextBlock Text="Name" Foreground="{StaticResource TextSubtleBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="NameBox" Height="38" Margin="0,0,0,16" VerticalContentAlignment="Center"/>
            <TextBlock Text="Host / IP" Foreground="{StaticResource TextSubtleBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="HostBox" Height="38" Margin="0,0,0,16" VerticalContentAlignment="Center"/>
            <TextBlock Text="Role" Foreground="{StaticResource TextSubtleBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="RoleBox" Height="38" VerticalContentAlignment="Center"/>
          </StackPanel>
        </Border>
        <Border Padding="22,18" Margin="0,14,0,0" Background="{StaticResource CardBgBrush}"
                BorderBrush="#2C536B" BorderThickness="1" CornerRadius="14">
          <StackPanel>
            <TextBlock Text="SYSLOG CONFIGURATION" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11"/>
            <TextBlock Text="Delivery endpoint" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,15"/>
            <TextBlock Text="Syslog port" Foreground="{StaticResource TextSubtleBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="PortBox" Width="135" Height="38" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
            <Border Height="1" Background="#294257" Margin="0,18,0,15"/>
            <CheckBox x:Name="EnabledCheckBox" Content="Enabled" Foreground="{StaticResource TextBrush}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Padding="20,14" Background="#0A1929" BorderBrush="#294257" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Width="100" Height="40" Margin="0,0,10,0"
                Style="{StaticResource SecondaryButton}" IsCancel="True"/>
        <Button Content="Save device" Width="130" Height="40"
                Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OkButton_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
