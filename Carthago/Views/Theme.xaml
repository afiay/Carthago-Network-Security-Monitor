<!-- File: Views/Theme.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Carthago.Views">

  <!-- Palette -->
  <SolidColorBrush x:Key="AppBgBrush" Color="#07121F"/>
  <SolidColorBrush x:Key="HeaderBgBrush" Color="#0B1B2A"/>
  <SolidColorBrush x:Key="SidebarBgBrush" Color="#081523"/>
  <SolidColorBrush x:Key="CardBgBrush" Color="#0C1A29"/>
  <SolidColorBrush x:Key="CardElevatedBg" Color="#102233"/>
  <SolidColorBrush x:Key="CardBorderBrush" Color="#20384B"/>

  <SolidColorBrush x:Key="AccentBrush" Color="#24C9EC"/>
  <SolidColorBrush x:Key="AccentAltBrush" Color="#42D8F4"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#65E1F9"/>
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#15A4C7"/>

  <SolidColorBrush x:Key="WarnBrush" Color="#EF4444"/>
  <SolidColorBrush x:Key="OkBrush" Color="#22C55E"/>
  <SolidColorBrush x:Key="InfoBrush" Color="#38BDF8"/>
  <SolidColorBrush x:Key="CriticalBrush" Color="#EF4444"/>
  <SolidColorBrush x:Key="HighBrush" Color="#F97316"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>

  <SolidColorBrush x:Key="TextBrush" Color="#F3F7FB"/>
  <SolidColorBrush x:Key="TextSubtleBrush" Color="#C1D2DF"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="#90A7B9"/>
  <SolidColorBrush x:Key="TextInverseBrush" Color="#0B1020"/>
  <SolidColorBrush x:Key="TextWarningBrush" Color="#F59E0B"/>
  <SolidColorBrush x:Key="TextInfoBrush" Color="#38BDF8"/>
  <SolidColorBrush x:Key="TextSuccessBrush" Color="#22C55E"/>
  <SolidColorBrush x:Key="PillBgBrush" Color="#0E1A2C"/>
  <SolidColorBrush x:Key="PillAccentBgBrush" Color="#0A2A47"/>
  <SolidColorBrush x:Key="StatusMonitoringBgBrush" Color="#163121"/>
  <SolidColorBrush x:Key="StatusMonitoringBorderBrush" Color="#22C55E"/>
  <SolidColorBrush x:Key="StatusPausedBgBrush" Color="#36220F"/>
  <SolidColorBrush x:Key="StatusPausedBorderBrush" Color="#F59E0B"/>
  <SolidColorBrush x:Key="StatusOfflineBgBrush" Color="#334155"/>
  <SolidColorBrush x:Key="StatusOfflineBorderBrush" Color="#72839A"/>
  <SolidColorBrush x:Key="SeverityCriticalBrush" Color="#EF4444"/>
  <SolidColorBrush x:Key="SeverityHighBrush" Color="#F97316"/>
  <SolidColorBrush x:Key="SeverityMediumBrush" Color="#F59E0B"/>
  <SolidColorBrush x:Key="SeverityLowBrush" Color="#22C55E"/>
  <SolidColorBrush x:Key="SeverityUnknownBrush" Color="#94A3B8"/>

  <SolidColorBrush x:Key="RowAltBrush" Color="#0E2030"/>
  <SolidColorBrush x:Key="RowHoverBrush" Color="#133247"/>
  <SolidColorBrush x:Key="SelectionBgBrush" Color="#123B53"/>

  <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#0B1728" Offset="0"/>
    <GradientStop Color="#0E1C30" Offset="1"/>
  </LinearGradientBrush>



  <LinearGradientBrush x:Key="AppBackdropGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#050B14" Offset="0"/>
    <GradientStop Color="#071426" Offset="0.55"/>
    <GradientStop Color="#08101D" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="HeaderSurfaceGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#0C1829" Offset="0"/>
    <GradientStop Color="#0A1322" Offset="0.62"/>
    <GradientStop Color="#081120" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="CardSurfaceGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#0C1727" Offset="0"/>
    <GradientStop Color="#081321" Offset="1"/>
  </LinearGradientBrush>

  <SolidColorBrush x:Key="InputBgBrush" Color="#0B1C2B"/>
  <SolidColorBrush x:Key="InputBorderBrush" Color="#29445A"/>
  <SolidColorBrush x:Key="SoftDividerBrush" Color="#1B3245"/>
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#143449"/>
  <SolidColorBrush x:Key="KeyboardFocusBrush" Color="#80E7FA"/>

  <!-- Layout scale -->
  <Thickness x:Key="PagePaddingWide">18,0,18,0</Thickness>
  <Thickness x:Key="PagePaddingStandard">14,0,14,0</Thickness>
  <Thickness x:Key="PagePaddingCompact">10,0,10,0</Thickness>
  <Thickness x:Key="CardPaddingComfortable">16,14</Thickness>
  <Thickness x:Key="CardPaddingCompact">12,10</Thickness>

  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#24C9EC" Offset="0"/>
    <GradientStop Color="#42D8F4" Offset="1"/>
  </LinearGradientBrush>

  <DropShadowEffect x:Key="CardShadow"
                    Color="#000000"
                    BlurRadius="24"
                    Opacity="0.22"
                    ShadowDepth="0"/>
  <DropShadowEffect x:Key="RaisedShadow"
                    Color="#000000"
                    BlurRadius="32"
                    Opacity="0.28"
                    ShadowDepth="2"/>

  <Style x:Key="KeyboardFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{StaticResource KeyboardFocusBrush}"
                  BorderThickness="2"
                  CornerRadius="5"
                  Margin="2"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Global defaults -->
  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource AppBackdropGradient}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
  </Style>

  <Style TargetType="Page">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource AppBackdropGradient}"/>
  </Style>

  <Style TargetType="Label">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <!-- Cards -->
  <Style x:Key="KpiCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Padding" Value="18"/>
    <Setter Property="Margin" Value="6"/>
    <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
  </Style>

  <Style x:Key="ElevatedCard" TargetType="Border" BasedOn="{StaticResource KpiCard}">
    <Setter Property="Background" Value="{StaticResource CardElevatedBg}"/>
    <Setter Property="Effect" Value="{StaticResource RaisedShadow}"/>
  </Style>

  <Style x:Key="IncidentCard" TargetType="Border" BasedOn="{StaticResource ElevatedCard}">
    <Setter Property="Padding" Value="18"/>
    <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>

  <Style x:Key="EmptyStateCard" TargetType="Border" BasedOn="{StaticResource ElevatedCard}">
    <Setter Property="Padding" Value="22"/>
    <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
  </Style>

  <Style x:Key="TimelineItem" TargetType="Border" BasedOn="{StaticResource KpiCard}">
    <Setter Property="Padding" Value="14"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>

  <Style x:Key="EvidenceItem" TargetType="Border" BasedOn="{StaticResource KpiCard}">
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
    <Setter Property="CornerRadius" Value="10"/>
  </Style>

  <!-- Buttons -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="12">
            <ContentPresenter Margin="12,5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="999">
            <ContentPresenter Margin="12,4"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource PillBgBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Background" Value="{StaticResource WarnBrush}"/>
  </Style>

  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Margin" Value="4,0,0,0"/>
  </Style>

  <Style x:Key="Pill" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PillBgBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="Padding" Value="10,4"/>
  </Style>

  <Style x:Key="RiskBadge" TargetType="Border" BasedOn="{StaticResource Pill}">
    <Setter Property="Padding" Value="8,3"/>
  </Style>

  <!-- Inputs -->
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="SelectionOpacity" Value="0.35"/>
  </Style>

  <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Background" Value="#10192B"/>
    <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
    <Setter Property="Padding" Value="12,8"/>
  </Style>

  <Style TargetType="PasswordBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,5"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <ToggleButton x:Name="ToggleButton"
                          TextElement.Foreground="{StaticResource TextBrush}"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          ClickMode="Press">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Chrome"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                      </Grid.ColumnDefinitions>
                      <ContentPresenter Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        TextElement.Foreground="{StaticResource TextBrush}"
                                        RecognizesAccessKey="True"/>
                      <TextBlock Grid.Column="1"
                                 Text="⌄"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontSize="13"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="ContentSite"
                              TextElement.Foreground="{StaticResource TextBrush}"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              Margin="10,0,34,0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"/>
            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   PopupAnimation="Slide"
                   Placement="Bottom">
              <Border Background="{StaticResource InputBgBrush}"
                      BorderBrush="{StaticResource InputBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#17304D"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#102C4A"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="18"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Box"
                    Width="14"
                    Height="14"
                    CornerRadius="3"
                    Background="#0B1728"
                    BorderBrush="{StaticResource InputBorderBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
              <Path x:Name="CheckMark"
                    Data="M 2 7 L 5.4 10.4 L 12 3"
                    Stroke="White"
                    StrokeThickness="2"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Grid.Column="1"
                              Margin="5,0,0,0"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentAltBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Section headers -->
  <Style x:Key="SectionHeader" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>

  <!-- Tabs -->
  <Style x:Key="TabItem.Themed" TargetType="{x:Type TabItem}">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabItem}">
          <Border x:Name="Bd"
                  Background="#10192B"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="12">
            <ContentPresenter ContentSource="Header"
                              Margin="8,3"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#182338"/>
              <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#17304D"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TabControl.Themed" TargetType="{x:Type TabControl}">
    <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource TabItem.Themed}"/>
  </Style>

  <!-- Sidebar -->
  <Style x:Key="NavButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="Margin" Value="0,2,0,0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="NavChrome"
                  Background="{TemplateBinding Background}"
                  CornerRadius="9">
            <Grid>
              <Border x:Name="ActiveRail" Width="3" Margin="0,6,0,6" HorizontalAlignment="Left" CornerRadius="2" Background="Transparent"/>
              <ContentPresenter Margin="0"
                                VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="Active">
              <Setter Property="Background" Value="#123B53"/>
              <Setter TargetName="ActiveRail" Property="Background" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="#133247"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Background" Value="#17465B"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType={x:Type views:Sidebar}}}" Value="True">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,9"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- GroupBox -->
  <Style TargetType="GroupBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type GroupBox}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="#10192B"
                    CornerRadius="12,12,0,0"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1,1,1,0"
                    Padding="12,8">
              <ContentPresenter ContentSource="Header"/>
            </Border>
            <Border Grid.Row="1"
                    Background="{StaticResource CardBgBrush}"
                    CornerRadius="0,0,12,12"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1,0,1,1"
                    Padding="10">
              <ContentPresenter/>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- DataGrid -->
  <Style TargetType="DataGrid">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="#223047"/>
    <Setter Property="RowBackground" Value="{StaticResource CardBgBrush}"/>
    <Setter Property="AlternatingRowBackground" Value="{StaticResource RowAltBrush}"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="EnableRowVirtualization" Value="True"/>
    <Setter Property="EnableColumnVirtualization" Value="True"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="SelectionMode" Value="Extended"/>
    <Setter Property="SelectionUnit" Value="FullRow"/>
    <Setter Property="RowHeight" Value="32"/>
  </Style>

  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}"/>
    <Setter Property="Background" Value="#10192B"/>
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="12,8"/>
  </Style>

  <Style TargetType="DataGridRow">
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource SelectionBgBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="DataGridCell">
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
  </Style>

  <!-- Lists -->
  <Style TargetType="ListBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0"/>
