<!-- File: Views/IncidentsPage.xaml -->
<Page x:Class="Carthago.Views.IncidentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Carthago.Views"
      Title="Incidents"
      PreviewKeyDown="Page_PreviewKeyDown">

  <Page.Resources>
    <local:SeverityToBrushConverter x:Key="SeverityBrush"/>
    <BooleanToVisibilityConverter x:Key="TimelineEventVisibility"/>
    <Style x:Key="AnomalySectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
      <Setter Property="FontSize" Value="15.5"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="AnomalySectionMeta" TargetType="TextBlock" BasedOn="{StaticResource TinyStatusText}">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="AnomalyFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MicroLabel}">
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="AnomalyFieldValue" TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- SOC-11: one actionable, source-bound case reference template for both review locations. -->
    <DataTemplate x:Key="IncidentDetectionLinkCard">
      <Border Background="#10293B" BorderBrush="#31536A" BorderThickness="1"
              CornerRadius="8" Padding="13,12" Margin="0,0,0,9">
        <StackPanel>
          <TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource TextMutedBrush}"
                     FontSize="11" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding RuleLabel}" Foreground="{StaticResource TextBrush}"
                     FontWeight="SemiBold" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSubtleBrush}"
                     FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding EventIdLabel}" Foreground="{StaticResource TextMutedBrush}"
                     FontSize="11" FontFamily="Consolas" Margin="0,8,0,0" TextWrapping="Wrap"/>
          <Button Content="Inspect exact detection" HorizontalAlignment="Left"
                  Margin="0,10,0,0" Padding="12,6" FontSize="11.5"
                  IsEnabled="{Binding CanInvestigate}"
                  Click="InvestigateLinkedDetection_Click"
                  AutomationProperties.Name="Inspect exact recorded detection"
                  ToolTip="Search this recorded event ID in the bounded Network Investigation snapshot"/>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- GA UI-143: responsive incident-command masthead with a distinct live-data case counter. -->
      <Border Grid.Row="0" Style="{StaticResource IncidentOpsHeroCard}" Margin="0,0,0,18" Padding="24,22">
        <Grid x:Name="IncidentHeroGrid">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="IncidentHeroSecondRow" Height="0"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="IncidentHeroCountColumn" Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="IncidentHeroNarrative" Grid.Row="0" Grid.Column="0" Margin="0,0,24,0">
            <TextBlock Text="INCIDENT RESPONSE  /  LOCAL CASES" Style="{StaticResource IncidentOpsEyebrow}"/>
            <TextBlock Text="Incident Command Center" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" Margin="0,9,0,7" TextWrapping="Wrap"/>
            <TextBlock Text="Prioritize correlated cases, inspect evidence and record analyst decisions."
                       Foreground="{StaticResource TextSubtleBrush}" FontSize="13"
                       TextWrapping="Wrap" MaxWidth="650" HorizontalAlignment="Left"/>
            <WrapPanel Margin="0,18,0,0">
              <Border Background="#103246" BorderBrush="#356D80" BorderThickness="1"
                      CornerRadius="7" Padding="11,7" Margin="0,0,9,7">
                <TextBlock Text="01  TRIAGE" Foreground="{StaticResource AccentAltBrush}" FontSize="11" FontWeight="SemiBold"/>
              </Border>
              <Border Background="#0D2636" BorderBrush="#29485C" BorderThickness="1"
                      CornerRadius="7" Padding="11,7" Margin="0,0,9,7">
                <TextBlock Text="02  INVESTIGATE" Foreground="{StaticResource TextSubtleBrush}" FontSize="11" FontWeight="SemiBold"/>
              </Border>
              <Border Background="#0D2636" BorderBrush="#29485C" BorderThickness="1"
                      CornerRadius="7" Padding="11,7" Margin="0,0,0,7">
                <TextBlock Text="03  REVIEW" Foreground="{StaticResource TextSubtleBrush}" FontSize="11" FontWeight="SemiBold"/>
              </Border>
            </WrapPanel>
          </StackPanel>
          <Border x:Name="IncidentHeroCountCard" Grid.Row="0" Grid.Column="1"
                  Background="#0A2637" BorderBrush="#39798A" BorderThickness="1"
                  CornerRadius="12" Padding="22,17" MinWidth="184" VerticalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="ACTIVE CASES" Style="{StaticResource IncidentOpsEyebrow}"
                         Foreground="{StaticResource AccentAltBrush}"/>
              <TextBlock Text="{Binding ActiveIncidentCount}" FontSize="36" FontWeight="Bold"
                         Foreground="{StaticResource TextBrush}" Margin="0,8,0,5"/>
              <Border Height="3" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,4,0,9"/>
              <TextBlock Text="Current local incident queue" Foreground="{StaticResource TextMutedBrush}"
                         FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <UniformGrid x:Name="KpiGrid"
                   Grid.Row="1"
                   Columns="5"
                   Margin="0,0,0,20">
        <Border Style="{StaticResource IncidentOpsKpiCard}" MinHeight="142" Padding="17,15" Margin="0,0,10,0" BorderBrush="{StaticResource SeverityHighBrush}">
          <StackPanel>
            <TextBlock Text="Active Incidents" Style="{StaticResource TinyStatusText}"/>
            <TextBlock Text="{Binding ActiveIncidentCount}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
            <TextBlock Text="Correlated cases awaiting closure" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,5,0,0"/>
            <Border Height="4" Background="{StaticResource SeverityHighBrush}" CornerRadius="3" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource IncidentOpsKpiCard}" MinHeight="142" Padding="17,15" Margin="0,0,10,0" BorderBrush="{StaticResource SeverityCriticalBrush}">
          <StackPanel>
            <TextBlock Text="Critical Incidents" Style="{StaticResource TinyStatusText}"/>
            <TextBlock Text="{Binding CriticalIncidentCount}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
            <TextBlock Text="Highest-risk analyst workload" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,5,0,0"/>
            <Border Height="4" Background="{StaticResource SeverityCriticalBrush}" CornerRadius="3" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource IncidentOpsKpiCard}" MinHeight="142" Padding="17,15" Margin="0,0,10,0" BorderBrush="{StaticResource AccentBrush}">
          <StackPanel>
            <TextBlock Text="New in 1h" Style="{StaticResource TinyStatusText}"/>
            <TextBlock Text="{Binding NewInHourCount}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
            <TextBlock Text="Fresh cases added to response" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,5,0,0"/>
            <Border Height="4" Background="{StaticResource AccentBrush}" CornerRadius="3" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource IncidentOpsKpiCard}" MinHeight="142" Padding="17,15" Margin="0,0,10,0" BorderBrush="{StaticResource SeverityMediumBrush}">
          <StackPanel>
            <TextBlock Text="In Investigation" Style="{StaticResource TinyStatusText}"/>
            <TextBlock Text="{Binding InInvestigationCount}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
            <TextBlock Text="Acknowledged or actively triaged" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,5,0,0"/>
            <Border Height="4" Background="{StaticResource SeverityMediumBrush}" CornerRadius="3" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource IncidentOpsKpiCard}" MinHeight="142" Padding="17,15" BorderBrush="{StaticResource OkBrush}">
          <StackPanel>
            <TextBlock Text="Resolved Today" Style="{StaticResource TinyStatusText}"/>
            <TextBlock Text="{Binding ResolvedTodayCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource OkBrush}" Margin="0,8,0,0"/>
            <TextBlock Text="Completed analyst response flow" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,5,0,0"/>
            <Border Height="4" Background="{StaticResource OkBrush}" CornerRadius="3" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
      </UniformGrid>

      <Grid x:Name="PrimaryWorkspaceGrid" Grid.Row="2">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="PrimaryWorkspaceTopRow" Height="Auto"/>
          <RowDefinition x:Name="PrimaryWorkspaceBottomRow" Height="0"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="PrimaryWorkspaceQueueColumn" Width="0.46*"/>
          <ColumnDefinition x:Name="PrimaryWorkspaceDetailColumn" Width="0.54*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="QueuePanel" Grid.Column="0"
                Style="{StaticResource IncidentOpsPanel}"
                Margin="0,0,18,0" Padding="20">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
              <StackPanel>
                <StackPanel>
                  <TextBlock Text="01 / PRIORITY TRIAGE" Style="{StaticResource IncidentOpsEyebrow}" Margin="0,0,0,6"/>
                  <TextBlock Text="{Binding WorkspaceTitle}"
                             Style="{StaticResource IncidentOpsPanelTitle}"/>
                  <TextBlock Text="{Binding WorkspaceSubtitle}"
                             Style="{StaticResource AnomalySectionMeta}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="Copy JSON"
                          Width="92"
                          Style="{StaticResource SecondaryButton}"
                          Click="CopyJson_Click"
                          ToolTip="Copies the selected incident's JSON details to the system clipboard, not a file. With no incident selected, nothing is copied."
                          ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                          AutomationProperties.Name="Copy selected incident JSON to clipboard"
                          AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
                  <Button Content="Clear"
                          Width="74"
                          Margin="8,0,0,0"
                          Style="{StaticResource SecondaryButton}"
                          Click="Clear_Click"
                          ToolTip="Clears the current in-memory incident queue without confirmation. Does not resolve incidents or delete persisted records; subsequent updates or reopening may repopulate the list."
                          ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                          AutomationProperties.Name="Clear displayed incident queue"
                          AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>
              </StackPanel>

              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="152"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SeverityFilter"
                          Height="38"
                          VerticalContentAlignment="Center"
                          ToolTip="Filters this local incident queue by severity. All shows every severity. This selection does not change incident status or detection settings."
                          ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                          AutomationProperties.Name="Incident queue severity filter"
                          AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}">
                  <ComboBoxItem Content="All" IsSelected="True"/>
                  <ComboBoxItem Content="Critical"/>
                  <ComboBoxItem Content="High"/>
                  <ComboBoxItem Content="Medium"/>
                  <ComboBoxItem Content="Low"/>
                </ComboBox>
                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         Height="38"
                         Margin="10,0,0,0"
                         Style="{StaticResource SearchBox}"
                         VerticalContentAlignment="Center"
                         ToolTip="Search incident titles, hosts, destinations, evidence, or summary"/>
              </Grid>

              <CheckBox x:Name="OnlyUnackedBox"
                        Content="Open incidents only"
                        Margin="0,10,0,0"
                        Checked="OnlyUnackedBox_Changed"
                        Unchecked="OnlyUnackedBox_Changed"
                        ToolTip="Shows only incidents whose status is not Resolved. Acknowledged or investigating incidents may still appear. This filter does not change incident status."
                        ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                        AutomationProperties.Name="Show only unresolved incidents in queue"
                        AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
            </StackPanel>

            <Grid Grid.Row="1"
                  Margin="0,16,0,0">
              <ListBox x:Name="IncidentsList"
                       ItemsSource="{Binding All}"
                       SelectionMode="Single"
                       BorderThickness="0"
                       Background="Transparent"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource AnomalyQueueItemContainerStyle}"/>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <!-- GA UI-167: severity-first priority card; source-backed bindings only. -->
                    <Border Style="{StaticResource IncidentOpsQueueRow}" MinHeight="148" Padding="0" Margin="0,0,0,12"
                            BorderThickness="1" BorderBrush="#34566B" CornerRadius="12">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="6"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                CornerRadius="5,0,0,5"/>
                        <Grid Grid.Column="1" Margin="17,15,16,14">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                          </Grid.RowDefinitions>
                          <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                              <Border Style="{StaticResource RiskBadge}" BorderBrush="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                      Background="#0D1D31" Margin="0,0,9,0">
                                <TextBlock Text="{Binding SeverityUpper}" FontWeight="Bold" FontSize="10.5"
                                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                              </Border>
                              <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource TextSubtleBrush}"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#0A2637" BorderBrush="#35566B" BorderThickness="1"
                                    CornerRadius="8" Padding="9,5" Margin="8,0,0,0">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="RISK " Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding RiskScoreNumber}" FontWeight="Bold" FontSize="17"
                                           Foreground="{StaticResource TextBrush}"/>
                              </StackPanel>
                            </Border>
                          </Grid>
                          <StackPanel Grid.Row="1" Margin="0,11,0,11">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" ToolTip="{Binding Title}"/>
                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSubtleBrush}"
                                       FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" ToolTip="{Binding Summary}"/>
                          </StackPanel>
                          <Border Grid.Row="2" BorderBrush="#28475C" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding SourceLabel}" FontSize="11.5" Foreground="{StaticResource AccentAltBrush}"
                                         TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceLabel}"/>
                              <TextBlock Grid.Column="1" Text="{Binding UpdatedUtc, StringFormat={}{0:HH:mm:ss}}"
                                         FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0"/>
                            </Grid>
                          </Border>
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Border x:Name="IncidentsEmptyState"
                      Style="{StaticResource EmptyStateCard}"
                      Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="320">
                  <TextBlock Text="No incidents match this view"
                             FontSize="18"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="Carthago will correlate detections and anomalies into incidents once enough evidence exists."
                             Foreground="{StaticResource TextSubtleBrush}"
                             TextWrapping="Wrap"
                             TextAlignment="Center"
                             Margin="0,10,0,0"/>
                </StackPanel>
              </Border>
            </Grid>

            <TextBlock Grid.Row="2"
                       Text="{Binding ActiveIncidentCount, StringFormat=Showing {0} active incidents}"
                       Foreground="{StaticResource TextSubtleBrush}"
                       Margin="0,12,0,0"/>
          </Grid>
        </Border>

        <Border x:Name="InvestigationPanel" Grid.Column="1"
                Style="{StaticResource IncidentOpsPanel}" Padding="24" BorderBrush="#39748A" BorderThickness="1.5">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                       Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="02 / SELECTED CASE / ANALYSIS" Style="{StaticResource IncidentOpsEyebrow}" Margin="0,0,0,6"/>
                  <TextBlock Text="Incident Investigation"
                           Style="{StaticResource IncidentOpsPanelTitle}"/>
                <TextBlock Text="Case evidence, impact, analyst feedback, and response decisions for the selected incident."
                           Style="{StaticResource AnomalySectionMeta}"/>
              </StackPanel>
              <WrapPanel Margin="0,12,0,0">
                <Button Content="Acknowledge"
                        Width="106"
                        Margin="0,0,0,7"
                        Style="{StaticResource SecondaryButton}"
                        Click="Ack_Click"
                        ToolTip="Sets the selected incident's status to Acknowledged without confirmation. With no incident selected, no status update is requested."
                        ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                        AutomationProperties.Name="Acknowledge selected incident"
                        AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
                <Button Content="Resolve"
                        Width="88"
                        Margin="8,0,0,7"
                        Style="{StaticResource SecondaryButton}"
                        Click="Resolve_Click"
                        ToolTip="Sets the selected incident's status to Resolved without confirmation. This is an incident status action, not a network remediation command. With no selection, no update is requested."
                        ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                        AutomationProperties.Name="Resolve selected incident"
                        AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
                <Button Content="Investigate source"
                        MinWidth="132" Margin="8,0,0,7"
                        Style="{StaticResource SecondaryButton}"
                        Click="InvestigateSource_Click"
                        ToolTip="Opens retained local traffic and detections matching the selected incident's source IP. Matching an address does not prove incident membership."
                        AutomationProperties.Name="Investigate selected incident source IP"/>
                <Button Content="Investigate destination"
                        MinWidth="155" Margin="8,0,0,7"
                        Style="{StaticResource SecondaryButton}"
                        Click="InvestigateDestination_Click"
                        ToolTip="Searches retained traffic and detections using the incident's recorded destination host or address."
                        AutomationProperties.Name="Investigate selected incident destination"/>
                <Button Content="Export available analysis"
                        MinWidth="164" Margin="8,0,0,7"
                        Style="{StaticResource SecondaryButton}"
                        Click="ExportAnalysis_Click"
                        ToolTip="Uses the existing local Excel exporter for the available multi-category snapshot. This is not a single-incident or complete-history export."
                        AutomationProperties.Name="Export local multi-sheet analysis workbook"/>
              </WrapPanel>
            </StackPanel>

            <StackPanel x:Name="DetailsScrollViewer"
                        Grid.Row="1"
                        Visibility="Collapsed">
              <!-- GA UI-144: selected-case hero; severity is a rail, not an all-edge alert surface. -->
              <Border Background="#10283A" BorderBrush="#31536A" BorderThickness="1"
                      CornerRadius="12" Padding="0" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="{Binding Selected.Severity, Converter={StaticResource SeverityBrush}}"
                          CornerRadius="3,0,0,3"/>
                  <Grid Grid.Column="1" Margin="22,21,20,23">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="132"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                      <TextBlock Text="SELECTED CASE / CORRELATED INCIDENT"
                                 Style="{StaticResource IncidentOpsEyebrow}" Margin="0,0,0,12"/>
                      <TextBlock Text="{Binding Selected.Title}" FontSize="27" FontWeight="Bold"
                                 Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Selected.Summary}" FontSize="13"
                                 Foreground="{StaticResource TextSubtleBrush}"
                                 Margin="0,10,0,0" TextWrapping="Wrap"/>
                      <Border Height="1" Background="#31536A" Margin="0,16,0,12"/>
                      <TextBlock Text="{Binding Selected.IncidentIdLabel}" FontSize="11"
                                 Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#0B2232" BorderBrush="#34576B"
                            BorderThickness="1" CornerRadius="10" Padding="10,14"
                            VerticalAlignment="Top">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="LOCAL RISK" Style="{StaticResource TinyStatusText}"
                                   HorizontalAlignment="Center"/>
                        <Grid Width="98" Height="98" Margin="0,10,0,0">
                          <Ellipse Style="{StaticResource RiskScoreCircle}" Width="98" Height="98"
                                   Stroke="{Binding Selected.Severity, Converter={StaticResource SeverityBrush}}"/>
                          <TextBlock Text="{Binding Selected.RiskScoreNumber}" FontSize="29"
                                     FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource RiskBadge}"
                                BorderBrush="{Binding Selected.Severity, Converter={StaticResource SeverityBrush}}"
                                Margin="0,12,0,0">
                          <TextBlock Text="{Binding Selected.Severity}"
                                     Foreground="{Binding Selected.Severity, Converter={StaticResource SeverityBrush}}"
                                     FontWeight="Bold"/>
                        </Border>
                      </StackPanel>
                    </Border>
                  </Grid>
                </Grid>
              </Border>

              <TextBlock Text="CASE CONTEXT / OBSERVED FACTS" Style="{StaticResource IncidentOpsEyebrow}" Margin="0,20,0,10"/>
              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailGridCard}" Padding="17,15" Background="#112C3E" BorderBrush="#31536A" Margin="0,0,8,8">
                  <StackPanel>
                    <TextBlock Text="Source host" Style="{StaticResource AnomalyFieldLabel}"/>
                    <TextBlock Text="{Binding Selected.SourceLabel}"
                               Style="{StaticResource AnomalyFieldValue}"
                               ToolTip="{Binding Selected.SourceLabel}"/>
                  </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailGridCard}" Padding="17,15" Background="#112C3E" BorderBrush="#31536A" Margin="8,0,8,8">
                  <StackPanel>
                    <TextBlock Text="Destination" Style="{StaticResource AnomalyFieldLabel}"/>
                    <TextBlock Text="{Binding Selected.DestinationLabel}"
                               Style="{StaticResource AnomalyFieldValue}"
                               ToolTip="{Binding Selected.DestinationLabel}"/>
                  </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailGridCard}" Padding="17,15" Background="#112C3E" BorderBrush="#31536A" Margin="0,0,8,8">
                  <StackPanel>
                    <TextBlock Text="Category" Style="{StaticResource AnomalyFieldLabel}"/>
                    <TextBlock Text="{Binding Selected.Category}"
                               Style="{StaticResource AnomalyFieldValue}"
                               ToolTip="{Binding Selected.Category}"/>
                  </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailGridCard}" Padding="17,15" Background="#112C3E" BorderBrush="#31536A" Margin="8,0,0,8">
                  <StackPanel>
                    <TextBlock Text="Detected" Style="{StaticResource AnomalyFieldLabel}"/>
                    <TextBlock Text="{Binding Selected.CreatedLabel}"
                               Style="{StaticResource AnomalyFieldValue}"
                               ToolTip="{Binding Selected.CreatedLabel}"/>
                  </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource DetailGridCard}" Padding="17,15" Background="#112C3E" BorderBrush="#31536A" Margin="0,0,8,0">
                  <StackPanel>
                    <TextBlock Text="Status" Style="{StaticResource AnomalyFieldLabel}"/>
                    <TextBlock Text="{Binding Selected.Status}"
                               Style="{StaticResource AnomalyFieldValue}"
                               ToolTip="{Binding Selected.Status}"/>
                  </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailGridCard}" Padding="17,15" Background="#112C3E" BorderBrush="#31536A" Margin="8,0,0,0">
                  <StackPanel>
                    <TextBlock Text="Related anomalies" Style="{StaticResource AnomalyFieldLabel}"/>
                    <TextBlock Text="{Binding Selected.RelatedAnomalyCountLabel}"
                               Style="{StaticResource AnomalyFieldValue}"/>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- GA UI-145: evidence is a readable two-stage analysis stream, not one mixed list. -->
              <TextBlock Text="03 / EVIDENCE REVIEW" Style="{StaticResource IncidentOpsEyebrow}" Margin="0,24,0,12"/>
              <Border Background="#0C2132" BorderBrush="#31536A" BorderThickness="1"
                      CornerRadius="12" Padding="18,20" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="WHY THIS CASE WAS PRIORITIZED" Style="{StaticResource IncidentOpsEyebrow}"/>
                  <TextBlock Text="Risk evidence" FontSize="20" FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}" Margin="0,6,0,14"/>
                  <ItemsControl ItemsSource="{Binding Selected.RiskReasons}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#122E40" BorderBrush="#31536A" BorderThickness="1"
                                CornerRadius="8" Padding="14,12" Margin="0,0,0,9">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="4"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#36CBE6" CornerRadius="2"/>
                            <TextBlock Grid.Column="1" Text="{Binding}" Margin="14,0,0,0"
                                       TextWrapping="Wrap" FontSize="13"
                                       Foreground="{StaticResource TextSubtleBrush}"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Height="1" Background="#31536A" Margin="0,12,0,16"/>
                  <TextBlock Text="CORRELATED SIGNALS" Style="{StaticResource IncidentOpsEyebrow}"/>
                  <TextBlock Text="Related detections" FontSize="18" FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}" Margin="0,6,0,12"/>
                  <TextBlock Text="{Binding Selected.RelatedDetectionLinkStatus}" FontSize="11"
                             Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                  <ItemsControl ItemsSource="{Binding Selected.RelatedDetectionLinks}"
                                ItemTemplate="{StaticResource IncidentDetectionLinkCard}"/>
                </StackPanel>
              </Border>
              <TextBlock Text="04 / ATTRIBUTION AND ANALYST NOTES"
                         Style="{StaticResource IncidentOpsEyebrow}" Margin="0,6,0,12"/>
              <Grid Margin="0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="InvestigationReviewGrid" Grid.Row="0" Grid.Column="0">
                  <Grid.RowDefinitions>
                    <RowDefinition x:Name="InvestigationReviewTopRow" Height="Auto"/>
                    <RowDefinition x:Name="InvestigationReviewBottomRow" Height="0"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="InvestigationReviewAttributionColumn" Width="*"/>
                    <ColumnDefinition x:Name="InvestigationReviewNotesColumn" Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="InvestigationAttributionCard" Grid.Row="0" Grid.Column="0"
                          Style="{StaticResource BaselineComparisonCard}" Margin="0,0,10,0"
                          Padding="22,20" BorderBrush="#31536A">
                    <StackPanel>
                      <TextBlock Text="03A / CORRELATION CONTEXT" Style="{StaticResource IncidentOpsEyebrow}" Margin="0,0,0,8"/>
                      <TextBlock Text="MITRE / Tags / Rules"
                                 FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                      <Border Height="1" Background="#31536A" Margin="0,12,0,2"/>
                      <ItemsControl ItemsSource="{Binding Selected.MitreTechniques}"
                                    Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource SmallPill}"
                                    Margin="0,0,6,6">
                              <TextBlock Text="{Binding}"
                                         Foreground="{StaticResource TextSubtleBrush}"/>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <ItemsControl ItemsSource="{Binding Selected.Tags}"
                                    Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource SmallPill}"
                                    Margin="0,0,6,6">
                              <TextBlock Text="{Binding}"
                                         Foreground="{StaticResource TextSubtleBrush}"/>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <ItemsControl ItemsSource="{Binding Selected.RuleIds}"
                                    Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource SmallPill}"
                                    Margin="0,0,6,6">
                              <TextBlock Text="{Binding}"
                                         Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border x:Name="InvestigationNotesCard" Grid.Row="0" Grid.Column="1"
                          Style="{StaticResource BaselineComparisonCard}"
                          Margin="10,0,0,0" Padding="22,20" BorderBrush="#31536A">
                    <StackPanel>
                      <TextBlock Text="03B / ANALYST WORKSPACE" Style="{StaticResource IncidentOpsEyebrow}" Margin="0,0,0,8"/>
                      <TextBlock Text="Analyst Note" FontSize="18" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextBrush}"/>
                      <Border Height="1" Background="#31536A" Margin="0,12,0,2"/>
                      <TextBox Text="{Binding Selected.AnalystNoteDraft, UpdateSourceTrigger=PropertyChanged}"
                               AcceptsReturn="True"
                               MinHeight="170"
                               Margin="0,10,0,0"
                               VerticalScrollBarVisibility="Auto"
                               TextWrapping="Wrap"/>
                      <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="{Binding Selected.FeedbackStateLabel}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                        <Button Content="Save Note"
                                Width="88"
                                Style="{StaticResource SecondaryButton}"
                                DockPanel.Dock="Right"
                                Click="SaveNote_Click"/>
                      </DockPanel>
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>

              <!-- GA UI-145: response decisions have a distinct, deliberate command surface. -->
              <Border Background="#10283A" BorderBrush="#31536A" BorderThickness="1"
                      CornerRadius="12" Padding="20,22" Margin="0,22,0,0">
                <StackPanel>
                  <TextBlock Text="05 / ANALYST RESPONSE" Style="{StaticResource IncidentOpsEyebrow}"/>
                  <TextBlock Text="Decision and follow-up" FontSize="20" FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}" Margin="0,6,0,8"/>
                  <TextBlock Text="Classify the selected incident or apply an explicitly chosen local trust action."
                             TextWrapping="Wrap" Foreground="{StaticResource TextSubtleBrush}"
                             Margin="0,0,0,18"/>
                  <Border Height="1" Background="#31536A" Margin="0,0,0,16"/>
                  <WrapPanel>

                <Button Content="Confirm Suspicious"
                        Width="154"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,8"
                        Click="ConfirmSuspicious_Click"/>
                <Button Content="Mark Expected"
                        Width="132"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,8"
                        Click="MarkExpected_Click"/>
                <Button Content="False Positive"
                        Width="128"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,8"
                        Click="MarkFalsePositive_Click"/>
                <Button Content="Suppress Similar"
                        Width="138"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,8"
                        Click="SuppressSimilar_Click"/>
                <Button Content="Trust Destination"
                        Width="138"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,8"
                        IsEnabled="{Binding Selected.HasDestinationTrustCandidate}"
                        Click="TrustDestination_Click"/>
                <Button Content="Trust Port"
                        Width="106"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,8"
                        IsEnabled="{Binding Selected.HasPortTrustCandidate}"
                        Click="TrustPort_Click"/>
                <Button Content="Trust Process"
                        Width="122"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,8"
                        IsEnabled="{Binding Selected.HasProcessTrustCandidate}"
                        Click="TrustProcess_Click"/>
                <Button Content="Copy Report"
                        Width="112"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,8"
                        Click="CopyMarkdown_Click"/>

                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <Border x:Name="DetailsEmptyState"
                    Grid.Row="1"
                    Style="{StaticResource EmptyStateCard}">
              <StackPanel HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          MaxWidth="340">
                <TextBlock Text="Select an incident"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="The investigation cockpit will show evidence, timeline, impact, analyst note, and response decisions."
                           Foreground="{StaticResource TextSubtleBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <Grid x:Name="SupportingWorkspaceGrid" Grid.Row="3"
            Margin="0,20,0,0">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="SupportingWorkspaceFirstRow" Height="Auto"/>
          <RowDefinition x:Name="SupportingWorkspaceSecondRow" Height="0"/>
          <RowDefinition x:Name="SupportingWorkspaceThirdRow" Height="0"/>
          <RowDefinition x:Name="SupportingWorkspaceFourthRow" Height="0"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="SupportingWorkspaceFirstColumn" Width="1.05*"/>
          <ColumnDefinition x:Name="SupportingWorkspaceSecondColumn" Width="0.95*"/>
          <ColumnDefinition x:Name="SupportingWorkspaceThirdColumn" Width="0.95*"/>
          <ColumnDefinition x:Name="SupportingWorkspaceFourthColumn" Width="0.95*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="TimelinePanel" Style="{StaticResource IncidentOpsPanel}" Margin="0,0,10,0" Padding="18,18" BorderBrush="#31536A">
          <StackPanel>
            <TextBlock Text="06 / INCIDENT TIMELINE" Style="{StaticResource IncidentOpsEyebrow}"/>
            <TextBlock Text="Event chronology" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,6,0,5" TextWrapping="Wrap"/>
            <TextBlock Text="Selected case activity" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
            <!-- SOC-13: presentation filter only; underlying recorded story remains intact. -->
            <ComboBox x:Name="TimelineFilterComboBox" Width="180" HorizontalAlignment="Left"
                      Margin="0,12,0,5" Padding="8,5" FontSize="12"
                      AutomationProperties.Name="Filter incident timeline by activity type">
              <ComboBoxItem Content="All activity" IsSelected="True"/>
              <ComboBoxItem Content="Detections"/>
              <ComboBoxItem Content="Anomalies"/>
              <ComboBoxItem Content="Risk changes"/>
              <ComboBoxItem Content="Case actions"/>
              <ComboBoxItem Content="Story updates"/>
              <ComboBoxItem Content="Other activity"/>
            </ComboBox>
            <TextBlock Text="{Binding Selected.TimelineFilterSummary}" FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
            <Border Height="1" Background="#31536A" Margin="0,15,0,15"/>
            <TextBlock Text="No timeline entries match this activity filter. Choose All activity to see the full chronology."
                       Visibility="{Binding Selected.HasNoMatchingTimelineItems, Converter={StaticResource TimelineEventVisibility}}"
                       FontSize="12" Foreground="{StaticResource TextSubtleBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>
            <ItemsControl ItemsSource="{Binding Selected.VisibleTimelineItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#102A3B" BorderBrush="#31536A" BorderThickness="1"
                          CornerRadius="9" Padding="14,14" Margin="0,0,0,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" CornerRadius="2"/>
                      <StackPanel Grid.Column="1" Margin="13,0,0,0">
                        <TextBlock Text="{Binding TimeLabel}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Title}" Margin="0,5,0,0" FontSize="14"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Description}" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSubtleBrush}" TextWrapping="Wrap"/>
                        <!-- Only an explicit, case-owned Detection EventId permits this action. -->
                        <StackPanel Visibility="{Binding CanInvestigateExactEvent, Converter={StaticResource TimelineEventVisibility}}"
                                    Margin="0,11,0,0">
                          <TextBlock Text="{Binding ExactEventIdLabel}" FontSize="11" FontFamily="Consolas"
                                     Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                          <Button Content="Inspect timeline detection" HorizontalAlignment="Left"
                                  Margin="0,7,0,0" Padding="12,6" FontSize="11.5"
                                  Click="InvestigateTimelineDetection_Click"
                                  AutomationProperties.Name="Inspect exact timeline detection"
                                  ToolTip="Open this recorded detection event ID in Network Investigation"/>
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander Header="Recorded detection references" IsExpanded="False"
                      Margin="0,9,0,0" Foreground="{StaticResource TextBrush}">
              <StackPanel Margin="0,12,0,0">
                <TextBlock Text="{Binding Selected.RelatedDetectionLinkStatus}"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock Text="Chronology entries without an explicit event ID are not treated as detection links."
                           Foreground="{StaticResource TextSubtleBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>
                <ItemsControl ItemsSource="{Binding Selected.RelatedDetectionLinks}"
                              ItemTemplate="{StaticResource IncidentDetectionLinkCard}"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <Border x:Name="RelatedAnomaliesPanel" Grid.Column="1" Style="{StaticResource IncidentOpsPanel}" Margin="0,0,10,0" Padding="18,18" BorderBrush="#31536A">
          <StackPanel>
            <TextBlock Text="07 / RELATED ANOMALIES" Style="{StaticResource IncidentOpsEyebrow}"/>
            <TextBlock Text="Correlated observations" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,6,0,5" TextWrapping="Wrap"/>
            <TextBlock Text="Signals associated with this case" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
            <Border Height="1" Background="#31536A" Margin="0,15,0,15"/>
            <ItemsControl ItemsSource="{Binding Selected.RelatedAnomalyDescriptions}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#102A3B" BorderBrush="#31536A" BorderThickness="1" CornerRadius="9" Padding="14,14" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#36CBE6" CornerRadius="2"/><TextBlock Grid.Column="1" Text="{Binding}" Margin="13,0,0,0" Foreground="{StaticResource TextSubtleBrush}" FontSize="13" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
        </Border>

        <Border x:Name="AffectedHostsPanel" Grid.Column="2" Style="{StaticResource IncidentOpsPanel}" Margin="0,0,10,0" Padding="18,18" BorderBrush="#31536A">
          <StackPanel>
            <TextBlock Text="08 / AFFECTED HOSTS" Style="{StaticResource IncidentOpsEyebrow}"/>
            <TextBlock Text="Host impact context" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,6,0,5" TextWrapping="Wrap"/>
            <TextBlock Text="Hosts associated with the selected case" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
            <Border Height="1" Background="#31536A" Margin="0,15,0,15"/>
            <ItemsControl ItemsSource="{Binding Selected.AffectedHosts}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#102A3B" BorderBrush="#31536A" BorderThickness="1" CornerRadius="9" Padding="14,14" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding HostDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" ToolTip="{Binding Host}"/><Border Height="1" Background="#31536A" Margin="0,11,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Role}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/><Border Grid.Column="1" Background="#193648" BorderBrush="#31536A" BorderThickness="1" CornerRadius="5" Padding="9,4" Margin="10,0,0,0"><TextBlock Text="{Binding RiskScoreLabel}" FontWeight="SemiBold" Foreground="{StaticResource TextWarningBrush}"/></Border></Grid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
        </Border>

        <Border x:Name="ResponseChecklistPanel" Grid.Column="3" Style="{StaticResource IncidentOpsPanel}" Padding="18,18" BorderBrush="#31536A">
          <StackPanel>
            <TextBlock Text="09 / RESPONSE CHECKLIST" Style="{StaticResource IncidentOpsEyebrow}"/>
            <TextBlock Text="Response readiness" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,6,0,5" TextWrapping="Wrap"/>
            <TextBlock Text="Existing case checklist and status" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
            <Border Height="1" Background="#31536A" Margin="0,15,0,15"/>
            <ItemsControl ItemsSource="{Binding Selected.ChecklistItems}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#102A3B" BorderBrush="#31536A" BorderThickness="1" CornerRadius="9" Padding="14,14" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Marker}" Foreground="{StaticResource OkBrush}" FontSize="16" FontWeight="Bold"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><Border HorizontalAlignment="Left" Background="#193648" BorderBrush="#31536A" BorderThickness="1" CornerRadius="5" Padding="9,4" Margin="0,9,0,0"><TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/></Border></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</Page>
