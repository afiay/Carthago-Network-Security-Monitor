{
  "AlertCooldownSeconds": 90,
  "StateTtlMinutes": 30,
  "CleanupIntervalSeconds": 120,

  "EnablePortScan": true,
  "PortScanWindowSeconds": 20,
  "PortScanThreshold": 8,

  "EnableFlood": true,
  "FloodWindowSeconds": 10,
  "FloodThreshold": 5,
  "FloodByteThreshold": 1000000,
  "SynAckRatioThreshold": 5.0,

  "EnableThreatFeed": true,

  "EnableBruteForce": true,
  "BruteForceWindowSeconds": 60,
  "BruteForceThreshold": 25,

  "EnableSuspiciousProtocol": true,

  "EnableDns": true,
  "DnsWindowSeconds": 30,
  "DnsThreshold": 20,
  "DnsEntropyThreshold": 3.5,
  "DnsAvgLabelLenThreshold": 20.0,
  "DnsQueryLenThreshold": 50,

  "EnableDnsNxDomainSpike": true,
  "DnsNxWindowSeconds": 60,
  "DnsNxThreshold": 30,

  "EnableBeaconing": true,
  "BeaconMinSamples": 6,
  "BeaconMinObservationSeconds": 60,
  "BeaconStdDevFraction": 0.04,
  "BeaconAutocorrLags": 3,

  "EnableExfiltration": true,
  "ExfilWindowSeconds": 60,
  "ExfilThresholdBytes": 5000000,

  "EnableVpnProxy": true,

  "EnableGeoip": true,
  "GeoipBlacklist": ["CN", "RU", "KP", "IR"],

  "EnableDhcp": true,
  "DhcpWindowSeconds": 60,
  "DhcpThreshold": 20,

  "EnableTlsInspection": true,

  "EnableUncommonPorts": true,
  "UncommonPortsAnomalyThreshold": 0.66,

  "EnableCleartextCredentials": true,

  "EnableArpSpoofing": true,

  "EnableReputation": true,

  "EnableHostSweep": true,
  "HostSweepWindowSeconds": 30,
  "HostSweepDistinctHostsThreshold": 10,

  "EnableHttpIpNoHost": true,

  "EnableHttpUriAnomaly": true,
  "HttpUriLenThreshold": 2000,
  "HttpUriChunkLenThreshold": 80,
  "HttpUriEntropyThreshold": 4.0,

  "EnableSmtpEgress25": true,
  "SmtpAllowedSources": ["10.0.0.10"],

  "EnableIcmpTunnel": true,
  "IcmpWindowSeconds": 60,
  "IcmpPktCountThreshold": 20,
  "IcmpTotalBytesThreshold": 100000
}
