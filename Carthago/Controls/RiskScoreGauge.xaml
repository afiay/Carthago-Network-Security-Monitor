<UserControl x:Class="Carthago.Controls.RiskScoreGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <Grid Width="{Binding GaugeSize, ElementName=Root}"
        Height="{Binding GaugeSize, ElementName=Root}">
    <Ellipse Stroke="#162436"
             StrokeThickness="6"
             Fill="#07111F"/>
    <Ellipse x:Name="AccentRing"
             StrokeThickness="6"
             Fill="Transparent"/>
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center">
      <TextBlock Text="{Binding Caption, ElementName=Root}"
                 Foreground="{StaticResource TextMutedBrush}"
                 FontSize="10"
                 FontWeight="Bold"
                 HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding Score, ElementName=Root}"
                 Foreground="{StaticResource TextBrush}"
                 FontSize="28"
                 FontWeight="Bold"
                 HorizontalAlignment="Center"
                 Margin="0,2,0,0"/>
      <Border Background="#2A1116"
              BorderBrush="{Binding AccentBrush, ElementName=Root}"
              BorderThickness="1"
              CornerRadius="999"
              Padding="10,4"
              Margin="0,8,0,0"
              HorizontalAlignment="Center">
        <TextBlock Text="{Binding StatusText, ElementName=Root}"
                   Foreground="{Binding AccentBrush, ElementName=Root}"
                   FontSize="11"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
