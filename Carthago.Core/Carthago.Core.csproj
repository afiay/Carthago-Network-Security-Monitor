<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Retain canonical source paths during the incremental extraction.
         These files are compiled only by Core, not by either host. -->
    <Compile Include="../Carthago/Services/SessionFiles/CarthagoSessionSnapshot.cs" Link="SessionFiles/CarthagoSessionSnapshot.cs" />
    <Compile Include="../Carthago/Services/SessionFiles/CarthagoSessionArchiveService.cs" Link="SessionFiles/CarthagoSessionArchiveService.cs" />
    <Compile Include="../Carthago/Services/DnsWireNameCodec.cs" Link="Services/DnsWireNameCodec.cs" />
    <Compile Include="../Carthago/Services/ProtocolIntelligence/DnsAddressObservationInspector.cs" Link="Services/ProtocolIntelligence/DnsAddressObservationInspector.cs" />
    <Compile Include="../Carthago/Services/ProtocolIntelligence/BacnetEventDisableInspector.cs" Link="Services/ProtocolIntelligence/BacnetEventDisableInspector.cs" />
    <Compile Include="../Carthago/Models/TrafficRecord.cs" Link="Models/TrafficRecord.cs" />
    <Compile Include="../Carthago/Engine/Rules/Abstractions/SensitiveTelemetryContracts.cs" Link="Engine/Rules/Abstractions/SensitiveTelemetryContracts.cs" />
    <!-- Preserve existing internal access while consumers migrate. -->
    <InternalsVisibleTo Include="Carthago" />
    <InternalsVisibleTo Include="carthago" />
    <InternalsVisibleTo Include="Carthago.Tests" />
    <InternalsVisibleTo Include="Carthago.Cli.Tests" />
  </ItemGroup>
</Project>
